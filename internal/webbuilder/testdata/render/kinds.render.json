{"html":"<div class=\"wb-page cv @container relative bg-white text-left\" data-wb-root=\"\" data-wb-post=\"42\" style=\"--brand:#4058e3;--r-card:12px;--r-btn:8px;--f-head:&#x27;Instrument Serif&#x27;, Georgia, &#x27;Times New Roman&#x27;, serif;--f-display:&#x27;Instrument Serif&#x27;, Georgia, &#x27;Times New Roman&#x27;, serif;--f-body:&#x27;Inter&#x27;, ui-sans-serif, system-ui, sans-serif;font-family:var(--f-body)\"><section class=\"sf\" id=\"s_1lzpxnn\" style=\"--bg:#131417;--fg:#f2f3f5;--muted:#9ca1ab;--hl:color-mix(in srgb, #4058e3 60%, #fff);--line:rgba(255,255,255,.1);--card:#1b1c20;--accent:color-mix(in srgb, #4058e3 62%, #fff);--btn-bg:#4058e3;--btn-fg:#ffffff;--btn2:rgba(255,255,255,.28);--ov:#86a2ff;--ov-ink:#0b1030;background:var(--bg);color:var(--fg);margin:0px 0px 0px 0px\"><div class=\"pointer-events-none absolute inset-0 overflow-hidden\" aria-hidden=\"true\" data-wb-bg=\"\"></div><div class=\"relative z-[1]\"><div class=\"flex h-[68px] items-center\"><div class=\"mx-auto w-full max-w-[1160px] px-6 @3xl:px-10 flex items-center justify-between gap-6\"><div class=\"flex items-center gap-2.5\"><span class=\"grid size-[30px] shrink-0 place-items-center rounded-full border-2 border-current\"><span class=\"ed rt font-[Space_Grotesk] text-[14px] font-bold leading-none\">P</span></span><span class=\"ed rt text-[19px] font-semibold tracking-[-0.01em]\">Pursae</span></div><div class=\"flex items-center gap-7\"><nav data-wb-grid=\"\" class=\"hidden items-center text-[14.5px] @4xl:flex\" style=\"color:var(--muted);column-gap:24px\"><a class=\"ed\">Özellikler</a><a class=\"ed\">Mimari</a><a class=\"ed\">Eklentiler</a><a class=\"ed\">Golementor</a><a class=\"ed\">Yol haritası</a><a class=\"ed\">SSS</a></nav><a class=\"ed hidden h-10 items-center px-4 text-[14px] font-semibold @md:inline-flex\" style=\"background:var(--btn-bg);color:var(--btn-fg);border-radius:var(--r-btn)\">Pursae&#x27;yi edinin</a><details data-wb-menu=\"\" class=\"group/m @4xl:hidden\"><summary aria-label=\"Menu\" class=\"cursor-pointer list-none [&amp;::-webkit-details-marker]:hidden grid size-10 place-items-center\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"21\" height=\"21\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-menu group-open/m:hidden\" aria-hidden=\"true\"><path d=\"M4 5h16\"></path><path d=\"M4 12h16\"></path><path d=\"M4 19h16\"></path></svg><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"21\" height=\"21\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-x hidden group-open/m:block\" aria-hidden=\"true\"><path d=\"M18 6 6 18\"></path><path d=\"m6 6 12 12\"></path></svg></summary><div class=\"absolute inset-x-0 top-full z-50 shadow-[0_30px_40px_-30px_rgba(0,0,0,.35)]\" style=\"background:var(--bg);color:var(--fg)\"><div class=\"px-6 pb-6 pt-2\"><nav aria-label=\"Menu\" class=\"flex flex-col text-[16px] font-medium\"><a class=\"ed block border-b py-3\" style=\"border-color:var(--line)\">Özellikler</a><a class=\"ed block border-b py-3\" style=\"border-color:var(--line)\">Mimari</a><a class=\"ed block border-b py-3\" style=\"border-color:var(--line)\">Eklentiler</a><a class=\"ed block border-b py-3\" style=\"border-color:var(--line)\">Golementor</a><a class=\"ed block border-b py-3\" style=\"border-color:var(--line)\">Yol haritası</a><a class=\"ed block border-b py-3\" style=\"border-color:var(--line)\">SSS</a></nav><div class=\"mt-5 flex\"><a class=\"ed flex h-11 flex-1 items-center justify-center px-5 text-[14.5px] font-semibold\" style=\"background:var(--btn-bg);color:var(--btn-fg);border-radius:var(--r-btn)\">Pursae&#x27;yi edinin</a></div></div></div></details></div></div></div></div></section><section class=\"sf\" id=\"s_o06snzj\" style=\"--bg:#4058e3;--fg:#ffffff;--muted:rgba(255,255,255,.82);--hl:rgba(255,255,255,.88);--line:rgba(255,255,255,.22);--card:rgba(255,255,255,.09);--accent:#ffffff;--btn-bg:#ffffff;--btn-fg:#4058e3;--btn2:rgba(255,255,255,.75);--ov:#ffffff;--ov-ink:#111827;background:var(--bg);color:var(--fg);margin:0px 0px 0px 0px\"><div class=\"pointer-events-none absolute inset-0 overflow-hidden\" aria-hidden=\"true\" data-wb-bg=\"\"><div class=\"absolute aspect-square transition-[left,top,width,opacity] duration-300\" style=\"left:73%;top:50%;width:min(980px, 95.0cqi);transform:translate(-50%, -50%) rotate(0deg);color:currentColor;opacity:0.16\"><div class=\"size-full\"><svg viewBox=\"0 0 800 800\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.2\" class=\"size-full\"><circle cx=\"400\" cy=\"400\" r=\"390\"></circle><ellipse cx=\"400\" cy=\"400\" rx=\"390\" ry=\"150\"></ellipse><ellipse cx=\"400\" cy=\"400\" rx=\"390\" ry=\"290\"></ellipse><ellipse cx=\"400\" cy=\"400\" rx=\"150\" ry=\"390\"></ellipse><ellipse cx=\"400\" cy=\"400\" rx=\"290\" ry=\"390\"></ellipse><line x1=\"10\" y1=\"400\" x2=\"790\" y2=\"400\"></line><line x1=\"400\" y1=\"10\" x2=\"400\" y2=\"790\"></line></svg></div></div></div><div class=\"relative z-[1]\"><div class=\"relative\" style=\"padding-top:clamp(60px, 10.00cqi, 120px);padding-bottom:clamp(60px, 10.00cqi, 120px)\"><div class=\"mx-auto w-full max-w-[1160px] px-6 @3xl:px-10 relative grid items-center gap-16 @5xl:grid-cols-[1.05fr_.95fr]\"><div class=\"\"><span class=\"ed dot-badge inline-flex items-center gap-2 rounded-full px-3 py-1 text-[13px] font-medium\" style=\"background:color-mix(in srgb, var(--fg) 14%, transparent)\">Erken sürüm · 0.1</span><h1 class=\"mt-8\" style=\"font-family:var(--f-head);font-weight:400;letter-spacing:-0.01em;line-height:1.02;font-size:clamp(44px, 7.67cqi, 92px)\"><span class=\"ed rt block\">WordPress,</span><span class=\"ed rt block italic\" style=\"color:var(--hl)\">Go&#x27;nun hızıyla.</span></h1><p class=\"ed rt mt-7 block max-w-[36rem] text-[17px] leading-[1.65]\" style=\"color:var(--muted)\">Pursae, WordPress çekirdeğini Go ile yeniden yazar: tek binary, tek PostgreSQL veritabanı, WebAssembly sandbox&#x27;ında çalışan eklentiler ve yerleşik sayfa oluşturucu. Yönetim paneli ve blok editörü alıştığınız gibi çalışır.</p><div class=\"mt-10 flex flex-wrap gap-3\"><a class=\"ed inline-flex h-12 items-center justify-center gap-2 px-6 text-[15px] font-semibold transition-[background-color,color,border-color,border-radius] duration-300\" style=\"background:var(--btn-bg);color:var(--btn-fg);border-radius:var(--r-btn)\">Hemen başlayın</a><a class=\"ed inline-flex h-12 items-center justify-center gap-2 px-6 text-[15px] font-semibold transition-[background-color,color,border-color,border-radius] duration-300\" style=\"box-shadow:inset 0 0 0 1.5px var(--btn2);color:var(--fg);border-radius:var(--r-btn)\">Mimariyi inceleyin</a></div><div data-wb-grid=\"\" class=\"mt-9 flex flex-wrap text-[12px] font-semibold uppercase tracking-[.08em]\" style=\"color:var(--muted);column-gap:24px;row-gap:8px\"><span class=\"inline-flex items-center gap-1.5\"><span class=\"ed shrink-0 place-items-center inline-grid\" style=\"width:13px;height:13px;color:currentColor\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg></span><span class=\"ed\">Tek binary</span></span><span class=\"inline-flex items-center gap-1.5\"><span class=\"ed shrink-0 place-items-center inline-grid\" style=\"width:13px;height:13px;color:currentColor\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg></span><span class=\"ed\">PostgreSQL + JSONB</span></span><span class=\"inline-flex items-center gap-1.5\"><span class=\"ed shrink-0 place-items-center inline-grid\" style=\"width:13px;height:13px;color:currentColor\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg></span><span class=\"ed\">WASM eklentiler</span></span><span class=\"inline-flex items-center gap-1.5\"><span class=\"ed shrink-0 place-items-center inline-grid\" style=\"width:13px;height:13px;color:currentColor\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg></span><span class=\"ed\">GPL-2.0</span></span></div></div><div class=\"relative mx-auto w-full max-w-[520px]\"><div class=\"ed block\" style=\"border-radius:12px\"><div class=\"overflow-hidden rounded-[12px] border border-white/10 bg-[#141518] text-[#e6e8ec] shadow-[0_40px_90px_-30px_rgba(0,0,0,.6)]\"><div class=\"flex h-10 items-center gap-2 border-b border-white/[0.07] px-4\"><span class=\"size-2.5 rounded-full bg-white/20\"></span><span class=\"size-2.5 rounded-full bg-white/20\"></span><span class=\"size-2.5 rounded-full bg-white/20\"></span><span class=\"ed rt ml-3 font-mono text-[12px] text-white/45\">~/siten</span></div><div class=\"relative px-5 py-5 font-mono text-[12px] leading-[1.9] @md:text-[12.5px]\"><pre class=\"overflow-hidden\"><div class=\"h-[1.9em] whitespace-pre\"><span class=\"text-white/40\">$ </span><span>docker compose up -d</span></div><div class=\"h-[1.9em] whitespace-pre\"><span class=\"text-emerald-400\">✓ </span><span>db</span><span>       </span><span class=\"text-white/45\">postgres:17 · sağlıklı</span></div><div class=\"h-[1.9em] whitespace-pre\"><span class=\"text-emerald-400\">✓ </span><span>pursae</span><span>   </span><span class=\"text-white/45\">tek binary · başladı</span></div><div class=\"h-[1.9em] whitespace-pre\"><span></span></div><div class=\"h-[1.9em] whitespace-pre\"><span class=\"text-white/40\">$ </span><span>pursae serve</span></div><div class=\"h-[1.9em] whitespace-pre\"><span class=\"text-white/35\">› </span><span>şema geçişleri</span><span>     </span><span class=\"text-white/45\">güncel</span></div><div class=\"h-[1.9em] whitespace-pre\"><span class=\"text-white/35\">› </span><span>görev çalıştırıcı</span><span>  </span><span class=\"text-white/45\">çalışıyor</span></div><div class=\"h-[1.9em] whitespace-pre\"><span class=\"text-white/35\">› </span><span>wasm eklentiler</span><span>    </span><span class=\"text-white/45\">3 yüklendi, imzalar ok</span></div><div class=\"h-[1.9em] whitespace-pre\"><span class=\"text-white/35\">› </span><span>http://localhost:8080</span><span>  </span><span class=\"text-white/45\"></span><span class=\"text-emerald-400\">hazır</span><span class=\"text-white/45\"></span></div></pre></div></div></div><div class=\"absolute hidden rounded-[10px] bg-white px-4 py-3 text-[#121418] shadow-[0_18px_40px_-12px_rgba(0,0,0,.45)] @3xl:block wb-bob -bottom-8 -left-8 w-[200px]\" style=\"animation-delay:0.4s\"><span class=\"ed rt block text-[10px] font-semibold tracking-[.12em] text-[#6b7280]\">EKLENTİ SANDBOX&#x27;I</span><div class=\"mt-1.5 flex items-center gap-1.5 text-[14px] font-semibold text-emerald-600\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg> <span class=\"ed rt\">İmza doğrulandı</span></div><div class=\"mt-2.5 h-1 rounded-full bg-emerald-500\"></div></div><div class=\"absolute hidden rounded-[10px] bg-white px-4 py-3 text-[#121418] shadow-[0_18px_40px_-12px_rgba(0,0,0,.45)] @3xl:block wb-bob -right-6 -top-8 w-[170px]\" style=\"animation-delay:0s\"><span class=\"ed rt block text-[10px] font-semibold tracking-[.12em] text-[#6b7280]\">SAYFA ÖNBELLEĞİ</span><span class=\"ed rt mt-1 block text-[22px] font-semibold tracking-tight\">Açık</span><span class=\"ed rt block text-[12px] text-[#6b7280]\">isabet oranı %94</span></div></div></div></div></div></section><section class=\"sf\" id=\"s_pgj7r1h\" style=\"--bg:#f1f2f4;--fg:#121418;--muted:#5b616c;--hl:#4058e3;--line:#dcdee3;--card:#ffffff;--accent:#4058e3;--btn-bg:#4058e3;--btn-fg:#ffffff;--btn2:#c6c9d0;--ov:#3d63f5;--ov-ink:#ffffff;background:var(--bg);color:var(--fg);margin:0px 0px 0px 0px\"><div class=\"pointer-events-none absolute inset-0 overflow-hidden\" aria-hidden=\"true\" data-wb-bg=\"\"></div><div class=\"relative z-[1]\"><div class=\"py-3.5\"><div class=\"mx-auto w-full max-w-[1160px] px-6 @3xl:px-10 text-center text-[14px]\"><span class=\"ed rt\">Pursae 0.1 erken sürüm olarak yayında. Gerçek trafiğe açmadan önce</span> <a class=\"ed font-medium underline decoration-1 underline-offset-4\" style=\"color:var(--accent)\">üretim kontrol listesini okuyun.</a></div></div></div></section><section class=\"sf\" id=\"s_p8hovbk\" style=\"--bg:#ffffff;--fg:#121418;--muted:#5b616c;--hl:#4058e3;--line:#e6e7ea;--card:#f6f7f8;--accent:#4058e3;--btn-bg:#4058e3;--btn-fg:#ffffff;--btn2:#cfd2d8;--ov:#3d63f5;--ov-ink:#ffffff;background:var(--bg);color:var(--fg);margin:0px 0px 0px 0px\"><div class=\"pointer-events-none absolute inset-0 overflow-hidden\" aria-hidden=\"true\" data-wb-bg=\"\"></div><div class=\"relative z-[1]\"><div style=\"padding-top:clamp(56px, 9.33cqi, 112px);padding-bottom:clamp(56px, 9.33cqi, 112px)\"><div class=\"mx-auto w-full max-w-[1160px] px-6 @3xl:px-10\"><div class=\"max-w-2xl\"><span class=\"ed inline-block text-[12.5px] font-semibold uppercase tracking-[.14em]\" style=\"color:var(--accent)\">Özellikler</span><h2 class=\"ed rt mt-4 block text-balance\" style=\"font-family:var(--f-head);font-weight:400;letter-spacing:-0.01em;line-height:1.02;font-size:clamp(30px, 4.67cqi, 56px)\">Bildiğiniz WordPress, yepyeni bir motor.</h2><p class=\"ed rt mt-5 block text-[17px] leading-[1.65]\" style=\"color:var(--muted)\">Temaları, eklentileri ve yönetim panelini değiştirmeden; daha az sunucu, daha az bakım.</p></div><div data-wb-grid=\"\" class=\"mt-14 grid grid-cols-(--gm) @3xl:grid-cols-(--gt) @5xl:grid-cols-(--gd)\" style=\"--gm:repeat(1, minmax(0, 1fr));--gt:repeat(2, minmax(0, 1fr));--gd:repeat(3, minmax(0, 1fr));column-gap:16px;row-gap:16px\"><div class=\"ed edb\" style=\"padding:28px;background:var(--card);border:1px solid var(--line);border-radius:var(--r-card)\"><span class=\"ed shrink-0 place-items-center grid mb-6\" style=\"width:40px;height:40px;border-radius:10px;background:color-mix(in srgb, var(--accent) 13%, transparent);color:var(--accent)\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-box\" aria-hidden=\"true\"><path d=\"M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z\"></path><path d=\"m3.3 7 8.7 5 8.7-5\"></path><path d=\"M12 22V12\"></path></svg></span><h3 class=\"ed rt block text-[17px] font-semibold tracking-[-0.01em]\">Tek binary</h3><p class=\"ed rt mt-2 block text-[14.5px] leading-[1.6]\" style=\"color:var(--muted)\">Kurulum tek bir dosya. PHP-FPM, Nginx ya da ek servis gerekmez.</p></div><div class=\"ed edb\" style=\"padding:28px;background:var(--card);border:1px solid var(--line);border-radius:var(--r-card)\"><span class=\"ed shrink-0 place-items-center grid mb-6\" style=\"width:40px;height:40px;border-radius:10px;background:color-mix(in srgb, var(--accent) 13%, transparent);color:var(--accent)\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-database\" aria-hidden=\"true\"><ellipse cx=\"12\" cy=\"5\" rx=\"9\" ry=\"3\"></ellipse><path d=\"M3 5V19A9 3 0 0 0 21 19V5\"></path><path d=\"M3 12A9 3 0 0 0 21 12\"></path></svg></span><h3 class=\"ed rt block text-[17px] font-semibold tracking-[-0.01em]\">PostgreSQL + JSONB</h3><p class=\"ed rt mt-2 block text-[14.5px] leading-[1.6]\" style=\"color:var(--muted)\">Meta tabloları yerine JSONB; sorgular indekslenir, yedekler sadeleşir.</p></div><div class=\"ed edb\" style=\"padding:28px;background:var(--card);border:1px solid var(--line);border-radius:var(--r-card)\"><span class=\"ed shrink-0 place-items-center grid mb-6\" style=\"width:40px;height:40px;border-radius:10px;background:color-mix(in srgb, var(--accent) 13%, transparent);color:var(--accent)\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-puzzle\" aria-hidden=\"true\"><path d=\"M15.39 4.39a1 1 0 0 0 1.68-.474 2.5 2.5 0 1 1 3.014 3.015 1 1 0 0 0-.474 1.68l1.683 1.682a2.414 2.414 0 0 1 0 3.414L19.61 15.39a1 1 0 0 1-1.68-.474 2.5 2.5 0 1 0-3.014 3.015 1 1 0 0 1 .474 1.68l-1.683 1.682a2.414 2.414 0 0 1-3.414 0L8.61 19.61a1 1 0 0 0-1.68.474 2.5 2.5 0 1 1-3.014-3.015 1 1 0 0 0 .474-1.68l-1.683-1.682a2.414 2.414 0 0 1 0-3.414L4.39 8.61a1 1 0 0 1 1.68.474 2.5 2.5 0 1 0 3.014-3.015 1 1 0 0 1-.474-1.68l1.683-1.682a2.414 2.414 0 0 1 3.414 0z\"></path></svg></span><h3 class=\"ed rt block text-[17px] font-semibold tracking-[-0.01em]\">WASM eklentileri</h3><p class=\"ed rt mt-2 block text-[14.5px] leading-[1.6]\" style=\"color:var(--muted)\">Eklentiler imzalı bir sandbox&#x27;ta çalışır, siteyi asla çökertemez.</p></div><div class=\"ed edb\" style=\"padding:28px;background:var(--card);border:1px solid var(--line);border-radius:var(--r-card)\"><span class=\"ed shrink-0 place-items-center grid mb-6\" style=\"width:40px;height:40px;border-radius:10px;background:color-mix(in srgb, var(--accent) 13%, transparent);color:var(--accent)\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-layout-template\" aria-hidden=\"true\"><rect width=\"18\" height=\"7\" x=\"3\" y=\"3\" rx=\"1\"></rect><rect width=\"9\" height=\"7\" x=\"3\" y=\"14\" rx=\"1\"></rect><rect width=\"5\" height=\"7\" x=\"16\" y=\"14\" rx=\"1\"></rect></svg></span><h3 class=\"ed rt block text-[17px] font-semibold tracking-[-0.01em]\">Yerleşik sayfa oluşturucu</h3><p class=\"ed rt mt-2 block text-[14.5px] leading-[1.6]\" style=\"color:var(--muted)\">Golementor ile sürükle, bırak, yayınla. Tek satır kod yazmadan.</p></div><div class=\"ed edb\" style=\"padding:28px;background:var(--card);border:1px solid var(--line);border-radius:var(--r-card)\"><span class=\"ed shrink-0 place-items-center grid mb-6\" style=\"width:40px;height:40px;border-radius:10px;background:color-mix(in srgb, var(--accent) 13%, transparent);color:var(--accent)\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-timer\" aria-hidden=\"true\"><line x1=\"10\" x2=\"14\" y1=\"2\" y2=\"2\"></line><line x1=\"12\" x2=\"15\" y1=\"14\" y2=\"11\"></line><circle cx=\"12\" cy=\"14\" r=\"8\"></circle></svg></span><h3 class=\"ed rt block text-[17px] font-semibold tracking-[-0.01em]\">Görev çalıştırıcı</h3><p class=\"ed rt mt-2 block text-[14.5px] leading-[1.6]\" style=\"color:var(--muted)\">Za