{
  "title": "Fixture Studio",
  "category": "business",
  "description": "A small kit for the tests: every part type, four pages, two menus and three posts.",
  "screenshot": "screenshot.webp",
  "tags": ["business", "test"],
  "site": {"name": "FX Kit Site", "tagline": "FX tagline from the kit"},
  "settings": {"body_background_background": "classic", "body_background_color": "#FFFFFF"},
  "globals": {
    "colors": [
      {"_id": "primary", "title": "Primary", "color": "#1D4ED8"},
      {"_id": "secondary", "title": "Secondary", "color": "#0F172A"},
      {"_id": "text", "title": "Text", "color": "#334155"},
      {"_id": "accent", "title": "Accent", "color": "#F59E0B"},
      {"_id": "fxlight", "title": "Light", "color": "#F8FAFC"}
    ],
    "typography": [
      {"_id": "primary", "title": "Headings", "typography_typography": "custom", "typography_font_family": "Fraunces", "typography_font_weight": "700"},
      {"_id": "secondary", "title": "Secondary", "typography_typography": "custom", "typography_font_family": "Fraunces", "typography_font_weight": "500"},
      {"_id": "text", "title": "Text", "typography_typography": "custom", "typography_font_family": "Inter", "typography_font_weight": "400"},
      {"_id": "accent", "title": "Accent", "typography_typography": "custom", "typography_font_family": "Inter", "typography_font_weight": "600"}
    ],
    "settings": {"container_width": {"unit": "px", "size": 1180, "sizes": []}, "button_border_radius": {"unit": "px", "top": "6", "right": "6", "bottom": "6", "left": "6", "isLinked": true},
      "__globals__": {"body_color": "globals/colors?id=text", "button_background_color": "globals/colors?id=primary"}}
  },
  "parts": [
    {"type": "header", "title": "Header", "conditions": ["include/general"], "content": [
      {"elType": "container", "settings": {"flex_direction": "row", "flex_justify_content": "space-between",
        "__globals__": {"background_color": "globals/colors?id=fxlight"}, "background_background": "classic"}, "elements": [
        {"elType": "widget", "widgetType": "theme-site-title", "settings": {"__globals__": {"title_color": "globals/colors?id=primary"}}},
        {"elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>FX-HEADER</p>"}},
        {"elType": "widget", "widgetType": "nav-menu", "settings": {"menu_location": "primary"}}
      ]}
    ]},
    {"type": "footer", "title": "Footer", "conditions": ["include/general"], "content": [
      {"elType": "container", "settings": {"flex_direction": "row"}, "elements": [
        {"elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>FX-FOOTER <a href=\"{{page:about}}\">About</a></p>"}},
        {"elType": "widget", "widgetType": "nav-menu", "settings": {"menu_location": "footer"}},
        {"elType": "widget", "widgetType": "theme-site-copyright", "settings": {}}
      ]}
    ]},
    {"type": "single-post", "title": "Single post", "conditions": ["include/singular/post"], "content": [
      {"elType": "container", "settings": {"flex_direction": "column"}, "elements": [
        {"elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>FX-SINGLE-POST</p>"}},
        {"elType": "widget", "widgetType": "theme-post-title", "settings": {"header_size": "h1"}},
        {"elType": "widget", "widgetType": "theme-post-featured-image", "settings": {}},
        {"elType": "widget", "widgetType": "post-info", "settings": {}},
        {"elType": "widget", "widgetType": "theme-post-content", "settings": {}}
      ]}
    ]},
    {"type": "single-page", "title": "Single page", "conditions": ["include/singular/page", "exclude/singular/front_page", "exclude/singular/page/{{page_id:contact}}"], "content": [
      {"elType": "container", "settings": {"flex_direction": "column"}, "elements": [
        {"elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>FX-SINGLE-PAGE</p>"}},
        {"elType": "widget", "widgetType": "theme-post-title", "settings": {"header_size": "h1"}},
        {"elType": "widget", "widgetType": "theme-post-content", "settings": {}}
      ]}
    ]},
    {"type": "archive", "title": "Blog and archives", "conditions": ["include/archive"], "content": [
      {"elType": "container", "settings": {"flex_direction": "column"}, "elements": [
        {"elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>FX-ARCHIVE</p>"}},
        {"elType": "widget", "widgetType": "theme-archive-title", "settings": {}},
        {"elType": "widget", "widgetType": "archive-posts", "settings": {"columns": "3"}}
      ]}
    ]},
    {"type": "search-results", "title": "Search results", "conditions": ["include/archive/search"], "content": [
      {"elType": "container", "settings": {"flex_direction": "column"}, "elements": [
        {"elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>FX-SEARCH</p>"}},
        {"elType": "widget", "widgetType": "theme-archive-title", "settings": {}},
        {"elType": "widget", "widgetType": "archive-posts", "settings": {}}
      ]}
    ]},
    {"type": "error-404", "title": "Not found", "conditions": ["include/singular/not_found404"], "content": [
      {"elType": "container", "settings": {"flex_direction": "column"}, "elements": [
        {"elType": "widget", "widgetType": "heading", "settings": {"title": "FX-404 nothing here", "__globals__": {"title_color": "globals/colors?id=accent"}}},
        {"elType": "widget", "widgetType": "search-form", "settings": {}}
      ]}
    ]}
  ],
  "pages": [
    {"slug": "home", "title": "Home", "front_page": true, "content": [
      {"elType": "container", "settings": {"flex_direction": "column"}, "elements": [
        {"elType": "widget", "widgetType": "heading", "settings": {"title": "FX-HOME welcome", "header_size": "h1",
          "__globals__": {"title_color": "globals/colors?id=primary", "typography_typography": "globals/typography?id=primary"}}},
        {"elType": "widget", "widgetType": "image", "settings": {"image": {"url": "{{library:images/hero.webp}}", "id": ""}}},
        {"elType": "widget", "widgetType": "button", "settings": {"text": "FX contact button", "link": {"url": "{{page:contact}}", "is_external": "", "nofollow": ""}}}
      ]}
    ]},
    {"slug": "blog", "title": "Journal", "posts_page": true},
    {"slug": "about", "title": "About", "template": "default", "content": [
      {"elType": "container", "settings": {"flex_direction": "column"}, "elements": [
        {"elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>FX-ABOUT we are a small studio.</p>"}},
        {"elType": "widget", "widgetType": "image", "settings": {"image": {"url": "{{library:images/office.webp}}", "id": ""}}},
        {"elType": "widget", "widgetType": "image", "settings": {"image": {"url": "{{library:kits/fixture-studio/images/team.webp}}", "id": ""}}}
      ]}
    ]},
    {"slug": "contact", "title": "Contact", "settings": {"template": "elementor_header_footer", "hide_title": "yes"}, "content": [
      {"elType": "container", "settings": {"flex_direction": "column"}, "elements": [
        {"elType": "widget", "widgetType": "heading", "settings": {"title": "FX-CONTACT get in touch", "header_size": "h1"}},
        {"elType": "widget", "widgetType": "form", "settings": {"form_name": "Contact", "submit_actions": ["save-to-database"],
          "form_fields": [{"_id": "a1", "custom_id": "name", "field_type": "text", "field_label": "Name", "required": "true"},
                          {"_id": "a2", "custom_id": "email", "field_type": "email", "field_label": "Email", "required": "true"},
                          {"_id": "a3", "custom_id": "message", "field_type": "textarea", "field_label": "Message"}]}}
      ]}
    ]},
    {"slug": "services", "title": "Services", "optional": true, "content": [
      {"elType": "container", "settings": {}, "elements": [
        {"elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>FX-SERVICES</p>"}}
      ]}
    ]}
  ],
  "menus": [
    {"location": "primary", "name": "Main menu", "items": [
      {"title": "Home", "page": "home"}, {"title": "About", "page": "about", "children": [{"title": "Services", "page": "services"}]},
      {"title": "Journal", "page": "blog"}, {"page": "contact"}
    ]},
    {"location": "footer", "name": "Footer menu", "items": [
      {"title": "FX Footer About", "page": "about"}, {"title": "FX Elsewhere", "url": "https://example.org/"}
    ]}
  ],
  "posts": [
    {"title": "FX first post", "slug": "fx-first-post", "content": "<!-- wp:paragraph -->\n<p>FX-POST-BODY one. Read <a href=\"{{page:about}}\">about</a>.</p>\n<!-- /wp:paragraph -->",
     "image": "{{library:images/post-a.webp}}", "category": "FX News"},
    {"title": "FX second post", "content": "<!-- wp:paragraph -->\n<p>FX-POST-BODY two.</p>\n<!-- /wp:paragraph -->",
     "image": "{{library:images/post-b.webp}}", "categories": ["FX News", "FX Guides"]},
    {"title": "FX third post", "content": "<!-- wp:paragraph -->\n<p>FX-POST-BODY three, findable by zebrafish.</p>\n<!-- /wp:paragraph -->",
     "image": "{{library:images/post-a.webp}}"}
  ]
}
