{
  "slug": "devboard",
  "name": "Devboard",
  "version": "1.0.0",
  "description": "A dense developer Q&A board built for Pursae Forum: compact topic rows with monospace counts, readable code blocks in posts, a dark header with the account menu, a front page with the latest questions and a stats sidebar beside every forum page. Inter and JetBrains Mono, self-hosted. Works without JavaScript.",
  "author": "Pursae",
  "author_url": "https://github.com/pursae",
  "theme_url": "https://github.com/pursae/pursae/tree/main/library/themes/devboard",
  "tags": ["Community", "Forum", "Technology", "Custom Colors", "Custom Logo", "Custom Menu", "Editor Style", "Translation Ready", "Right Sidebar"],
  "requires_core": "0.1.0",
  "screenshot": "assets/screenshot.png",

  "category": "technology",
  "style": "Dense developer Q&A board with code styling and a stats sidebar",
  "demo": "demo/demo.json",

  "menu_locations": [
    {"id": "primary", "name": "Primary Menu", "description": "In the dark header bar."},
    {"id": "footer", "name": "Footer Menu", "description": "Links in the footer."}
  ],

  "styles": [
    {"handle": "devboard-style", "src": "assets/style.css", "deps": [], "media": "all"}
  ],
  "editor_styles": ["assets/editor-style.css"],
  "preload_fonts": ["assets/fonts/inter.woff2"],

  "palette": [
    {"name": "Indigo", "slug": "primary", "color": "#4F46E5"},
    {"name": "Mint", "slug": "accent", "color": "#10B981"},
    {"name": "Ink", "slug": "text", "color": "#0F172A"},
    {"name": "Header", "slug": "header", "color": "#0F172A"},
    {"name": "Background", "slug": "background", "color": "#F8FAFC"},
    {"name": "Surface", "slug": "surface", "color": "#FFFFFF"},
    {"name": "Slate", "slug": "muted", "color": "#64748B"},
    {"name": "Line", "slug": "line", "color": "#E2E8F0"}
  ],
  "supports": {
    "pursae-forum": true,
    "post-thumbnails": true,
    "title-tag": true,
    "custom-logo": {"width": 160, "height": 36, "flex-width": true, "flex-height": true},
    "responsive-embeds": true,
    "html5": ["search-form", "comment-form", "comment-list", "gallery", "caption", "script", "style"]
  },

  "customizer": {
    "sections": [
      {
        "id": "devboard_options", "title": "Devboard", "description": "Accent color and the forum layout.", "priority": 40,
        "settings": [
          {"id": "accent", "label": "Accent color", "description": "Buttons, links, the active row marker.", "type": "color", "default": "#4F46E5", "transport": "postMessage", "css_var": "--pf-accent"},
          {"id": "layout", "label": "Forum layout", "description": "The stats and recent-topics sidebar beside the forum pages.", "type": "select", "default": "sidebar", "transport": "refresh", "body_class": "db-layout-{value}",
            "choices": [{"value": "sidebar", "label": "With sidebar"}, {"value": "full", "label": "Full width"}]}
        ]
      }
    ]
  }
}
