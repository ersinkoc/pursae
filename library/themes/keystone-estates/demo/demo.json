\n<!-- wp:paragraph --><p>Five minutes' walk to the market square, the station and the river path.</p><!-- /wp:paragraph -->\n\n<!-- wp:group {\"className\":\"agent-card\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group agent-card\"><!-- wp:paragraph --><p><strong>Want to see it?</strong> Viewings are available six days a week, including early evenings.</p><!-- /wp:paragraph --><!-- wp:buttons --><div class=\"wp-block-buttons\"><!-- wp:button --><div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"{{page:contact}}\">Book a viewing</a></div><!-- /wp:button --></div><!-- /wp:buttons --></div><!-- /wp:group -->",
