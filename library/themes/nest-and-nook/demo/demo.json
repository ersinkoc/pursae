   "excerpt": "We design calm, light-filled homes with natural materials and a lot of patience. Explore our rooms, projects and ideas.",
   "content": "<!-- wp:paragraph {\"className\":\"kicker\",\"align\":\"center\"} --><p class=\"has-text-align-center kicker\">Room by room</p><!-- /wp:paragraph -->\n\n<!-- wp:heading {\"textAlign\":\"center\"} --><h2 class=\"wp-block-heading has-text-align-center\">Find inspiration for every corner</h2><!-- /wp:heading -->\n\n<!-- wp:columns {\"align\":\"wide\",\"className\":\"room-tiles\"} --><div class=\"wp-block-columns alignwide room-tiles\"><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:group {\"className\":\"room-tile\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group room-tile\"><!-- wp:image {\"id\":{{media_id:living}},\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} --><figure class=\"wp-block-image size-large\"><a href=\"{{category:living-room}}\"><img src=\"{{media:living}}\" alt=\"Living room photo\" class=\"wp-image-{{media_id:living}}\"/></a></figure><!-- /wp:image --><!-- wp:paragraph --><p><a href=\"{{category:living-room}}\">Living</a></p><!-- /wp:paragraph --></div><!-- /wp:group --></div><!-- /wp:column --><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:group {\"className\":\"room-tile\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group room-tile\"><!-- wp:image {\"id\":{{media_id:kitchen-after}},\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} --><figure class=\"wp-block-image size-large\"><a href=\"{{category:kitchen}}\"><img src=\"{{media:kitchen-after}}\" alt=\"Kitchen room photo\" class=\"wp-image-{{media_id:kitchen-after}}\"/></a></figure><!-- /wp:image --><!-- wp:paragraph --><p><a href=\"{{category:kitchen}}\">Kitchen</a></p><!-- /wp:paragraph --></div><!-- /wp:group --></div><!-- /wp:column --><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:group {\"className\":\"room-tile\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group room-tile\"><!-- wp:image {\"id\":{{media_id:bedroom}},\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} --><figure class=\"wp-block-image size-large\"><a href=\"{{category:bedroom}}\"><img src=\"{{media:bedroom}}\" alt=\"Bedroom room photo\" class=\"wp-image-{{media_id:bedroom}}\"/></a></figure><!-- /wp:image --><!-- wp:paragraph --><p><a href=\"{{category:bedroom}}\">Bedroom</a></p><!-- /wp:paragraph --></div><!-- /wp:group --></div><!-- /wp:column --><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:group {\"className\":\"room-tile\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group room-tile\"><!-- wp:image {\"id\":{{media_id:bath-after}},\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} --><figure class=\"wp-block-image size-large\"><a href=\"{{category:bathroom}}\"><img src=\"{{media:bath-after}}\" alt=\"Bathroom room photo\" class=\"wp-image-{{media_id:bath-after}}\"/></a></figure><!-- /wp:image --><!-- wp:paragraph --><p><a href=\"{{category:bathroom}}\">Bathroom</a></p><!-- /wp:paragraph --></div><!-- /wp:group --></div><!-- /wp:column --><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:group {\"className\":\"room-tile\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group room-tile\"><!-- wp:image {\"id\":{{media_id:balcony}},\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} --><figure class=\"wp-block-image size-large\"><a href=\"{{category:outdoor}}\"><img src=\"{{media:balcony}}\" alt=\"Outdoor room photo\" class=\"wp-image-{{media_id:balcony}}\"/></a></figure><!-- /wp:image --><!-- wp:paragraph --><p><a href=\"{{category:outdoor}}\">Outdoor</a></p><!-- /wp:paragraph --></div><!-- /wp:group --></div><!-- /wp:column --></div><!-- /wp:columns -->\n\n<!-- wp:group {\"align\":\"full\",\"className\":\"band-linen\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group alignfull band-linen\"><!-- wp:columns --><div class=\"wp-block-columns\"><!-- wp:column {\"width\":\"38%\"} --><div class=\"wp-block-column\" style=\"flex-basis:38%\"><!-- wp:paragraph {\"className\":\"kicker\"} --><p class=\"kicker\">Before &amp; after</p><!-- /wp:paragraph --><!-- wp:heading --><h2 class=\"wp-block-heading\">The galley kitchen</h2><!-- /wp:heading --><!-- wp:paragraph --><p>A narrow 1970s kitchen became a bright workspace with one long oak counter. We kept the layout and changed the light.</p><!-- /wp:paragraph --><!-- wp:buttons --><div class=\"wp-block-buttons\"><!-- wp:button --><div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"{{post:before-and-after-galley-kitchen}}\">See the transformation</a></div><!-- /wp:button --></div><!-- /wp:buttons --></div><!-- /wp:column --><!-- wp:column {\"width\":\"62%\"} --><div class=\"wp-block-column\" style=\"flex-basis:62%\"><!-- wp:columns {\"className\":\"before-after\"} --><div class=\"wp-block-columns before-after\"><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:image {\"id\":{{media_id:kitchen-before}},\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} --><figure class=\"wp-block-image size-large\"><img src=\"{{media:kitchen-before}}\" alt=\"The kitchen before\" class=\"wp-image-{{media_id:kitchen-before}}\"/><figcaption class=\"wp-element-caption\">Before</figcaption></figure><!-- /wp:image --></div><!-- /wp:column --><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:image {\"id\":{{media_id:kitchen-after}},\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} --><figure class=\"wp-block-image size-large\"><img src=\"{{media:kitchen-after}}\" alt=\"The kitchen after\" class=\"wp-image-{{media_id:kitchen-after}}\"/><figcaption class=\"wp-element-caption\">After</figcaption></figure><!-- /wp:image --></div><!-- /wp:column --></div><!-- /wp:columns --></div><!-- /wp:column --></div><!-- /wp:columns --></div><!-- /wp:group -->\n\n<!-- wp:paragraph {\"className\":\"kicker\",\"align\":\"center\"} --><p class=\"has-text-align-center kicker\">How we can help</p><!-- /wp:paragraph -->\n\n<!-- wp:heading {\"textAlign\":\"center\"} --><h2 class=\"wp-block-heading has-text-align-center\">Studio services</h2><!-- /wp:heading -->\n\n<!-- wp:columns {\"align\":\"wide\",\"className\":\"services\"} --><div class=\"wp-block-columns alignwide services\"><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:paragraph {\"className\":\"num\"} --><p class=\"num\">01</p><!-- /wp:paragraph --><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Design consultation</h3><!-- /wp:heading --><!-- wp:paragraph --><p>A two-hour visit with a clear plan, a colour palette and a shopping list you can follow yourself.</p><!-- /wp:paragraph --></div><!-- /wp:column --><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:paragraph {\"className\":\"num\"} --><p class=\"num\">02</p><!-- /wp:paragraph --><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Room design</h3><!-- /wp:heading --><!-- wp:paragraph --><p>Full concept, layout drawings, sourcing and styling for a single room.</p><!-- /wp:paragraph --></div><!-- /wp:column --><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:paragraph {\"className\":\"num\"} --><p class=\"num\">03</p><!-- /wp:paragraph --><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Renovation</h3><!-- /wp:heading --><!-- wp:paragraph --><p>From planning to the final cushion: we manage trades, budgets and timelines.</p><!-- /wp:paragraph --></div><!-- /wp:column --></div><!-- /wp:columns -->\n\n<!-- wp:group {\"align\":\"full\",\"className\":\"band-dark\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group alignfull band-dark\"><!-- wp:columns --><div class=\"wp-block-columns\"><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:heading --><h2 class=\"wp-block-heading\">Shop the look</h2><!-- /wp:heading --><!-- wp:paragraph --><p>Every project ends with a list of the pieces we used, so you can bring the feeling home.</p><!-- /wp:paragraph --></div><!-- /wp:column --><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:buttons --><div class=\"wp-block-buttons\"><!-- wp:button --><div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"{{category:shop-the-look}}\">Browse shop-the-look</a></div><!-- /wp:button --></div><!-- /wp:buttons --></div><!-- /wp:column --></div><!-- /wp:columns --></div><!-- /wp:group -->\n\n<!-- wp:quote --><blockquote class=\"wp-block-quote\"><!-- wp:paragraph --><p>A home should look like the people who live in it, only a little more rested.</p><!-- /wp:paragraph --><cite>Nest &amp; Nook</cite></blockquote><!-- /wp:quote -->"
  },
