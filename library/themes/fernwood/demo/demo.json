   "content": "<!-- wp:cover {\"url\":\"{{media:hero}}\",\"dimRatio\":40,\"minHeight\":560,\"align\":\"full\",\"className\":\"gs-hero\",\"id\":{{media_id:hero}}} --><div class=\"wp-block-cover alignfull gs-hero\" style=\"min-height:560px\"><span aria-hidden=\"true\" class=\"wp-block-cover__background has-background-dim-40 has-background-dim\"></span><img class=\"wp-block-cover__image-background wp-image-{{media_id:hero}}\" alt=\"\" src=\"{{media:hero}}\" data-object-fit=\"cover\"/><div class=\"wp-block-cover__inner-container\"><!-- wp:group {\"layout\":{\"type\":\"default\"}} --><div class=\"wp-block-group\"><!-- wp:paragraph {\"className\":\"gs-eyebrow\"} --><p class=\"gs-eyebrow\">New this season</p><!-- /wp:paragraph --><!-- wp:heading {\"level\":1} --><h1 class=\"wp-block-heading\">Bring the outside in.</h1><!-- /wp:heading --><!-- wp:paragraph --><p>Easy-going houseplants, handmade planters and the tools to keep them thriving, delivered from our greenhouse to your door.</p><!-- /wp:paragraph --><!-- wp:group {\"className\":\"gs-row\",\"layout\":{\"type\":\"default\"}} --><div class=\"wp-block-group gs-row\"><!-- wp:buttons --><div class=\"wp-block-buttons\"><!-- wp:button --><div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"/shop/\">Shop plants</a></div><!-- /wp:button --></div><!-- /wp:buttons --><!-- wp:buttons --><div class=\"wp-block-buttons\"><!-- wp:button --><div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"{{page:about}}\">How we grow</a></div><!-- /wp:button --></div><!-- /wp:buttons --></div><!-- /wp:group --></div><!-- /wp:group --></div></div><!-- /wp:cover --><!-- wp:group {\"className\":\"gs-section gs-bg-cream\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group gs-section gs-bg-cream\"><!-- wp:group {\"layout\":{\"type\":\"default\"}} --><div class=\"wp-block-group\"><!-- wp:group {\"className\":\"gs-feature\",\"layout\":{\"type\":\"default\"}} --><div class=\"wp-block-group gs-feature\"><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Free delivery</h3><!-- /wp:heading --><!-- wp:paragraph --><p>On every order over $60</p><!-- /wp:paragraph --></div><!-- /wp:group --><!-- wp:group {\"className\":\"gs-feature\",\"layout\":{\"type\":\"default\"}} --><div class=\"wp-block-group gs-feature\"><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Happy-plant promise</h3><!-- /wp:heading --><!-- wp:paragraph --><p>30 days to settle in</p><!-- /wp:paragraph --></div><!-- /wp:group --><!-- wp:group {\"className\":\"gs-feature\",\"layout\":{\"type\":\"default\"}} --><div class=\"wp-block-group gs-feature\"><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Peat-free</h3><!-- /wp:heading --><!-- wp:paragraph --><p>Potted in better soil</p><!-- /wp:paragraph --></div><!-- /wp:group --><!-- wp:group {\"className\":\"gs-feature\",\"layout\":{\"type\":\"default\"}} --><div class=\"wp-block-group gs-feature\"><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Plant doctor</h3><!-- /wp:heading --><!-- wp:paragraph --><p>Free advice by e-mail</p><!-- /wp:paragraph --></div><!-- /wp:group --></div><!-- /wp:group --></div><!-- /wp:group --><!-- wp:group {\"className\":\"gs-section\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group gs-section\"><!-- wp:group {\"className\":\"gs-row\",\"layout\":{\"type\":\"default\"}} --><div class=\"wp-block-group gs-row\"><!-- wp:group {\"layout\":{\"type\":\"default\"}} --><div class=\"wp-block-group\"><!-- wp:paragraph {\"className\":\"gs-eyebrow\"} --><p class=\"gs-eyebrow\">Shop by category</p><!-- /wp:paragraph --><!-- wp:heading --><h2 class=\"wp-block-heading\">Something green for every corner</h2><!-- /wp:heading --></div><!-- /wp:group --><!-- wp:buttons --><div class=\"wp-block-buttons\"><!-- wp:button --><div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"/shop/\">Browse the shop</a></div><!-- /wp:button --></div><!-- /wp:buttons --></div><!-- /wp:group --><!-- wp:shortcode -->[product_categories number=\"4\" columns=\"4\" hide_empty=\"1\"]<!-- /wp:shortcode --></div><!-- /wp:group --><!-- wp:group {\"className\":\"gs-section\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group gs-section\"><!-- wp:group {\"layout\":{\"type\":\"default\"}} --><div class=\"wp-block-group\"><!-- wp:paragraph {\"className\":\"gs-eyebrow\"} --><p class=\"gs-eyebrow\">Staff favourites</p><!-- /wp:paragraph --><!-- wp:heading --><h2 class=\"wp-block-heading\">Plants we can't stop recommending</h2><!-- /wp:heading --></div><!-- /wp:group --><!-- wp:shortcode -->[products limit=\"4\" columns=\"4\" visibility=\"featured\" orderby=\"menu_order\" order=\"ASC\"]<!-- /wp:shortcode --></div><!-- /wp:group --><!-- wp:group {\"className\":\"gs-section gs-bg-primary\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group gs-section gs-bg-primary\"><!-- wp:group {\"layout\":{\"type\":\"default\"}} --><div class=\"wp-block-group\"><!-- wp:columns --><div class=\"wp-block-columns\"><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:image {\"id\":{{media_id:about}},\"sizeSlug\":\"large\"} --><figure class=\"wp-block-image size-large\"><img src=\"{{media:about}}\" alt=\"The greenhouse with benches of young plants\" class=\"wp-image-{{media_id:about}}\"/></figure><!-- /wp:image --></div><!-- /wp:column --><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:paragraph {\"className\":\"gs-eyebrow\"} --><p class=\"gs-eyebrow\">Our greenhouse</p><!-- /wp:paragraph --><!-- wp:heading --><h2 class=\"wp-block-heading\">Grown slowly, sent with care</h2><!-- /wp:heading --><!-- wp:paragraph --><p>Every plant spends at least eight weeks on our benches before it ships, so it arrives acclimatised, rooted and ready. We pot in peat-free compost, wrap in paper and include a care card written for that exact plant.</p><!-- /wp:paragraph --><!-- wp:buttons --><div class=\"wp-block-buttons\"><!-- wp:button --><div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"{{page:about}}\">Our story</a></div><!-- /wp:button --></div><!-- /wp:buttons --></div><!-- /wp:column --></div><!-- /wp:columns --></div><!-- /wp:group --></div><!-- /wp:group --><!-- wp:group {\"className\":\"gs-section\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group gs-section\"><!-- wp:group {\"layout\":{\"type\":\"default\"}} --><div class=\"wp-block-group\"><!-- wp:paragraph {\"className\":\"gs-eyebrow\"} --><p class=\"gs-eyebrow\">Good to go</p><!-- /wp:paragraph --><!-- wp:heading --><h2 class=\"wp-block-heading\">Fresh from the greenhouse</h2><!-- /wp:heading --></div><!-- /wp:group --><!-- wp:shortcode -->[products limit=\"8\" columns=\"4\" orderby=\"date\" order=\"DESC\"]<!-- /wp:shortcode --><!-- wp:buttons --><div class=\"wp-block-buttons\"><!-- wp:button --><div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"/shop/\">See everything</a></div><!-- /wp:button --></div><!-- /wp:buttons --></div><!-- /wp:group --><!-- wp:group {\"className\":\"gs-section\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group gs-section\"><!-- wp:paragraph {\"className\":\"gs-eyebrow\"} --><p class=\"gs-eyebrow\">&ldquo;The calathea arrived looking better than in the photos, and the care card actually answered my questions.&rdquo;</p><!-- /wp:paragraph --><!-- wp:paragraph --><p>Imogen, verified buyer</p><!-- /wp:paragraph --></div><!-- /wp:group --><!-- wp:group {\"className\":\"gs-section gs-bg-sand\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group gs-section gs-bg-sand\"><!-- wp:group {\"className\":\"gs-row\",\"layout\":{\"type\":\"default\"}} --><div class=\"wp-block-group gs-row\"><!-- wp:group {\"layout\":{\"type\":\"default\"}} --><div class=\"wp-block-group\"><!-- wp:heading --><h2 class=\"wp-block-heading\">First plant? 10% off.</h2><!-- /wp:heading --><!-- wp:paragraph --><p>Use the code WELCOME10 at checkout. It works on everything, from tiny pothos to the big fig.</p><!-- /wp:paragraph --></div><!-- /wp:group --><!-- wp:buttons --><div class=\"wp-block-buttons\"><!-- wp:button --><div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"/shop/\">Get 10% off: WELCOME10</a></div><!-- /wp:button --></div><!-- /wp:buttons --></div><!-- /wp:group --></div><!-- /wp:group -->"
