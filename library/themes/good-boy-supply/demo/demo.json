   "title": "Home",
   "front_page": true,
   "content": "<!-- wp:cover {\"url\":\"{{media:hero}}\",\"dimRatio\":40,\"minHeight\":560,\"align\":\"full\",\"className\":\"gs-hero\",\"id\":{{media_id:hero}}} --><div class=\"wp-block-cover alignfull gs-hero\" style=\"min-height:560px\"><span aria-hidden=\"true\" class=\"wp-block-cover__background has-background-dim-40 has-background-dim\"></span><img class=\"wp-block-cover__image-background wp-image-{{media_id:hero}}\" alt=\"\" src=\"{{media:hero}}\" data-object-fit=\"cover\"/><div class=\"wp-block-cover__inner-container\"><!-- wp:group {\"layout\":{\"type\":\"default\"}} --><div class=\"wp-block-group\"><!-- wp:paragraph {\"className\":\"gs-eyebrow\"} --><p class=\"gs-eyebrow\">Spring collection</p><!-- /wp:paragraph --><!-- wp:heading {\"level\":1} --><h1 class=\"wp-block-heading\">Gear for very good pets.</h1><!-- /wp:heading --><!-- wp:paragraph --><p>Comfy beds, tough toys and honest treats. Everything tested by our office dogs, Biscuit and Juno, before it reaches you.</p><!-- /wp:paragraph --><!-- wp:group {\"className\":\"gs-row\",\"layout\":{\"type\":\"default\"}} --><div class=\"wp-block-group gs-row\"><!-- wp:buttons --><div class=\"wp-block-buttons\"><!-- wp:button --><div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"/shop/\">Shop the collection</a></div><!-- /wp:button --></div><!-- /wp:buttons --><!-- wp:buttons --><div class=\"wp-block-buttons\"><!-- wp:button --><div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"{{page:about}}\">Meet the testers</a></div><!-- /wp:button --></div><!-- /wp:buttons --></div><!-- /wp:group --></div><!-- /wp:group --></div></div><!-- /wp:cover --><!-- wp:group {\"className\":\"gs-section gs-bg-primary\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group gs-section gs-bg-primary\"><!-- wp:group {\"layout\":{\"type\":\"default\"}} --><div class=\"wp-block-group\"><!-- wp:group {\"className\":\"gs-feature\",\"layout\":{\"type\":\"default\"}} --><div class=\"wp-block-group gs-feature\"><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Free delivery</h3><!-- /wp:heading --><!-- wp:paragraph --><p>On orders over $60</p><!-- /wp:paragraph --></div><!-- /wp:group --><!-- wp:group {\"className\":\"gs-feature\",\"layout\":{\"type\":\"default\"}} --><div class=\"wp-block-group gs-feature\"><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Easy exchanges</h3><!-- /wp:heading --><!-- wp:paragraph --><p>Wrong size? Swap it free</p><!-- /wp:paragraph --></div><!-- /wp:group --><!-- wp:group {\"className\":\"gs-feature\",\"layout\":{\"type\":\"default\"}} --><div class=\"wp-block-group gs-feature\"><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Pet tested</h3><!-- /wp:heading --><!-- wp:paragraph --><p>Approved by real dogs and cats</p><!-- /wp:paragraph --></div><!-- /wp:group --><!-- wp:group {\"className\":\"gs-feature\",\"layout\":{\"type\":\"default\"}} --><div class=\"wp-block-group gs-feature\"><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">1% for shelters</h3><!-- /wp:heading --><!-- wp:paragraph --><p>Of every order, every month</p><!-- /wp:paragraph --></div><!-- /wp:group --></div><!-- /wp:group --></div><!-- /wp:group --><!-- wp:group {\"className\":\"gs-section\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group gs-section\"><!-- wp:group {\"className\":\"gs-row\",\"layout\":{\"type\":\"default\"}} --><div class=\"wp-block-group gs-row\"><!-- wp:group {\"layout\":{\"type\":\"default\"}} --><div class=\"wp-block-group\"><!-- wp:paragraph {\"className\":\"gs-eyebrow\"} --><p class=\"gs-eyebrow\">Shop by pet</p><!-- /wp:paragraph --><!-- wp:heading --><h2 class=\"wp-block-heading\">Everything for dogs, cats and their people</h2><!-- /wp:heading --></div><!-- /wp:group --><!-- wp:buttons --><div class=\"wp-block-buttons\"><!-- wp:button --><div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"/shop/\">Browse the shop</a></div><!-- /wp:button --></div><!-- /wp:buttons --></div><!-- /wp:group --><!-- wp:shortcode -->[product_categories number=\"4\" columns=\"4\" hide_empty=\"1\"]<!-- /wp:shortcode --></div><!-- /wp:group --><!-- wp:group {\"className\":\"gs-section\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group gs-section\"><!-- wp:group {\"layout\":{\"type\":\"default\"}} --><div class=\"wp-block-group\"><!-- wp:paragraph {\"className\":\"gs-eyebrow\"} --><p class=\"gs-eyebrow\">Bestsellers</p><!-- /wp:paragraph --><!-- wp:heading --><h2 class=\"wp-block-heading\">Tail-wag approved</h2><!-- /wp:heading --></div><!-- /wp:group --><!-- wp:shortcode -->[products limit=\"4\" columns=\"4\" visibility=\"featured\" orderby=\"menu_order\" order=\"ASC\"]<!-- /wp:shortcode --></div><!-- /wp:group --><!-- wp:group {\"className\":\"gs-section gs-bg-skyl\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group gs-section gs-bg-skyl\"><!-- wp:group {\"layout\":{\"type\":\"default\"}} --><div class=\"wp-block-group\"><!-- wp:columns --><div class=\"wp-block-columns\"><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:image {\"id\":{{media_id:about}},\"sizeSlug\":\"large\"} --><figure class=\"wp-block-image size-large\"><img src=\"{{media:about}}\" alt=\"The office dogs on their beds\" class=\"wp-image-{{media_id:about}}\"/></figure><!-- /wp:image --></div><!-- /wp:column --><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:paragraph {\"className\":\"gs-eyebrow\"} --><p class=\"gs-eyebrow\">Our testers</p><!-- /wp:paragraph --><!-- wp:heading --><h2 class=\"wp-block-heading\">Nothing ships until Biscuit says yes</h2><!-- /wp:heading --><!-- wp:paragraph --><p>Every bed is slept on, every toy is chewed and every treat is taste-tested by the dogs and cats of our team. If it doesn't survive a week in the office, it doesn't make the shop.</p><!-- /wp:paragraph --><!-- wp:buttons --><div class=\"wp-block-buttons\"><!-- wp:button --><div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"{{page:about}}\">Our story</a></div><!-- /wp:button --></div><!-- /wp:buttons --></div><!-- /wp:column --></div><!-- /wp:columns --></div><!-- /wp:group --></div><!-- /wp:group --><!-- wp:group {\"className\":\"gs-section\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group gs-section\"><!-- wp:group {\"layout\":{\"type\":\"default\"}} --><div class=\"wp-block-group\"><!-- wp:paragraph {\"className\":\"gs-eyebrow\"} --><p class=\"gs-eyebrow\">Good to go</p><!-- /wp:paragraph --><!-- wp:heading --><h2 class=\"wp-block-heading\">Just arrived</h2><!-- /wp:heading --></div><!-- /wp:group --><!-- wp:shortcode -->[products limit=\"8\" columns=\"4\" orderby=\"date\" order=\"DESC\"]<!-- /wp:shortcode --><!-- wp:buttons --><div class=\"wp-block-buttons\"><!-- wp:button --><div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"/shop/\">See everything</a></div><!-- /wp:button --></div><!-- /wp:buttons --></div><!-- /wp:group --><!-- wp:group {\"className\":\"gs-section\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group gs-section\"><!-- wp:paragraph {\"className\":\"gs-eyebrow\"} --><p class=\"gs-eyebrow\">&ldquo;Juno has destroyed every toy she's owned. The rope tug is on week six and still in one piece.&rdquo;</p><!-- /wp:paragraph --><!-- wp:paragraph --><p>Sam, verified buyer</p><!-- /wp:paragraph --></div><!-- /wp:group --><!-- wp:group {\"className\":\"gs-section gs-bg-accent\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group gs-section gs-bg-accent\"><!-- wp:group {\"className\":\"gs-row\",\"layout\":{\"type\":\"default\"}} --><div class=\"wp-block-group gs-row\"><!-- wp:group {\"layout\":{\"type\":\"default\"}} --><div class=\"wp-block-group\"><!-- wp:heading --><h2 class=\"wp-block-heading\">New here? Treat yourself.</h2><!-- /wp:heading --><!-- wp:paragraph --><p>Take 10% off your first order with the code WELCOME10. Your pet will never know.</p><!-- /wp:paragraph --></div><!-- /wp:group --><!-- wp:buttons --><div class=\"wp-block-buttons\"><!-- wp:button --><div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"/shop/\">Get 10% off: WELCOME10</a></div><!-- /wp:button --></div><!-- /wp:buttons --></div><!-- /wp:group --></div><!-- /wp:group -->"
  },
  {
   "slug": "about",
   "title": "Our testers",
   "content": "<!-- wp:group {\"className\":\"gs-section\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group gs-section\"><!-- wp:paragraph {\"className\":\"gs-eyebrow\"} --><p class=\"gs-eyebrow\">About Good Boy Supply</p><!-- /wp:paragraph --><!-- wp:heading {\"level\":1} --><h1 class=\"wp-block-heading\">A pet shop run by pet people (and their pets)</h1><!-- /wp:heading --><!-- wp:paragraph --><p>We are a small team of dog walkers, cat sitters and one former vet nurse who got tired of gear that didn't last.</p><!-- /wp:paragraph --></div><!-- /wp:group --><!-- wp:group {\"className\":\"gs-section\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group gs-section\"><!-- wp:group {\"layout\":{\"type\":\"default\"}} --><div class=\"wp-block-group\"><!-- wp:columns --><div class=\"wp-block-columns\"><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:image {\"id\":{{media_id:about}},\"sizeSlug\":\"large\"} --><figure class=\"wp-block-image size-large\"><img src=\"{{media:about}}\" alt=\"The office dogs on their beds\" class=\"wp-image-{{media_id:about}}\"/></figure><!-- /wp:image --></div><!-- /wp:column --><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:heading --><h2 class=\"wp-block-heading\">Tested in real life</h2><!-- /wp:heading --><!-- wp:paragraph --><p>Biscuit, a ten-year-old beagle, tests beds. Juno, a terrier with a jaw like a vice, tests toys. Pixel the cat tests whatever she likes. Products that fail don't make the shop.</p><!-- /wp:paragraph --><!-- wp:paragraph --><p>We choose durable materials, honest ingredients and makers who treat animals well, and we give 1% of every order to local shelters.</p><!-- /wp:paragraph --></div><!-- /wp:column --></div><!-- /wp:columns --></div><!-- /wp:group --></div><!-- /wp:group --><!-- wp:group {\"className\":\"gs-section gs-bg-sand\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group gs-section gs-bg-sand\"><!-- wp:group {\"layout\":{\"type\":\"default\"}} --><div class=\"wp-block-group\"><!-- wp:group {\"className\":\"gs-feature\",\"layout\":{\"type\":\"default\"}} --><div class=\"wp-block-group gs-feature\"><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Pet tested</h3><!-- /wp:heading --><!-- wp:paragraph --><p>Every product spends a week with our office pets.</p><!-- /wp:paragraph --></div><!-- /wp:group --><!-- wp:group {\"className\":\"gs-feature\",\"layout\":{\"type\":\"default\"}} --><div class=\"wp-block-group gs-feature\"><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Honest treats</h3><!-- /wp:heading --><!-- wp:paragraph --><p>Short ingredient lists you can actually read.</p><!-- /wp:paragraph --></div><!-- /wp:group --><!-- wp:group {\"className\":\"gs-feature\",\"layout\":{\"type\":\"default\"}} --><div class=\"wp-block-group gs-feature\"><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Giving back</h3><!-- /wp:heading --><!-- wp:paragraph --><p>1% of every order goes to local shelters.</p><!-- /wp:paragraph --></div><!-- /wp:group --></div><!-- /wp:group --></div><!-- /wp:group --><!-- wp:group {\"className\":\"gs-section\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group gs-section\"><!-- wp:heading --><h2 class=\"wp-block-heading\">Find something your pet will love</h2><!-- /wp:heading --><!-- wp:buttons --><div class=\"wp-block-buttons\"><!-- wp:button --><div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"/shop/\">Visit the shop</a></div><!-- /wp:button --></div><!-- /wp:buttons --></div><!-- /wp:group -->"
  },
  {
   "slug": "contact",
   "title": "Contact",
   "content": "<!-- wp:group {\"className\":\"gs-section\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group gs-section\"><!-- wp:group {\"layout\":{\"type\":\"default\"}} --><div class=\"wp-block-group\"><!-- wp:columns --><div class=\"wp-block-columns\"><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:paragraph {\"className\":\"gs-eyebrow\"} --><p class=\"gs-eyebrow\">Say hello</p><!-- /wp:paragraph --><!-- wp:heading {\"level\":1} --><h1 class=\"wp-block-heading\">Questions about sizes? We're here.</h1><!-- /wp:heading --><!-- wp:paragraph --><p>Send us your pet's measurements and we'll tell you which size fits. Photos of good boys and girls always welcome.</p><!-- /wp:paragraph --><!-- wp:list {\"className\":\"gs-plain-list\"} --><ul class=\"wp-block-list gs-plain-list\"><!-- wp:list-item --><li>8 Barkley Square, Old Town</li><!-- /wp:list-item --><!-- wp:list-item --><li>woof@goodboy.example</li><!-- /wp:list-item --><!-- wp:list-item --><li>+1 555 0177</li><!-- /wp:list-item --></ul><!-- /wp:list --></div><!-- /wp:column --><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Opening hours</h3><!-- /wp:heading --><!-- wp:paragraph --><p>Monday to Saturday, 9:00&ndash;19:00<br>Dogs welcome in the shop, always</p><!-- /wp:paragraph --><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Delivery</h3><!-- /wp:heading --><!-- wp:paragraph --><p>Orders before 2 pm ship the same day. Wrong size? Exchanges are free within 30 days.</p><!-- /wp:paragraph --></div><!-- /wp:column --></div><!-- /wp:columns --></div><!-- /wp:group --></div><!-- /wp:group -->"
  }
 ],
