{
  "slug": "wanderline",
  "name": "Wanderline",
  "version": "1.0.0",
  "description": "An adventurous travel blog theme: full-bleed landscape heroes under a header that floats over the image, destination tiles, postcard-style story cards with stamp labels, dashed route lines and contour-map accents in a sunset palette. Poster, journal or clean type, three story layouts and a Customizer-driven hero.",
  "author": "Pursae",
  "author_url": "https://github.com/pursae",
  "theme_url": "https://github.com/pursae/pursae-dev/tree/main/library/themes/wanderline",
  "tags": [
    "Travel",
    "Blog",
    "Grid Layout",
    "Right Sidebar",
    "Left Sidebar",
    "Custom Colors",
    "Custom Logo",
    "Custom Menu",
    "Featured Images",
    "Full Width Template",
    "Sticky Post",
    "Threaded Comments",
    "Wide Blocks",
    "Editor Style"
  ],
  "requires_core": "0.1.0",
  "screenshot": "assets/screenshot.png",
  "category": "travel",
  "style": "Adventurous travel journal with poster type and sunset colors",
  "demo": "demo/demo.json",
  "widget_areas": [
    {
      "id": "sidebar-1",
      "name": "Sidebar",
      "description": "Beside stories and archives (choose left, right or none in Customize › Layout)."
    },
    {
      "id": "footer-1",
      "name": "Footer",
      "description": "Columns in the dusk-colored footer."
    }
  ],
  "menu_locations": [
    {
      "id": "primary",
      "name": "Primary Menu"
    },
    {
      "id": "social",
      "name": "Social Links"
    }
  ],
  "styles": [
    {
      "handle": "wanderline-style",
      "src": "assets/style.css",
      "deps": [
        "wp-block-library"
      ],
      "media": "all"
    }
  ],
  "scripts": [
    {
      "handle": "wanderline-navigation",
      "src": "assets/js/navigation.js",
      "deps": [],
      "in_footer": true
    }
  ],
  "editor_styles": [
    "assets/editor-style.css"
  ],
  "preload_fonts": [
    "assets/fonts/karla.woff2"
  ],
  "palette": [
    {
      "name": "Sunset",
      "slug": "sunset",
      "color": "#e4572e"
    },
    {
      "name": "Amber",
      "slug": "amber",
      "color": "#f3a712"
    },
    {
      "name": "Dusk",
      "slug": "dusk",
      "color": "#1f2041"
    },
    {
      "name": "Lagoon",
      "slug": "lagoon",
      "color": "#2a7f8f"
    },
    {
      "name": "Sand",
      "slug": "sand",
      "color": "#f6e7d3"
    },
    {
      "name": "Paper",
      "slug": "paper",
      "color": "#fffaf3"
    }
  ],
  "supports": {
    "post-thumbnails": true,
    "custom-logo": {
      "width": 240,
      "height": 80,
      "flex-width": true,
      "flex-height": true,
      "header-text": [
        "site-title",
        "site-description"
      ]
    },
    "title-tag": true,
    "html5": [
      "search-form",
      "comment-form",
      "comment-list",
      "gallery",
      "caption",
      "script",
      "style"
    ],
    "responsive-embeds": true,
    "align-wide": true,
    "wp-block-styles": true
  },
  "customizer": {
    "sections": [
      {
        "id": "wl_colors",
        "title": "Wanderline Colors",
        "priority": 30,
        "description": "The sunset accent, the dusk of the header and footer, and the paper background.",
        "settings": [
          {
            "id": "accent",
            "label": "Sunset accent",
            "description": "Buttons, stamps, route lines and links.",
            "type": "color",
            "default": "#e4572e",
            "transport": "postMessage",
            "css_var": "--wl-sunset"
          },
          {
            "id": "dusk",
            "label": "Dusk (header and footer)",
            "type": "color",
            "default": "#1f2041",
            "transport": "postMessage",
            "css_var": "--wl-dusk"
          },
          {
            "id": "paper",
            "label": "Page background",
            "type": "color",
            "default": "#fffaf3",
            "transport": "postMessage",
            "css_var": "--wl-paper"
          }
        ]
      },
      {
        "id": "wl_layout",
        "title": "Wanderline Layout",
        "priority": 31,
        "settings": [
          {
            "id": "post_layout",
            "label": "Story layout",
            "type": "select",
            "default": "tiles",
            "transport": "postMessage",
            "body_class": "wl-layout-{value}",
            "choices": [
              {
                "value": "tiles",
                "label": "Postcard tiles (first story large)"
              },
              {
                "value": "grid",
                "label": "Three-column grid"
              },
              {
                "value": "list",
                "label": "Wide list"
              }
            ]
          },
          {
            "id": "sidebar",
            "label": "Sidebar",
            "type": "select",
            "default": "right",
            "transport": "postMessage",
            "body_class": "sidebar-{value}",
            "choices": [
              {
                "value": "right",
                "label": "Right"
              },
              {
                "value": "left",
                "label": "Left"
              },
              {
                "value": "none",
                "label": "No sidebar"
              }
            ]
          },
          {
            "id": "header_style",
            "label": "Header style",
            "type": "select",
            "default": "overlay",
            "transport": "postMessage",
            "body_class": "wl-header-{value}",
            "choices": [
              {
                "value": "overlay",
                "label": "Over the hero image"
              },
              {
                "value": "solid",
                "label": "Solid dusk"
              },
              {
                "value": "light",
                "label": "Light"
              }
            ]
          },
          {
            "id": "font_pairing",
            "label": "Typography",
            "type": "select",
            "default": "poster",
            "transport": "postMessage",
            "body_class": "wl-fonts-{value}",
            "choices": [
              {
                "value": "poster",
                "label": "Poster (Anton + Karla)"
              },
              {
                "value": "journal",
                "label": "Journal (serif + Karla)"
              },
              {
                "value": "clean",
                "label": "Clean (Karla)"
              }
            ]
          },
          {
            "id": "sticky_header",
            "label": "Sticky header",
            "type": "checkbox",
            "default": true,
            "transport": "postMessage",
            "body_class": "sticky-header"
          },
          {
            "id": "show_thumbs",
            "label": "Show featured images",
            "type": "checkbox",
            "default": true,
            "transport": "postMessage",
            "body_class": "show-thumbs"
          },
          {
            "id": "show_author",
            "label": "Show the author",
            "type": "checkbox",
            "default": false,
            "transport": "postMessage",
            "body_class": "show-author"
          }
        ]
      },
      {
        "id": "wl_hero",
        "title": "Wanderline Hero & Footer",
        "priority": 32,
        "description": "The big image at the top of the front page.",
        "settings": [
          {
            "id": "hero_image",
            "label": "Hero image",
            "description": "A wide landscape works best (at least 1600 px).",
            "type": "image"
          },
          {
            "id": "hero_kicker",
            "label": "Small line above the title",
            "type": "text",
            "default": "Field notes from the long way round"
          },
          {
            "id": "hero_title",
            "label": "Hero title",
            "type": "text",
            "default": "Go further than the map"
          },
          {
            "id": "hero_text",
            "label": "Hero text",
            "type": "textarea",
            "default": "Slow journeys, high trails and the places in between, told one story at a time."
          },
          {
            "id": "hero_button",
            "label": "Button label",
            "description": "Leave empty to hide the button.",
            "type": "text",
            "default": "Start exploring"
          },
          {
            "id": "hero_link",
            "label": "Button link",
            "type": "text",
            "default": "#main"
          },
          {
            "id": "hero_coords",
            "label": "Map coordinates",
            "description": "Printed like a map label in the hero's corner.",
            "type": "text",
            "default": "46.55° N · 7.98° E"
          },
          {
            "id": "footer_text",
            "label": "Footer text",
            "description": "Replaces the copyright line.",
            "type": "text",
            "default": ""
          }
        ]
      }
    ]
  }
}
