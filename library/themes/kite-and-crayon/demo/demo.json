   "slug": "home",
   "title": "Home",
   "front_page": true,
   "content": "<!-- wp:cover {\"url\":\"{{media:hero}}\",\"dimRatio\":40,\"minHeight\":560,\"align\":\"full\",\"className\":\"gs-hero\",\"id\":{{media_id:hero}}} --><div class=\"wp-block-cover alignfull gs-hero\" style=\"min-height:560px\"><span aria-hidden=\"true\" class=\"wp-block-cover__background has-background-dim-40 has-background-dim\"></span><img class=\"wp-block-cover__image-background wp-image-{{media_id:hero}}\" alt=\"\" src=\"{{media:hero}}\" data-object-fit=\"cover\"/><div class=\"wp-block-cover__inner-container\"><!-- wp:group {\"layout\":{\"type\":\"default\"}} --><div class=\"wp-block-group\"><!-- wp:paragraph {\"className\":\"gs-eyebrow\"} --><p class=\"gs-eyebrow\">Play, make, imagine</p><!-- /wp:paragraph --><!-- wp:heading {\"level\":1} --><h1 class=\"wp-block-heading\">Toys that grow with them.</h1><!-- /wp:heading --><!-- wp:paragraph --><p>Wooden toys, clever games and real art supplies, chosen by teachers and parents to spark hours of open-ended play.</p><!-- /wp:paragraph --><!-- wp:group {\"className\":\"gs-row\",\"layout\":{\"type\":\"default\"}} --><div class=\"wp-block-group gs-row\"><!-- wp:buttons --><div class=\"wp-block-buttons\"><!-- wp:button --><div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"/shop/\">Shop toys</a></div><!-- /wp:button --></div><!-- /wp:buttons --><!-- wp:buttons --><div class=\"wp-block-buttons\"><!-- wp:button --><div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"{{page:about}}\">Our promise</a></div><!-- /wp:button --></div><!-- /wp:buttons --></div><!-- /wp:group --></div><!-- /wp:group --></div></div><!-- /wp:cover --><!-- wp:group {\"className\":\"gs-section gs-bg-minty\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group gs-section gs-bg-minty\"><!-- wp:group {\"layout\":{\"type\":\"default\"}} --><div class=\"wp-block-group\"><!-- wp:group {\"className\":\"gs-feature\",\"layout\":{\"type\":\"default\"}} --><div class=\"wp-block-group gs-feature\"><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Gift wrapping</h3><!-- /wp:heading --><!-- wp:paragraph --><p>Free on every order</p><!-- /wp:paragraph --></div><!-- /wp:group --><!-- wp:group {\"className\":\"gs-feature\",\"layout\":{\"type\":\"default\"}} --><div class=\"wp-block-group gs-feature\"><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Safety first</h3><!-- /wp:heading --><!-- wp:paragraph --><p>EN 71 tested toys</p><!-- /wp:paragraph --></div><!-- /wp:group --><!-- wp:group {\"className\":\"gs-feature\",\"layout\":{\"type\":\"default\"}} --><div class=\"wp-block-group gs-feature\"><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Sustainable wood</h3><!-- /wp:heading --><!-- wp:paragraph --><p>FSC-certified beech</p><!-- /wp:paragraph --></div><!-- /wp:group --><!-- wp:group {\"className\":\"gs-feature\",\"layout\":{\"type\":\"default\"}} --><div class=\"wp-block-group gs-feature\"><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Free delivery</h3><!-- /wp:heading --><!-- wp:paragraph --><p>On orders over €50</p><!-- /wp:paragraph --></div><!-- /wp:group --></div><!-- /wp:group --></div><!-- /wp:group --><!-- wp:group {\"className\":\"gs-section\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group gs-section\"><!-- wp:group {\"className\":\"gs-row\",\"layout\":{\"type\":\"default\"}} --><div class=\"wp-block-group gs-row\"><!-- wp:group {\"layout\":{\"type\":\"default\"}} --><div class=\"wp-block-group\"><!-- wp:paragraph {\"className\":\"gs-eyebrow\"} --><p class=\"gs-eyebrow\">Shop by kind of play</p><!-- /wp:paragraph --><!-- wp:heading --><h2 class=\"wp-block-heading\">Build, play, draw and dream</h2><!-- /wp:heading --></div><!-- /wp:group --><!-- wp:buttons --><div class=\"wp-block-buttons\"><!-- wp:button --><div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"/shop/\">Browse the shop</a></div><!-- /wp:button --></div><!-- /wp:buttons --></div><!-- /wp:group --><!-- wp:shortcode -->[product_categories number=\"4\" columns=\"4\" hide_empty=\"1\"]<!-- /wp:shortcode --></div><!-- /wp:group --><!-- wp:group {\"className\":\"gs-section\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group gs-section\"><!-- wp:group {\"layout\":{\"type\":\"default\"}} --><div class=\"wp-block-group\"><!-- wp:paragraph {\"className\":\"gs-eyebrow\"} --><p class=\"gs-eyebrow\">Favourites</p><!-- /wp:paragraph --><!-- wp:heading --><h2 class=\"wp-block-heading\">Played with every single day</h2><!-- /wp:heading --></div><!-- /wp:group --><!-- wp:shortcode -->[products limit=\"4\" columns=\"4\" visibility=\"featured\" orderby=\"menu_order\" order=\"ASC\"]<!-- /wp:shortcode --></div><!-- /wp:group --><!-- wp:group {\"className\":\"gs-section gs-bg-sun\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group gs-section gs-bg-sun\"><!-- wp:group {\"layout\":{\"type\":\"default\"}} --><div class=\"wp-block-group\"><!-- wp:columns --><div class=\"wp-block-columns\"><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:image {\"id\":{{media_id:about}},\"sizeSlug\":\"large\"} --><figure class=\"wp-block-image size-large\"><img src=\"{{media:about}}\" alt=\"Children playing with wooden blocks\" class=\"wp-image-{{media_id:about}}\"/></figure><!-- /wp:image --></div><!-- /wp:column --><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:paragraph {\"className\":\"gs-eyebrow\"} --><p class=\"gs-eyebrow\">Our promise</p><!-- /wp:paragraph --><!-- wp:heading --><h2 class=\"wp-block-heading\">Made to be handed down</h2><!-- /wp:heading --><!-- wp:paragraph --><p>We choose toys that last for years and work for many ages: solid beech, water-based paints, sturdy card. If a toy can't survive two siblings, we don't sell it.</p><!-- /wp:paragraph --><!-- wp:buttons --><div class=\"wp-block-buttons\"><!-- wp:button --><div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"{{page:about}}\">Our story</a></div><!-- /wp:button --></div><!-- /wp:buttons --></div><!-- /wp:column --></div><!-- /wp:columns --></div><!-- /wp:group --></div><!-- /wp:group --><!-- wp:group {\"className\":\"gs-section\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group gs-section\"><!-- wp:group {\"layout\":{\"type\":\"default\"}} --><div class=\"wp-block-group\"><!-- wp:paragraph {\"className\":\"gs-eyebrow\"} --><p class=\"gs-eyebrow\">Good to go</p><!-- /wp:paragraph --><!-- wp:heading --><h2 class=\"wp-block-heading\">New in the toy box</h2><!-- /wp:heading --></div><!-- /wp:group --><!-- wp:shortcode -->[products limit=\"8\" columns=\"4\" orderby=\"date\" order=\"DESC\"]<!-- /wp:shortcode --><!-- wp:buttons --><div class=\"wp-block-buttons\"><!-- wp:button --><div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"/shop/\">See everything</a></div><!-- /wp:button --></div><!-- /wp:buttons --></div><!-- /wp:group --><!-- wp:group {\"className\":\"gs-section\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group gs-section\"><!-- wp:paragraph {\"className\":\"gs-eyebrow\"} --><p class=\"gs-eyebrow\">&ldquo;The rainbow stacker has been a tunnel, a bridge, a cradle and a racetrack. Best toy we own.&rdquo;</p><!-- /wp:paragraph --><!-- wp:paragraph --><p>Anaïs, mum of two</p><!-- /wp:paragraph --></div><!-- /wp:group --><!-- wp:group {\"className\":\"gs-section gs-bg-secondary\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group gs-section gs-bg-secondary\"><!-- wp:group {\"className\":\"gs-row\",\"layout\":{\"type\":\"default\"}} --><div class=\"wp-block-group gs-row\"><!-- wp:group {\"layout\":{\"type\":\"default\"}} --><div class=\"wp-block-group\"><!-- wp:heading --><h2 class=\"wp-block-heading\">Welcome gift: 10% off</h2><!-- /wp:heading --><!-- wp:paragraph --><p>Use WELCOME10 on your first order. Wrapped with a handwritten card, as always.</p><!-- /wp:paragraph --></div><!-- /wp:group --><!-- wp:buttons --><div class=\"wp-block-buttons\"><!-- wp:button --><div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"/shop/\">Get 10% off: WELCOME10</a></div><!-- /wp:button --></div><!-- /wp:buttons --></div><!-- /wp:group --></div><!-- /wp:group -->"
  },
  {
   "slug": "about",
   "title": "Our promise",
   "content": "<!-- wp:group {\"className\":\"gs-section\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group gs-section\"><!-- wp:paragraph {\"className\":\"gs-eyebrow\"} --><p class=\"gs-eyebrow\">About Kite & Crayon</p><!-- /wp:paragraph --><!-- wp:heading {\"level\":1} --><h1 class=\"wp-block-heading\">A toy shop with a teacher's eye</h1><!-- /wp:heading --><!-- wp:paragraph --><p>We are two former primary school teachers who believe the best toys do less, so children do more.</p><!-- /wp:paragraph --></div><!-- /wp:group --><!-- wp:group {\"className\":\"gs-section\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group gs-section\"><!-- wp:group {\"layout\":{\"type\":\"default\"}} --><div class=\"wp-block-group\"><!-- wp:columns --><div class=\"wp-block-columns\"><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:image {\"id\":{{media_id:about}},\"sizeSlug\":\"large\"} --><figure class=\"wp-block-image size-large\"><img src=\"{{media:about}}\" alt=\"Children playing with wooden blocks\" class=\"wp-image-{{media_id:about}}\"/></figure><!-- /wp:image --></div><!-- /wp:column --><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:heading --><h2 class=\"wp-block-heading\">Open-ended by design</h2><!-- /wp:heading --><!-- wp:paragraph --><p>A block can be a phone, a car or a cake. We look for toys like that: simple, beautiful and endlessly reusable, made from wood, wool, card and water-based colours.</p><!-- /wp:paragraph --><!-- wp:paragraph --><p>Every toy is safety tested to EN 71, every order is gift-wrapped for free, and our packaging is recycled and recyclable.</p><!-- /wp:paragraph --></div><!-- /wp:column --></div><!-- /wp:columns --></div><!-- /wp:group --></div><!-- /wp:group --><!-- wp:group {\"className\":\"gs-section gs-bg-sand\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group gs-section gs-bg-sand\"><!-- wp:group {\"layout\":{\"type\":\"default\"}} --><div class=\"wp-block-group\"><!-- wp:group {\"className\":\"gs-feature\",\"layout\":{\"type\":\"default\"}} --><div class=\"wp-block-group gs-feature\"><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Open-ended</h3><!-- /wp:heading --><!-- wp:paragraph --><p>Toys that become whatever they imagine.</p><!-- /wp:paragraph --></div><!-- /wp:group --><!-- wp:group {\"className\":\"gs-feature\",\"layout\":{\"type\":\"default\"}} --><div class=\"wp-block-group gs-feature\"><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Natural materials</h3><!-- /wp:heading --><!-- wp:paragraph --><p>FSC beech, organic cotton, water-based paint.</p><!-- /wp:paragraph --></div><!-- /wp:group --><!-- wp:group {\"className\":\"gs-feature\",\"layout\":{\"type\":\"default\"}} --><div class=\"wp-block-group gs-feature\"><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Wrapped with love</h3><!-- /wp:heading --><!-- wp:paragraph --><p>Free gift wrapping and a handwritten card.</p><!-- /wp:paragraph --></div><!-- /wp:group --></div><!-- /wp:group --></div><!-- /wp:group --><!-- wp:group {\"className\":\"gs-section\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group gs-section\"><!-- wp:heading --><h2 class=\"wp-block-heading\">Find the next favourite toy</h2><!-- /wp:heading --><!-- wp:buttons --><div class=\"wp-block-buttons\"><!-- wp:button --><div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"/shop/\">Visit the shop</a></div><!-- /wp:button --></div><!-- /wp:buttons --></div><!-- /wp:group -->"
  },
  {
   "slug": "contact",
   "title": "Contact",
   "content": "<!-- wp:group {\"className\":\"gs-section\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group gs-section\"><!-- wp:group {\"layout\":{\"type\":\"default\"}} --><div class=\"wp-block-group\"><!-- wp:columns --><div class=\"wp-block-columns\"><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:paragraph {\"className\":\"gs-eyebrow\"} --><p class=\"gs-eyebrow\">Say hello</p><!-- /wp:paragraph --><!-- wp:heading {\"level\":1} --><h1 class=\"wp-block-heading\">Need a gift idea? Ask a teacher.</h1><!-- /wp:heading --><!-- wp:paragraph --><p>Tell us the age and what they love, and we'll suggest three toys within a day.</p><!-- /wp:paragraph --><!-- wp:list {\"className\":\"gs-plain-list\"} --><ul class=\"wp-block-list gs-plain-list\"><!-- wp:list-item --><li>Rue des Cerfs-Volants 12</li><!-- /wp:list-item --><!-- wp:list-item --><li>hello@kiteandcrayon.example</li><!-- /wp:list-item --><!-- wp:list-item --><li>+32 2 555 01 88</li><!-- /wp:list-item --></ul><!-- /wp:list --></div><!-- /wp:column --><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Opening hours</h3><!-- /wp:heading --><!-- wp:paragraph --><p>Tuesday to Saturday, 10:00&ndash;18:00<br>Story hour on Saturdays at 11:00</p><!-- /wp:paragraph --><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Delivery</h3><!-- /wp:heading --><!-- wp:paragraph --><p>Orders before noon ship the same day, gift-wrapped. Free delivery over €50.</p><!-- /wp:paragraph --></div><!-- /wp:column --></div><!-- /wp:columns --></div><!-- /wp:group --></div><!-- /wp:group -->"
  }
 ],
