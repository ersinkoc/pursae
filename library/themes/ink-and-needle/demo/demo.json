   "slug": "home",
   "title": "Home",
   "content": "<!-- wp:group {\"className\":\"in-section\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group in-section\"><!-- wp:group {\"className\":\"in-section-head\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group in-section-head\"><!-- wp:paragraph {\"className\":\"in-kicker\"} --><p class=\"in-kicker\">&#10022; What we do &#10022;</p><!-- /wp:paragraph --><!-- wp:heading --><h2 class=\"wp-block-heading\">Tattoo, piercing &amp; aftercare</h2><!-- /wp:heading --></div><!-- /wp:group --><!-- wp:columns {\"className\":\"in-services\"} --><div class=\"wp-block-columns in-services\"><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Custom tattoos</h3><!-- /wp:heading --><!-- wp:paragraph --><p>Designed with you, drawn by hand, built to age well. From palm-sized flash to full sleeves.</p><!-- /wp:paragraph --><!-- wp:paragraph --><p><a href=\"{{page:artists}}\">Meet the artists</a></p><!-- /wp:paragraph --></div><!-- /wp:column --><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Piercing</h3><!-- /wp:heading --><!-- wp:paragraph --><p>Ear, nose and facial piercings with implant-grade titanium and solid gold jewellery.</p><!-- /wp:paragraph --><!-- wp:paragraph --><p><a href=\"{{post:piercing-aftercare-basics}}\">Piercing aftercare</a></p><!-- /wp:paragraph --></div><!-- /wp:column --><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Flash</h3><!-- /wp:heading --><!-- wp:paragraph --><p>Ready-drawn designs on the wall, tattooed on walk-in days at a set price.</p><!-- /wp:paragraph --><!-- wp:paragraph --><p><a href=\"{{page:flash}}\">See the flash wall</a></p><!-- /wp:paragraph --></div><!-- /wp:column --></div><!-- /wp:columns --></div><!-- /wp:group --><!-- wp:group {\"align\":\"full\",\"className\":\"in-section in-bone-band\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group alignfull in-section in-bone-band\"><!-- wp:group {\"className\":\"in-section-head\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group in-section-head\"><!-- wp:paragraph {\"className\":\"in-kicker\"} --><p class=\"in-kicker\">&#10022; On the wall this month &#10022;</p><!-- /wp:paragraph --><!-- wp:heading --><h2 class=\"wp-block-heading\">Flash sheet</h2><!-- /wp:heading --></div><!-- /wp:group --><!-- wp:gallery {\"columns\":3,\"linkTo\":\"none\",\"className\":\"in-flash\"} --><figure class=\"wp-block-gallery has-nested-images columns-3 is-cropped in-flash\"><!-- wp:image {\"id\":{{media_id:flash-dagger-rose}},\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} --><figure class=\"wp-block-image size-large\"><img src=\"{{media:flash-dagger-rose}}\" alt=\"Flash design: a dagger through a red rose\" class=\"wp-image-{{media_id:flash-dagger-rose}}\"/><figcaption class=\"wp-element-caption\">€160</figcaption></figure><!-- /wp:image --><!-- wp:image {\"id\":{{media_id:flash-swallow}},\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} --><figure class=\"wp-block-image size-large\"><img src=\"{{media:flash-swallow}}\" alt=\"Flash design: a swallow in flight with a banner\" class=\"wp-image-{{media_id:flash-swallow}}\"/><figcaption class=\"wp-element-caption\">€140</figcaption></figure><!-- /wp:image --><!-- wp:image {\"id\":{{media_id:flash-anchor}},\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} --><figure class=\"wp-block-image size-large\"><img src=\"{{media:flash-anchor}}\" alt=\"Flash design: an anchor wrapped in rope\" class=\"wp-image-{{media_id:flash-anchor}}\"/><figcaption class=\"wp-element-caption\">€150</figcaption></figure><!-- /wp:image --><!-- wp:image {\"id\":{{media_id:flash-heart}},\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} --><figure class=\"wp-block-image size-large\"><img src=\"{{media:flash-heart}}\" alt=\"Flash design: a red heart with a blank banner\" class=\"wp-image-{{media_id:flash-heart}}\"/><figcaption class=\"wp-element-caption\">€120</figcaption></figure><!-- /wp:image --><!-- wp:image {\"id\":{{media_id:flash-moon}},\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} --><figure class=\"wp-block-image size-large\"><img src=\"{{media:flash-moon}}\" alt=\"Flash design: a crescent moon with a face and stars\" class=\"wp-image-{{media_id:flash-moon}}\"/><figcaption class=\"wp-element-caption\">€140</figcaption></figure><!-- /wp:image --><!-- wp:image {\"id\":{{media_id:flash-snake}},\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} --><figure class=\"wp-block-image size-large\"><img src=\"{{media:flash-snake}}\" alt=\"Flash design: a coiled green snake\" class=\"wp-image-{{media_id:flash-snake}}\"/><figcaption class=\"wp-element-caption\">€180</figcaption></figure><!-- /wp:image --></figure><!-- /wp:gallery --><!-- wp:buttons {\"layout\":{\"type\":\"flex\",\"justifyContent\":\"center\"}} --><div class=\"wp-block-buttons\"><!-- wp:button --><div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"{{page:flash}}\">See the whole wall</a></div><!-- /wp:button --></div><!-- /wp:buttons --></div><!-- /wp:group --><!-- wp:group {\"className\":\"in-section\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group in-section\"><!-- wp:group {\"className\":\"in-section-head\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group in-section-head\"><!-- wp:paragraph {\"className\":\"in-kicker\"} --><p class=\"in-kicker\">&#10022; The artists &#10022;</p><!-- /wp:paragraph --><!-- wp:heading --><h2 class=\"wp-block-heading\">Two chairs, two styles</h2><!-- /wp:heading --></div><!-- /wp:group --><!-- wp:columns {\"className\":\"in-artists\"} --><div class=\"wp-block-columns in-artists\"><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:group {\"className\":\"in-artist\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group in-artist\"><!-- wp:image {\"id\":{{media_id:artist-mara}},\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} --><figure class=\"wp-block-image size-large\"><img src=\"{{media:artist-mara}}\" alt=\"Portrait illustration of artist Mara Vell in black and red\" class=\"wp-image-{{media_id:artist-mara}}\"/></figure><!-- /wp:image --><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Mara Vell</h3><!-- /wp:heading --><!-- wp:paragraph {\"className\":\"in-specialty\"} --><p class=\"in-specialty\">Bold traditional</p><!-- /wp:paragraph --><!-- wp:paragraph --><p>Roses, daggers and anything with a ship in it.</p><!-- /wp:paragraph --></div><!-- /wp:group --></div><!-- /wp:column --><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:group {\"className\":\"in-artist\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group in-artist\"><!-- wp:image {\"id\":{{media_id:artist-jonah}},\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} --><figure class=\"wp-block-image size-large\"><img src=\"{{media:artist-jonah}}\" alt=\"Portrait illustration of artist Jonah Reyes in black and green\" class=\"wp-image-{{media_id:artist-jonah}}\"/></figure><!-- /wp:image --><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Jonah Reyes</h3><!-- /wp:heading --><!-- wp:paragraph {\"className\":\"in-specialty\"} --><p class=\"in-specialty\">Botanical fine line</p><!-- /wp:paragraph --><!-- wp:paragraph --><p>Ferns, wildflowers and quiet details.</p><!-- /wp:paragraph --></div><!-- /wp:group --></div><!-- /wp:column --></div><!-- /wp:columns --></div><!-- /wp:group --><!-- wp:group {\"className\":\"in-section\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group in-section\"><!-- wp:group {\"className\":\"in-section-head\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group in-section-head\"><!-- wp:paragraph {\"className\":\"in-kicker\"} --><p class=\"in-kicker\">&#10022; From the journal &#10022;</p><!-- /wp:paragraph --><!-- wp:heading --><h2 class=\"wp-block-heading\">News &amp; aftercare</h2><!-- /wp:heading --></div><!-- /wp:group --><!-- wp:latest-posts {\"postsToShow\":3,\"displayPostDate\":true,\"displayFeaturedImage\":true,\"featuredImageSizeSlug\":\"large\",\"displayPostContent\":true,\"excerptLength\":20,\"postLayout\":\"grid\",\"columns\":3} /--></div><!-- /wp:group --><!-- wp:group {\"className\":\"in-section in-booking-cta\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group in-section in-booking-cta\"><!-- wp:heading --><h2 class=\"wp-block-heading\">Book a session</h2><!-- /wp:heading --><!-- wp:paragraph --><p>Consultations are free. Tell us your idea, your placement and your budget, and we will match you with the right artist.</p><!-- /wp:paragraph --><!-- wp:buttons --><div class=\"wp-block-buttons\"><!-- wp:button --><div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"{{page:booking}}\">Book now</a></div><!-- /wp:button --><!-- wp:button {\"className\":\"is-style-outline\"} --><div class=\"wp-block-button is-style-outline\"><a class=\"wp-block-button__link wp-element-button\" href=\"{{post:tattoo-aftercare-the-first-two-weeks}}\">Aftercare guide</a></div><!-- /wp:button --></div><!-- /wp:buttons --></div><!-- /wp:group -->",
