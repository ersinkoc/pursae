{
  "slug": "little-sprouts",
  "name": "Little Sprouts",
  "version": "1.0.0",
  "description": "A cheerful theme for kindergartens, nurseries and daycare centres. A rainbow stripe, a sprout logo mark, colourful pill menus, bubbly buttons, blob-shaped pictures and wavy dividers; programmes by age as bright cards, a daily schedule timeline, parent news cards and a big yellow visit band. Four primary colours, roundness, waves, fonts and the enrol button are set in the Customizer.",
  "author": "Pursae",
  "author_url": "https://github.com/pursae",
  "theme_url": "https://github.com/pursae/pursae-dev/tree/main/library/themes/little-sprouts",
  "tags": [
    "Kids",
    "Education",
    "Blog",
    "Light",
    "Grid Layout",
    "Right Sidebar",
    "Custom Colors",
    "Custom Logo",
    "Custom Menu",
    "Editor Style",
    "Featured Images",
    "Footer Widgets",
    "Threaded Comments",
    "Wide Blocks"
  ],
  "requires_core": "0.1.0",
  "screenshot": "assets/screenshot.png",
  "category": "kids",
  "style": "Cheerful primary colours, rounded shapes and wavy edges",
  "demo": "demo/demo.json",
  "widget_areas": [
    {
      "id": "sidebar-1",
      "name": "Sidebar",
      "description": "Beside parent news, archives and search."
    },
    {
      "id": "footer-1",
      "name": "Footer",
      "description": "Opening hours and contact details in the footer."
    }
  ],
  "menu_locations": [
    {
      "id": "primary",
      "name": "Primary Menu"
    },
    {
      "id": "footer",
      "name": "Footer Menu"
    }
  ],
  "styles": [
    {
      "handle": "little-sprouts-style",
      "src": "assets/style.css",
      "deps": [
        "wp-block-library"
      ],
      "media": "all"
    }
  ],
  "scripts": [
    {
      "handle": "little-sprouts-navigation",
      "src": "assets/js/navigation.js",
      "deps": [],
      "in_footer": true
    }
  ],
  "editor_styles": [
    "assets/editor-style.css"
  ],
  "preload_fonts": [
    "assets/fonts/fredoka.woff2",
    "assets/fonts/atkinson-400.woff2"
  ],
  "palette": [
    {
      "name": "Poppy Red",
      "slug": "poppy-red",
      "color": "#e63946"
    },
    {
      "name": "Sunny Yellow",
      "slug": "sunny-yellow",
      "color": "#ffbe0b"
    },
    {
      "name": "Sky Blue",
      "slug": "sky-blue",
      "color": "#3a86ff"
    },
    {
      "name": "Leaf Green",
      "slug": "leaf-green",
      "color": "#2bb673"
    },
    {
      "name": "Cream",
      "slug": "cream",
      "color": "#fffaf0"
    },
    {
      "name": "Navy",
      "slug": "navy",
      "color": "#23305a"
    }
  ],
  "supports": {
    "post-thumbnails": true,
    "custom-logo": {
      "width": 220,
      "height": 80,
      "flex-width": true,
      "flex-height": true,
      "header-text": [
        "site-title",
        "site-description"
      ]
    },
    "title-tag": true,
    "html5": [
      "search-form",
      "comment-form",
      "comment-list",
      "gallery",
      "caption",
      "script",
      "style"
    ],
    "responsive-embeds": true,
    "align-wide": true,
    "wp-block-styles": true
  },
  "customizer": {
    "sections": [
      {
        "id": "ls_colors",
        "title": "Colours & Shapes",
        "priority": 40,
        "settings": [
          {
            "id": "red",
            "label": "Red",
            "type": "color",
            "default": "#e63946",
            "transport": "postMessage",
            "css_var": "--ls-red",
            "description": "Main buttons, the first menu colour and highlights."
          },
          {
            "id": "yellow",
            "label": "Yellow",
            "type": "color",
            "default": "#ffbe0b",
            "transport": "postMessage",
            "css_var": "--ls-yellow",
            "description": "The hero, the visit band and bullets."
          },
          {
            "id": "blue",
            "label": "Blue",
            "type": "color",
            "default": "#3a86ff",
            "transport": "postMessage",
            "css_var": "--ls-blue",
            "description": "Links, tags and the hero image shadow."
          },
          {
            "id": "green",
            "label": "Green",
            "type": "color",
            "default": "#2bb673",
            "transport": "postMessage",
            "css_var": "--ls-green",
            "description": "The enrol button, kickers and the sprout."
          },
          {
            "id": "background",
            "label": "Background",
            "type": "color",
            "default": "#fffaf0",
            "transport": "postMessage",
            "css_var": "--ls-bg"
          },
          {
            "id": "waves",
            "label": "Wavy edges",
            "type": "checkbox",
            "default": true,
            "transport": "postMessage",
            "body_class": "ls-waves",
            "description": "Wavy dividers under the hero, around coloured bands and above the footer."
          },
          {
            "id": "roundness",
            "label": "Roundness",
            "type": "select",
            "default": "bubbly",
            "transport": "postMessage",
            "body_class": "ls-round-{value}",
            "choices": [
              {
                "value": "bubbly",
                "label": "Bubbly"
              },
              {
                "value": "soft",
                "label": "Soft"
              },
              {
                "value": "crisp",
                "label": "Crisp"
              }
            ]
          },
          {
            "id": "font_pairing",
            "label": "Font pairing",
            "type": "select",
            "default": "fredoka",
            "transport": "postMessage",
            "body_class": "ls-fonts-{value}",
            "choices": [
              {
                "value": "fredoka",
                "label": "Fredoka & Atkinson Hyperlegible"
              },
              {
                "value": "atkinson",
                "label": "Atkinson Hyperlegible only"
              },
              {
                "value": "system",
                "label": "System rounded"
              }
            ]
          }
        ]
      },
      {
        "id": "ls_layout",
        "title": "News & Layout",
        "priority": 41,
        "settings": [
          {
            "id": "news_layout",
            "label": "News layout",
            "type": "select",
            "default": "cards",
            "transport": "postMessage",
            "body_class": "ls-news-{value}",
            "choices": [
              {
                "value": "cards",
                "label": "Colourful cards"
              },
              {
                "value": "list",
                "label": "List with pictures"
              }
            ]
          },
          {
            "id": "sidebar",
            "label": "Sidebar",
            "type": "select",
            "default": "right",
            "transport": "postMessage",
            "body_class": "ls-sidebar-{value}",
            "choices": [
              {
                "value": "right",
                "label": "Right"
              },
              {
                "value": "none",
                "label": "None"
              }
            ]
          },
          {
            "id": "show_author",
            "label": "Show author names",
            "type": "checkbox",
            "default": false,
            "transport": "postMessage",
            "body_class": "ls-show-author"
          },
          {
            "id": "sticky_header",
            "label": "Sticky header",
            "type": "checkbox",
            "default": false,
            "transport": "postMessage",
            "body_class": "ls-sticky"
          }
        ]
      },
      {
        "id": "ls_school",
        "title": "School Details",
        "priority": 42,
        "settings": [
          {
            "id": "notice_text",
            "label": "Notice bar",
            "type": "text",
            "default": "",
            "transport": "refresh",
            "description": "A short message above the header, like a closure day. Leave empty to hide."
          },
          {
            "id": "enroll_label",
            "label": "Enrol button label",
            "type": "text",
            "default": "Book a visit",
            "transport": "refresh"
          },
          {
            "id": "enroll_url",
            "label": "Enrol button link",
            "type": "text",
            "default": "/enrol/",
            "transport": "refresh"
          },
          {
            "id": "hero_image",
            "label": "Hero picture",
            "type": "image",
            "transport": "refresh",
            "description": "Falls back to the front page's featured image."
          },
          {
            "id": "hero_kicker",
            "label": "Hero kicker",
            "type": "text",
            "default": "Ages 1 to 5",
            "transport": "refresh"
          },
          {
            "id": "hero_heading",
            "label": "Hero heading",
            "type": "text",
            "default": "",
            "transport": "refresh",
            "description": "Defaults to the site title."
          },
          {
            "id": "cta_label",
            "label": "Second button label",
            "type": "text",
            "default": "Our programmes",
            "transport": "refresh"
          },
          {
            "id": "cta_url",
            "label": "Second button link",
            "type": "text",
            "default": "/programmes/",
            "transport": "refresh"
          },
          {
            "id": "footer_text",
            "label": "Footer text",
            "type": "text",
            "default": "",
            "transport": "refresh"
          }
        ]
      }
    ]
  }
}
