{
  "slug": "quiet-hours",
  "name": "Quiet Hours",
  "version": "1.0.0",
  "description": "An ultra-minimal, text-first blog: a single calm column, a monospaced voice, posts listed by year and a light/dark switch that remembers the reader's choice. No clutter, no chrome, just writing and whitespace.",
  "author": "Pursae",
  "author_url": "https://github.com/pursae",
  "theme_url": "https://github.com/pursae/pursae-dev/tree/main/library/themes/quiet-hours",
  "tags": ["Blog", "Minimal", "One Column", "Dark Mode", "Custom Colors", "Custom Menu", "Editor Style", "Footer Widgets", "Threaded Comments", "Accessibility Ready"],
  "requires_core": "0.1.0",
  "screenshot": "assets/screenshot.png",
  "category": "minimal",
  "style": "Monospaced, text-only, light and dark",
  "demo": "demo/demo.json",

  "widget_areas": [
    {"id": "footer-1", "name": "Footer", "description": "A quiet row of widgets above the footer line."}
  ],
  "menu_locations": [
    {"id": "primary", "name": "Primary Menu"},
    {"id": "footer", "name": "Footer Links"}
  ],

  "styles": [
    {"handle": "quiet-hours-style", "src": "assets/style.css", "deps": ["wp-block-library"], "media": "all"}
  ],
  "scripts": [
    {"handle": "quiet-hours-scheme", "src": "assets/js/scheme.js", "deps": [], "in_footer": false},
    {"handle": "quiet-hours-ui", "src": "assets/js/quiet.js", "deps": [], "in_footer": true}
  ],
  "editor_styles": ["assets/editor-style.css"],
  "preload_fonts": ["assets/fonts/ibm-plex-mono-400.woff2"],

  "palette": [
    {"name": "Accent", "slug": "accent", "color": "#b4532a"},
    {"name": "Ink", "slug": "ink", "color": "#1c1c1a"},
    {"name": "Graphite", "slug": "graphite", "color": "#5f5e59"},
    {"name": "Rule", "slug": "rule", "color": "#e4e2dc"},
    {"name": "Paper", "slug": "paper", "color": "#fbfaf7"},
    {"name": "Night", "slug": "night", "color": "#141413"}
  ],
  "supports": {
    "post-thumbnails": true,
    "custom-logo": {"width": 120, "height": 40, "flex-width": true, "flex-height": true, "header-text": ["site-title", "site-description"]},
    "title-tag": true,
    "html5": ["search-form", "comment-form", "comment-list", "gallery", "caption", "script", "style"],
    "responsive-embeds": true,
    "align-wide": false,
    "wp-block-styles": true
  },

  "customizer": {
    "sections": [
      {
        "id": "qh_colors", "title": "Quiet Hours: Colors", "description": "Paper, ink and the one accent.", "priority": 40,
        "settings": [
          {"id": "accent", "label": "Accent color", "description": "Links on hover, the year markers and focus rings.", "type": "color", "default": "#b4532a", "transport": "postMessage", "css_var": "--qh-accent"},
          {"id": "paper_color", "label": "Paper (light background)", "type": "color", "default": "#fbfaf7", "transport": "postMessage", "css_var": "--qh-paper-light"},
          {"id": "night_color", "label": "Night (dark background)", "type": "color", "default": "#141413", "transport": "postMessage", "css_var": "--qh-paper-dark"},
          {"id": "color_scheme", "label": "Default color scheme", "description": "What visitors see before they use the light/dark switch.", "type": "select", "default": "auto", "transport": "postMessage", "body_class": "qh-scheme-{value}",
            "choices": [{"value": "auto", "label": "Follow the visitor's system"}, {"value": "light", "label": "Light"}, {"value": "dark", "label": "Dark"}]},
          {"id": "show_toggle", "label": "Show the light/dark switch", "type": "checkbox", "default": true, "transport": "postMessage", "body_class": "qh-has-toggle"}
        ]
      },
      {
        "id": "qh_type", "title": "Quiet Hours: Type & Layout", "priority": 41,
        "settings": [
          {"id": "font_pairing", "label": "Font pairing", "type": "select", "default": "mono", "transport": "postMessage", "body_class": "qh-font-{value}",
            "choices": [{"value": "mono", "label": "Monospace throughout"}, {"value": "sans", "label": "Mono details, sans-serif text"}, {"value": "serif", "label": "Mono details, serif text"}]},
          {"id": "content_width", "label": "Column width", "type": "select", "default": "normal", "transport": "postMessage", "body_class": "qh-width-{value}",
            "choices": [{"value": "narrow", "label": "Narrow (34rem)"}, {"value": "normal", "label": "Normal (40rem)"}, {"value": "wide", "label": "Wide (48rem)"}]},
          {"id": "font_size", "label": "Base font size (px)", "type": "number", "default": 16, "min": 14, "max": 20, "transport": "postMessage", "css_var": "--qh-size"}
        ]
      },
      {
        "id": "qh_content", "title": "Quiet Hours: Content", "priority": 42,
        "settings": [
          {"id": "index_style", "label": "Post list", "type": "select", "default": "years", "transport": "postMessage", "body_class": "qh-index-{value}",
            "choices": [{"value": "years", "label": "Titles grouped by year"}, {"value": "excerpts", "label": "Titles with excerpts"}]},
          {"id": "show_dates", "label": "Show dates in post lists", "type": "checkbox", "default": true, "transport": "postMessage", "body_class": "qh-show-dates"},
          {"id": "show_featured", "label": "Show featured images on single posts", "type": "checkbox", "default": false, "transport": "postMessage", "body_class": "qh-show-images"},
          {"id": "intro_text", "label": "Home page introduction", "description": "A short paragraph above the post list on the blog home.", "type": "textarea", "default": "", "transport": "refresh"},
          {"id": "footer_text", "label": "Footer text", "description": "Replaces the copyright line.", "type": "text", "default": "", "transport": "refresh"}
        ]
      }
    ]
  }
}
