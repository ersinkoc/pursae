   "front_page": true,
   "template": "page-no-title",
   "content": "<!-- wp:cover {\"url\":\"{{media:meadow}}\",\"id\":{{media_id:meadow}},\"dimRatio\":45,\"minHeight\":680,\"minHeightUnit\":\"px\",\"align\":\"full\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-cover alignfull\" style=\"min-height:680px\"><img class=\"wp-block-cover__image-background wp-image-{{media_id:meadow}}\" alt=\"\" src=\"{{media:meadow}}\" data-object-fit=\"cover\"/><span aria-hidden=\"true\" class=\"wp-block-cover__background has-background-dim-45 has-background-dim\"></span><div class=\"wp-block-cover__inner-container\"><!-- wp:heading {\"level\":1,\"fontSize\":\"xx-large\"} -->\n<h1 class=\"wp-block-heading has-xx-large-font-size\">Patient pictures of quiet places</h1>\n<!-- /wp:heading --><!-- wp:paragraph {\"fontSize\":\"large\"} -->\n<p class=\"has-large-font-size\">Landscape photography by Mara Ellison: meadows, ridges, marshes and the long minutes of waiting for the light.</p>\n<!-- /wp:paragraph --><!-- wp:buttons -->\n<div class=\"wp-block-buttons\"><!-- wp:button -->\n<div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"{{page:portfolio}}\">View the portfolio</a></div>\n<!-- /wp:button --><!-- wp:button {\"className\":\"is-style-outline\"} -->\n<div class=\"wp-block-button is-style-outline\"><a class=\"wp-block-button__link wp-element-button\" href=\"{{page:prints}}\">Prints &amp; commissions</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons --></div></div>\n<!-- /wp:cover -->\n\n<!-- wp:group {\"align\":\"wide\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|60\",\"bottom\":\"var:preset|spacing|60\"}}},\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group alignwide\" style=\"padding-top:var(--wp--preset--spacing--60);padding-bottom:var(--wp--preset--spacing--60)\"><!-- wp:gallery {\"columns\":3,\"linkTo\":\"none\",\"align\":\"wide\"} -->\n<figure class=\"wp-block-gallery alignwide has-nested-images columns-3 is-cropped\"><!-- wp:image {\"id\":{{media_id:ridge}},\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} -->\n<figure class=\"wp-block-image size-large\"><img src=\"{{media:ridge}}\" alt=\"A tree on a ridge\" class=\"wp-image-{{media_id:ridge}}\"/></figure>\n<!-- /wp:image --><!-- wp:image {\"id\":{{media_id:cliff}},\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} -->\n<figure class=\"wp-block-image size-large\"><img src=\"{{media:cliff}}\" alt=\"Cliff dwellings\" class=\"wp-image-{{media_id:cliff}}\"/></figure>\n<!-- /wp:image --><!-- wp:image {\"id\":{{media_id:buttercups}},\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} -->\n<figure class=\"wp-block-image size-large\"><img src=\"{{media:buttercups}}\" alt=\"Buttercups\" class=\"wp-image-{{media_id:buttercups}}\"/></figure>\n<!-- /wp:image --><!-- wp:image {\"id\":{{media_id:creek}},\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} -->\n<figure class=\"wp-block-image size-large\"><img src=\"{{media:creek}}\" alt=\"A creek\" class=\"wp-image-{{media_id:creek}}\"/></figure>\n<!-- /wp:image --><!-- wp:image {\"id\":{{media_id:birds}},\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} -->\n<figure class=\"wp-block-image size-large\"><img src=\"{{media:birds}}\" alt=\"Marsh birds\" class=\"wp-image-{{media_id:birds}}\"/></figure>\n<!-- /wp:image --><!-- wp:image {\"id\":{{media_id:coral}},\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} -->\n<figure class=\"wp-block-image size-large\"><img src=\"{{media:coral}}\" alt=\"Coral\" class=\"wp-image-{{media_id:coral}}\"/></figure>\n<!-- /wp:image --></figure>\n<!-- /wp:gallery --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|60\",\"bottom\":\"var:preset|spacing|60\"}}},\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group\" style=\"padding-top:var(--wp--preset--spacing--60);padding-bottom:var(--wp--preset--spacing--60)\"><!-- wp:columns {\"align\":\"wide\"} -->\n<div class=\"wp-block-columns alignwide\"><!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">About the work</h2>\n<!-- /wp:heading --><!-- wp:paragraph -->\n<p>I photograph a small number of places many times, in every season and every kind of weather. The pictures here are the ones where the place and the light finally agreed.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:column --><!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Prints</h2>\n<!-- /wp:heading --><!-- wp:paragraph -->\n<p>Every photograph is available as a signed archival print in three sizes, printed on cotton rag paper and shipped flat.</p>\n<!-- /wp:paragraph --><!-- wp:buttons -->\n<div class=\"wp-block-buttons\"><!-- wp:button {\"className\":\"is-style-outline\"} -->\n<div class=\"wp-block-button is-style-outline\"><a class=\"wp-block-button__link wp-element-button\" href=\"{{page:prints}}\">Order a print</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|60\",\"bottom\":\"var:preset|spacing|60\"}}},\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group\" style=\"padding-top:var(--wp--preset--spacing--60);padding-bottom:var(--wp--preset--spacing--60)\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">From the journal</h2>\n<!-- /wp:heading --><!-- wp:latest-posts {\"postsToShow\":3,\"displayPostDate\":true,\"align\":\"wide\"} /--></div>\n<!-- /wp:group -->"
  },
  {
   "slug": "portfolio",
   "title": "Portfolio",
   "template": "page-no-title",
   "content": "<!-- wp:group {\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|60\",\"bottom\":\"var:preset|spacing|60\"}}},\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group\" style=\"padding-top:var(--wp--preset--spacing--60);padding-bottom:var(--wp--preset--spacing--60)\"><!-- wp:heading {\"level\":1} -->\n<h1 class=\"wp-block-heading\">Portfolio</h1>\n<!-- /wp:heading --><!-- wp:paragraph {\"fontSize\":\"large\"} -->\n<p class=\"has-large-font-size\">Selected photographs, 2022 to 2026. Click through the journal for the stories behind them.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:gallery {\"columns\":3,\"linkTo\":\"none\",\"align\":\"wide\"} -->\n<figure class=\"wp-block-gallery alignwide has-nested-images columns-3 is-cropped\"><!-- wp:image {\"id\":{{media_id:meadow-wide}},\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} -->\n<figure class=\"wp-block-image size-large\"><img src=\"{{media:meadow-wide}}\" alt=\"Flowers close to the ground\" class=\"wp-image-{{media_id:meadow-wide}}\"/></figure>\n<!-- /wp:image --><!-- wp:image {\"id\":{{media_id:ridge}},\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} -->\n<figure class=\"wp-block-image size-large\"><img src=\"{{media:ridge}}\" alt=\"A tree on a ridge\" class=\"wp-image-{{media_id:ridge}}\"/></figure>\n<!-- /wp:image --><!-- wp:image {\"id\":{{media_id:ruins}},\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} -->\n<figure class=\"wp-block-image size-large\"><img src=\"{{media:ruins}}\" alt=\"Stone towers\" class=\"wp-image-{{media_id:ruins}}\"/></figure>\n<!-- /wp:image --><!-- wp:image {\"id\":{{media_id:cliff}},\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} -->\n<figure class=\"wp-block-image size-large\"><img src=\"{{media:cliff}}\" alt=\"Cliff dwellings\" class=\"wp-image-{{media_id:cliff}}\"/></figure>\n<!-- /wp:image --><!-- wp:image {\"id\":{{media_id:buttercups}},\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} -->\n<figure class=\"wp-block-image size-large\"><img src=\"{{media:buttercups}}\" alt=\"Buttercups\" class=\"wp-image-{{media_id:buttercups}}\"/></figure>\n<!-- /wp:image --><!-- wp:image {\"id\":{{media_id:meadow}},\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} -->\n<figure class=\"wp-block-image size-large\"><img src=\"{{media:meadow}}\" alt=\"A wide meadow\" class=\"wp-image-{{media_id:meadow}}\"/></figure>\n<!-- /wp:image --><!-- wp:image {\"id\":{{media_id:creek}},\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} -->\n<figure class=\"wp-block-image size-large\"><img src=\"{{media:creek}}\" alt=\"A creek\" class=\"wp-image-{{media_id:creek}}\"/></figure>\n<!-- /wp:image --><!-- wp:image {\"id\":{{media_id:birds}},\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} -->\n<figure class=\"wp-block-image size-large\"><img src=\"{{media:birds}}\" alt=\"Marsh birds\" class=\"wp-image-{{media_id:birds}}\"/></figure>\n<!-- /wp:image --><!-- wp:image {\"id\":{{media_id:coral}},\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} -->\n<figure class=\"wp-block-image size-large\"><img src=\"{{media:coral}}\" alt=\"Coral\" class=\"wp-image-{{media_id:coral}}\"/></figure>\n<!-- /wp:image --></figure>\n<!-- /wp:gallery -->\n\n<!-- wp:spacer {\"height\":\"var:preset|spacing|60\"} -->\n<div style=\"height:var(--wp--preset--spacing--60)\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n<!-- /wp:spacer -->"
  },
  {
   "slug": "journal",
