{
  "slug": "bright-smile",
  "name": "Bright Smile Dental",
  "version": "1.0.0",
  "description": "A cheerful, rounded theme for dental clinics: fresh aqua and white with a coral accent, soft bubbly shapes, a wavy hero with booking buttons, treatments, the team, before-and-after results, reviews and oral-care articles.",
  "author": "WordPress Go",
  "author_url": "https://github.com/boracomet/wordpress-go",
  "theme_url": "https://github.com/boracomet/wordpress-go/tree/main/web/theme-library/bright-smile",
  "tags": [
    "Health",
    "Dental",
    "Clinic",
    "Blog",
    "Two Columns",
    "Right Sidebar",
    "Left Sidebar",
    "Grid Layout",
    "Custom Colors",
    "Custom Logo",
    "Custom Menu",
    "Editor Style",
    "Featured Images",
    "Footer Widgets",
    "Sticky Header",
    "Threaded Comments",
    "Wide Blocks"
  ],
  "requires_core": "0.1.0",
  "screenshot": "assets/screenshot.png",
  "category": "health",
  "style": "Fresh aqua and white, rounded and playful",
  "demo": "demo/demo.json",
  "widget_areas": [
    {
      "id": "sidebar-1",
      "name": "Sidebar",
      "description": "Beside posts, archives and search results (Customize sets the side or hides it)."
    },
    {
      "id": "footer-1",
      "name": "Footer",
      "description": "Columns in the footer, next to the site name and description."
    }
  ],
  "menu_locations": [
    {
      "id": "primary",
      "name": "Primary Menu"
    },
    {
      "id": "footer",
      "name": "Footer Menu"
    }
  ],
  "styles": [
    {
      "handle": "bright-smile-style",
      "src": "assets/style.css",
      "deps": [
        "wp-block-library"
      ],
      "media": "all"
    }
  ],
  "scripts": [
    {
      "handle": "bright-smile-navigation",
      "src": "assets/js/navigation.js",
      "deps": [],
      "in_footer": true
    }
  ],
  "editor_styles": [
    "assets/editor-style.css"
  ],
  "preload_fonts": [
    "assets/fonts/fredoka.woff2",
    "assets/fonts/mulish.woff2"
  ],
  "palette": [
    {
      "name": "Aqua",
      "slug": "aqua",
      "color": "#14a9b8"
    },
    {
      "name": "Lagoon",
      "slug": "lagoon",
      "color": "#0e3b4a"
    },
    {
      "name": "Coral",
      "slug": "coral",
      "color": "#ff7a6b"
    },
    {
      "name": "Foam",
      "slug": "foam",
      "color": "#e9f8f9"
    },
    {
      "name": "Sunny",
      "slug": "sunny",
      "color": "#ffd166"
    },
    {
      "name": "White",
      "slug": "white",
      "color": "#ffffff"
    }
  ],
  "supports": {
    "post-thumbnails": true,
    "custom-logo": {
      "width": 240,
      "height": 64,
      "flex-width": true,
      "flex-height": true,
      "header-text": [
        "site-title",
        "site-description"
      ]
    },
    "title-tag": true,
    "html5": [
      "search-form",
      "comment-form",
      "comment-list",
      "gallery",
      "caption",
      "script",
      "style"
    ],
    "responsive-embeds": true,
    "align-wide": true,
    "wp-block-styles": true
  },
  "customizer": {
    "sections": [
      {
        "id": "brightsmile_colors",
        "title": "Colors & Shapes",
        "priority": 40,
        "settings": [
          {
            "id": "primary_color",
            "label": "Primary (aqua)",
            "type": "color",
            "default": "#14a9b8",
            "transport": "postMessage",
            "css_var": "--bs-primary",
            "description": "Hero, links, icons and the booking band."
          },
          {
            "id": "accent_color",
            "label": "Accent (coral)",
            "type": "color",
            "default": "#ff7a6b",
            "transport": "postMessage",
            "css_var": "--bs-accent",
            "description": "Booking buttons and badges."
          },
          {
            "id": "ink_color",
            "label": "Text and headings",
            "type": "color",
            "default": "#0e3b4a",
            "transport": "postMessage",
            "css_var": "--bs-ink"
          },
          {
            "id": "background_color",
            "label": "Soft background",
            "type": "color",
            "default": "#e9f8f9",
            "transport": "postMessage",
            "css_var": "--bs-foam",
            "description": "Background of tinted sections and cards."
          },
          {
            "id": "corner_style",
            "label": "Corner roundness",
            "type": "select",
            "default": "round",
            "transport": "postMessage",
            "body_class": "bs-radius-{value}",
            "choices": [
              {
                "value": "soft",
                "label": "Soft"
              },
              {
                "value": "round",
                "label": "Round"
              },
              {
                "value": "pill",
                "label": "Extra round"
              }
            ]
          },
          {
            "id": "bubbles",
            "label": "Floating bubbles in the hero and booking band",
            "type": "checkbox",
            "default": true,
            "transport": "postMessage",
            "body_class": "bs-bubbles"
          },
          {
            "id": "font_pairing",
            "label": "Typefaces",
            "type": "select",
            "default": "fredoka",
            "transport": "postMessage",
            "body_class": "bs-font-{value}",
            "choices": [
              {
                "value": "fredoka",
                "label": "Fredoka headings, Mulish text"
              },
              {
                "value": "mulish",
                "label": "Mulish throughout"
              },
              {
                "value": "system",
                "label": "System fonts"
              }
            ]
          }
        ]
      },
      {
        "id": "brightsmile_header",
        "title": "Header & Booking",
        "priority": 41,
        "settings": [
          {
            "id": "header_style",
            "label": "Header style",
            "type": "select",
            "default": "floating",
            "transport": "postMessage",
            "body_class": "bs-header-{value}",
            "choices": [
              {
                "value": "floating",
                "label": "Floating pill"
              },
              {
                "value": "full",
                "label": "Full-width white"
              },
              {
                "value": "aqua",
                "label": "Aqua bar"
              }
            ]
          },
          {
            "id": "sticky_header",
            "label": "Keep the header visible while scrolling",
            "type": "checkbox",
            "default": true,
            "transport": "postMessage",
            "body_class": "bs-sticky"
          },
          {
            "id": "show_topbar",
            "label": "Show opening hours and phone above the header",
            "type": "checkbox",
            "default": true,
            "transport": "refresh"
          },
          {
            "id": "hours",
            "label": "Opening hours",
            "type": "text",
            "default": "Mon–Fri 8:00–19:00 · Sat 9:00–14:00",
            "transport": "refresh"
          },
          {
            "id": "phone",
            "label": "Phone number",
            "type": "text",
            "default": "+1 (555) 017-3300",
            "transport": "refresh"
          },
          {
            "id": "cta_label",
            "label": "Booking button label",
            "type": "text",
            "default": "Book a visit",
            "transport": "refresh",
            "description": "Leave empty to hide the button."
          },
          {
            "id": "cta_url",
            "label": "Booking button link",
            "type": "text",
            "default": "/book/",
            "transport": "refresh"
          },
          {
            "id": "booking_heading",
            "label": "Booking band heading",
            "type": "text",
            "default": "Ready for a brighter smile? New patients are always welcome.",
            "transport": "refresh",
            "description": "The band above the footer; leave empty to hide it."
          }
        ]
      },
      {
        "id": "brightsmile_hero",
        "title": "Front Page Hero",
        "priority": 42,
        "settings": [
          {
            "id": "hero_image",
            "label": "Hero image",
            "description": "Without an image the front page's featured image is used.",
            "type": "image"
          },
          {
            "id": "hero_kicker",
            "label": "Small line above the heading",
            "type": "text",
            "default": "Family & cosmetic dentistry",
            "transport": "refresh"
          },
          {
            "id": "hero_heading",
            "label": "Heading",
            "type": "text",
            "default": "",
            "transport": "refresh",
            "description": "Empty uses the page title."
          },
          {
            "id": "hero_text",
            "label": "Text",
            "type": "textarea",
            "default": "",
            "transport": "refresh"
          },
          {
            "id": "hero_button_label",
            "label": "Second button label",
            "type": "text",
            "default": "Our treatments",
            "transport": "refresh"
          },
          {
            "id": "hero_button_url",
            "label": "Second button link",
            "type": "text",
            "default": "#treatments",
            "transport": "refresh"
          },
          {
            "id": "hero_badges",
            "label": "Badges under the buttons",
            "type": "text",
            "default": "Gentle with kids,Evening hours,Same-day emergencies",
            "transport": "refresh",
            "description": "Separate badges with commas."
          }
        ],
        "description": "The wavy hero on a static front page."
      },
      {
        "id": "brightsmile_blog",
        "title": "Articles & Footer",
        "priority": 43,
        "settings": [
          {
            "id": "blog_layout",
            "label": "Post list layout",
            "type": "select",
            "default": "grid",
            "transport": "postMessage",
            "body_class": "bs-blog-{value}",
            "choices": [
              {
                "value": "grid",
                "label": "Rounded cards"
              },
              {
                "value": "list",
                "label": "List with round thumbnails"
              }
            ]
          },
          {
            "id": "sidebar_position",
            "label": "Sidebar",
            "type": "select",
            "default": "right",
            "transport": "postMessage",
            "body_class": "bs-sidebar-{value}",
            "choices": [
              {
                "value": "right",
                "label": "Right"
              },
              {
                "value": "left",
                "label": "Left"
              },
              {
                "value": "none",
                "label": "No sidebar"
              }
            ]
          },
          {
            "id": "show_featured",
            "label": "Show featured images",
            "type": "checkbox",
            "default": true,
            "transport": "postMessage",
            "body_class": "bs-thumbs"
          },
          {
            "id": "show_author",
            "label": "Show the author on posts and cards",
            "type": "checkbox",
            "default": true,
            "transport": "postMessage",
            "body_class": "bs-show-author"
          },
          {
            "id": "footer_text",
            "label": "Footer text",
            "type": "text",
            "default": "",
            "transport": "refresh",
            "description": "Replaces the copyright line."
          }
        ]
      }
    ]
  }
}
