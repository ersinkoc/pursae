{
  "slug": "justitia",
  "name": "Justitia",
  "version": "1.0.0",
  "description": "A dignified theme for law firms with a legal blog: deep burgundy and charcoal with gold hairlines, Caslon headings, a full-bleed hero with a free-consultation call to action, practice areas, attorney profiles, case results and articles that answer everyday law questions.",
  "author": "Pursae",
  "author_url": "https://github.com/boracomet/wordpress-go",
  "theme_url": "https://github.com/boracomet/wordpress-go/tree/main/web/theme-library/justitia",
  "tags": [
    "Legal",
    "Law Firm",
    "Business",
    "Blog",
    "Two Columns",
    "Right Sidebar",
    "Left Sidebar",
    "Grid Layout",
    "Custom Colors",
    "Custom Logo",
    "Custom Menu",
    "Editor Style",
    "Featured Images",
    "Footer Widgets",
    "Sticky Header",
    "Threaded Comments",
    "Wide Blocks"
  ],
  "requires_core": "0.1.0",
  "screenshot": "assets/screenshot.png",
  "category": "legal",
  "style": "Burgundy and charcoal, Caslon serif, gold hairlines",
  "demo": "demo/demo.json",
  "widget_areas": [
    {
      "id": "sidebar-1",
      "name": "Sidebar",
      "description": "Beside posts, archives and search results (Customize sets the side or hides it)."
    },
    {
      "id": "footer-1",
      "name": "Footer",
      "description": "Columns in the footer, next to the site name and description."
    }
  ],
  "menu_locations": [
    {
      "id": "primary",
      "name": "Primary Menu"
    },
    {
      "id": "footer",
      "name": "Footer Menu"
    }
  ],
  "styles": [
    {
      "handle": "justitia-style",
      "src": "assets/style.css",
      "deps": [
        "wp-block-library"
      ],
      "media": "all"
    }
  ],
  "scripts": [
    {
      "handle": "justitia-navigation",
      "src": "assets/js/navigation.js",
      "deps": [],
      "in_footer": true
    }
  ],
  "editor_styles": [
    "assets/editor-style.css"
  ],
  "preload_fonts": [
    "assets/fonts/libre-caslon-text-400.woff2",
    "assets/fonts/source-sans-3.woff2"
  ],
  "palette": [
    {
      "name": "Burgundy",
      "slug": "burgundy",
      "color": "#6b1f2a"
    },
    {
      "name": "Charcoal",
      "slug": "charcoal",
      "color": "#23201f"
    },
    {
      "name": "Gold",
      "slug": "gold",
      "color": "#b4914b"
    },
    {
      "name": "Ivory",
      "slug": "ivory",
      "color": "#faf7f2"
    },
    {
      "name": "Stone",
      "slug": "stone",
      "color": "#e9e3d9"
    },
    {
      "name": "White",
      "slug": "white",
      "color": "#ffffff"
    }
  ],
  "supports": {
    "post-thumbnails": true,
    "custom-logo": {
      "width": 240,
      "height": 64,
      "flex-width": true,
      "flex-height": true,
      "header-text": [
        "site-title",
        "site-description"
      ]
    },
    "title-tag": true,
    "html5": [
      "search-form",
      "comment-form",
      "comment-list",
      "gallery",
      "caption",
      "script",
      "style"
    ],
    "responsive-embeds": true,
    "align-wide": true,
    "wp-block-styles": true
  },
  "customizer": {
    "sections": [
      {
        "id": "justitia_brand",
        "title": "Brand & Colors",
        "priority": 40,
        "settings": [
          {
            "id": "primary_color",
            "label": "Primary (burgundy)",
            "type": "color",
            "default": "#6b1f2a",
            "transport": "postMessage",
            "css_var": "--jt-primary",
            "description": "Buttons, the hero overlay, links and the consultation band."
          },
          {
            "id": "ink_color",
            "label": "Charcoal",
            "type": "color",
            "default": "#23201f",
            "transport": "postMessage",
            "css_var": "--jt-ink",
            "description": "Headings, the top strip and the footer."
          },
          {
            "id": "gold_color",
            "label": "Gold",
            "type": "color",
            "default": "#b4914b",
            "transport": "postMessage",
            "css_var": "--jt-gold",
            "description": "Hairlines, numerals and small capitals."
          },
          {
            "id": "paper_color",
            "label": "Page background",
            "type": "color",
            "default": "#faf7f2",
            "transport": "postMessage",
            "css_var": "--jt-paper"
          },
          {
            "id": "font_pairing",
            "label": "Typefaces",
            "type": "select",
            "default": "caslon",
            "transport": "postMessage",
            "body_class": "jt-font-{value}",
            "choices": [
              {
                "value": "caslon",
                "label": "Libre Caslon headings, Source Sans text"
              },
              {
                "value": "serif",
                "label": "Libre Caslon throughout"
              },
              {
                "value": "sans",
                "label": "Source Sans throughout"
              },
              {
                "value": "system",
                "label": "System fonts"
              }
            ]
          },
          {
            "id": "gold_hairlines",
            "label": "Gold hairlines under headings and around cards",
            "type": "checkbox",
            "default": true,
            "transport": "postMessage",
            "body_class": "jt-hairlines"
          }
        ]
      },
      {
        "id": "justitia_header",
        "title": "Header & Consultation",
        "priority": 41,
        "settings": [
          {
            "id": "header_style",
            "label": "Header style",
            "type": "select",
            "default": "classic",
            "transport": "postMessage",
            "body_class": "jt-header-{value}",
            "choices": [
              {
                "value": "classic",
                "label": "Ivory bar, logo left"
              },
              {
                "value": "centered",
                "label": "Centered crest, menu below"
              },
              {
                "value": "burgundy",
                "label": "Burgundy bar"
              }
            ]
          },
          {
            "id": "sticky_header",
            "label": "Keep the header visible while scrolling",
            "type": "checkbox",
            "default": true,
            "transport": "postMessage",
            "body_class": "jt-sticky"
          },
          {
            "id": "show_topbar",
            "label": "Show the charcoal strip above the header",
            "type": "checkbox",
            "default": true,
            "transport": "refresh"
          },
          {
            "id": "topbar_text",
            "label": "Strip text",
            "type": "text",
            "default": "Free first consultation · Evening appointments on Thursdays",
            "transport": "refresh"
          },
          {
            "id": "phone",
            "label": "Phone number",
            "type": "text",
            "default": "+1 (555) 014-7700",
            "transport": "refresh",
            "description": "Shown in the strip and the consultation band."
          },
          {
            "id": "cta_label",
            "label": "Consultation button label",
            "type": "text",
            "default": "Free consultation",
            "transport": "refresh",
            "description": "Leave empty to hide the button."
          },
          {
            "id": "cta_url",
            "label": "Consultation button link",
            "type": "text",
            "default": "/contact/",
            "transport": "refresh"
          },
          {
            "id": "consult_heading",
            "label": "Consultation band heading",
            "type": "text",
            "default": "Tell us what happened. The first meeting is on us.",
            "transport": "refresh",
            "description": "The band above the footer; leave empty to hide it."
          }
        ]
      },
      {
        "id": "justitia_hero",
        "title": "Front Page Hero",
        "priority": 42,
        "settings": [
          {
            "id": "hero_image",
            "label": "Hero image",
            "description": "Without an image the front page's featured image is used.",
            "type": "image"
          },
          {
            "id": "hero_overlay",
            "label": "Image overlay",
            "type": "select",
            "default": "burgundy",
            "transport": "postMessage",
            "body_class": "jt-overlay-{value}",
            "choices": [
              {
                "value": "burgundy",
                "label": "Burgundy"
              },
              {
                "value": "charcoal",
                "label": "Charcoal"
              },
              {
                "value": "light",
                "label": "Light veil"
              }
            ]
          },
          {
            "id": "hero_kicker",
            "label": "Small line above the heading",
            "type": "text",
            "default": "Attorneys at law · Since 1987",
            "transport": "refresh"
          },
          {
            "id": "hero_heading",
            "label": "Heading",
            "type": "text",
            "default": "",
            "transport": "refresh",
            "description": "Empty uses the page title."
          },
          {
            "id": "hero_text",
            "label": "Text",
            "type": "textarea",
            "default": "",
            "transport": "refresh"
          },
          {
            "id": "hero_button_label",
            "label": "Second button label",
            "type": "text",
            "default": "Practice areas",
            "transport": "refresh"
          },
          {
            "id": "hero_button_url",
            "label": "Second button link",
            "type": "text",
            "default": "#practice",
            "transport": "refresh"
          }
        ],
        "description": "The full-bleed hero on a static front page."
      },
      {
        "id": "justitia_blog",
        "title": "Articles & Footer",
        "priority": 43,
        "settings": [
          {
            "id": "blog_layout",
            "label": "Post list layout",
            "type": "select",
            "default": "list",
            "transport": "postMessage",
            "body_class": "jt-blog-{value}",
            "choices": [
              {
                "value": "list",
                "label": "Editorial list"
              },
              {
                "value": "grid",
                "label": "Cards in a grid"
              }
            ]
          },
          {
            "id": "sidebar_position",
            "label": "Sidebar",
            "type": "select",
            "default": "right",
            "transport": "postMessage",
            "body_class": "jt-sidebar-{value}",
            "choices": [
              {
                "value": "right",
                "label": "Right"
              },
              {
                "value": "left",
                "label": "Left"
              },
              {
                "value": "none",
                "label": "No sidebar"
              }
            ]
          },
          {
            "id": "show_featured",
            "label": "Show featured images",
            "type": "checkbox",
            "default": true,
            "transport": "postMessage",
            "body_class": "jt-thumbs"
          },
          {
            "id": "show_author",
            "label": "Show the author on posts and cards",
            "type": "checkbox",
            "default": true,
            "transport": "postMessage",
            "body_class": "jt-show-author"
          },
          {
            "id": "disclaimer",
            "label": "Legal disclaimer",
            "type": "textarea",
            "default": "The articles on this site are general information, not legal advice. Reading them does not create an attorney–client relationship.",
            "transport": "refresh",
            "description": "Small print above the footer bar."
          },
          {
            "id": "footer_text",
            "label": "Footer text",
            "type": "text",
            "default": "",
            "transport": "refresh",
            "description": "Replaces the copyright line."
          }
        ]
      }
    ]
  }
}
