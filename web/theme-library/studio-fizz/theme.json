{
  "slug": "studio-fizz",
  "name": "Studio Fizz",
  "version": "1.0.0",
  "description": "A bold, colourful theme for creative agencies. A big playful hero with floating shapes, chunky outlined cards with offset shadows, and a static home page with services, team, testimonials and a call to action. Case studies are posts. Colours, corners, shadows, shapes and the header button are all set in the Customizer.",
  "author": "Pursae",
  "author_url": "https://github.com/pursae",
  "theme_url": "https://github.com/pursae/pursae-dev/tree/main/web/theme-library/studio-fizz",
  "tags": ["Agency", "Business", "Portfolio", "Grid Layout", "Custom Colors", "Custom Logo", "Custom Menu", "Editor Style", "Featured Images", "Footer Widgets", "Threaded Comments", "Wide Blocks"],
  "requires_core": "0.1.0",
  "screenshot": "assets/screenshot.png",
  "category": "agency",
  "style": "Bold, colourful and playful",
  "demo": "demo/demo.json",

  "widget_areas": [
    {"id": "footer-1", "name": "Footer", "description": "Widgets in the footer, under the call to action."}
  ],
  "menu_locations": [
    {"id": "primary", "name": "Primary Menu"},
    {"id": "social", "name": "Social Links"}
  ],

  "styles": [
    {"handle": "studio-fizz-style", "src": "assets/style.css", "deps": ["wp-block-library"], "media": "all"}
  ],
  "scripts": [
    {"handle": "studio-fizz-navigation", "src": "assets/js/navigation.js", "deps": [], "in_footer": true}
  ],
  "editor_styles": ["assets/editor-style.css"],
  "preload_fonts": ["assets/fonts/bricolage.woff2"],

  "palette": [
    {"name": "Bubblegum", "slug": "bubblegum", "color": "#ff4fa3"},
    {"name": "Grape", "slug": "grape", "color": "#6c3bff"},
    {"name": "Lemon", "slug": "lemon", "color": "#ffd23f"},
    {"name": "Mint", "slug": "mint", "color": "#2ee6a8"},
    {"name": "Midnight", "slug": "midnight", "color": "#1b1035"},
    {"name": "Cream", "slug": "cream", "color": "#fff6e9"}
  ],
  "supports": {
    "post-thumbnails": true,
    "custom-logo": {"width": 180, "height": 56, "flex-width": true, "flex-height": true, "header-text": ["site-title", "site-description"]},
    "title-tag": true,
    "html5": ["search-form", "comment-form", "comment-list", "gallery", "caption", "script", "style"],
    "responsive-embeds": true,
    "align-wide": true,
    "wp-block-styles": true
  },

  "customizer": {
    "sections": [
      {
        "id": "fizz_colors", "title": "Colours & Type", "priority": 40,
        "settings": [
          {"id": "accent", "label": "Main colour", "description": "Buttons, links and highlights.", "type": "color", "default": "#ff4fa3", "transport": "postMessage", "css_var": "--fz-accent"},
          {"id": "secondary", "label": "Second colour", "description": "Dark sections and hover states.", "type": "color", "default": "#6c3bff", "transport": "postMessage", "css_var": "--fz-second"},
          {"id": "pop", "label": "Pop colour", "description": "Underlines, chips and the footer call to action.", "type": "color", "default": "#ffd23f", "transport": "postMessage", "css_var": "--fz-pop"},
          {"id": "background", "label": "Background colour", "type": "color", "default": "#fff6e9", "transport": "postMessage", "css_var": "--fz-bg"},
          {"id": "font_pairing", "label": "Font pairing", "type": "select", "default": "bricolage-dm", "transport": "postMessage", "body_class": "fz-fonts-{value}",
            "choices": [{"value": "bricolage-dm", "label": "Bricolage Grotesque & DM Sans"}, {"value": "dm", "label": "DM Sans throughout"}, {"value": "system", "label": "System fonts"}]}
        ]
      },
      {
        "id": "fizz_style", "title": "Shapes & Layout", "priority": 41,
        "settings": [
          {"id": "corners", "label": "Corners", "type": "select", "default": "round", "transport": "postMessage", "body_class": "fz-corners-{value}",
            "choices": [{"value": "round", "label": "Extra round"}, {"value": "soft", "label": "Soft"}, {"value": "square", "label": "Square"}]},
          {"id": "shadows", "label": "Offset shadows", "description": "The hard, cartoon-like shadows under cards and buttons.", "type": "checkbox", "default": true, "transport": "postMessage", "body_class": "fz-shadows"},
          {"id": "shapes", "label": "Floating shapes", "description": "Decorative blobs and squiggles in the hero.", "type": "checkbox", "default": true, "transport": "postMessage", "body_class": "fz-shapes"},
          {"id": "card_layout", "label": "Case study list", "type": "select", "default": "grid", "transport": "postMessage", "body_class": "fz-cards-{value}",
            "choices": [{"value": "grid", "label": "Grid of cards"}, {"value": "zigzag", "label": "Zig-zag rows"}]},
          {"id": "sticky_header", "label": "Sticky header", "type": "checkbox", "default": true, "transport": "postMessage", "body_class": "fz-sticky"},
          {"id": "show_author", "label": "Show the author", "type": "checkbox", "default": true, "transport": "postMessage", "body_class": "fz-show-author"}
        ]
      },
      {
        "id": "fizz_content", "title": "Hero & Buttons", "priority": 42,
        "settings": [
          {"id": "hero_heading", "label": "Hero heading", "type": "text", "default": "We make brands people actually remember.", "transport": "refresh"},
          {"id": "hero_text", "label": "Hero text", "type": "textarea", "default": "Strategy, identity, campaigns and digital products for curious companies. Small team, big colours, no boring decks.", "transport": "refresh"},
          {"id": "hero_image", "label": "Hero image", "description": "Falls back to the front page's featured image.", "type": "image", "transport": "refresh"},
          {"id": "cta_label", "label": "Button label", "description": "The button in the header, hero and footer. Leave empty to hide it.", "type": "text", "default": "Start a project", "transport": "refresh"},
          {"id": "cta_url", "label": "Button link", "type": "text", "default": "/contact/", "transport": "refresh"},
          {"id": "footer_text", "label": "Footer text", "type": "text", "default": "", "transport": "refresh"}
        ]
      }
    ]
  }
}
