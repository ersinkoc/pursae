{
  "slug": "driftwood-inn",
  "name": "Driftwood Inn",
  "version": "1.0.0",
  "description": "A calm boutique hotel theme for a small inn by the sea: sandy neutrals, ocean blue and driftwood brown, Gilda Display headings with Libre Franklin text, a full-screen hero with a stay bar, room cards with nightly rates, amenities, a local guide blog and book-a-stay calls to action.",
  "author": "Pursae",
  "author_url": "https://github.com/boracomet/wordpress-go",
  "theme_url": "https://github.com/boracomet/wordpress-go/tree/main/web/theme-library/driftwood-inn",
  "tags": [
    "Hotel",
    "Travel",
    "Business",
    "Grid Layout",
    "Right Sidebar",
    "Custom Colors",
    "Custom Logo",
    "Custom Menu",
    "Editor Style",
    "Featured Images",
    "Footer Widgets",
    "Threaded Comments",
    "Wide Blocks"
  ],
  "requires_core": "0.1.0",
  "screenshot": "assets/screenshot.png",
  "category": "hotel",
  "style": "Boutique seaside hotel, sandy neutrals and ocean blue, airy serif",
  "demo": "demo/demo.json",
  "widget_areas": [
    {
      "id": "sidebar-1",
      "name": "Sidebar",
      "description": "Beside local guide posts while Customize › Local Guide & Footer shows the sidebar."
    },
    {
      "id": "footer-1",
      "name": "Footer",
      "description": "The middle footer column, between the inn's details and the social links."
    }
  ],
  "menu_locations": [
    {
      "id": "primary",
      "name": "Primary Menu"
    },
    {
      "id": "social",
      "name": "Social Links"
    }
  ],
  "styles": [
    {
      "handle": "driftwood-inn-style",
      "src": "assets/style.css",
      "deps": [
        "wp-block-library"
      ],
      "media": "all"
    }
  ],
  "scripts": [
    {
      "handle": "driftwood-inn-navigation",
      "src": "assets/js/navigation.js",
      "deps": [],
      "in_footer": true
    }
  ],
  "editor_styles": [
    "assets/editor-style.css"
  ],
  "preload_fonts": [
    "assets/fonts/gilda-display.woff2",
    "assets/fonts/libre-franklin.woff2"
  ],
  "palette": [
    {
      "name": "Ocean",
      "slug": "ocean",
      "color": "#1f5f7a"
    },
    {
      "name": "Deep sea",
      "slug": "deep-sea",
      "color": "#163f52"
    },
    {
      "name": "Sand",
      "slug": "sand",
      "color": "#f5efe4"
    },
    {
      "name": "Dune",
      "slug": "dune",
      "color": "#e6dac6"
    },
    {
      "name": "Driftwood",
      "slug": "driftwood",
      "color": "#7d6a58"
    },
    {
      "name": "Shell",
      "slug": "shell",
      "color": "#fffdf9"
    }
  ],
  "supports": {
    "post-thumbnails": true,
    "custom-logo": {
      "width": 240,
      "height": 80,
      "flex-width": true,
      "flex-height": true,
      "header-text": [
        "site-title",
        "site-description"
      ]
    },
    "title-tag": true,
    "html5": [
      "search-form",
      "comment-form",
      "comment-list",
      "gallery",
      "caption",
      "script",
      "style"
    ],
    "responsive-embeds": true,
    "align-wide": true,
    "wp-block-styles": true
  },
  "customizer": {
    "sections": [
      {
        "id": "drift_colors",
        "title": "Colors & Type",
        "priority": 40,
        "settings": [
          {
            "id": "ocean_color",
            "label": "Ocean blue",
            "type": "color",
            "default": "#1f5f7a",
            "transport": "postMessage",
            "css_var": "--dw-ocean",
            "description": "Buttons, links and the stay bar."
          },
          {
            "id": "sand_color",
            "label": "Sand background",
            "type": "color",
            "default": "#f5efe4",
            "transport": "postMessage",
            "css_var": "--dw-sand"
          },
          {
            "id": "wood_color",
            "label": "Driftwood",
            "type": "color",
            "default": "#7d6a58",
            "transport": "postMessage",
            "css_var": "--dw-wood",
            "description": "Small labels, lines and ornaments."
          },
          {
            "id": "font_pairing",
            "label": "Typefaces",
            "type": "select",
            "default": "gilda",
            "transport": "postMessage",
            "body_class": "dw-font-{value}",
            "choices": [
              {
                "value": "gilda",
                "label": "Gilda Display with Libre Franklin"
              },
              {
                "value": "franklin",
                "label": "Libre Franklin only"
              },
              {
                "value": "serif",
                "label": "Classic book serif"
              }
            ]
          }
        ]
      },
      {
        "id": "drift_header",
        "title": "Header & Booking",
        "priority": 41,
        "settings": [
          {
            "id": "header_layout",
            "label": "Header layout",
            "type": "select",
            "default": "inline",
            "transport": "postMessage",
            "body_class": "dw-header-{value}",
            "choices": [
              {
                "value": "inline",
                "label": "Name left, menu right"
              },
              {
                "value": "centered",
                "label": "Centered name, menu below"
              }
            ]
          },
          {
            "id": "transparent_header",
            "label": "Transparent header over the front page hero",
            "type": "checkbox",
            "default": true,
            "transport": "postMessage",
            "body_class": "dw-overlay"
          },
          {
            "id": "booking_label",
            "label": "Booking button label",
            "type": "text",
            "default": "Book a stay",
            "transport": "refresh",
            "description": "Empty hides the button."
          },
          {
            "id": "booking_url",
            "label": "Booking link",
            "type": "text",
            "default": "/book/",
            "transport": "refresh"
          }
        ]
      },
      {
        "id": "drift_front",
        "title": "Front Page Hero",
        "priority": 42,
        "settings": [
          {
            "id": "hero_image",
            "label": "Hero image",
            "type": "image",
            "description": "Without an image the front page's featured image is used."
          },
          {
            "id": "hero_heading",
            "label": "Heading",
            "type": "text",
            "default": "",
            "transport": "refresh",
            "description": "Empty uses the page title."
          },
          {
            "id": "hero_text",
            "label": "Text",
            "type": "textarea",
            "default": "",
            "transport": "refresh"
          },
          {
            "id": "hero_height",
            "label": "Hero height",
            "type": "select",
            "default": "full",
            "transport": "postMessage",
            "body_class": "dw-hero-{value}",
            "choices": [
              {
                "value": "full",
                "label": "Full screen"
              },
              {
                "value": "medium",
                "label": "Medium"
              }
            ]
          },
          {
            "id": "show_staybar",
            "label": "Show the stay bar under the hero",
            "type": "checkbox",
            "default": true,
            "transport": "postMessage",
            "body_class": "dw-staybar"
          },
          {
            "id": "checkin_text",
            "label": "Arrival times",
            "type": "text",
            "default": "Check-in from 3 pm · Check-out by 11 am",
            "transport": "refresh"
          },
          {
            "id": "rate_text",
            "label": "Rate line",
            "type": "text",
            "default": "$180 a night, breakfast included",
            "transport": "refresh"
          }
        ]
      },
      {
        "id": "drift_blog",
        "title": "Local Guide & Footer",
        "priority": 43,
        "settings": [
          {
            "id": "blog_layout",
            "label": "Local guide layout",
            "type": "select",
            "default": "magazine",
            "transport": "postMessage",
            "body_class": "blog-{value}",
            "choices": [
              {
                "value": "magazine",
                "label": "Magazine, first post large"
              },
              {
                "value": "grid",
                "label": "Even grid"
              },
              {
                "value": "list",
                "label": "List with images beside"
              }
            ]
          },
          {
            "id": "show_sidebar",
            "label": "Show the sidebar beside posts",
            "type": "checkbox",
            "default": false,
            "transport": "postMessage",
            "body_class": "has-sidebar"
          },
          {
            "id": "address",
            "label": "Address",
            "type": "textarea",
            "default": "1 Harbour Steps\nGull Point",
            "transport": "refresh"
          },
          {
            "id": "footer_text",
            "label": "Footer text",
            "type": "text",
            "default": "",
            "transport": "refresh",
            "description": "Replaces the copyright line."
          }
        ]
      }
    ]
  }
}
