  {
   "slug": "home",
   "title": "Sleep by the sea, wake to the tide",
   "content": "<!-- wp:group {\"align\":\"wide\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group alignwide\"><!-- wp:paragraph {\"align\":\"center\",\"className\":\"eyebrow\"} --><p class=\"has-text-align-center eyebrow\">Welcome</p><!-- /wp:paragraph --><!-- wp:heading {\"textAlign\":\"center\",\"className\":\"section-title\"} --><h2 class=\"wp-block-heading has-text-align-center section-title\">Nine rooms, one long beach and nowhere you have to be</h2><!-- /wp:heading --><!-- wp:paragraph {\"align\":\"center\",\"className\":\"lead\"} --><p class=\"has-text-align-center lead\">Driftwood is a small inn on the harbour steps, rebuilt from a fisherman's net loft. Every room looks at the water, breakfast is served until eleven, and the tide decides the rest of your day.</p><!-- /wp:paragraph --></div><!-- /wp:group -->\n\n<!-- wp:group {\"align\":\"full\",\"className\":\"section-band\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group alignfull section-band\"><!-- wp:columns {\"align\":\"wide\"} --><div class=\"wp-block-columns alignwide\"><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:group {\"className\":\"room-card\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group room-card\"><!-- wp:image {\"id\":{{media_id:room-harbour}},\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} --><figure class=\"wp-block-image size-large\"><img src=\"{{media:room-harbour}}\" alt=\"The Harbour Room\" class=\"wp-image-{{media_id:room-harbour}}\"/></figure><!-- /wp:image --><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Harbour Room</h3><!-- /wp:heading --><!-- wp:paragraph {\"className\":\"rate\"} --><p class=\"rate\">From $180 a night</p><!-- /wp:paragraph --><!-- wp:paragraph --><p>A king bed, a window seat and a view straight down the harbour.</p><!-- /wp:paragraph --><!-- wp:buttons --><div class=\"wp-block-buttons\"><!-- wp:button {\"className\":\"is-style-outline\"} --><div class=\"wp-block-button is-style-outline\"><a class=\"wp-block-button__link wp-element-button\" href=\"{{page:book}}\">Book this room</a></div><!-- /wp:button --></div><!-- /wp:buttons --></div><!-- /wp:group --></div><!-- /wp:column --><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:group {\"className\":\"room-card\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group room-card\"><!-- wp:image {\"id\":{{media_id:room-dune}},\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} --><figure class=\"wp-block-image size-large\"><img src=\"{{media:room-dune}}\" alt=\"The Dune Room\" class=\"wp-image-{{media_id:room-dune}}\"/></figure><!-- /wp:image --><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Dune Room</h3><!-- /wp:heading --><!-- wp:paragraph {\"className\":\"rate\"} --><p class=\"rate\">From $165 a night</p><!-- /wp:paragraph --><!-- wp:paragraph --><p>Warm sandstone tones, a walk-in shower and a balcony over the dunes.</p><!-- /wp:paragraph --><!-- wp:buttons --><div class=\"wp-block-buttons\"><!-- wp:button {\"className\":\"is-style-outline\"} --><div class=\"wp-block-button is-style-outline\"><a class=\"wp-block-button__link wp-element-button\" href=\"{{page:book}}\">Book this room</a></div><!-- /wp:button --></div><!-- /wp:buttons --></div><!-- /wp:group --></div><!-- /wp:column --><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:group {\"className\":\"room-card\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group room-card\"><!-- wp:image {\"id\":{{media_id:suite-tide}},\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} --><figure class=\"wp-block-image size-large\"><img src=\"{{media:suite-tide}}\" alt=\"The Tide Suite\" class=\"wp-image-{{media_id:suite-tide}}\"/></figure><!-- /wp:image --><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Tide Suite</h3><!-- /wp:heading --><!-- wp:paragraph {\"className\":\"rate\"} --><p class=\"rate\">From $260 a night</p><!-- /wp:paragraph --><!-- wp:paragraph --><p>Our largest room, with a separate sitting area and a deep bath by the window.</p><!-- /wp:paragraph --><!-- wp:buttons --><div class=\"wp-block-buttons\"><!-- wp:button {\"className\":\"is-style-outline\"} --><div class=\"wp-block-button is-style-outline\"><a class=\"wp-block-button__link wp-element-button\" href=\"{{page:book}}\">Book this room</a></div><!-- /wp:button --></div><!-- /wp:buttons --></div><!-- /wp:group --></div><!-- /wp:column --></div><!-- /wp:columns --><!-- wp:buttons {\"layout\":{\"type\":\"flex\",\"justifyContent\":\"center\"}} --><div class=\"wp-block-buttons is-content-justification-center is-layout-flex\"><!-- wp:button --><div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"{{page:rooms}}\">See all rooms</a></div><!-- /wp:button --></div><!-- /wp:buttons --></div><!-- /wp:group -->\n\n<!-- wp:group {\"align\":\"full\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group alignfull\"><!-- wp:columns {\"align\":\"wide\"} --><div class=\"wp-block-columns alignwide\"><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:image {\"id\":{{media_id:breakfast}},\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} --><figure class=\"wp-block-image size-large\"><img src=\"{{media:breakfast}}\" alt=\"Breakfast on a wooden table\" class=\"wp-image-{{media_id:breakfast}}\"/></figure><!-- /wp:image --></div><!-- /wp:column --><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:paragraph {\"className\":\"eyebrow\"} --><p class=\"eyebrow\">Every stay includes</p><!-- /wp:paragraph --><!-- wp:heading {\"className\":\"section-title\"} --><h2 class=\"wp-block-heading section-title\">Slow mornings, warm evenings</h2><!-- /wp:heading --><!-- wp:list {\"className\":\"amenities\"} --><ul class=\"wp-block-list amenities\"><!-- wp:list-item --><li>Breakfast with local eggs, smoked fish and bread from the harbour bakery</li><!-- /wp:list-item --><!-- wp:list-item --><li>Bikes, beach towels and windbreaks to borrow</li><!-- /wp:list-item --><!-- wp:list-item --><li>An honesty bar by the fire in the snug</li><!-- /wp:list-item --><!-- wp:list-item --><li>Late check-out on Sundays, if the room is free</li><!-- /wp:list-item --></ul><!-- /wp:list --></div><!-- /wp:column --></div><!-- /wp:columns --></div><!-- /wp:group -->\n\n<!-- wp:group {\"align\":\"full\",\"className\":\"section-dark\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group alignfull section-dark\"><!-- wp:heading {\"textAlign\":\"center\",\"className\":\"section-title\"} --><h2 class=\"wp-block-heading has-text-align-center section-title\">“The kind of quiet you forget exists.”</h2><!-- /wp:heading --><!-- wp:paragraph {\"align\":\"center\"} --><p class=\"has-text-align-center\">Guest book, room four, last September</p><!-- /wp:paragraph --><!-- wp:buttons {\"layout\":{\"type\":\"flex\",\"justifyContent\":\"center\"}} --><div class=\"wp-block-buttons is-content-justification-center is-layout-flex\"><!-- wp:button --><div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"{{page:book}}\">Book a stay</a></div><!-- /wp:button --></div><!-- /wp:buttons --></div><!-- /wp:group -->\n\n<!-- wp:group {\"align\":\"full\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group alignfull\"><!-- wp:paragraph {\"align\":\"center\",\"className\":\"eyebrow\"} --><p class=\"has-text-align-center eyebrow\">Local guide</p><!-- /wp:paragraph --><!-- wp:heading {\"textAlign\":\"center\",\"className\":\"section-title\"} --><h2 class=\"wp-block-heading has-text-align-center section-title\">Where to walk, swim and eat</h2><!-- /wp:heading --><!-- wp:latest-posts {\"postsToShow\":3,\"displayPostDate\":true,\"postLayout\":\"grid\",\"columns\":3,\"align\":\"wide\",\"displayPostContent\":true,\"excerptLength\":18,\"displayFeaturedImage\":true,\"featuredImageSizeSlug\":\"medium_large\"} /--></div><!-- /wp:group -->",
