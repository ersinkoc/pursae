{
  "slug": "gearhead-garage",
  "name": "Gearhead Garage",
  "version": "1.0.0",
  "description": "A bold auto repair and detailing theme: carbon black with racing red, Chakra Petch capitals and Barlow text, angled sections, racing stripes, a full-bleed hero with opening hours, a service price table, booking calls to action and a car-care tips blog. Switches to a light workshop mode.",
  "author": "Pursae",
  "author_url": "https://github.com/pursae",
  "theme_url": "https://github.com/pursae/pursae-dev/tree/main/web/theme-library/gearhead-garage",
  "tags": [
    "Automotive",
    "Business",
    "Dark",
    "Grid Layout",
    "Right Sidebar",
    "Custom Colors",
    "Custom Logo",
    "Custom Menu",
    "Editor Style",
    "Featured Images",
    "Footer Widgets",
    "Threaded Comments",
    "Wide Blocks"
  ],
  "requires_core": "0.1.0",
  "screenshot": "assets/screenshot.png",
  "category": "automotive",
  "style": "Carbon black and racing red auto shop, angled edges, condensed caps",
  "demo": "demo/demo.json",
  "widget_areas": [
    {
      "id": "sidebar-1",
      "name": "Sidebar",
      "description": "Beside tips posts while Customize › Blog & Footer shows the sidebar."
    },
    {
      "id": "footer-1",
      "name": "Footer",
      "description": "The middle footer column, between the shop details and the opening hours."
    }
  ],
  "menu_locations": [
    {
      "id": "primary",
      "name": "Primary Menu"
    },
    {
      "id": "social",
      "name": "Social Links"
    }
  ],
  "styles": [
    {
      "handle": "gearhead-garage-style",
      "src": "assets/style.css",
      "deps": [
        "wp-block-library"
      ],
      "media": "all"
    }
  ],
  "scripts": [
    {
      "handle": "gearhead-garage-navigation",
      "src": "assets/js/navigation.js",
      "deps": [],
      "in_footer": true
    }
  ],
  "editor_styles": [
    "assets/editor-style.css"
  ],
  "preload_fonts": [
    "assets/fonts/chakra-700.woff2",
    "assets/fonts/barlow-400.woff2"
  ],
  "palette": [
    {
      "name": "Racing red",
      "slug": "racing-red",
      "color": "#d7192a"
    },
    {
      "name": "Carbon",
      "slug": "carbon",
      "color": "#121315"
    },
    {
      "name": "Graphite",
      "slug": "graphite",
      "color": "#1d1f23"
    },
    {
      "name": "Steel",
      "slug": "steel",
      "color": "#8b929c"
    },
    {
      "name": "Chrome",
      "slug": "chrome",
      "color": "#e9ebee"
    },
    {
      "name": "Signal yellow",
      "slug": "signal-yellow",
      "color": "#f5c400"
    }
  ],
  "supports": {
    "post-thumbnails": true,
    "custom-logo": {
      "width": 240,
      "height": 80,
      "flex-width": true,
      "flex-height": true,
      "header-text": [
        "site-title",
        "site-description"
      ]
    },
    "title-tag": true,
    "html5": [
      "search-form",
      "comment-form",
      "comment-list",
      "gallery",
      "caption",
      "script",
      "style"
    ],
    "responsive-embeds": true,
    "align-wide": true,
    "wp-block-styles": true
  },
  "customizer": {
    "sections": [
      {
        "id": "gear_colors",
        "title": "Colors & Mode",
        "priority": 40,
        "settings": [
          {
            "id": "red_color",
            "label": "Racing red",
            "type": "color",
            "default": "#d7192a",
            "transport": "postMessage",
            "css_var": "--gg-red",
            "description": "Buttons, stripes, prices and highlights."
          },
          {
            "id": "carbon_color",
            "label": "Carbon",
            "type": "color",
            "default": "#121315",
            "transport": "postMessage",
            "css_var": "--gg-carbon",
            "description": "Background in dark mode; header and footer in light mode."
          },
          {
            "id": "color_mode",
            "label": "Color mode",
            "type": "select",
            "default": "dark",
            "transport": "postMessage",
            "body_class": "gg-mode-{value}",
            "choices": [
              {
                "value": "dark",
                "label": "Dark carbon"
              },
              {
                "value": "light",
                "label": "Light workshop"
              }
            ]
          },
          {
            "id": "carbon_texture",
            "label": "Carbon-fibre texture on dark surfaces",
            "type": "checkbox",
            "default": true,
            "transport": "postMessage",
            "body_class": "gg-texture"
          },
          {
            "id": "racing_stripes",
            "label": "Racing stripes on the header and headings",
            "type": "checkbox",
            "default": true,
            "transport": "postMessage",
            "body_class": "gg-stripes"
          },
          {
            "id": "font_pairing",
            "label": "Typefaces",
            "type": "select",
            "default": "chakra",
            "transport": "postMessage",
            "body_class": "gg-font-{value}",
            "choices": [
              {
                "value": "chakra",
                "label": "Chakra Petch with Barlow"
              },
              {
                "value": "barlow",
                "label": "Barlow only"
              },
              {
                "value": "system",
                "label": "System condensed"
              }
            ]
          }
        ]
      },
      {
        "id": "gear_header",
        "title": "Header & Booking",
        "priority": 41,
        "settings": [
          {
            "id": "sticky_header",
            "label": "Keep the header visible while scrolling",
            "type": "checkbox",
            "default": true,
            "transport": "postMessage",
            "body_class": "gg-sticky"
          },
          {
            "id": "edge_style",
            "label": "Section edges",
            "type": "select",
            "default": "angled",
            "transport": "postMessage",
            "body_class": "gg-edges-{value}",
            "choices": [
              {
                "value": "angled",
                "label": "Angled"
              },
              {
                "value": "straight",
                "label": "Straight"
              }
            ]
          },
          {
            "id": "booking_label",
            "label": "Booking button label",
            "type": "text",
            "default": "Book a service",
            "transport": "refresh",
            "description": "Empty hides the button."
          },
          {
            "id": "booking_url",
            "label": "Booking link",
            "type": "text",
            "default": "/book-a-service/",
            "transport": "refresh"
          },
          {
            "id": "phone",
            "label": "Phone number",
            "type": "text",
            "default": "+1 (555) 019-4466",
            "transport": "refresh"
          }
        ]
      },
      {
        "id": "gear_front",
        "title": "Front Page Hero",
        "priority": 42,
        "settings": [
          {
            "id": "hero_image",
            "label": "Hero image",
            "type": "image",
            "description": "Without an image the front page's featured image is used."
          },
          {
            "id": "hero_heading",
            "label": "Heading",
            "type": "text",
            "default": "",
            "transport": "refresh",
            "description": "Empty uses the page title."
          },
          {
            "id": "hero_text",
            "label": "Text",
            "type": "textarea",
            "default": "",
            "transport": "refresh"
          },
          {
            "id": "hours_text",
            "label": "Workshop hours",
            "type": "textarea",
            "default": "Mon – Fri  7:30 – 18:00\nSaturday  8:00 – 13:00",
            "transport": "refresh",
            "description": "Shown under the hero and in the footer."
          }
        ]
      },
      {
        "id": "gear_blog",
        "title": "Blog & Footer",
        "priority": 43,
        "settings": [
          {
            "id": "blog_layout",
            "label": "Blog layout",
            "type": "select",
            "default": "grid",
            "transport": "postMessage",
            "body_class": "blog-{value}",
            "choices": [
              {
                "value": "grid",
                "label": "Grid of cards"
              },
              {
                "value": "list",
                "label": "List with images beside"
              }
            ]
          },
          {
            "id": "show_sidebar",
            "label": "Show the sidebar beside posts",
            "type": "checkbox",
            "default": false,
            "transport": "postMessage",
            "body_class": "has-sidebar"
          },
          {
            "id": "address",
            "label": "Address",
            "type": "textarea",
            "default": "Unit 4, Foundry Lane\nEast Works",
            "transport": "refresh"
          },
          {
            "id": "footer_text",
            "label": "Footer text",
            "type": "text",
            "default": "",
            "transport": "refresh",
            "description": "Replaces the copyright line."
          }
        ]
      }
    ]
  }
}
