   "slug": "home",
   "title": "Built right. Fixed fast.",
   "content": "<!-- wp:group {\"align\":\"wide\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group alignwide\"><!-- wp:columns {\"align\":\"wide\",\"className\":\"stat-row\"} --><div class=\"wp-block-columns alignwide stat-row\"><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:paragraph {\"className\":\"stat\"} --><p class=\"stat\">4.9</p><!-- /wp:paragraph --><!-- wp:paragraph {\"className\":\"stat-label\"} --><p class=\"stat-label\">average review score</p><!-- /wp:paragraph --></div><!-- /wp:column --><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:paragraph {\"className\":\"stat\"} --><p class=\"stat\">12</p><!-- /wp:paragraph --><!-- wp:paragraph {\"className\":\"stat-label\"} --><p class=\"stat-label\">month parts &amp; labour warranty</p><!-- /wp:paragraph --></div><!-- /wp:column --><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:paragraph {\"className\":\"stat\"} --><p class=\"stat\">3</p><!-- /wp:paragraph --><!-- wp:paragraph {\"className\":\"stat-label\"} --><p class=\"stat-label\">lifts, no waiting weeks</p><!-- /wp:paragraph --></div><!-- /wp:column --><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:paragraph {\"className\":\"stat\"} --><p class=\"stat\">1998</p><!-- /wp:paragraph --><!-- wp:paragraph {\"className\":\"stat-label\"} --><p class=\"stat-label\">fixing cars since</p><!-- /wp:paragraph --></div><!-- /wp:column --></div><!-- /wp:columns --></div><!-- /wp:group -->\n\n<!-- wp:group {\"align\":\"full\",\"className\":\"section-band\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group alignfull section-band\"><!-- wp:paragraph {\"className\":\"eyebrow\"} --><p class=\"eyebrow\">What we do</p><!-- /wp:paragraph --><!-- wp:heading {\"className\":\"section-title\"} --><h2 class=\"wp-block-heading section-title\">Honest repairs. Showroom shine.</h2><!-- /wp:heading --><!-- wp:paragraph {\"className\":\"lead\"} --><p class=\"lead\">Independent mechanics and detailers under one roof. We explain the fault, show you the old part and quote before we touch a spanner.</p><!-- /wp:paragraph --><!-- wp:columns {\"align\":\"wide\"} --><div class=\"wp-block-columns alignwide\"><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:group {\"className\":\"feature-card\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group feature-card\"><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Service &amp; MOT prep</h3><!-- /wp:heading --><!-- wp:paragraph --><p>Manufacturer-schedule servicing that keeps your warranty valid.</p><!-- /wp:paragraph --><!-- wp:paragraph {\"className\":\"price-from\"} --><p class=\"price-from\">from $149</p><!-- /wp:paragraph --></div><!-- /wp:group --></div><!-- /wp:column --><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:group {\"className\":\"feature-card\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group feature-card\"><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Brakes &amp; tyres</h3><!-- /wp:heading --><!-- wp:paragraph --><p>Pads, discs, fluid, alignment and tyres from four brands.</p><!-- /wp:paragraph --><!-- wp:paragraph {\"className\":\"price-from\"} --><p class=\"price-from\">from $89</p><!-- /wp:paragraph --></div><!-- /wp:group --></div><!-- /wp:column --><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:group {\"className\":\"feature-card\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group feature-card\"><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Diagnostics</h3><!-- /wp:heading --><!-- wp:paragraph --><p>Warning light on? A full scan and a plain-English report.</p><!-- /wp:paragraph --><!-- wp:paragraph {\"className\":\"price-from\"} --><p class=\"price-from\">$59</p><!-- /wp:paragraph --></div><!-- /wp:group --></div><!-- /wp:column --><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:group {\"className\":\"feature-card\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group feature-card\"><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Detailing</h3><!-- /wp:heading --><!-- wp:paragraph --><p>Hand wash, paint correction and ceramic coating.</p><!-- /wp:paragraph --><!-- wp:paragraph {\"className\":\"price-from\"} --><p class=\"price-from\">from $120</p><!-- /wp:paragraph --></div><!-- /wp:group --></div><!-- /wp:column --></div><!-- /wp:columns --><!-- wp:buttons --><div class=\"wp-block-buttons\"><!-- wp:button --><div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"{{page:services}}\">Full price list</a></div><!-- /wp:button --><!-- wp:button {\"className\":\"is-style-outline\"} --><div class=\"wp-block-button is-style-outline\"><a class=\"wp-block-button__link wp-element-button\" href=\"{{page:book-a-service}}\">Book a service</a></div><!-- /wp:button --></div><!-- /wp:buttons --></div><!-- /wp:group -->\n\n<!-- wp:group {\"align\":\"full\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group alignfull\"><!-- wp:columns {\"align\":\"wide\"} --><div class=\"wp-block-columns alignwide\"><!-- wp:column {\"width\":\"50%\"} --><div class=\"wp-block-column\" style=\"flex-basis:50%\"><!-- wp:image {\"id\":{{media_id:detailing}},\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} --><figure class=\"wp-block-image size-large\"><img src=\"{{media:detailing}}\" alt=\"Water beading on waxed red paint\" class=\"wp-image-{{media_id:detailing}}\"/></figure><!-- /wp:image --></div><!-- /wp:column --><!-- wp:column {\"width\":\"50%\"} --><div class=\"wp-block-column\" style=\"flex-basis:50%\"><!-- wp:paragraph {\"className\":\"eyebrow\"} --><p class=\"eyebrow\">Detailing bay</p><!-- /wp:paragraph --><!-- wp:heading {\"className\":\"section-title\"} --><h2 class=\"wp-block-heading section-title\">Paint that looks deeper than it did new</h2><!-- /wp:heading --><!-- wp:paragraph --><p>Our detailing bay has its own lights, a deionised water system and two people who will happily spend a whole day on one bonnet.</p><!-- /wp:paragraph --><!-- wp:list {\"className\":\"price-list\"} --><ul class=\"wp-block-list price-list\"><!-- wp:list-item --><li><strong>Signature wash</strong> <span class=\"price\">$120</span> <span class=\"desc\">Snow foam, two-bucket wash, decontamination, sealant</span></li><!-- /wp:list-item --><!-- wp:list-item --><li><strong>Paint correction</strong> <span class=\"price\">from $380</span> <span class=\"desc\">One or two-stage machine polish</span></li><!-- /wp:list-item --><!-- wp:list-item --><li><strong>Ceramic coating</strong> <span class=\"price\">from $690</span> <span class=\"desc\">Five-year protection, with a care kit</span></li><!-- /wp:list-item --></ul><!-- /wp:list --></div><!-- /wp:column --></div><!-- /wp:columns --></div><!-- /wp:group -->\n\n<!-- wp:group {\"align\":\"full\",\"className\":\"section-dark\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group alignfull section-dark\"><!-- wp:heading {\"textAlign\":\"center\",\"className\":\"section-title\"} --><h2 class=\"wp-block-heading has-text-align-center section-title\">Booked in by nine, back by five.</h2><!-- /wp:heading --><!-- wp:paragraph {\"align\":\"center\"} --><p class=\"has-text-align-center\">Most services are same-day. Drop the keys in the box by the gate if you are early.</p><!-- /wp:paragraph --><!-- wp:buttons {\"layout\":{\"type\":\"flex\",\"justifyContent\":\"center\"}} --><div class=\"wp-block-buttons is-content-justification-center is-layout-flex\"><!-- wp:button --><div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"{{page:book-a-service}}\">Book a service</a></div><!-- /wp:button --></div><!-- /wp:buttons --></div><!-- /wp:group -->\n\n<!-- wp:group {\"align\":\"full\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group alignfull\"><!-- wp:paragraph {\"className\":\"eyebrow\"} --><p class=\"eyebrow\">Car-care tips</p><!-- /wp:paragraph --><!-- wp:heading {\"className\":\"section-title\"} --><h2 class=\"wp-block-heading section-title\">From the workshop floor</h2><!-- /wp:heading --><!-- wp:latest-posts {\"postsToShow\":3,\"displayPostDate\":true,\"postLayout\":\"grid\",\"columns\":3,\"align\":\"wide\",\"displayPostContent\":true,\"excerptLength\":18,\"displayFeaturedImage\":true,\"featuredImageSizeSlug\":\"medium_large\"} /--></div><!-- /wp:group -->",
