{
  "slug": "aurum-and-pearl",
  "name": "Aurum & Pearl",
  "version": "1.0.0",
  "description": "A quiet, luxurious fine-jewellery boutique for Goocommerce. A centred masthead with a letter-spaced wordmark between search and the bag, a hairline-ruled menu, a full-bleed hero with an italic serif headline and a gold ornament, arched category frames, centred product cards that draw a gold frame and reveal \"add to bag\" on hover, an unhurried product page and an onyx footer. Cormorant Garamond and Jost, with an optional Marcellus pairing, self-hosted. A Noir (dark) mode included. Ships a complete store demo: rings, necklaces, earrings and bracelets with ring sizes, reviews, a coupon and insured shipping.",
  "author": "WordPress Go",
  "author_url": "https://github.com/boracomet/wordpress-go",
  "theme_url": "https://github.com/boracomet/wordpress-go/tree/main/web/theme-library/aurum-and-pearl",
  "tags": ["E-Commerce", "Fashion", "Jewelry", "Grid Layout", "Custom Colors", "Custom Logo", "Custom Menu", "Editor Style", "Featured Images", "Footer Widgets", "Wide Blocks"],
  "requires_core": "0.1.0",
  "screenshot": "assets/screenshot.png",
  "category": "shop",
  "style": "Quiet luxury jewellery, ivory and gold",
  "demo": "demo/demo.json",

  "widget_areas": [
    {"id": "footer-1", "name": "Footer", "description": "Widgets in the footer columns."},
    {"id": "shop-sidebar", "name": "Shop Sidebar", "description": "Filters beside the product catalog."}
  ],
  "menu_locations": [
    {"id": "primary", "name": "Primary Menu"},
    {"id": "footer", "name": "Footer Menu"}
  ],

  "styles": [
    {"handle": "aurum-and-pearl-style", "src": "assets/style.css", "deps": ["wp-block-library"], "media": "all"}
  ],
  "scripts": [
    {"handle": "aurum-and-pearl-navigation", "src": "assets/js/navigation.js", "deps": [], "in_footer": true}
  ],
  "editor_styles": ["assets/editor-style.css"],
  "preload_fonts": ["assets/fonts/cormorant.woff2", "assets/fonts/jost.woff2"],

  "palette": [
    {"name": "Ivory", "slug": "ivory", "color": "#faf7f2"},
    {"name": "Gold", "slug": "gold", "color": "#b8954a"},
    {"name": "Onyx", "slug": "onyx", "color": "#141414"},
    {"name": "Champagne", "slug": "champagne", "color": "#e9dcc4"},
    {"name": "Pearl", "slug": "pearl", "color": "#f3eee6"}
  ],
  "supports": {
    "post-thumbnails": true,
    "custom-logo": {"width": 300, "height": 90, "flex-width": true, "flex-height": true, "header-text": ["site-title", "site-description"]},
    "title-tag": true,
    "html5": ["search-form", "comment-form", "comment-list", "gallery", "caption", "script", "style"],
    "responsive-embeds": true,
    "align-wide": true,
    "wp-block-styles": true,
    "woocommerce": true
  },

  "customizer": {
    "sections": [
      {
        "id": "aurum_and_pearl_colors", "title": "Colours & Type", "priority": 40,
        "settings": [
          {"id": "accent", "label": "Gold accent", "description": "Ornaments, prices, sale marks and hover frames.", "type": "color", "default": "#b8954a", "transport": "postMessage", "css_var": "--ap-gold"},
          {"id": "champagne", "label": "Champagne (panels)", "description": "The backdrop behind product images and panels.", "type": "color", "default": "#e9dcc4", "transport": "postMessage", "css_var": "--ap-champagne"},
          {"id": "background", "label": "Background", "type": "color", "default": "#faf7f2", "transport": "postMessage", "css_var": "--ap-bg"},
          {"id": "text_color", "label": "Text colour", "type": "color", "default": "#141414", "transport": "postMessage", "css_var": "--ap-ink"},
          {"id": "font_pairing", "label": "Font pairing", "type": "select", "default": "cormorant", "transport": "postMessage", "body_class": "ap-fonts-{value}",
            "choices": [{"value": "cormorant", "label": "Cormorant Garamond & Jost"}, {"value": "marcellus", "label": "Marcellus & Jost"}]},
          {"id": "button_style", "label": "Buttons", "type": "select", "default": "solid", "transport": "postMessage", "body_class": "ap-buttons-{value}",
            "choices": [{"value": "solid", "label": "Solid onyx"}, {"value": "outline", "label": "Hairline outline"}]},
          {"id": "noir_mode", "label": "Noir mode (dark)", "description": "Onyx background with ivory text and gold.", "type": "checkbox", "default": false, "transport": "postMessage", "body_class": "ap-noir"}
        ]
      },
      {
        "id": "aurum_and_pearl_header", "title": "Masthead & Boutique", "priority": 41,
        "settings": [
          {"id": "show_announcement", "label": "Show the announcement line", "type": "checkbox", "default": true, "transport": "postMessage", "body_class": "ap-has-announcement"},
          {"id": "announcement", "label": "Announcement", "type": "text", "default": "Complimentary insured delivery · Engraving on request", "transport": "refresh"},
          {"id": "header_layout", "label": "Masthead", "type": "select", "default": "centered", "transport": "postMessage", "body_class": "ap-header-{value}",
            "choices": [{"value": "centered", "label": "Centred wordmark, menu below"}, {"value": "inline", "label": "Wordmark left, menu beside"}]},
          {"id": "tile_shape", "label": "Category frames", "type": "select", "default": "arch", "transport": "postMessage", "body_class": "ap-tiles-{value}",
            "choices": [{"value": "arch", "label": "Arched"}, {"value": "circle", "label": "Round"}, {"value": "square", "label": "Square"}]},
          {"id": "catalog_columns", "label": "Products per row (large screens)", "type": "select", "default": "4", "transport": "postMessage", "body_class": "ap-cols-{value}",
            "choices": [{"value": "3", "label": "3"}, {"value": "4", "label": "4"}]},
          {"id": "footer_text", "label": "Footer text", "type": "text", "default": "", "transport": "refresh"}
        ]
      }
    ]
  }
}
