{
  "slug": "lumen-folio",
  "name": "Lumen Folio",
  "version": "1.0.0",
  "description": "A dark, full-bleed showcase for photographers. The front page is a masonry wall of your stories, every image opens on a quiet, lightbox-like stage, and the chrome stays out of the way. Light Jost type with Cormorant italics, adjustable gallery columns, gaps and captions, all previewed live in the Customizer.",
  "author": "Pursae",
  "author_url": "https://github.com/pursae",
  "theme_url": "https://github.com/pursae/pursae-dev/tree/main/web/theme-library/lumen-folio",
  "tags": ["Photography", "Portfolio", "Dark", "Grid Layout", "Full Width Template", "Custom Colors", "Custom Logo", "Custom Menu", "Featured Images", "Footer Widgets", "Threaded Comments", "Wide Blocks"],
  "requires_core": "0.1.0",
  "screenshot": "assets/screenshot.png",
  "category": "photography",
  "style": "Dark full-bleed masonry gallery",
  "demo": "demo/demo.json",

  "widget_areas": [
    {"id": "footer-1", "name": "Footer", "description": "Up to three columns of widgets above the footer bar."}
  ],
  "menu_locations": [
    {"id": "primary", "name": "Primary Menu"},
    {"id": "social", "name": "Social Links"}
  ],

  "styles": [
    {"handle": "lumen-folio-style", "src": "assets/style.css", "deps": ["wp-block-library"], "media": "all"}
  ],
  "scripts": [
    {"handle": "lumen-folio-navigation", "src": "assets/js/navigation.js", "deps": [], "in_footer": true}
  ],
  "editor_styles": ["assets/editor-style.css"],
  "preload_fonts": ["assets/fonts/jost.woff2"],

  "palette": [
    {"name": "Darkroom", "slug": "darkroom", "color": "#0c0c0d"},
    {"name": "Graphite", "slug": "graphite", "color": "#1b1b1d"},
    {"name": "Silver", "slug": "silver", "color": "#8e8b86"},
    {"name": "Paper", "slug": "paper", "color": "#ebe7e0"},
    {"name": "Amber", "slug": "amber", "color": "#d9a35b"}
  ],
  "supports": {
    "post-thumbnails": true,
    "custom-logo": {"width": 180, "height": 48, "flex-width": true, "flex-height": true, "header-text": ["site-title", "site-description"]},
    "title-tag": true,
    "html5": ["search-form", "comment-form", "comment-list", "gallery", "caption", "script", "style"],
    "responsive-embeds": true,
    "align-wide": true,
    "wp-block-styles": true
  },

  "customizer": {
    "sections": [
      {
        "id": "lumen_gallery", "title": "Gallery", "description": "How the stories are laid out on the front page and in archives.", "priority": 40,
        "settings": [
          {"id": "gallery_layout", "label": "Gallery layout", "type": "select", "default": "masonry", "transport": "postMessage", "body_class": "lf-layout-{value}",
            "choices": [{"value": "masonry", "label": "Masonry (natural heights)"}, {"value": "grid", "label": "Even grid (cropped)"}, {"value": "stacked", "label": "Stacked (one large image per row)"}]},
          {"id": "gallery_columns", "label": "Columns on wide screens", "type": "select", "default": "3", "transport": "postMessage", "body_class": "lf-cols-{value}",
            "choices": [{"value": "2", "label": "Two"}, {"value": "3", "label": "Three"}, {"value": "4", "label": "Four"}]},
          {"id": "gallery_gap", "label": "Space between images", "type": "select", "default": "normal", "transport": "postMessage", "body_class": "lf-gap-{value}",
            "choices": [{"value": "none", "label": "None (edge to edge)"}, {"value": "tight", "label": "Tight"}, {"value": "normal", "label": "Normal"}, {"value": "airy", "label": "Airy"}]},
          {"id": "captions", "label": "Titles on images", "type": "select", "default": "hover", "transport": "postMessage", "body_class": "lf-captions-{value}",
            "choices": [{"value": "hover", "label": "On hover and focus"}, {"value": "always", "label": "Always below the image"}, {"value": "hidden", "label": "Hidden"}]},
          {"id": "intro_text", "label": "Front page introduction", "description": "A short line above the gallery on the front page. Leave empty to hide it.", "type": "textarea", "default": "Light, weather and quiet places, photographed slowly.", "transport": "refresh"},
          {"id": "hero_image", "label": "Front page cover image", "description": "An optional full-bleed image above the gallery.", "type": "image", "transport": "refresh"}
        ]
      },
      {
        "id": "lumen_look", "title": "Colors & Type", "priority": 41,
        "settings": [
          {"id": "accent", "label": "Accent color", "description": "Links, focus rings and small highlights.", "type": "color", "default": "#d9a35b", "transport": "postMessage", "css_var": "--lf-accent"},
          {"id": "background", "label": "Background color", "description": "Keep it dark so photographs glow.", "type": "color", "default": "#0c0c0d", "transport": "postMessage", "css_var": "--lf-bg"},
          {"id": "text_color", "label": "Text color", "type": "color", "default": "#ebe7e0", "transport": "postMessage", "css_var": "--lf-text"},
          {"id": "font_pairing", "label": "Font pairing", "type": "select", "default": "jost-cormorant", "transport": "postMessage", "body_class": "lf-fonts-{value}",
            "choices": [{"value": "jost-cormorant", "label": "Jost & Cormorant italic"}, {"value": "cormorant", "label": "Cormorant throughout"}, {"value": "system", "label": "System sans-serif"}]}
        ]
      },
      {
        "id": "lumen_chrome", "title": "Header & Footer", "priority": 42,
        "settings": [
          {"id": "header_style", "label": "Header style", "type": "select", "default": "split", "transport": "postMessage", "body_class": "lf-header-{value}",
            "choices": [{"value": "split", "label": "Title left, menu right"}, {"value": "centered", "label": "Centered"}]},
          {"id": "sticky_header", "label": "Keep the header visible while scrolling", "type": "checkbox", "default": false, "transport": "postMessage", "body_class": "lf-sticky-header"},
          {"id": "show_meta", "label": "Show date and author on stories", "type": "checkbox", "default": true, "transport": "postMessage", "body_class": "lf-show-meta"},
          {"id": "footer_text", "label": "Footer text", "description": "Replaces the copyright line.", "type": "text", "default": "", "transport": "refresh"}
        ]
      }
    ]
  }
}
