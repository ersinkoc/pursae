   "title": "Home",
   "content": "<!-- wp:group {\"className\":\"pw-section pw-latest-ep\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group pw-section pw-latest-ep\"><!-- wp:image {\"id\":{{media_id:ep-bread}},\"sizeSlug\":\"large\",\"linkDestination\":\"custom\"} --><figure class=\"wp-block-image size-large\"><a href=\"{{post:ep-24-the-secret-life-of-sourdough}}\"><img src=\"{{media:ep-bread}}\" alt=\"Cover art: a round loaf of bread with steam rising in waves\" class=\"wp-image-{{media_id:ep-bread}}\"/></a></figure><!-- /wp:image --><!-- wp:group {\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group\"><!-- wp:paragraph {\"className\":\"pw-kicker\"} --><p class=\"pw-kicker\">Latest episode</p><!-- /wp:paragraph --><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\"><a href=\"{{post:ep-24-the-secret-life-of-sourdough}}\">Ep. 24: The secret life of sourdough</a></h3><!-- /wp:heading --><!-- wp:paragraph --><p>A baker who has kept the same starter alive for nineteen years explains why bread is mostly patience.</p><!-- /wp:paragraph --><!-- wp:html --><div class=\"pw-wave-line\" aria-hidden=\"true\"></div><!-- /wp:html --><!-- wp:buttons --><div class=\"wp-block-buttons\"><!-- wp:button --><div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"{{post:ep-24-the-secret-life-of-sourdough}}\">Show notes</a></div><!-- /wp:button --><!-- wp:button {\"className\":\"is-style-outline\"} --><div class=\"wp-block-button is-style-outline\"><a class=\"wp-block-button__link wp-element-button\" href=\"{{page:episodes}}\">All episodes</a></div><!-- /wp:button --></div><!-- /wp:buttons --></div><!-- /wp:group --></div><!-- /wp:group --><!-- wp:group {\"className\":\"pw-section\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group pw-section\"><!-- wp:group {\"className\":\"pw-section-head\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group pw-section-head\"><!-- wp:heading --><h2 class=\"wp-block-heading\">Recent episodes</h2><!-- /wp:heading --><!-- wp:buttons --><div class=\"wp-block-buttons\"><!-- wp:button {\"className\":\"is-style-outline\"} --><div class=\"wp-block-button is-style-outline\"><a class=\"wp-block-button__link wp-element-button\" href=\"{{page:episodes}}\">Browse all</a></div><!-- /wp:button --></div><!-- /wp:buttons --></div><!-- /wp:group --><!-- wp:latest-posts {\"postsToShow\":6,\"displayPostDate\":true,\"displayFeaturedImage\":true,\"featuredImageSizeSlug\":\"large\",\"displayPostContent\":true,\"excerptLength\":20,\"postLayout\":\"grid\",\"columns\":3} /--></div><!-- /wp:group --><!-- wp:group {\"className\":\"pw-section\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group pw-section\"><!-- wp:group {\"className\":\"pw-section-head\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group pw-section-head\"><!-- wp:heading --><h2 class=\"wp-block-heading\">Meet your hosts</h2><!-- /wp:heading --><!-- wp:paragraph --><p><a href=\"{{page:hosts}}\">More about us &rarr;</a></p><!-- /wp:paragraph --></div><!-- /wp:group --><!-- wp:columns {\"className\":\"pw-hosts\"} --><div class=\"wp-block-columns pw-hosts\"><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:group {\"className\":\"pw-host\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group pw-host\"><!-- wp:image {\"id\":{{media_id:host-ada}},\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} --><figure class=\"wp-block-image size-large\"><img src=\"{{media:host-ada}}\" alt=\"Illustrated portrait of host Ada Lin, in violet tones\" class=\"wp-image-{{media_id:host-ada}}\"/></figure><!-- /wp:image --><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Ada Lin</h3><!-- /wp:heading --><!-- wp:paragraph {\"className\":\"pw-role\"} --><p class=\"pw-role\">Host &amp; producer</p><!-- /wp:paragraph --><!-- wp:paragraph --><p>Former radio producer, asks the follow-up question you were thinking.</p><!-- /wp:paragraph --></div><!-- /wp:group --></div><!-- /wp:column --><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:group {\"className\":\"pw-host\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group pw-host\"><!-- wp:image {\"id\":{{media_id:host-sam}},\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} --><figure class=\"wp-block-image size-large\"><img src=\"{{media:host-sam}}\" alt=\"Illustrated portrait of host Sam Okoye, in coral tones\" class=\"wp-image-{{media_id:host-sam}}\"/></figure><!-- /wp:image --><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Sam Okoye</h3><!-- /wp:heading --><!-- wp:paragraph {\"className\":\"pw-role\"} --><p class=\"pw-role\">Host &amp; editor</p><!-- /wp:paragraph --><!-- wp:paragraph --><p>Makes the edits, the jokes and, occasionally, the tea.</p><!-- /wp:paragraph --></div><!-- /wp:group --></div><!-- /wp:column --><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:group {\"className\":\"pw-host\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group pw-host\"><!-- wp:image {\"id\":{{media_id:guest-wall}},\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} --><figure class=\"wp-block-image size-large\"><img src=\"{{media:guest-wall}}\" alt=\"A wall of round illustrated guest portraits\" class=\"wp-image-{{media_id:guest-wall}}\"/></figure><!-- /wp:image --><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Our guests</h3><!-- /wp:heading --><!-- wp:paragraph {\"className\":\"pw-role\"} --><p class=\"pw-role\">Bakers, foresters, restorers</p><!-- /wp:paragraph --><!-- wp:paragraph --><p>Ninety guests and counting. <a href=\"{{page:guests}}\">See them all</a>.</p><!-- /wp:paragraph --></div><!-- /wp:group --></div><!-- /wp:column --></div><!-- /wp:columns --></div><!-- /wp:group --><!-- wp:columns {\"className\":\"pw-section pw-stats\"} --><div class=\"wp-block-columns pw-section pw-stats\"><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:paragraph {\"className\":\"pw-stat\"} --><p class=\"pw-stat\">24</p><!-- /wp:paragraph --><!-- wp:paragraph --><p>episodes</p><!-- /wp:paragraph --></div><!-- /wp:column --><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:paragraph {\"className\":\"pw-stat\"} --><p class=\"pw-stat\">90+</p><!-- /wp:paragraph --><!-- wp:paragraph --><p>guests</p><!-- /wp:paragraph --></div><!-- /wp:column --><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:paragraph {\"className\":\"pw-stat\"} --><p class=\"pw-stat\">41</p><!-- /wp:paragraph --><!-- wp:paragraph --><p>countries listening</p><!-- /wp:paragraph --></div><!-- /wp:column --><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:paragraph {\"className\":\"pw-stat\"} --><p class=\"pw-stat\">4am</p><!-- /wp:paragraph --><!-- wp:paragraph --><p>earliest recording</p><!-- /wp:paragraph --></div><!-- /wp:column --></div><!-- /wp:columns --><!-- wp:group {\"className\":\"pw-section pw-listen\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group pw-section pw-listen\"><!-- wp:heading --><h2 class=\"wp-block-heading\">Listen wherever you are</h2><!-- /wp:heading --><!-- wp:paragraph --><p>New episodes every Tuesday morning. Free, always, in any podcast app.</p><!-- /wp:paragraph --><!-- wp:buttons --><div class=\"wp-block-buttons\"><!-- wp:button --><div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"{{page:subscribe}}\">Subscribe</a></div><!-- /wp:button --><!-- wp:button {\"className\":\"is-style-outline\"} --><div class=\"wp-block-button is-style-outline\"><a class=\"wp-block-button__link wp-element-button\" href=\"/feed/\">RSS feed</a></div><!-- /wp:button --><!-- wp:button {\"className\":\"is-style-outline\"} --><div class=\"wp-block-button is-style-outline\"><a class=\"wp-block-button__link wp-element-button\" href=\"{{page:subscribe}}\">Newsletter</a></div><!-- /wp:button --></div><!-- /wp:buttons --></div><!-- /wp:group -->",
