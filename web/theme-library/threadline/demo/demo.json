 "posts": [
  {
   "slug": "how-to-care-for-linen",
   "title": "How to care for linen",
   "date": "2026-09-30T09:00:00",
   "categories": [
    "notes"
   ],
   "featured_media": "p-linen-wrap-dress",
   "excerpt": "Linen gets better with age, if you let it. Five habits that keep it soft for years.",
   "content": "<!-- wp:paragraph --><p>Wash cool, skip the dryer, and stop ironing: linen is meant to look lived in. Hang it while damp and the weight of the fabric does most of the work.</p><!-- /wp:paragraph --><!-- wp:paragraph --><p>Store it folded, not on wire hangers, and give stains a little gentle soap rather than bleach.</p><!-- /wp:paragraph -->"
  },
  {
   "slug": "a-week-in-the-wool-coat",
   "title": "A week in the wool coat",
   "date": "2026-10-08T10:00:00",
   "categories": [
    "notes"
   ],
   "featured_media": "p-oversized-wool-coat",
   "excerpt": "Seven days, seven outfits, one coat that goes with all of them.",
   "content": "<!-- wp:paragraph --><p>We asked three people from the studio to wear the oversized coat for a week, over everything from a summer dress to a hoodie. The verdict: it goes with everything, and pockets matter.</p><!-- /wp:paragraph -->"
  },
  {
   "slug": "meet-the-shoemakers",
   "title": "Meet the shoemakers",
   "date": "2026-10-20T08:30:00",
   "categories": [
    "makers"
   ],
   "featured_media": "p-chelsea-boot",
   "excerpt": "Three generations, one workshop and a lot of patience: the people behind our boots.",
   "content": "<!-- wp:paragraph --><p>Our Chelsea boots are made in a small workshop run by the same family since the sixties. Every pair is lasted by hand and can be resoled when the time comes.</p><!-- /wp:paragraph -->"
  }
 ],
