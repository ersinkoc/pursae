{
  "slug": "byte-notes",
  "name": "Byte Notes",
  "version": "1.0.0",
  "description": "A dark-first developer blog: glowing gradient accents, card or list layouts, beautifully styled code blocks, tag pills, a newsletter box and a light/dark switch that remembers the reader's choice. Space Grotesk, Inter and JetBrains Mono are self-hosted.",
  "author": "Pursae",
  "author_url": "https://github.com/pursae",
  "theme_url": "https://github.com/pursae/pursae-dev/tree/main/web/theme-library/byte-notes",
  "tags": ["Blog", "Technology", "Dark", "Grid Layout", "Right Sidebar", "Custom Colors", "Custom Logo", "Custom Menu", "Editor Style", "Featured Images", "Sticky Post", "Threaded Comments", "Wide Blocks"],
  "requires_core": "0.1.0",
  "screenshot": "assets/screenshot.png",

  "category": "technology",
  "style": "Dark-first developer blog with code blocks",
  "demo": "demo/demo.json",

  "widget_areas": [
    {"id": "sidebar-1", "name": "Sidebar", "description": "Beside posts and archives when Customize › Byte Notes Layout › Sidebar is on."},
    {"id": "footer-1", "name": "Footer", "description": "Columns of widgets above the footer bar."}
  ],
  "menu_locations": [
    {"id": "primary", "name": "Primary Menu"},
    {"id": "footer", "name": "Footer Links"}
  ],

  "styles": [
    {"handle": "byte-notes-style", "src": "assets/style.css", "deps": ["wp-block-library"], "media": "all"}
  ],
  "scripts": [
    {"handle": "byte-notes-scheme", "src": "assets/js/scheme.js", "deps": [], "in_footer": false},
    {"handle": "byte-notes-ui", "src": "assets/js/ui.js", "deps": [], "in_footer": true}
  ],
  "editor_styles": ["assets/editor-style.css"],
  "preload_fonts": ["assets/fonts/inter.woff2", "assets/fonts/space-grotesk.woff2"],

  "palette": [
    {"name": "Violet", "slug": "violet", "color": "#7c5cff"},
    {"name": "Cyan", "slug": "cyan", "color": "#22d3ee"},
    {"name": "Pink", "slug": "pink", "color": "#f472b6"},
    {"name": "Lime", "slug": "lime", "color": "#a3e635"},
    {"name": "Night", "slug": "night", "color": "#0b0d1c"},
    {"name": "Panel", "slug": "panel", "color": "#151830"},
    {"name": "Fog", "slug": "fog", "color": "#a6adc8"},
    {"name": "Snow", "slug": "snow", "color": "#f5f6fb"}
  ],
  "supports": {
    "post-thumbnails": true,
    "custom-logo": {"width": 180, "height": 48, "flex-width": true, "flex-height": true, "header-text": ["site-title", "site-description"]},
    "title-tag": true,
    "html5": ["search-form", "comment-form", "comment-list", "gallery", "caption", "script", "style"],
    "responsive-embeds": true,
    "align-wide": true,
    "wp-block-styles": true
  },

  "customizer": {
    "sections": [
      {
        "id": "byte_notes_colors", "title": "Byte Notes Colors", "description": "Accent gradient and color scheme.", "priority": 40,
        "settings": [
          {"id": "accent", "label": "Accent color", "description": "Links, buttons, the gradient's first stop.", "type": "color", "default": "#7c5cff", "transport": "postMessage", "css_var": "--bn-accent"},
          {"id": "accent_2", "label": "Second accent", "description": "The gradient's second stop, category labels and highlights.", "type": "color", "default": "#22d3ee", "transport": "postMessage", "css_var": "--bn-accent-2"},
          {"id": "default_scheme", "label": "Default color scheme", "description": "What a first-time reader sees; the toggle stores each reader's own choice.", "type": "select", "default": "dark", "transport": "refresh", "css_var": "--bn-scheme", "body_class": "bn-default-{value}",
            "choices": [{"value": "dark", "label": "Dark"}, {"value": "light", "label": "Light"}, {"value": "system", "label": "Follow the reader's system"}]},
          {"id": "show_toggle", "label": "Show the light/dark toggle", "type": "checkbox", "default": true, "transport": "postMessage", "body_class": "bn-has-toggle"}
        ]
      },
      {
        "id": "byte_notes_layout", "title": "Byte Notes Layout", "description": "Post lists, fonts and header.", "priority": 41,
        "settings": [
          {"id": "post_layout", "label": "Post list layout", "type": "select", "default": "cards", "transport": "postMessage", "body_class": "bn-layout-{value}",
            "choices": [{"value": "cards", "label": "Card grid"}, {"value": "list", "label": "Compact list"}]},
          {"id": "font_pairing", "label": "Font pairing", "type": "select", "default": "grotesk", "transport": "postMessage", "body_class": "bn-font-{value}",
            "choices": [{"value": "grotesk", "label": "Space Grotesk + Inter"}, {"value": "mono", "label": "JetBrains Mono headings"}, {"value": "system", "label": "System UI"}]},
          {"id": "container_width", "label": "Container width", "type": "select", "default": "normal", "transport": "postMessage", "body_class": "bn-width-{value}",
            "choices": [{"value": "normal", "label": "Normal (1140px)"}, {"value": "wide", "label": "Wide (1320px)"}]},
          {"id": "show_sidebar", "label": "Sidebar on posts and archives", "type": "checkbox", "default": false, "transport": "refresh", "body_class": "bn-has-sidebar"},
          {"id": "show_thumbnails", "label": "Show featured images", "type": "checkbox", "default": true, "transport": "postMessage", "body_class": "bn-show-thumbs"},
          {"id": "show_author", "label": "Show author names", "type": "checkbox", "default": true, "transport": "postMessage", "body_class": "bn-show-author"},
          {"id": "sticky_header", "label": "Sticky header", "type": "checkbox", "default": true, "transport": "postMessage", "body_class": "bn-sticky-header"}
        ]
      },
      {
        "id": "byte_notes_home", "title": "Byte Notes Home Intro", "description": "The intro panel above the latest posts.", "priority": 42,
        "settings": [
          {"id": "hero_show", "label": "Show the intro panel", "type": "checkbox", "default": true, "transport": "postMessage", "body_class": "bn-hero-on"},
          {"id": "hero_kicker", "label": "Kicker", "type": "text", "default": "$ cat ./notes", "transport": "refresh"},
          {"id": "hero_title", "label": "Headline", "type": "text", "default": "Notes on building software that lasts.", "transport": "refresh"},
          {"id": "hero_text", "label": "Text", "type": "textarea", "default": "Practical write-ups on backends, databases, tooling and the web platform.", "transport": "refresh"},
          {"id": "hero_image", "label": "Intro background image", "description": "Shown behind the intro panel.", "type": "image", "transport": "refresh"}
        ]
      },
      {
        "id": "byte_notes_newsletter", "title": "Byte Notes Newsletter & Footer", "description": "The newsletter box under posts and lists, and the footer line.", "priority": 43,
        "settings": [
          {"id": "newsletter_show", "label": "Show the newsletter box", "type": "checkbox", "default": true, "transport": "postMessage", "body_class": "bn-newsletter-on"},
          {"id": "newsletter_heading", "label": "Heading", "type": "text", "default": "Get new notes by email", "transport": "refresh"},
          {"id": "newsletter_text", "label": "Text", "type": "textarea", "default": "One email when something new is published. No tracking, unsubscribe any time.", "transport": "refresh"},
          {"id": "newsletter_button", "label": "Button label", "type": "text", "default": "Subscribe", "transport": "refresh"},
          {"id": "newsletter_url", "label": "Button link", "description": "Your newsletter sign-up page, or the site feed.", "type": "text", "default": "/feed/", "transport": "refresh"},
          {"id": "footer_text", "label": "Footer text", "description": "Replaces the copyright line.", "type": "text", "default": "", "transport": "refresh"}
        ]
      }
    ]
  }
}
