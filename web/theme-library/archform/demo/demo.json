   "slug": "home",
   "title": "Quiet buildings, made to last",
   "content": "<!-- wp:paragraph {\"className\":\"statement\"} --><p class=\"statement\">We design buildings that are <em>quiet</em>, durable and generous with light: houses, libraries and workplaces made from few materials, carefully joined.</p><!-- /wp:paragraph -->\n\n<!-- wp:separator --><hr class=\"wp-block-separator has-alpha-channel-opacity\"/><!-- /wp:separator -->\n\n<!-- wp:group {\"anchor\":\"index\",\"align\":\"full\",\"layout\":{\"type\":\"constrained\"}} --><div id=\"index\" class=\"wp-block-group alignfull\"><!-- wp:paragraph {\"className\":\"kicker\"} --><p class=\"kicker\">Project index</p><!-- /wp:paragraph --><!-- wp:heading {\"className\":\"section-title\"} --><h2 class=\"wp-block-heading section-title\">Selected work, 2022–2026</h2><!-- /wp:heading --><!-- wp:table {\"className\":\"project-index\"} --><figure class=\"wp-block-table project-index\"><table><thead><tr><th>No.</th><th>Project</th><th>Type</th><th>Place</th><th>Year</th></tr></thead><tbody><tr><td>01</td><td>House on the Ridge</td><td>Residential</td><td>Westmere Hills</td><td>2026</td></tr><tr><td>02</td><td>Kiln Lane Library</td><td>Civic</td><td>Westmere</td><td>2025</td></tr><tr><td>03</td><td>Lakeside Pavilion</td><td>Landscape</td><td>Lake Orra</td><td>2025</td></tr><tr><td>04</td><td>Foundry Yard Studios</td><td>Workplace</td><td>Westmere</td><td>2024</td></tr><tr><td>05</td><td>Chapel of Light</td><td>Sacred</td><td>Eastvale</td><td>2023</td></tr><tr><td>06</td><td>Tower 9 Housing</td><td>Housing</td><td>Northbank</td><td>2022</td></tr></tbody></table></figure><!-- /wp:table --></div><!-- /wp:group -->\n\n<!-- wp:columns {\"align\":\"wide\",\"className\":\"duo\"} --><div class=\"wp-block-columns alignwide duo\"><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:image {\"id\":{{media_id:cantilever}},\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} --><figure class=\"wp-block-image size-large\"><img src=\"{{media:cantilever}}\" alt=\"House on the Ridge\" class=\"wp-image-{{media_id:cantilever}}\"/><figcaption class=\"wp-element-caption\">House on the Ridge <span>2026</span></figcaption></figure><!-- /wp:image --></div><!-- /wp:column --><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:image {\"id\":{{media_id:pavilion}},\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} --><figure class=\"wp-block-image size-large\"><img src=\"{{media:pavilion}}\" alt=\"Lakeside Pavilion\" class=\"wp-image-{{media_id:pavilion}}\"/><figcaption class=\"wp-element-caption\">Lakeside Pavilion <span>2025</span></figcaption></figure><!-- /wp:image --></div><!-- /wp:column --></div><!-- /wp:columns -->\n\n<!-- wp:image {\"id\":{{media_id:courtyard}},\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"align\":\"wide\",\"className\":\"wide-plate\"} --><figure class=\"wp-block-image alignwide size-large wide-plate\"><img src=\"{{media:courtyard}}\" alt=\"Light in the courtyard of the Chapel of Light\" class=\"wp-image-{{media_id:courtyard}}\"/><figcaption class=\"wp-element-caption\">Chapel of Light, courtyard <span>2023</span></figcaption></figure><!-- /wp:image -->\n\n<!-- wp:group {\"align\":\"full\",\"className\":\"section-ink\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group alignfull section-ink\"><!-- wp:columns {\"align\":\"wide\"} --><div class=\"wp-block-columns alignwide\"><!-- wp:column {\"width\":\"34%\"} --><div class=\"wp-block-column\" style=\"flex-basis:34%\"><!-- wp:paragraph {\"className\":\"kicker\"} --><p class=\"kicker\">Recognition</p><!-- /wp:paragraph --><!-- wp:heading {\"className\":\"section-title\"} --><h2 class=\"wp-block-heading section-title\">Awards</h2><!-- /wp:heading --></div><!-- /wp:column --><!-- wp:column {\"width\":\"66%\"} --><div class=\"wp-block-column\" style=\"flex-basis:66%\"><!-- wp:table {\"className\":\"awards is-style-left\"} --><figure class=\"wp-block-table awards is-style-left\"><table><thead><tr><th>Year</th><th>Award</th><th>Project</th></tr></thead><tbody><tr><td>2026</td><td>Regional Architecture Prize, Residential</td><td>House on the Ridge</td></tr><tr><td>2025</td><td>Civic Trust Award</td><td>Kiln Lane Library</td></tr><tr><td>2025</td><td>Concrete Society, Commendation</td><td>Lakeside Pavilion</td></tr><tr><td>2024</td><td>Young Practice of the Year, shortlist</td><td>Studio</td></tr><tr><td>2023</td><td>Sacred Spaces Award</td><td>Chapel of Light</td></tr></tbody></table></figure><!-- /wp:table --></div><!-- /wp:column --></div><!-- /wp:columns --></div><!-- /wp:group -->\n\n<!-- wp:group {\"align\":\"full\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group alignfull\"><!-- wp:paragraph {\"className\":\"kicker\"} --><p class=\"kicker\">Journal</p><!-- /wp:paragraph --><!-- wp:heading {\"className\":\"section-title\"} --><h2 class=\"wp-block-heading section-title\">Essays on making</h2><!-- /wp:heading --><!-- wp:latest-posts {\"postsToShow\":3,\"displayPostDate\":true,\"postLayout\":\"grid\",\"columns\":3,\"displayPostContent\":true,\"excerptLength\":22} /--></div><!-- /wp:group -->",
