   "slug": "projects",
   "title": "Projects",
   "content": "<!-- wp:paragraph {\"className\":\"statement\"} --><p class=\"statement\">Six recent works. Each began with a site visit at dawn and a list of what should <em>not</em> change.</p><!-- /wp:paragraph -->\n\n<!-- wp:table {\"className\":\"project-index\"} --><figure class=\"wp-block-table project-index\"><table><thead><tr><th>No.</th><th>Project</th><th>Type</th><th>Place</th><th>Year</th></tr></thead><tbody><tr><td>01</td><td>House on the Ridge</td><td>Residential</td><td>Westmere Hills</td><td>2026</td></tr><tr><td>02</td><td>Kiln Lane Library</td><td>Civic</td><td>Westmere</td><td>2025</td></tr><tr><td>03</td><td>Lakeside Pavilion</td><td>Landscape</td><td>Lake Orra</td><td>2025</td></tr><tr><td>04</td><td>Foundry Yard Studios</td><td>Workplace</td><td>Westmere</td><td>2024</td></tr><tr><td>05</td><td>Chapel of Light</td><td>Sacred</td><td>Eastvale</td><td>2023</td></tr><tr><td>06</td><td>Tower 9 Housing</td><td>Housing</td><td>Northbank</td><td>2022</td></tr></tbody></table></figure><!-- /wp:table -->\n\n<!-- wp:image {\"id\":{{media_id:hero}},\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"align\":\"wide\",\"className\":\"wide-plate\"} --><figure class=\"wp-block-image alignwide size-large wide-plate\"><img src=\"{{media:hero}}\" alt=\"House on the Ridge\" class=\"wp-image-{{media_id:hero}}\"/><figcaption class=\"wp-element-caption\">01 — House on the Ridge <span>Westmere Hills, 2026</span></figcaption></figure><!-- /wp:image -->\n\n<!-- wp:columns {\"align\":\"wide\",\"className\":\"duo\"} --><div class=\"wp-block-columns alignwide duo\"><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:image {\"id\":{{media_id:facade}},\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} --><figure class=\"wp-block-image size-large\"><img src=\"{{media:facade}}\" alt=\"Kiln Lane Library façade\" class=\"wp-image-{{media_id:facade}}\"/><figcaption class=\"wp-element-caption\">02 — Kiln Lane Library <span>2025</span></figcaption></figure><!-- /wp:image --></div><!-- /wp:column --><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:image {\"id\":{{media_id:stair}},\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} --><figure class=\"wp-block-image size-large\"><img src=\"{{media:stair}}\" alt=\"Foundry Yard Studios stair\" class=\"wp-image-{{media_id:stair}}\"/><figcaption class=\"wp-element-caption\">04 — Foundry Yard Studios <span>2024</span></figcaption></figure><!-- /wp:image --></div><!-- /wp:column --></div><!-- /wp:columns -->\n\n<!-- wp:columns {\"align\":\"wide\",\"className\":\"duo\"} --><div class=\"wp-block-columns alignwide duo\"><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:image {\"id\":{{media_id:arch}},\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} --><figure class=\"wp-block-image size-large\"><img src=\"{{media:arch}}\" alt=\"Chapel of Light entrance\" class=\"wp-image-{{media_id:arch}}\"/><figcaption class=\"wp-element-caption\">05 — Chapel of Light <span>2023</span></figcaption></figure><!-- /wp:image --></div><!-- /wp:column --><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:image {\"id\":{{media_id:tower}},\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} --><figure class=\"wp-block-image size-large\"><img src=\"{{media:tower}}\" alt=\"Tower 9 Housing\" class=\"wp-image-{{media_id:tower}}\"/><figcaption class=\"wp-element-caption\">06 — Tower 9 Housing <span>2022</span></figcaption></figure><!-- /wp:image --></div><!-- /wp:column --></div><!-- /wp:columns -->",
