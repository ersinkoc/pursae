{
  "slug": "atelier-nord",
  "name": "Atelier Nord",
  "version": "1.0.0",
  "description": "A Swiss-style portfolio for designers, architects and studios. A strict twelve-column grid, big grotesk type and a numbered project index; case studies are posts with a facts column, and a static front page presents selected work. Change the type scale, font pairing, work layout and the visible grid in the Customizer.",
  "author": "WordPress Go",
  "author_url": "https://github.com/boracomet/wordpress-go",
  "theme_url": "https://github.com/boracomet/wordpress-go/tree/main/web/theme-library/atelier-nord",
  "tags": ["Portfolio", "Grid Layout", "Two Columns", "Custom Colors", "Custom Logo", "Custom Menu", "Editor Style", "Featured Images", "Footer Widgets", "Threaded Comments", "Wide Blocks"],
  "requires_core": "0.1.0",
  "screenshot": "assets/screenshot.png",
  "category": "portfolio",
  "style": "Swiss grid, big grotesk type",
  "demo": "demo/demo.json",

  "widget_areas": [
    {"id": "footer-1", "name": "Footer", "description": "Columns of widgets above the footer line."}
  ],
  "menu_locations": [
    {"id": "primary", "name": "Primary Menu"},
    {"id": "footer", "name": "Footer Menu"}
  ],

  "styles": [
    {"handle": "atelier-nord-style", "src": "assets/style.css", "deps": ["wp-block-library"], "media": "all"}
  ],
  "scripts": [
    {"handle": "atelier-nord-navigation", "src": "assets/js/navigation.js", "deps": [], "in_footer": true}
  ],
  "editor_styles": ["assets/editor-style.css"],
  "preload_fonts": ["assets/fonts/inter-tight.woff2"],

  "palette": [
    {"name": "Signal Red", "slug": "signal-red", "color": "#e2231a"},
    {"name": "Ink", "slug": "ink", "color": "#111111"},
    {"name": "Concrete", "slug": "concrete", "color": "#8a877f"},
    {"name": "Paper", "slug": "paper", "color": "#f2f0eb"},
    {"name": "Cobalt", "slug": "cobalt", "color": "#1d4ed8"}
  ],
  "supports": {
    "post-thumbnails": true,
    "custom-logo": {"width": 160, "height": 40, "flex-width": true, "flex-height": true, "header-text": ["site-title", "site-description"]},
    "title-tag": true,
    "html5": ["search-form", "comment-form", "comment-list", "gallery", "caption", "script", "style"],
    "responsive-embeds": true,
    "align-wide": true,
    "wp-block-styles": true
  },

  "customizer": {
    "sections": [
      {
        "id": "atelier_type", "title": "Grid & Type", "description": "The typographic system of Atelier Nord.", "priority": 40,
        "settings": [
          {"id": "font_pairing", "label": "Font pairing", "type": "select", "default": "inter-plex", "transport": "postMessage", "body_class": "an-fonts-{value}",
            "choices": [{"value": "inter-plex", "label": "Inter Tight & Plex Mono"}, {"value": "archivo-plex", "label": "Archivo & Plex Mono"}, {"value": "system", "label": "System grotesk"}]},
          {"id": "type_scale", "label": "Type scale", "type": "select", "default": "display", "transport": "postMessage", "body_class": "an-scale-{value}",
            "choices": [{"value": "compact", "label": "Compact"}, {"value": "regular", "label": "Regular"}, {"value": "display", "label": "Display (largest)"}]},
          {"id": "show_grid", "label": "Show the column grid", "description": "Thin vertical lines that reveal the twelve-column grid.", "type": "checkbox", "default": true, "transport": "postMessage", "body_class": "an-show-grid"},
          {"id": "uppercase_nav", "label": "Uppercase labels", "description": "Menu, labels and meta in uppercase monospace.", "type": "checkbox", "default": true, "transport": "postMessage", "body_class": "an-caps"}
        ]
      },
      {
        "id": "atelier_colors", "title": "Colors", "priority": 41,
        "settings": [
          {"id": "accent", "label": "Accent color", "type": "color", "default": "#e2231a", "transport": "postMessage", "css_var": "--an-accent"},
          {"id": "paper", "label": "Background color", "type": "color", "default": "#f2f0eb", "transport": "postMessage", "css_var": "--an-paper"},
          {"id": "ink", "label": "Text color", "type": "color", "default": "#111111", "transport": "postMessage", "css_var": "--an-ink"}
        ]
      },
      {
        "id": "atelier_layout", "title": "Layout", "priority": 42,
        "settings": [
          {"id": "work_layout", "label": "Project list", "description": "How the blog, archives and search list projects.", "type": "select", "default": "index", "transport": "postMessage", "body_class": "an-work-{value}",
            "choices": [{"value": "index", "label": "Numbered index (hover to preview)"}, {"value": "grid", "label": "Grid of images"}, {"value": "mosaic", "label": "Mosaic, every third large"}]},
          {"id": "header_layout", "label": "Header", "type": "select", "default": "split", "transport": "postMessage", "body_class": "an-header-{value}",
            "choices": [{"value": "split", "label": "Name left, menu right"}, {"value": "stacked", "label": "Large name, menu below"}]},
          {"id": "sticky_header", "label": "Sticky header", "type": "checkbox", "default": false, "transport": "postMessage", "body_class": "an-sticky"},
          {"id": "show_author", "label": "Show the author on case studies", "type": "checkbox", "default": false, "transport": "postMessage", "body_class": "an-show-author"},
          {"id": "hero_heading", "label": "Front page statement", "description": "The large statement at the top of a static front page.", "type": "textarea", "default": "We design identities, books and places that are clear, useful and built to last.", "transport": "refresh"},
          {"id": "hero_image", "label": "Front page image", "description": "Shown under the statement. Falls back to the front page's featured image.", "type": "image", "transport": "refresh"},
          {"id": "footer_text", "label": "Footer text", "type": "text", "default": "", "transport": "refresh"}
        ]
      }
    ]
  }
}
