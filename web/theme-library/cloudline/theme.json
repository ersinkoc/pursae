{
  "slug": "cloudline",
  "name": "Cloudline",
  "version": "1.0.0",
  "description": "A crisp, trustworthy theme for managed IT and cloud service companies: a live status bar, a split hero with an uptime badge, service tiers, SLA figures, case studies and a security advisories blog with severity flags. Red Hat Display and Red Hat Text are self-hosted.",
  "author": "Pursae",
  "author_url": "https://github.com/pursae",
  "theme_url": "https://github.com/pursae/pursae-dev/tree/main/web/theme-library/cloudline",
  "tags": [
    "Technology",
    "Business",
    "IT Services",
    "Right Sidebar",
    "Left Sidebar",
    "Custom Colors",
    "Custom Logo",
    "Custom Menu",
    "Editor Style",
    "Featured Images",
    "Full Width Template",
    "Sticky Post",
    "Threaded Comments",
    "Wide Blocks"
  ],
  "requires_core": "0.1.0",
  "screenshot": "assets/screenshot.png",
  "category": "technology",
  "style": "Crisp blue IT services site with SLA figures and advisories",
  "demo": "demo/demo.json",
  "widget_areas": [
    {
      "id": "sidebar-1",
      "name": "Sidebar",
      "description": "Beside posts and archives; Customize › Cloudline Layout chooses the side."
    },
    {
      "id": "footer-1",
      "name": "Footer",
      "description": "Columns of widgets in the footer."
    }
  ],
  "menu_locations": [
    {
      "id": "primary",
      "name": "Primary Menu"
    },
    {
      "id": "footer",
      "name": "Footer Links"
    }
  ],
  "styles": [
    {
      "handle": "cloudline-style",
      "src": "assets/style.css",
      "deps": [
        "wp-block-library"
      ],
      "media": "all"
    }
  ],
  "scripts": [
    {
      "handle": "cloudline-navigation",
      "src": "assets/js/navigation.js",
      "deps": [],
      "in_footer": true
    }
  ],
  "editor_styles": [
    "assets/editor-style.css"
  ],
  "preload_fonts": [
    "assets/fonts/red-hat-display.woff2",
    "assets/fonts/red-hat-text.woff2"
  ],
  "palette": [
    {
      "name": "Signal Blue",
      "slug": "signal",
      "color": "#1662f3"
    },
    {
      "name": "Deep Navy",
      "slug": "navy",
      "color": "#0a1f44"
    },
    {
      "name": "Sky",
      "slug": "sky",
      "color": "#e8f0ff"
    },
    {
      "name": "Mint",
      "slug": "mint",
      "color": "#12b981"
    },
    {
      "name": "Alert",
      "slug": "alert",
      "color": "#e5484d"
    },
    {
      "name": "Steel",
      "slug": "steel",
      "color": "#51607a"
    },
    {
      "name": "White",
      "slug": "white",
      "color": "#ffffff"
    }
  ],
  "supports": {
    "post-thumbnails": true,
    "custom-logo": {
      "width": 200,
      "height": 48,
      "flex-width": true,
      "flex-height": true,
      "header-text": [
        "site-title",
        "site-description"
      ]
    },
    "title-tag": true,
    "html5": [
      "search-form",
      "comment-form",
      "comment-list",
      "gallery",
      "caption",
      "script",
      "style"
    ],
    "responsive-embeds": true,
    "align-wide": true,
    "wp-block-styles": true
  },
  "customizer": {
    "sections": [
      {
        "id": "cloudline_brand",
        "title": "Cloudline Brand",
        "priority": 40,
        "settings": [
          {
            "id": "primary",
            "label": "Primary blue",
            "type": "color",
            "default": "#1662f3",
            "transport": "postMessage",
            "css_var": "--cl-primary",
            "description": "Buttons, links, icons and the blue header."
          },
          {
            "id": "navy",
            "label": "Deep navy",
            "type": "color",
            "default": "#0a1f44",
            "transport": "postMessage",
            "css_var": "--cl-navy",
            "description": "Headings, the footer and dark sections."
          },
          {
            "id": "tint",
            "label": "Section tint",
            "type": "color",
            "default": "#eef3fc",
            "transport": "postMessage",
            "css_var": "--cl-tint",
            "description": "Background of alternating sections and cards."
          },
          {
            "id": "header_style",
            "label": "Header style",
            "type": "select",
            "default": "light",
            "transport": "postMessage",
            "body_class": "cl-header-{value}",
            "choices": [
              {
                "value": "light",
                "label": "White"
              },
              {
                "value": "blue",
                "label": "Primary blue"
              },
              {
                "value": "navy",
                "label": "Deep navy"
              }
            ]
          },
          {
            "id": "corners",
            "label": "Corner style",
            "type": "select",
            "default": "rounded",
            "transport": "postMessage",
            "body_class": "cl-corners-{value}",
            "choices": [
              {
                "value": "rounded",
                "label": "Rounded"
              },
              {
                "value": "square",
                "label": "Square"
              }
            ]
          },
          {
            "id": "font_pairing",
            "label": "Font pairing",
            "type": "select",
            "default": "redhat",
            "transport": "postMessage",
            "body_class": "cl-font-{value}",
            "choices": [
              {
                "value": "redhat",
                "label": "Red Hat Display + Red Hat Text"
              },
              {
                "value": "display",
                "label": "Red Hat Display throughout"
              },
              {
                "value": "system",
                "label": "System UI"
              }
            ]
          }
        ]
      },
      {
        "id": "cloudline_layout",
        "title": "Cloudline Layout",
        "priority": 41,
        "settings": [
          {
            "id": "sidebar",
            "label": "Sidebar",
            "type": "select",
            "default": "right",
            "transport": "refresh",
            "body_class": "cl-sidebar-{value}",
            "choices": [
              {
                "value": "right",
                "label": "Right"
              },
              {
                "value": "left",
                "label": "Left"
              },
              {
                "value": "none",
                "label": "No sidebar"
              }
            ]
          },
          {
            "id": "post_layout",
            "label": "Post list layout",
            "type": "select",
            "default": "cards",
            "transport": "postMessage",
            "body_class": "cl-list-{value}",
            "choices": [
              {
                "value": "cards",
                "label": "Cards"
              },
              {
                "value": "rows",
                "label": "Rows"
              }
            ]
          },
          {
            "id": "show_thumbnails",
            "label": "Show featured images",
            "type": "checkbox",
            "default": true,
            "transport": "postMessage",
            "body_class": "cl-thumbs"
          },
          {
            "id": "show_author",
            "label": "Show author names",
            "type": "checkbox",
            "default": true,
            "transport": "postMessage",
            "body_class": "cl-show-author"
          },
          {
            "id": "sticky_header",
            "label": "Sticky header",
            "type": "checkbox",
            "default": true,
            "transport": "postMessage",
            "body_class": "cl-sticky"
          }
        ]
      },
      {
        "id": "cloudline_header",
        "title": "Cloudline Status & Hero",
        "priority": 42,
        "settings": [
          {
            "id": "status_show",
            "label": "Show the status bar",
            "type": "checkbox",
            "default": true,
            "transport": "refresh",
            "body_class": "cl-status"
          },
          {
            "id": "status_text",
            "label": "Status message",
            "type": "text",
            "default": "All systems operational",
            "transport": "refresh"
          },
          {
            "id": "status_phone",
            "label": "Support phone",
            "type": "text",
            "default": "+1 555 010 4400",
            "transport": "refresh"
          },
          {
            "id": "cta_label",
            "label": "Header button label",
            "type": "text",
            "default": "Get support",
            "transport": "refresh"
          },
          {
            "id": "cta_url",
            "label": "Header button link",
            "type": "text",
            "default": "/",
            "transport": "refresh"
          },
          {
            "id": "hero_kicker",
            "label": "Hero kicker",
            "type": "text",
            "default": "Managed IT & cloud",
            "transport": "refresh"
          },
          {
            "id": "hero_heading",
            "label": "Hero heading",
            "type": "text",
            "default": "",
            "transport": "refresh",
            "description": "Empty uses the front page's title."
          },
          {
            "id": "hero_text",
            "label": "Hero text",
            "type": "textarea",
            "default": "We run your infrastructure so your team can run the business.",
            "transport": "refresh"
          },
          {
            "id": "hero_button_label",
            "label": "Hero button label",
            "type": "text",
            "default": "See our plans",
            "transport": "refresh"
          },
          {
            "id": "hero_button_url",
            "label": "Hero button link",
            "type": "text",
            "default": "#plans",
            "transport": "refresh"
          },
          {
            "id": "uptime_figure",
            "label": "Uptime badge",
            "type": "text",
            "default": "99.98%",
            "transport": "refresh",
            "description": "Shown on the hero image; empty hides the badge."
          },
          {
            "id": "hero_image",
            "label": "Hero image",
            "type": "image",
            "transport": "refresh",
            "description": "Empty uses the front page's featured image."
          },
          {
            "id": "footer_text",
            "label": "Footer text",
            "type": "text",
            "default": "",
            "transport": "refresh",
            "description": "Replaces the copyright line."
          }
        ]
      }
    ]
  }
}
