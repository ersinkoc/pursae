{
  "slug": "datafield",
  "name": "Datafield",
  "version": "1.0.0",
  "description": "A research notebook for data science writing: a paper-white page with gridlines, a serif reading face, mono labels, numbered figure captions, footnotes, data tables and notebook-style code cells, with series colors you pick in the Customizer. Newsreader, Source Sans 3 and Spline Sans Mono are self-hosted.",
  "author": "WordPress Go",
  "author_url": "https://github.com/boracomet/wordpress-go",
  "theme_url": "https://github.com/boracomet/wordpress-go/tree/main/web/theme-library/datafield",
  "tags": [
    "Blog",
    "Science",
    "Data",
    "One Column",
    "Right Sidebar",
    "Custom Colors",
    "Custom Logo",
    "Custom Menu",
    "Editor Style",
    "Featured Images",
    "Footer Widgets",
    "Sticky Post",
    "Threaded Comments",
    "Wide Blocks"
  ],
  "requires_core": "0.1.0",
  "screenshot": "assets/screenshot.png",
  "category": "science",
  "style": "Chart-inspired research notebook with figures and footnotes",
  "demo": "demo/demo.json",
  "widget_areas": [
    {
      "id": "sidebar-1",
      "name": "Sidebar",
      "description": "Beside posts and archives when Customize › Datafield Reading › Sidebar is on."
    },
    {
      "id": "footer-1",
      "name": "Footer",
      "description": "Columns of widgets in the footer."
    }
  ],
  "menu_locations": [
    {
      "id": "primary",
      "name": "Primary Menu"
    },
    {
      "id": "footer",
      "name": "Footer Links"
    }
  ],
  "styles": [
    {
      "handle": "datafield-style",
      "src": "assets/style.css",
      "deps": [
        "wp-block-library"
      ],
      "media": "all"
    }
  ],
  "scripts": [
    {
      "handle": "datafield-navigation",
      "src": "assets/js/navigation.js",
      "deps": [],
      "in_footer": true
    }
  ],
  "editor_styles": [
    "assets/editor-style.css"
  ],
  "preload_fonts": [
    "assets/fonts/newsreader.woff2",
    "assets/fonts/spline-sans-mono.woff2"
  ],
  "palette": [
    {
      "name": "Series Blue",
      "slug": "series-blue",
      "color": "#2b6cb0"
    },
    {
      "name": "Series Orange",
      "slug": "series-orange",
      "color": "#dd6b20"
    },
    {
      "name": "Series Teal",
      "slug": "series-teal",
      "color": "#2c7a7b"
    },
    {
      "name": "Series Plum",
      "slug": "series-plum",
      "color": "#805ad5"
    },
    {
      "name": "Ink",
      "slug": "ink",
      "color": "#1b1f24"
    },
    {
      "name": "Graphite",
      "slug": "graphite",
      "color": "#59606b"
    },
    {
      "name": "Grid",
      "slug": "grid",
      "color": "#e4e1d8"
    },
    {
      "name": "Paper",
      "slug": "paper",
      "color": "#fbfaf6"
    }
  ],
  "supports": {
    "post-thumbnails": true,
    "custom-logo": {
      "width": 200,
      "height": 48,
      "flex-width": true,
      "flex-height": true,
      "header-text": [
        "site-title",
        "site-description"
      ]
    },
    "title-tag": true,
    "html5": [
      "search-form",
      "comment-form",
      "comment-list",
      "gallery",
      "caption",
      "script",
      "style"
    ],
    "responsive-embeds": true,
    "align-wide": true,
    "wp-block-styles": true
  },
  "customizer": {
    "sections": [
      {
        "id": "datafield_colors",
        "title": "Datafield Colors",
        "priority": 40,
        "settings": [
          {
            "id": "series_1",
            "label": "Series color 1",
            "type": "color",
            "default": "#2b6cb0",
            "transport": "postMessage",
            "css_var": "--df-s1",
            "description": "Links, the first chart series and figure labels."
          },
          {
            "id": "series_2",
            "label": "Series color 2",
            "type": "color",
            "default": "#dd6b20",
            "transport": "postMessage",
            "css_var": "--df-s2",
            "description": "Highlights, the second chart series and footnote markers."
          },
          {
            "id": "series_3",
            "label": "Series color 3",
            "type": "color",
            "default": "#2c7a7b",
            "transport": "postMessage",
            "css_var": "--df-s3",
            "description": "Category keys and the third series."
          },
          {
            "id": "paper",
            "label": "Paper",
            "type": "color",
            "default": "#fbfaf6",
            "transport": "postMessage",
            "css_var": "--df-paper",
            "description": "The page background."
          },
          {
            "id": "ink",
            "label": "Ink",
            "type": "color",
            "default": "#1b1f24",
            "transport": "postMessage",
            "css_var": "--df-ink",
            "description": "Text and rules."
          },
          {
            "id": "gridlines",
            "label": "Graph-paper gridlines",
            "type": "checkbox",
            "default": true,
            "transport": "postMessage",
            "body_class": "df-grid",
            "description": "A faint grid behind the header and intro."
          }
        ]
      },
      {
        "id": "datafield_reading",
        "title": "Datafield Reading",
        "priority": 41,
        "settings": [
          {
            "id": "font_pairing",
            "label": "Font pairing",
            "type": "select",
            "default": "newsreader",
            "transport": "postMessage",
            "body_class": "df-font-{value}",
            "choices": [
              {
                "value": "newsreader",
                "label": "Newsreader serif + mono labels"
              },
              {
                "value": "sans",
                "label": "Source Sans 3 + mono labels"
              },
              {
                "value": "system",
                "label": "System fonts"
              }
            ]
          },
          {
            "id": "list_layout",
            "label": "Post list layout",
            "type": "select",
            "default": "index",
            "transport": "postMessage",
            "body_class": "df-list-{value}",
            "choices": [
              {
                "value": "index",
                "label": "Index table"
              },
              {
                "value": "cards",
                "label": "Figure cards"
              }
            ]
          },
          {
            "id": "measure",
            "label": "Text width",
            "type": "select",
            "default": "narrow",
            "transport": "postMessage",
            "body_class": "df-measure-{value}",
            "choices": [
              {
                "value": "narrow",
                "label": "Narrow (68ch)"
              },
              {
                "value": "wide",
                "label": "Wide (80ch)"
              }
            ]
          },
          {
            "id": "sidebar",
            "label": "Sidebar",
            "type": "select",
            "default": "none",
            "transport": "refresh",
            "body_class": "df-sidebar-{value}",
            "choices": [
              {
                "value": "right",
                "label": "Right"
              },
              {
                "value": "left",
                "label": "Left"
              },
              {
                "value": "none",
                "label": "No sidebar"
              }
            ]
          },
          {
            "id": "figure_numbers",
            "label": "Number figure captions",
            "type": "checkbox",
            "default": true,
            "transport": "postMessage",
            "body_class": "df-fig-numbers",
            "description": "Captions read “Figure 1”, “Figure 2” …"
          },
          {
            "id": "show_thumbnails",
            "label": "Show featured images",
            "type": "checkbox",
            "default": true,
            "transport": "postMessage",
            "body_class": "df-thumbs"
          },
          {
            "id": "show_author",
            "label": "Show author names",
            "type": "checkbox",
            "default": true,
            "transport": "postMessage",
            "body_class": "df-show-author"
          }
        ]
      },
      {
        "id": "datafield_intro",
        "title": "Datafield Intro & Footer",
        "priority": 42,
        "settings": [
          {
            "id": "intro_show",
            "label": "Show the intro on the home page",
            "type": "checkbox",
            "default": true,
            "transport": "refresh",
            "body_class": "df-intro"
          },
          {
            "id": "intro_kicker",
            "label": "Intro label",
            "type": "text",
            "default": "Working notes · est. 2021",
            "transport": "refresh"
          },
          {
            "id": "intro_title",
            "label": "Intro heading",
            "type": "text",
            "default": "Careful notes on data, models and the questions behind them.",
            "transport": "refresh"
          },
          {
            "id": "intro_text",
            "label": "Intro text",
            "type": "textarea",
            "default": "Essays, reproducible notebooks and multi-part series on statistics, machine learning and measurement.",
            "transport": "refresh"
          },
          {
            "id": "footer_text",
            "label": "Footer text",
            "type": "text",
            "default": "",
            "transport": "refresh",
            "description": "Replaces the copyright and license line."
          }
        ]
      }
    ]
  }
}
