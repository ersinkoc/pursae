{
  "slug": "petal-and-stem",
  "name": "Petal & Stem",
  "version": "1.0.0",
  "description": "A fresh florist and flower studio theme: peony pink and moss green on ivory, Instrument Serif italics with Hanken Grotesk, hand-drawn botanical illustrations, an arched hero photo, a bouquet catalogue with prices and order buttons, wedding and event pages and care-guide posts with numbered care steps.",
  "author": "Pursae",
  "author_url": "https://github.com/pursae",
  "theme_url": "https://github.com/pursae/pursae-dev/tree/main/web/theme-library/petal-and-stem",
  "tags": [
    "Shop",
    "Business",
    "Blog",
    "Wedding",
    "Grid Layout",
    "Custom Colors",
    "Custom Logo",
    "Custom Menu",
    "Editor Style",
    "Featured Images",
    "Footer Widgets",
    "Full Width Template",
    "Threaded Comments"
  ],
  "requires_core": "0.1.0",
  "screenshot": "assets/screenshot.png",
  "category": "shop",
  "style": "Botanical florist with bouquet catalogue, peony and moss",
  "demo": "demo/demo.json",
  "widget_areas": [
    {
      "id": "sidebar-1",
      "name": "Sidebar",
      "description": "Beside the journal when a sidebar is chosen."
    },
    {
      "id": "footer-1",
      "name": "Footer",
      "description": "Columns in the moss footer."
    }
  ],
  "menu_locations": [
    {
      "id": "primary",
      "name": "Primary Menu"
    },
    {
      "id": "social",
      "name": "Social Links"
    }
  ],
  "styles": [
    {
      "handle": "petal-and-stem-style",
      "src": "assets/style.css",
      "deps": [
        "wp-block-library"
      ],
      "media": "all"
    }
  ],
  "scripts": [
    {
      "handle": "petal-and-stem-navigation",
      "src": "assets/js/navigation.js",
      "deps": [],
      "in_footer": true
    }
  ],
  "editor_styles": [
    "assets/editor-style.css"
  ],
  "preload_fonts": [
    "assets/fonts/hanken-grotesk.woff2",
    "assets/fonts/instrument-serif-italic.woff2"
  ],
  "palette": [
    {
      "name": "Peony",
      "slug": "peony",
      "color": "#b8475f"
    },
    {
      "name": "Moss",
      "slug": "moss",
      "color": "#2f4a35"
    },
    {
      "name": "Sage",
      "slug": "sage",
      "color": "#c9d5c0"
    },
    {
      "name": "Blush",
      "slug": "blush",
      "color": "#f4d9d6"
    },
    {
      "name": "Butter",
      "slug": "butter",
      "color": "#e3b04b"
    },
    {
      "name": "Ivory",
      "slug": "ivory",
      "color": "#fbf8f2"
    }
  ],
  "supports": {
    "post-thumbnails": true,
    "custom-logo": {
      "width": 240,
      "height": 80,
      "flex-width": true,
      "flex-height": true,
      "header-text": [
        "site-title",
        "site-description"
      ]
    },
    "title-tag": true,
    "html5": [
      "search-form",
      "comment-form",
      "comment-list",
      "gallery",
      "caption",
      "script",
      "style"
    ],
    "responsive-embeds": true,
    "align-wide": true,
    "wp-block-styles": true
  },
  "customizer": {
    "sections": [
      {
        "id": "ps_colors",
        "title": "Colors & Type",
        "priority": 40,
        "settings": [
          {
            "id": "accent_color",
            "label": "Peony",
            "type": "color",
            "default": "#b8475f",
            "transport": "postMessage",
            "css_var": "--accent",
            "description": "Links, buttons and prices."
          },
          {
            "id": "moss_color",
            "label": "Moss",
            "type": "color",
            "default": "#2f4a35",
            "transport": "postMessage",
            "css_var": "--moss",
            "description": "The announcement bar, header button, bands and footer."
          },
          {
            "id": "background_color",
            "label": "Background",
            "type": "color",
            "default": "#fbf8f2",
            "transport": "postMessage",
            "css_var": "--bg"
          },
          {
            "id": "text_color",
            "label": "Text",
            "type": "color",
            "default": "#24302a",
            "transport": "postMessage",
            "css_var": "--text"
          },
          {
            "id": "font_pairing",
            "label": "Typefaces",
            "type": "select",
            "default": "serif",
            "transport": "postMessage",
            "body_class": "ps-font-{value}",
            "choices": [
              {
                "value": "serif",
                "label": "Instrument Serif with Hanken Grotesk"
              },
              {
                "value": "sans",
                "label": "Hanken Grotesk light"
              },
              {
                "value": "system",
                "label": "System fonts"
              }
            ]
          }
        ]
      },
      {
        "id": "ps_layout",
        "title": "Layout",
        "priority": 41,
        "settings": [
          {
            "id": "header_style",
            "label": "Header",
            "type": "select",
            "default": "inline",
            "transport": "postMessage",
            "body_class": "ps-header-{value}",
            "choices": [
              {
                "value": "inline",
                "label": "Name, menu and button on one line"
              },
              {
                "value": "stacked",
                "label": "Large centered name"
              }
            ]
          },
          {
            "id": "catalogue_columns",
            "label": "Bouquets per row",
            "type": "select",
            "default": "3",
            "transport": "postMessage",
            "body_class": "ps-cols-{value}",
            "choices": [
              {
                "value": "2",
                "label": "Two"
              },
              {
                "value": "3",
                "label": "Three"
              },
              {
                "value": "4",
                "label": "Four"
              }
            ],
            "description": "On the bouquet catalogue."
          },
          {
            "id": "blog_layout",
            "label": "Journal layout",
            "type": "select",
            "default": "grid",
            "transport": "postMessage",
            "body_class": "ps-layout-{value}",
            "choices": [
              {
                "value": "grid",
                "label": "Grid"
              },
              {
                "value": "list",
                "label": "List with round photos"
              }
            ]
          },
          {
            "id": "sidebar",
            "label": "Sidebar",
            "type": "select",
            "default": "none",
            "transport": "postMessage",
            "body_class": "ps-sidebar-{value}",
            "choices": [
              {
                "value": "none",
                "label": "No sidebar"
              },
              {
                "value": "right",
                "label": "Right"
              },
              {
                "value": "left",
                "label": "Left"
              }
            ]
          },
          {
            "id": "show_ornaments",
            "label": "Show botanical illustrations",
            "type": "checkbox",
            "default": true,
            "transport": "postMessage",
            "body_class": "ps-ornaments"
          },
          {
            "id": "show_featured",
            "label": "Show featured images",
            "type": "checkbox",
            "default": true,
            "transport": "postMessage",
            "body_class": "ps-thumbs"
          },
          {
            "id": "show_author",
            "label": "Show the author",
            "type": "checkbox",
            "default": false,
            "transport": "postMessage",
            "body_class": "ps-author"
          }
        ]
      },
      {
        "id": "ps_shop",
        "title": "Shop Details",
        "priority": 42,
        "settings": [
          {
            "id": "announcement",
            "label": "Announcement bar",
            "type": "text",
            "default": "",
            "transport": "refresh",
            "description": "A line above the header. Empty hides the bar."
          },
          {
            "id": "cta_label",
            "label": "Order button label",
            "type": "text",
            "default": "Order flowers",
            "transport": "refresh",
            "description": "In the header and the front page hero. Empty hides it."
          },
          {
            "id": "cta_url",
            "label": "Order button link",
            "type": "text",
            "default": "/bouquets/",
            "transport": "refresh"
          },
          {
            "id": "hero_image",
            "label": "Hero photo",
            "type": "image",
            "description": "The arched photo on a static front page. Empty uses the page's featured image."
          },
          {
            "id": "footer_text",
            "label": "Footer text",
            "type": "text",
            "default": "",
            "transport": "refresh",
            "description": "Replaces the copyright line."
          }
        ]
      }
    ]
  }
}
