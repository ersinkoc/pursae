  {
   "slug": "home",
   "title": "Home",
   "content": "<!-- wp:group {\"align\":\"full\",\"className\":\"cc-section\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group alignfull cc-section\"><!-- wp:paragraph {\"className\":\"cc-eyebrow\"} --><p class=\"cc-eyebrow\">Popular this term</p><!-- /wp:paragraph --><!-- wp:heading --><h2 class=\"wp-block-heading\">Courses starting soon</h2><!-- /wp:heading --><!-- wp:columns {\"align\":\"wide\",\"className\":\"cc-courses\"} --><div class=\"wp-block-columns alignwide cc-courses\"><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Introduction to Botany</h3><!-- /wp:heading --><!-- wp:paragraph --><p>Plants, soil and the science of growing things.</p><!-- /wp:paragraph --><!-- wp:paragraph {\"className\":\"cc-meta\"} --><p class=\"cc-meta\">Thursdays · 10 weeks · On campus</p><!-- /wp:paragraph --></div><!-- /wp:column --><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Conversational Portuguese</h3><!-- /wp:heading --><!-- wp:paragraph --><p>Real conversations from the very first class.</p><!-- /wp:paragraph --><!-- wp:paragraph {\"className\":\"cc-meta\"} --><p class=\"cc-meta\">Tue & Thu evenings · Online</p><!-- /wp:paragraph --></div><!-- /wp:column --><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Watercolour Foundations</h3><!-- /wp:heading --><!-- wp:paragraph --><p>Washes, colour mixing and painting outdoors.</p><!-- /wp:paragraph --><!-- wp:paragraph {\"className\":\"cc-meta\"} --><p class=\"cc-meta\">Saturdays · 8 weeks · Studio</p><!-- /wp:paragraph --></div><!-- /wp:column --><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Data Skills for Everyday Life</h3><!-- /wp:heading --><!-- wp:paragraph --><p>Spreadsheets, charts and clear thinking.</p><!-- /wp:paragraph --><!-- wp:paragraph {\"className\":\"cc-meta\"} --><p class=\"cc-meta\">Self-paced · Online</p><!-- /wp:paragraph --></div><!-- /wp:column --></div><!-- /wp:columns --><!-- wp:buttons --><div class=\"wp-block-buttons\"><!-- wp:button --><div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"{{page:courses}}\">Browse all courses</a></div><!-- /wp:button --></div><!-- /wp:buttons --></div><!-- /wp:group --><!-- wp:group {\"align\":\"full\",\"className\":\"cc-section cc-section--navy\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group alignfull cc-section cc-section--navy\"><!-- wp:columns {\"align\":\"wide\",\"className\":\"cc-numbers\"} --><div class=\"wp-block-columns alignwide cc-numbers\"><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:paragraph {\"className\":\"cc-big\"} --><p class=\"cc-big\">42</p><!-- /wp:paragraph --><!-- wp:paragraph --><p>courses this term</p><!-- /wp:paragraph --></div><!-- /wp:column --><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:paragraph {\"className\":\"cc-big\"} --><p class=\"cc-big\">1,800</p><!-- /wp:paragraph --><!-- wp:paragraph --><p>students of every age</p><!-- /wp:paragraph --></div><!-- /wp:column --><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:paragraph {\"className\":\"cc-big\"} --><p class=\"cc-big\">36</p><!-- /wp:paragraph --><!-- wp:paragraph --><p>teachers and tutors</p><!-- /wp:paragraph --></div><!-- /wp:column --><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:paragraph {\"className\":\"cc-big\"} --><p class=\"cc-big\">1974</p><!-- /wp:paragraph --><!-- wp:paragraph --><p>year we opened</p><!-- /wp:paragraph --></div><!-- /wp:column --></div><!-- /wp:columns --></div><!-- /wp:group --><!-- wp:group {\"align\":\"full\",\"className\":\"cc-section cc-section--sky\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group alignfull cc-section cc-section--sky\"><!-- wp:paragraph {\"className\":\"cc-eyebrow\"} --><p class=\"cc-eyebrow\">Around the commons</p><!-- /wp:paragraph --><!-- wp:heading --><h2 class=\"wp-block-heading\">News & announcements</h2><!-- /wp:heading --><!-- wp:latest-posts {\"postsToShow\":3,\"displayPostContent\":true,\"excerptLength\":18,\"displayPostDate\":true,\"postLayout\":\"grid\",\"columns\":3} /--><!-- wp:buttons --><div class=\"wp-block-buttons\"><!-- wp:button {\"className\":\"is-style-outline\"} --><div class=\"wp-block-button is-style-outline\"><a class=\"wp-block-button__link wp-element-button\" href=\"{{page:news}}\">All news</a></div><!-- /wp:button --></div><!-- /wp:buttons --></div><!-- /wp:group --><!-- wp:group {\"align\":\"full\",\"className\":\"cc-section\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group alignfull cc-section\"><!-- wp:paragraph {\"className\":\"cc-eyebrow\"} --><p class=\"cc-eyebrow\">The people who teach</p><!-- /wp:paragraph --><!-- wp:heading --><h2 class=\"wp-block-heading\">Meet the faculty</h2><!-- /wp:heading --><!-- wp:columns {\"align\":\"wide\",\"className\":\"cc-faculty\"} --><div class=\"wp-block-columns alignwide cc-faculty\"><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:image {\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} --><figure class=\"wp-block-image size-large\"><img src=\"{{media:teacher-1}}\" alt=\"Abstract portrait illustration of Hana Brightwater\"/></figure><!-- /wp:image --><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Hana Brightwater</h3><!-- /wp:heading --><!-- wp:paragraph --><p>Botany & Biology</p><!-- /wp:paragraph --></div><!-- /wp:column --><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:image {\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} --><figure class=\"wp-block-image size-large\"><img src=\"{{media:teacher-2}}\" alt=\"Abstract portrait illustration of Tomas Ferreira\"/></figure><!-- /wp:image --><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Tomas Ferreira</h3><!-- /wp:heading --><!-- wp:paragraph --><p>Languages</p><!-- /wp:paragraph --></div><!-- /wp:column --><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:image {\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} --><figure class=\"wp-block-image size-large\"><img src=\"{{media:teacher-3}}\" alt=\"Abstract portrait illustration of Robin Ashby\"/></figure><!-- /wp:image --><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Robin Ashby</h3><!-- /wp:heading --><!-- wp:paragraph --><p>Woodwork & Design</p><!-- /wp:paragraph --></div><!-- /wp:column --><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:image {\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} --><figure class=\"wp-block-image size-large\"><img src=\"{{media:teacher-4}}\" alt=\"Abstract portrait illustration of Grace Okonjo\"/></figure><!-- /wp:image --><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Grace Okonjo</h3><!-- /wp:heading --><!-- wp:paragraph --><p>Mathematics</p><!-- /wp:paragraph --></div><!-- /wp:column --></div><!-- /wp:columns --><!-- wp:buttons {\"layout\":{\"type\":\"flex\",\"justifyContent\":\"center\"}} --><div class=\"wp-block-buttons is-content-justification-center\"><!-- wp:button {\"className\":\"is-style-outline\"} --><div class=\"wp-block-button is-style-outline\"><a class=\"wp-block-button__link wp-element-button\" href=\"{{page:faculty}}\">All faculty</a></div><!-- /wp:button --></div><!-- /wp:buttons --></div><!-- /wp:group --><!-- wp:group {\"align\":\"full\",\"className\":\"cc-section cc-section--sky\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group alignfull cc-section cc-section--sky\"><!-- wp:media-text {\"mediaType\":\"image\",\"className\":\"alignwide\"} --><div class=\"wp-block-media-text is-stacked-on-mobile alignwide\"><figure class=\"wp-block-media-text__media\"><img src=\"{{media:campus}}\" alt=\"The campus lawn and main building\" class=\"size-full\"/></figure><div class=\"wp-block-media-text__content\"><!-- wp:paragraph {\"className\":\"cc-eyebrow\"} --><p class=\"cc-eyebrow\">Visit us</p><!-- /wp:paragraph --><!-- wp:heading --><h2 class=\"wp-block-heading\">Open evening on 14 November</h2><!-- /wp:heading --><!-- wp:paragraph --><p>Tour the classrooms, try a taster class and meet the teachers. Everyone is welcome.</p><!-- /wp:paragraph --><!-- wp:buttons --><div class=\"wp-block-buttons\"><!-- wp:button --><div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"{{page:events}}\">See all events</a></div><!-- /wp:button --></div><!-- /wp:buttons --></div></div><!-- /wp:media-text --></div><!-- /wp:group -->",
