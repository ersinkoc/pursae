  {
   "slug": "home",
   "title": "Benvenuti a tavola",
   "content": "<!-- wp:group {\"align\":\"full\",\"className\":\"section-intro\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group alignfull section-intro\"><!-- wp:paragraph {\"className\":\"eyebrow has-text-align-center\"} --><p class=\"eyebrow has-text-align-center\">Benvenuti</p><!-- /wp:paragraph --><!-- wp:heading {\"className\":\"section-title\",\"textAlign\":\"center\"} --><h2 class=\"wp-block-heading has-text-align-center section-title\">Cooking the way <em>nonna</em> taught us</h2><!-- /wp:heading --><!-- wp:paragraph {\"className\":\"lead has-text-align-center\"} --><p class=\"lead has-text-align-center\">Fresh pasta rolled every morning, bread from a wood-fired oven, and a menu that follows the market. Pull up a chair; we have been saving it for you.</p><!-- /wp:paragraph --><!-- wp:columns {\"align\":\"wide\"} --><div class=\"wp-block-columns alignwide\"><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:group {\"className\":\"signature-dish\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group signature-dish\"><!-- wp:image {\"sizeSlug\":\"large\"} --><figure class=\"wp-block-image size-large\"><img src=\"{{media:pasta}}\" alt=\"A plate of spaghetti with tomato sauce\"/></figure><!-- /wp:image --><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Spaghetti al pomodoro</h3><!-- /wp:heading --><!-- wp:paragraph --><p>Our tomatoes from August, slow-cooked with garlic and basil.</p><!-- /wp:paragraph --></div><!-- /wp:group --></div><!-- /wp:column --></div><!-- /wp:column --><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:group {\"className\":\"signature-dish\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group signature-dish\"><!-- wp:image {\"sizeSlug\":\"large\"} --><figure class=\"wp-block-image size-large\"><img src=\"{{media:pizza}}\" alt=\"A wood-fired pizza with mozzarella\"/></figure><!-- /wp:image --><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Pizza della casa</h3><!-- /wp:heading --><!-- wp:paragraph --><p>Ninety seconds in the oak-fired oven, blistered and soft.</p><!-- /wp:paragraph --></div><!-- /wp:group --></div><!-- /wp:column --></div><!-- /wp:column --><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:group {\"className\":\"signature-dish\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group signature-dish\"><!-- wp:image {\"sizeSlug\":\"large\"} --><figure class=\"wp-block-image size-large\"><img src=\"{{media:tiramisu}}\" alt=\"A slice of tiramisu\"/></figure><!-- /wp:image --><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Tiramisu</h3><!-- /wp:heading --><!-- wp:paragraph --><p>Made the day before, as it should be. Our most requested recipe.</p><!-- /wp:paragraph --></div><!-- /wp:group --></div><!-- /wp:column --></div><!-- /wp:column --></div><!-- /wp:columns --><!-- wp:buttons {\"layout\":{\"type\":\"flex\",\"justifyContent\":\"center\"}} --><div class=\"wp-block-buttons is-content-justification-center\"><!-- wp:button {\"className\":\"is-style-outline\"} --><div class=\"wp-block-button is-style-outline\"><a class=\"wp-block-button__link wp-element-button\" href=\"{{page:menu}}\">See the full menu</a></div><!-- /wp:button --></div><!-- /wp:buttons --></div><!-- /wp:group -->\n\n<!-- wp:group {\"align\":\"full\",\"className\":\"band-olive\",\"backgroundColor\":\"olive\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group alignfull band-olive has-olive-background-color has-background\"><!-- wp:columns {\"align\":\"wide\"} --><div class=\"wp-block-columns alignwide\"><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:paragraph {\"className\":\"eyebrow\"} --><p class=\"eyebrow\">Opening hours</p><!-- /wp:paragraph --><!-- wp:heading {\"className\":\"section-title\"} --><h2 class=\"wp-block-heading section-title\">Come hungry</h2><!-- /wp:heading --><!-- wp:list {\"className\":\"hours-list\"} --><ul class=\"wp-block-list hours-list\"><!-- wp:list-item --><li><strong>Tuesday – Thursday</strong> 12:00 – 22:00</li><!-- /wp:list-item --><!-- wp:list-item --><li><strong>Friday – Saturday</strong> 12:00 – 23:30</li><!-- /wp:list-item --><!-- wp:list-item --><li><strong>Sunday</strong> 12:00 – 21:00</li><!-- /wp:list-item --><!-- wp:list-item --><li><strong>Monday</strong> closed</li><!-- /wp:list-item --></ul><!-- /wp:list --></div><!-- /wp:column --><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:paragraph {\"className\":\"eyebrow\"} --><p class=\"eyebrow\">Reservations</p><!-- /wp:paragraph --><!-- wp:heading {\"className\":\"section-title\"} --><h2 class=\"wp-block-heading section-title\">Book a table</h2><!-- /wp:heading --><!-- wp:paragraph --><p>We keep half the room for walk-ins, but at weekends it is wise to book. Groups of eight or more can reserve the back room.</p><!-- /wp:paragraph --><!-- wp:paragraph --><p>Call <a href=\"tel:+15550184410\">+1 (555) 018-4410</a> or book online.</p><!-- /wp:paragraph --><!-- wp:buttons --><div class=\"wp-block-buttons\"><!-- wp:button --><div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"{{page:reservations}}\">Reserve a table</a></div><!-- /wp:button --></div><!-- /wp:buttons --></div><!-- /wp:column --></div><!-- /wp:columns --></div><!-- /wp:group -->\n\n<!-- wp:group {\"align\":\"full\",\"className\":\"section-story\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group alignfull section-story\"><!-- wp:media-text {\"align\":\"wide\",\"mediaType\":\"image\"} --><div class=\"wp-block-media-text alignwide is-stacked-on-mobile\"><figure class=\"wp-block-media-text__media\"><img src=\"{{media:facade}}\" alt=\"The arched doorways of the trattoria\"/></figure><div class=\"wp-block-media-text__content\"><!-- wp:paragraph {\"className\":\"eyebrow\"} --><p class=\"eyebrow\">Our story</p><!-- /wp:paragraph --><!-- wp:heading {\"className\":\"section-title\"} --><h2 class=\"wp-block-heading section-title\">Three arches on Via dei Fornai</h2><!-- /wp:heading --><!-- wp:paragraph --><p>The trattoria opened in 1987 in an old bakery, and the oven is still where the bakers left it. Two generations later we cook the same dishes, with the same suppliers, for the grandchildren of our first guests.</p><!-- /wp:paragraph --><!-- wp:buttons --><div class=\"wp-block-buttons\"><!-- wp:button {\"className\":\"is-style-outline\"} --><div class=\"wp-block-button is-style-outline\"><a class=\"wp-block-button__link wp-element-button\" href=\"{{page:about}}\">Read our story</a></div><!-- /wp:button --></div><!-- /wp:buttons --></div></div><!-- /wp:media-text --><!-- wp:spacer {\"height\":\"56px\"} --><div style=\"height:56px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div><!-- /wp:spacer --><!-- wp:quote {\"className\":\"testimonial\"} --><blockquote class=\"wp-block-quote testimonial\"><!-- wp:paragraph --><p>The kind of place where the waiter remembers your order and the chef comes out to ask about your mother.</p><!-- /wp:paragraph --><cite>A regular since 1994</cite></blockquote><!-- /wp:quote --></div><!-- /wp:group -->\n\n<!-- wp:group {\"align\":\"full\",\"className\":\"section-news\",\"backgroundColor\":\"parchment\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group alignfull section-news has-parchment-background-color has-background\"><!-- wp:paragraph {\"className\":\"eyebrow has-text-align-center\"} --><p class=\"eyebrow has-text-align-center\">Notizie</p><!-- /wp:paragraph --><!-- wp:heading {\"className\":\"section-title\",\"textAlign\":\"center\"} --><h2 class=\"wp-block-heading has-text-align-center section-title\">News from the kitchen</h2><!-- /wp:heading --><!-- wp:latest-posts {\"postsToShow\":3,\"displayPostContent\":true,\"excerptLength\":18,\"displayPostDate\":true,\"postLayout\":\"grid\",\"columns\":3,\"align\":\"wide\"} /--></div><!-- /wp:group -->\n\n<!-- wp:cover {\"url\":\"{{media:hills}}\",\"dimRatio\":50,\"overlayColor\":\"espresso\",\"align\":\"full\",\"minHeight\":460} --><div class=\"wp-block-cover alignfull\" style=\"min-height:460px\"><span aria-hidden=\"true\" class=\"wp-block-cover__background has-espresso-background-color has-background-dim-50 has-background-dim\"></span><img class=\"wp-block-cover__image-background\" alt=\"\" src=\"{{media:hills}}\" data-object-fit=\"cover\"/><div class=\"wp-block-cover__inner-container\"><!-- wp:heading {\"textAlign\":\"center\"} --><h2 class=\"wp-block-heading has-text-align-center\">Celebrations in the back room</h2><!-- /wp:heading --><!-- wp:paragraph {\"align\":\"center\"} --><p class=\"has-text-align-center\">Birthdays, anniversaries and long Sunday lunches for up to eighteen guests at one table.</p><!-- /wp:paragraph --><!-- wp:buttons {\"layout\":{\"type\":\"flex\",\"justifyContent\":\"center\"}} --><div class=\"wp-block-buttons is-content-justification-center\"><!-- wp:button --><div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"{{post:private-dining-back-room}}\">Plan a private dinner</a></div><!-- /wp:button --></div><!-- /wp:buttons --></div></div><!-- /wp:cover -->",
   "featured_media": "hero",
   "front_page": true
  },
