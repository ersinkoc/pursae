{
  "slug": "launchpad",
  "name": "Launchpad",
  "version": "1.0.0",
  "description": "A bright SaaS landing theme: a gradient mesh hero with a product screenshot, feature grids, pricing tiers, testimonials and a changelog blog laid out as a timeline. Plus Jakarta Sans is self-hosted; a dark mode, an announcement bar and the mesh colors are all in the Customizer.",
  "author": "Pursae",
  "author_url": "https://github.com/boracomet/wordpress-go",
  "theme_url": "https://github.com/boracomet/wordpress-go/tree/main/web/theme-library/launchpad",
  "tags": [
    "Startup",
    "SaaS",
    "Landing Page",
    "Changelog",
    "Custom Colors",
    "Custom Logo",
    "Custom Menu",
    "Editor Style",
    "Featured Images",
    "Full Width Template",
    "Sticky Post",
    "Threaded Comments",
    "Wide Blocks"
  ],
  "requires_core": "0.1.0",
  "screenshot": "assets/screenshot.png",
  "category": "startup",
  "style": "SaaS landing page with a gradient mesh hero and changelog",
  "demo": "demo/demo.json",
  "widget_areas": [
    {
      "id": "sidebar-1",
      "name": "Sidebar",
      "description": "Beside changelog posts when Customize › Launchpad Layout › Sidebar is on."
    },
    {
      "id": "footer-1",
      "name": "Footer",
      "description": "Columns of widgets in the footer."
    }
  ],
  "menu_locations": [
    {
      "id": "primary",
      "name": "Primary Menu"
    },
    {
      "id": "footer",
      "name": "Footer Links"
    }
  ],
  "styles": [
    {
      "handle": "launchpad-style",
      "src": "assets/style.css",
      "deps": [
        "wp-block-library"
      ],
      "media": "all"
    }
  ],
  "scripts": [
    {
      "handle": "launchpad-navigation",
      "src": "assets/js/navigation.js",
      "deps": [],
      "in_footer": true
    }
  ],
  "editor_styles": [
    "assets/editor-style.css"
  ],
  "preload_fonts": [
    "assets/fonts/plus-jakarta.woff2"
  ],
  "palette": [
    {
      "name": "Violet",
      "slug": "violet",
      "color": "#6d4aff"
    },
    {
      "name": "Pink",
      "slug": "pink",
      "color": "#ff4f9a"
    },
    {
      "name": "Amber",
      "slug": "amber",
      "color": "#ffb547"
    },
    {
      "name": "Ink",
      "slug": "ink",
      "color": "#0f1020"
    },
    {
      "name": "Slate",
      "slug": "slate",
      "color": "#5a5f7a"
    },
    {
      "name": "Cloud",
      "slug": "cloud",
      "color": "#f5f4ff"
    },
    {
      "name": "White",
      "slug": "white",
      "color": "#ffffff"
    }
  ],
  "supports": {
    "post-thumbnails": true,
    "custom-logo": {
      "width": 200,
      "height": 48,
      "flex-width": true,
      "flex-height": true,
      "header-text": [
        "site-title",
        "site-description"
      ]
    },
    "title-tag": true,
    "html5": [
      "search-form",
      "comment-form",
      "comment-list",
      "gallery",
      "caption",
      "script",
      "style"
    ],
    "responsive-embeds": true,
    "align-wide": true,
    "wp-block-styles": true
  },
  "customizer": {
    "sections": [
      {
        "id": "launchpad_colors",
        "title": "Launchpad Colors",
        "priority": 40,
        "settings": [
          {
            "id": "accent",
            "label": "Accent color",
            "type": "color",
            "default": "#6d4aff",
            "transport": "postMessage",
            "css_var": "--lp-accent",
            "description": "Buttons, links and highlights."
          },
          {
            "id": "mesh_1",
            "label": "Mesh color 1",
            "type": "color",
            "default": "#8b6cff",
            "transport": "postMessage",
            "css_var": "--lp-mesh-1",
            "description": "The gradient mesh behind the hero and the call to action band."
          },
          {
            "id": "mesh_2",
            "label": "Mesh color 2",
            "type": "color",
            "default": "#ff6fae",
            "transport": "postMessage",
            "css_var": "--lp-mesh-2"
          },
          {
            "id": "mesh_3",
            "label": "Mesh color 3",
            "type": "color",
            "default": "#ffc56b",
            "transport": "postMessage",
            "css_var": "--lp-mesh-3"
          },
          {
            "id": "dark_mode",
            "label": "Dark mode",
            "type": "checkbox",
            "default": false,
            "transport": "postMessage",
            "body_class": "lp-dark",
            "description": "A deep ink background with light text."
          }
        ]
      },
      {
        "id": "launchpad_layout",
        "title": "Launchpad Layout",
        "priority": 41,
        "settings": [
          {
            "id": "font_pairing",
            "label": "Font pairing",
            "type": "select",
            "default": "jakarta",
            "transport": "postMessage",
            "body_class": "lp-font-{value}",
            "choices": [
              {
                "value": "jakarta",
                "label": "Plus Jakarta Sans"
              },
              {
                "value": "serif",
                "label": "Jakarta + Instrument Serif italics"
              },
              {
                "value": "system",
                "label": "System UI"
              }
            ]
          },
          {
            "id": "header_style",
            "label": "Header style",
            "type": "select",
            "default": "floating",
            "transport": "postMessage",
            "body_class": "lp-header-{value}",
            "choices": [
              {
                "value": "floating",
                "label": "Floating pill"
              },
              {
                "value": "bar",
                "label": "Full-width bar"
              }
            ]
          },
          {
            "id": "blog_layout",
            "label": "Changelog layout",
            "type": "select",
            "default": "timeline",
            "transport": "postMessage",
            "body_class": "lp-blog-{value}",
            "choices": [
              {
                "value": "timeline",
                "label": "Timeline"
              },
              {
                "value": "grid",
                "label": "Card grid"
              }
            ]
          },
          {
            "id": "sidebar",
            "label": "Sidebar",
            "type": "select",
            "default": "none",
            "transport": "refresh",
            "body_class": "lp-sidebar-{value}",
            "choices": [
              {
                "value": "right",
                "label": "Right"
              },
              {
                "value": "left",
                "label": "Left"
              },
              {
                "value": "none",
                "label": "No sidebar"
              }
            ]
          },
          {
            "id": "container_width",
            "label": "Container width",
            "type": "select",
            "default": "normal",
            "transport": "postMessage",
            "body_class": "lp-width-{value}",
            "choices": [
              {
                "value": "normal",
                "label": "Normal (1160px)"
              },
              {
                "value": "wide",
                "label": "Wide (1320px)"
              }
            ]
          },
          {
            "id": "show_thumbnails",
            "label": "Show featured images",
            "type": "checkbox",
            "default": true,
            "transport": "postMessage",
            "body_class": "lp-thumbs"
          },
          {
            "id": "show_author",
            "label": "Show author names",
            "type": "checkbox",
            "default": true,
            "transport": "postMessage",
            "body_class": "lp-show-author"
          },
          {
            "id": "sticky_header",
            "label": "Sticky header",
            "type": "checkbox",
            "default": true,
            "transport": "postMessage",
            "body_class": "lp-sticky"
          }
        ]
      },
      {
        "id": "launchpad_hero",
        "title": "Launchpad Hero & Calls to Action",
        "priority": 42,
        "settings": [
          {
            "id": "announce_show",
            "label": "Show the announcement bar",
            "type": "checkbox",
            "default": true,
            "transport": "refresh",
            "body_class": "lp-announce"
          },
          {
            "id": "announce_text",
            "label": "Announcement",
            "type": "text",
            "default": "Launch week: five new features, one every day",
            "transport": "refresh"
          },
          {
            "id": "announce_url",
            "label": "Announcement link",
            "type": "text",
            "default": "/",
            "transport": "refresh"
          },
          {
            "id": "hero_kicker",
            "label": "Hero badge",
            "type": "text",
            "default": "New: automations 2.0",
            "transport": "refresh"
          },
          {
            "id": "hero_heading",
            "label": "Hero heading",
            "type": "text",
            "default": "",
            "transport": "refresh",
            "description": "Empty uses the front page's title."
          },
          {
            "id": "hero_text",
            "label": "Hero text",
            "type": "textarea",
            "default": "Plan, ship and measure in one calm workspace.",
            "transport": "refresh"
          },
          {
            "id": "cta_label",
            "label": "Primary button label",
            "type": "text",
            "default": "Start free trial",
            "transport": "refresh",
            "description": "Also shown in the header and footer."
          },
          {
            "id": "cta_url",
            "label": "Primary button link",
            "type": "text",
            "default": "/",
            "transport": "refresh"
          },
          {
            "id": "hero_secondary_label",
            "label": "Secondary button label",
            "type": "text",
            "default": "Book a demo",
            "transport": "refresh"
          },
          {
            "id": "hero_secondary_url",
            "label": "Secondary button link",
            "type": "text",
            "default": "/",
            "transport": "refresh"
          },
          {
            "id": "hero_image",
            "label": "Product screenshot",
            "type": "image",
            "transport": "refresh",
            "description": "Shown in a browser frame under the hero; empty uses the front page's featured image."
          },
          {
            "id": "footer_text",
            "label": "Footer text",
            "type": "text",
            "default": "",
            "transport": "refresh",
            "description": "Replaces the copyright line."
          }
        ]
      }
    ]
  }
}
