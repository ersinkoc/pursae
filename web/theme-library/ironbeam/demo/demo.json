  {
   "slug": "projects",
   "title": "Projects",
   "excerpt": "Completed buildings and infrastructure.",
   "content": "<!-- wp:paragraph {\"className\":\"lead\"} --><p class=\"lead\">A selection of buildings and infrastructure completed in the last five years. Every project was delivered by our own superintendents.</p><!-- /wp:paragraph -->\n\n<!-- wp:columns {\"align\":\"wide\"} --><div class=\"wp-block-columns alignwide\"><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:image {\"id\":{{media_id:tower}},\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"className\":\"project-tile\"} --><figure class=\"wp-block-image size-large project-tile\"><img src=\"{{media:tower}}\" alt=\"Harbourline Tower\" class=\"wp-image-{{media_id:tower}}\"/><figcaption class=\"wp-element-caption\">Harbourline Tower</figcaption></figure><!-- /wp:image --><!-- wp:paragraph {\"className\":\"project-meta\"} --><p class=\"project-meta\">28 storeys · Commercial · 2025</p><!-- /wp:paragraph --></div><!-- /wp:column --><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:image {\"id\":{{media_id:bridge}},\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"className\":\"project-tile\"} --><figure class=\"wp-block-image size-large project-tile\"><img src=\"{{media:bridge}}\" alt=\"Millrace Crossing\" class=\"wp-image-{{media_id:bridge}}\"/><figcaption class=\"wp-element-caption\">Millrace Crossing</figcaption></figure><!-- /wp:image --><!-- wp:paragraph {\"className\":\"project-meta\"} --><p class=\"project-meta\">Cable-stayed bridge · Civil · 2024</p><!-- /wp:paragraph --></div><!-- /wp:column --><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:image {\"id\":{{media_id:warehouse}},\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"className\":\"project-tile\"} --><figure class=\"wp-block-image size-large project-tile\"><img src=\"{{media:warehouse}}\" alt=\"Northgate Logistics Hub\" class=\"wp-image-{{media_id:warehouse}}\"/><figcaption class=\"wp-element-caption\">Northgate Logistics Hub</figcaption></figure><!-- /wp:image --><!-- wp:paragraph {\"className\":\"project-meta\"} --><p class=\"project-meta\">42,000 m² · Industrial · 2025</p><!-- /wp:paragraph --></div><!-- /wp:column --></div><!-- /wp:columns -->\n\n<!-- wp:columns {\"align\":\"wide\"} --><div class=\"wp-block-columns alignwide\"><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:image {\"id\":{{media_id:school}},\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"className\":\"project-tile\"} --><figure class=\"wp-block-image size-large project-tile\"><img src=\"{{media:school}}\" alt=\"Westfield Primary School\" class=\"wp-image-{{media_id:school}}\"/><figcaption class=\"wp-element-caption\">Westfield Primary School</figcaption></figure><!-- /wp:image --><!-- wp:paragraph {\"className\":\"project-meta\"} --><p class=\"project-meta\">Education · Design-build · 2024</p><!-- /wp:paragraph --></div><!-- /wp:column --><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:image {\"id\":{{media_id:pour}},\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"className\":\"project-tile\"} --><figure class=\"wp-block-image size-large project-tile\"><img src=\"{{media:pour}}\" alt=\"Riverside Parking Structure\" class=\"wp-image-{{media_id:pour}}\"/><figcaption class=\"wp-element-caption\">Riverside Parking Structure</figcaption></figure><!-- /wp:image --><!-- wp:paragraph {\"className\":\"project-meta\"} --><p class=\"project-meta\">Post-tensioned concrete · 2023</p><!-- /wp:paragraph --></div><!-- /wp:column --><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:image {\"id\":{{media_id:excavator}},\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"className\":\"project-tile\"} --><figure class=\"wp-block-image size-large project-tile\"><img src=\"{{media:excavator}}\" alt=\"Eastline Interchange\" class=\"wp-image-{{media_id:excavator}}\"/><figcaption class=\"wp-element-caption\">Eastline Interchange</figcaption></figure><!-- /wp:image --><!-- wp:paragraph {\"className\":\"project-meta\"} --><p class=\"project-meta\">Site works and utilities · 2026</p><!-- /wp:paragraph --></div><!-- /wp:column --></div><!-- /wp:columns -->\n\n<!-- wp:heading --><h2 class=\"wp-block-heading\">By the numbers</h2><!-- /wp:heading -->\n\n<!-- wp:table {\"className\":\"spec-table\"} --><figure class=\"wp-block-table spec-table\"><table><thead><tr><th>Project</th><th>Sector</th><th>Value</th><th>Delivered</th></tr></thead><tbody><tr><td>Harbourline Tower</td><td>Commercial</td><td>$184M</td><td>On time</td></tr><tr><td>Millrace Crossing</td><td>Civil</td><td>$96M</td><td>3 weeks early</td></tr><tr><td>Northgate Logistics Hub</td><td>Industrial</td><td>$58M</td><td>On time</td></tr><tr><td>Westfield Primary School</td><td>Education</td><td>$31M</td><td>Before term start</td></tr><tr><td>Riverside Parking Structure</td><td>Civic</td><td>$22M</td><td>On time</td></tr></tbody></table></figure><!-- /wp:table -->",
   "template": "page-wide",
   "menu_order": 1
  },
  {
   "slug": "safety-record",
   "title": "Safety record",
   "excerpt": "Everyone goes home safe.",
   "content": "<!-- wp:paragraph {\"className\":\"lead\"} --><p class=\"lead\">Every person on our sites goes home in the same condition they arrived. That is not a slogan; it is the first item on every daily briefing.</p><!-- /wp:paragraph -->\n\n<!-- wp:image {\"id\":{{media_id:hardhat}},\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"align\":\"wide\"} --><figure class=\"wp-block-image alignwide size-large\"><img src=\"{{media:hardhat}}\" alt=\"A yellow hard hat\" class=\"wp-image-{{media_id:hardhat}}\"/></figure><!-- /wp:image -->\n\n<!-- wp:heading --><h2 class=\"wp-block-heading\">How we work</h2><!-- /wp:heading -->\n\n<!-- wp:list {\"className\":\"check-list\"} --><ul class=\"wp-block-list check-list\"><!-- wp:list-item --><li>A ten-minute toolbox talk at the start of every shift, led by the crew foreman.</li><!-- /wp:list-item --><!-- wp:list-item --><li>Stop-work authority for every worker, with no questions asked afterwards.</li><!-- /wp:list-item --><!-- wp:list-item --><li>Weekly site walks by a director, not just the safety team.</li><!-- /wp:list-item --><!-- wp:list-item --><li>Near misses reported and shared across all sites within 24 hours.</li><!-- /wp:list-item --></ul><!-- /wp:list -->\n\n<!-- wp:heading --><h2 class=\"wp-block-heading\">Our record</h2><!-- /wp:heading -->\n\n<!-- wp:table {\"className\":\"spec-table\"} --><figure class=\"wp-block-table spec-table\"><table><thead><tr><th>Year</th><th>Hours worked</th><th>Lost-time incidents</th><th>Rate</th></tr></thead><tbody><tr><td>2026 (to date)</td><td>1,520,000</td><td>3</td><td>0.39</td></tr><tr><td>2025</td><td>1,880,000</td><td>4</td><td>0.42</td></tr><tr><td>2024</td><td>1,610,000</td><td>5</td><td>0.62</td></tr><tr><td>2023</td><td>1,450,000</td><td>6</td><td>0.83</td></tr></tbody></table></figure><!-- /wp:table -->",
   "menu_order": 2
  },
  {
   "slug": "about",
   "title": "About Ironbeam",
   "content": "<!-- wp:media-text {\"mediaId\":{{media_id:beams}},\"mediaType\":\"image\"} --><div class=\"wp-block-media-text is-stacked-on-mobile\"><figure class=\"wp-block-media-text__media\"><img src=\"{{media:beams}}\" alt=\"Steel beams\" class=\"wp-image-{{media_id:beams}} size-full\"/></figure><div class=\"wp-block-media-text__content\"><!-- wp:heading --><h2 class=\"wp-block-heading\">Since 1988</h2><!-- /wp:heading --><!-- wp:paragraph --><p>Ironbeam started as a two-truck steel erection crew. Today we are a general contractor with 420 employees, but we still self-perform the structure on most of our projects, because that is where schedules are won or lost.</p><!-- /wp:paragraph --></div></div><!-- /wp:media-text -->\n\n<!-- wp:heading --><h2 class=\"wp-block-heading\">What we believe</h2><!-- /wp:heading -->\n\n<!-- wp:list {\"className\":\"check-list\"} --><ul class=\"wp-block-list check-list\"><!-- wp:list-item --><li><strong>Safety first, always.</strong> No deadline is worth an injury.</li><!-- /wp:list-item --><!-- wp:list-item --><li><strong>Open books.</strong> Clients see the same cost reports we do.</li><!-- /wp:list-item --><!-- wp:list-item --><li><strong>Own the work.</strong> Our crews build the structure; we don't just manage subcontractors.</li><!-- /wp:list-item --><!-- wp:list-item --><li><strong>Finish clean.</strong> Handover includes a complete set of as-built drawings.</li><!-- /wp:list-item --></ul><!-- /wp:list -->\n\n<!-- wp:quote --><blockquote class=\"wp-block-quote\"><!-- wp:paragraph --><p>Build it as if your own family will work inside it.</p><!-- /wp:paragraph --><cite>Founding principle, painted on the wall of the yard</cite></blockquote><!-- /wp:quote -->",
   "menu_order": 3
  },
  {
   "slug": "careers",
   "title": "Careers",
   "excerpt": "Now hiring on three sites.",
   "content": "<!-- wp:paragraph {\"className\":\"lead\"} --><p class=\"lead\">We are hiring on three sites this season. If you take pride in doing the job properly, we would like to hear from you.</p><!-- /wp:paragraph -->\n\n<!-- wp:table {\"className\":\"spec-table\"} --><figure class=\"wp-block-table spec-table\"><table><thead><tr><th>Role</th><th>Location</th><th>Type</th></tr></thead><tbody><tr><td>Site superintendent</td><td>Harbour district</td><td>Full time</td></tr><tr><td>Project engineer</td><td>Head office</td><td>Full time</td></tr><tr><td>Ironworker apprentice</td><td>Northgate</td><td>Apprenticeship</td></tr><tr><td>Concrete finisher</td><td>Eastline</td><td>Full time</td></tr><tr><td>Safety coordinator</td><td>All sites</td><td>Full time</td></tr></tbody></table></figure><!-- /wp:table -->\n\n<!-- wp:heading --><h2 class=\"wp-block-heading\">What you get</h2><!-- /wp:heading -->\n\n<!-- wp:list {\"className\":\"check-list\"} --><ul class=\"wp-block-list check-list\"><!-- wp:list-item --><li>Union-scale wages or better</li><!-- /wp:list-item --><!-- wp:list-item --><li>Health, dental and pension from day one</li><!-- /wp:list-item --><!-- wp:list-item --><li>Paid training and certification</li><!-- /wp:list-item --><!-- wp:list-item --><li>Company vehicle for supervisors</li><!-- /wp:list-item --></ul><!-- /wp:list -->\n\n<!-- wp:paragraph --><p>Send a short note and your CV to <a href=\"mailto:jobs@ironbeam.example\">jobs@ironbeam.example</a>, or visit the site office at any of our projects.</p><!-- /wp:paragraph -->",
   "parent": "about",
   "menu_order": 4
  },
  {
   "slug": "contact",
   "title": "Request a bid",
   "content": "<!-- wp:paragraph {\"className\":\"lead\"} --><p class=\"lead\">Tell us about your project. A pre-construction manager will reply within two working days with next steps and, where possible, an early cost range.</p><!-- /wp:paragraph -->\n\n<!-- wp:columns {\"align\":\"wide\"} --><div class=\"wp-block-columns alignwide\"><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Head office</h3><!-- /wp:heading --><!-- wp:paragraph --><p>400 Foundry Road<br>Northgate, NG4 2AB</p><!-- /wp:paragraph --><!-- wp:paragraph --><p><a href=\"tel:+15550134400\">+1 (555) 013-4400</a><br><a href=\"mailto:bids@ironbeam.example\">bids@ironbeam.example</a></p><!-- /wp:paragraph --></div><!-- /wp:column --><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Request a bid</h3><!-- /wp:heading --><!-- wp:list {\"className\":\"check-list\"} --><ul class=\"wp-block-list check-list\"><!-- wp:list-item --><li>Project location and site size</li><!-- /wp:list-item --><!-- wp:list-item --><li>Drawings or a brief, if you have them</li><!-- /wp:list-item --><!-- wp:list-item --><li>Target start and completion dates</li><!-- /wp:list-item --><!-- wp:list-item --><li>Budget range</li><!-- /wp:list-item --></ul><!-- /wp:list --></div><!-- /wp:column --></div><!-- /wp:columns -->",
