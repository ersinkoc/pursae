{
  "slug": "ironbeam",
  "name": "Ironbeam Construction",
  "version": "1.0.0",
  "description": "A bold corporate theme for construction and engineering companies: safety yellow and steel grey, condensed industrial headings, hazard-stripe accents, a days-without-incident counter, services, completed projects, safety figures, careers and project-update posts.",
  "author": "Pursae",
  "author_url": "https://github.com/pursae",
  "theme_url": "https://github.com/pursae/pursae-dev/tree/main/web/theme-library/ironbeam",
  "tags": [
    "Construction",
    "Business",
    "Corporate",
    "Blog",
    "Two Columns",
    "Right Sidebar",
    "Left Sidebar",
    "Grid Layout",
    "Custom Colors",
    "Custom Logo",
    "Custom Menu",
    "Editor Style",
    "Featured Images",
    "Footer Widgets",
    "Sticky Header",
    "Threaded Comments",
    "Wide Blocks"
  ],
  "requires_core": "0.1.0",
  "screenshot": "assets/screenshot.png",
  "category": "construction",
  "style": "Safety yellow and steel, condensed industrial type",
  "demo": "demo/demo.json",
  "widget_areas": [
    {
      "id": "sidebar-1",
      "name": "Sidebar",
      "description": "Beside posts, archives and search results (Customize sets the side or hides it)."
    },
    {
      "id": "footer-1",
      "name": "Footer",
      "description": "Columns in the footer, next to the site name and description."
    }
  ],
  "menu_locations": [
    {
      "id": "primary",
      "name": "Primary Menu"
    },
    {
      "id": "footer",
      "name": "Footer Menu"
    }
  ],
  "styles": [
    {
      "handle": "ironbeam-style",
      "src": "assets/style.css",
      "deps": [
        "wp-block-library"
      ],
      "media": "all"
    }
  ],
  "scripts": [
    {
      "handle": "ironbeam-navigation",
      "src": "assets/js/navigation.js",
      "deps": [],
      "in_footer": true
    }
  ],
  "editor_styles": [
    "assets/editor-style.css"
  ],
  "preload_fonts": [
    "assets/fonts/big-shoulders-display.woff2",
    "assets/fonts/work-sans.woff2"
  ],
  "palette": [
    {
      "name": "Safety yellow",
      "slug": "safety-yellow",
      "color": "#ffc20e"
    },
    {
      "name": "Steel",
      "slug": "steel",
      "color": "#3d4650"
    },
    {
      "name": "Iron",
      "slug": "iron",
      "color": "#15191d"
    },
    {
      "name": "Concrete",
      "slug": "concrete",
      "color": "#eef0f2"
    },
    {
      "name": "Rust",
      "slug": "rust",
      "color": "#b5532a"
    },
    {
      "name": "White",
      "slug": "white",
      "color": "#ffffff"
    }
  ],
  "supports": {
    "post-thumbnails": true,
    "custom-logo": {
      "width": 240,
      "height": 64,
      "flex-width": true,
      "flex-height": true,
      "header-text": [
        "site-title",
        "site-description"
      ]
    },
    "title-tag": true,
    "html5": [
      "search-form",
      "comment-form",
      "comment-list",
      "gallery",
      "caption",
      "script",
      "style"
    ],
    "responsive-embeds": true,
    "align-wide": true,
    "wp-block-styles": true
  },
  "customizer": {
    "sections": [
      {
        "id": "ironbeam_brand",
        "title": "Brand & Type",
        "priority": 40,
        "settings": [
          {
            "id": "accent_color",
            "label": "Accent (safety yellow)",
            "type": "color",
            "default": "#ffc20e",
            "transport": "postMessage",
            "css_var": "--ib-accent",
            "description": "Buttons, stripes, numbers and highlights."
          },
          {
            "id": "steel_color",
            "label": "Steel",
            "type": "color",
            "default": "#3d4650",
            "transport": "postMessage",
            "css_var": "--ib-steel",
            "description": "Section bands and secondary surfaces."
          },
          {
            "id": "dark_color",
            "label": "Iron (darkest)",
            "type": "color",
            "default": "#15191d",
            "transport": "postMessage",
            "css_var": "--ib-dark",
            "description": "Header, footer and headings."
          },
          {
            "id": "font_pairing",
            "label": "Typefaces",
            "type": "select",
            "default": "industrial",
            "transport": "postMessage",
            "body_class": "ib-font-{value}",
            "choices": [
              {
                "value": "industrial",
                "label": "Big Shoulders headings, Work Sans text"
              },
              {
                "value": "grotesk",
                "label": "Work Sans throughout"
              },
              {
                "value": "system",
                "label": "System fonts"
              }
            ]
          },
          {
            "id": "hazard_stripes",
            "label": "Hazard stripes under the header and above the footer",
            "type": "checkbox",
            "default": true,
            "transport": "postMessage",
            "body_class": "ib-stripes"
          },
          {
            "id": "corner_style",
            "label": "Corners",
            "type": "select",
            "default": "square",
            "transport": "postMessage",
            "body_class": "ib-corners-{value}",
            "choices": [
              {
                "value": "square",
                "label": "Square, cut steel"
              },
              {
                "value": "rounded",
                "label": "Slightly rounded"
              }
            ]
          }
        ]
      },
      {
        "id": "ironbeam_header",
        "title": "Header & Safety Counter",
        "priority": 41,
        "settings": [
          {
            "id": "header_style",
            "label": "Header style",
            "type": "select",
            "default": "dark",
            "transport": "postMessage",
            "body_class": "ib-header-{value}",
            "choices": [
              {
                "value": "dark",
                "label": "Iron bar"
              },
              {
                "value": "yellow",
                "label": "Safety-yellow bar"
              },
              {
                "value": "light",
                "label": "White bar"
              }
            ]
          },
          {
            "id": "sticky_header",
            "label": "Keep the header visible while scrolling",
            "type": "checkbox",
            "default": true,
            "transport": "postMessage",
            "body_class": "ib-sticky"
          },
          {
            "id": "safety_days",
            "label": "Days without a lost-time incident",
            "type": "number",
            "default": 1284,
            "min": 0,
            "max": 100000,
            "transport": "refresh"
          },
          {
            "id": "safety_label",
            "label": "Counter label",
            "type": "text",
            "default": "days without a lost-time incident",
            "transport": "refresh"
          },
          {
            "id": "topbar_text",
            "label": "Strip text",
            "type": "text",
            "default": "Licensed general contractor · Bonded and insured · 24/7 site line +1 (555) 013-4400",
            "transport": "refresh"
          },
          {
            "id": "cta_label",
            "label": "Header button label",
            "type": "text",
            "default": "Request a bid",
            "transport": "refresh",
            "description": "Leave empty to hide the button."
          },
          {
            "id": "cta_url",
            "label": "Header button link",
            "type": "text",
            "default": "/contact/",
            "transport": "refresh"
          }
        ]
      },
      {
        "id": "ironbeam_hero",
        "title": "Front Page Hero",
        "priority": 42,
        "settings": [
          {
            "id": "hero_image",
            "label": "Hero image",
            "description": "Without an image the front page's featured image is used.",
            "type": "image"
          },
          {
            "id": "hero_kicker",
            "label": "Label above the heading",
            "type": "text",
            "default": "General contractor · Design-build",
            "transport": "refresh"
          },
          {
            "id": "hero_heading",
            "label": "Heading",
            "type": "text",
            "default": "",
            "transport": "refresh",
            "description": "Empty uses the page title."
          },
          {
            "id": "hero_text",
            "label": "Text",
            "type": "textarea",
            "default": "",
            "transport": "refresh"
          },
          {
            "id": "hero_button_label",
            "label": "Button label",
            "type": "text",
            "default": "See our projects",
            "transport": "refresh"
          },
          {
            "id": "hero_button_url",
            "label": "Button link",
            "type": "text",
            "default": "#projects",
            "transport": "refresh"
          }
        ],
        "description": "The full-bleed hero on a static front page."
      },
      {
        "id": "ironbeam_blog",
        "title": "Updates & Footer",
        "priority": 43,
        "settings": [
          {
            "id": "blog_layout",
            "label": "Post list layout",
            "type": "select",
            "default": "grid",
            "transport": "postMessage",
            "body_class": "ib-blog-{value}",
            "choices": [
              {
                "value": "grid",
                "label": "Cards in a grid"
              },
              {
                "value": "list",
                "label": "Wide rows"
              }
            ]
          },
          {
            "id": "sidebar_position",
            "label": "Sidebar",
            "type": "select",
            "default": "right",
            "transport": "postMessage",
            "body_class": "ib-sidebar-{value}",
            "choices": [
              {
                "value": "right",
                "label": "Right"
              },
              {
                "value": "left",
                "label": "Left"
              },
              {
                "value": "none",
                "label": "No sidebar"
              }
            ]
          },
          {
            "id": "show_featured",
            "label": "Show featured images",
            "type": "checkbox",
            "default": true,
            "transport": "postMessage",
            "body_class": "ib-thumbs"
          },
          {
            "id": "show_author",
            "label": "Show the author on posts and cards",
            "type": "checkbox",
            "default": true,
            "transport": "postMessage",
            "body_class": "ib-show-author"
          },
          {
            "id": "footer_slogan",
            "label": "Footer headline",
            "type": "text",
            "default": "Built right. Built safe. Built on schedule.",
            "transport": "refresh"
          },
          {
            "id": "footer_text",
            "label": "Footer text",
            "type": "text",
            "default": "",
            "transport": "refresh",
            "description": "Replaces the copyright line."
          }
        ]
      }
    ]
  }
}
