{
  "slug": "keystone-estates",
  "name": "Keystone Estates",
  "version": "1.0.0",
  "description": "A clean real estate agency theme in forest green and warm stone: a search-forward hero with popular-search chips, listings as posts with price badges and a property facts grid, agent and neighbourhood pages, and grid or list listing layouts.",
  "author": "Pursae",
  "author_url": "https://github.com/pursae",
  "theme_url": "https://github.com/pursae/pursae-dev/tree/main/web/theme-library/keystone-estates",
  "tags": ["Real Estate", "Business", "Grid Layout", "Right Sidebar", "Custom Colors", "Custom Logo", "Custom Menu", "Editor Style", "Featured Images", "Footer Widgets", "Sticky Header", "Wide Blocks"],
  "requires_core": "0.1.0",
  "screenshot": "assets/screenshot.png",
  "category": "real-estate",
  "style": "Clean agency, forest green and stone, search-first hero",
  "demo": "demo/demo.json",

  "widget_areas": [
    {"id": "sidebar-1", "name": "Sidebar", "description": "Beside listings and archives while Customize › Listings & Footer shows the sidebar."},
    {"id": "footer-1", "name": "Footer", "description": "Columns in the footer, next to the agency details."}
  ],
  "menu_locations": [
    {"id": "primary", "name": "Primary Menu"},
    {"id": "hero", "name": "Hero Popular Searches"},
    {"id": "footer", "name": "Footer Menu"}
  ],

  "styles": [
    {"handle": "keystone-estates-style", "src": "assets/style.css", "deps": ["wp-block-library"], "media": "all"}
  ],
  "scripts": [
    {"handle": "keystone-estates-navigation", "src": "assets/js/navigation.js", "deps": [], "in_footer": true}
  ],
  "editor_styles": ["assets/editor-style.css"],
  "preload_fonts": ["assets/fonts/manrope-400-700.woff2"],

  "palette": [
    {"name": "Forest", "slug": "forest", "color": "#1f4d3a"},
    {"name": "Sage", "slug": "sage", "color": "#8fa98f"},
    {"name": "Sand", "slug": "sand", "color": "#b9975b"},
    {"name": "Stone", "slug": "stone", "color": "#f2efe8"},
    {"name": "Charcoal", "slug": "charcoal", "color": "#1d2321"},
    {"name": "White", "slug": "white", "color": "#ffffff"}
  ],
  "supports": {
    "post-thumbnails": true,
    "custom-logo": {"width": 220, "height": 60, "flex-width": true, "flex-height": true, "header-text": ["site-title", "site-description"]},
    "title-tag": true,
    "html5": ["search-form", "comment-form", "comment-list", "gallery", "caption", "script", "style"],
    "responsive-embeds": true,
    "align-wide": true,
    "wp-block-styles": true
  },

  "customizer": {
    "sections": [
      {
        "id": "keystone_colors", "title": "Colors & Type", "priority": 40,
        "settings": [
          {"id": "primary_color", "label": "Primary green", "description": "Buttons, badges, footer and headings accents.", "type": "color", "default": "#1f4d3a", "transport": "postMessage", "css_var": "--ks-primary"},
          {"id": "accent_color", "label": "Accent", "description": "Prices, highlights and focus rings.", "type": "color", "default": "#b9975b", "transport": "postMessage", "css_var": "--ks-accent"},
          {"id": "stone_color", "label": "Stone background", "description": "Section bands, cards and the page intro.", "type": "color", "default": "#f2efe8", "transport": "postMessage", "css_var": "--ks-stone"},
          {"id": "font_pairing", "label": "Typefaces", "type": "select", "default": "manrope", "transport": "postMessage", "body_class": "ks-font-{value}",
            "choices": [{"value": "manrope", "label": "Manrope throughout"}, {"value": "classic", "label": "Cormorant Garamond headings, Manrope text"}, {"value": "system", "label": "System fonts"}]}
        ]
      },
      {
        "id": "keystone_header", "title": "Header & Hero", "description": "The search hero of a static front page. Without an image the page's featured image is used.", "priority": 41,
        "settings": [
          {"id": "header_style", "label": "Header on the front page", "type": "select", "default": "overlay", "transport": "postMessage", "body_class": "ks-header-{value}",
            "choices": [{"value": "overlay", "label": "Transparent over the hero image"}, {"value": "solid", "label": "Solid white bar"}]},
          {"id": "sticky_header", "label": "Keep the header visible while scrolling", "type": "checkbox", "default": false, "transport": "postMessage", "body_class": "ks-sticky"},
          {"id": "cta_label", "label": "Header button label", "description": "Empty hides it.", "type": "text", "default": "Book a valuation", "transport": "refresh"},
          {"id": "cta_url", "label": "Header button link", "type": "text", "default": "/contact/", "transport": "refresh"},
          {"id": "hero_image", "label": "Hero image", "type": "image"},
          {"id": "hero_heading", "label": "Heading", "description": "Empty uses the page title.", "type": "text", "default": "", "transport": "refresh"},
          {"id": "hero_text", "label": "Text", "type": "textarea", "default": "", "transport": "refresh"},
          {"id": "search_placeholder", "label": "Search box placeholder", "type": "text", "default": "Neighbourhood, street or feature…", "transport": "refresh"},
          {"id": "hero_overlay", "label": "Hero image darkening (%)", "type": "number", "default": 55, "min": 0, "max": 85, "transport": "postMessage", "css_var": "--ks-overlay"}
        ]
      },
      {
        "id": "keystone_listings", "title": "Listings & Footer", "priority": 42,
        "settings": [
          {"id": "listing_layout", "label": "Listing layout", "type": "select", "default": "grid", "transport": "postMessage", "body_class": "ks-listings-{value}",
            "choices": [{"value": "grid", "label": "Grid of cards"}, {"value": "list", "label": "Wide rows"}]},
          {"id": "show_sidebar", "label": "Show the sidebar beside listings", "type": "checkbox", "default": false, "transport": "postMessage", "body_class": "ks-has-sidebar"},
          {"id": "office_text", "label": "Office details in the footer", "type": "textarea", "default": "48 Orchard Row, Millbrook\nMon–Sat 9:00–18:00 · +1 (555) 016-7700", "transport": "refresh"},
          {"id": "footer_text", "label": "Footer text", "description": "Replaces the copyright line.", "type": "text", "default": "", "transport": "refresh"}
        ]
      }
    ]
  }
}
