 "pages": [
  {
   "slug": "home",
   "title": "Home",
   "content": "<!-- wp:group {\"className\":\"ls-section\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group ls-section\"><!-- wp:group {\"className\":\"ls-section-head\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group ls-section-head\"><!-- wp:paragraph {\"className\":\"ls-kicker\"} --><p class=\"ls-kicker\">Programmes by age</p><!-- /wp:paragraph --><!-- wp:heading --><h2 class=\"wp-block-heading\">A room for every stage</h2><!-- /wp:heading --></div><!-- /wp:group --><!-- wp:columns {\"className\":\"ls-programs\"} --><div class=\"wp-block-columns ls-programs\"><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:group {\"className\":\"ls-program ls-program--red\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group ls-program ls-program--red\"><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Seedlings</h3><!-- /wp:heading --><!-- wp:paragraph {\"className\":\"ls-age\"} --><p class=\"ls-age\">1 to 2 years</p><!-- /wp:paragraph --><!-- wp:paragraph --><p>Cuddles, songs and first steps in a calm, cosy room.</p><!-- /wp:paragraph --></div><!-- /wp:group --></div><!-- /wp:column --><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:group {\"className\":\"ls-program ls-program--yellow\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group ls-program ls-program--yellow\"><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Sprouts</h3><!-- /wp:heading --><!-- wp:paragraph {\"className\":\"ls-age\"} --><p class=\"ls-age\">2 to 3 years</p><!-- /wp:paragraph --><!-- wp:paragraph --><p>Messy play, new words and lots of time outdoors.</p><!-- /wp:paragraph --></div><!-- /wp:group --></div><!-- /wp:column --><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:group {\"className\":\"ls-program ls-program--green\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group ls-program ls-program--green\"><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Saplings</h3><!-- /wp:heading --><!-- wp:paragraph {\"className\":\"ls-age\"} --><p class=\"ls-age\">3 to 4 years</p><!-- /wp:paragraph --><!-- wp:paragraph --><p>Stories, building, friendships and big questions.</p><!-- /wp:paragraph --></div><!-- /wp:group --></div><!-- /wp:column --><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:group {\"className\":\"ls-program ls-program--blue\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group ls-program ls-program--blue\"><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Blossoms</h3><!-- /wp:heading --><!-- wp:paragraph {\"className\":\"ls-age\"} --><p class=\"ls-age\">4 to 5 years</p><!-- /wp:paragraph --><!-- wp:paragraph --><p>Getting ready for school, one adventure at a time.</p><!-- /wp:paragraph --></div><!-- /wp:group --></div><!-- /wp:column --></div><!-- /wp:columns --></div><!-- /wp:group --><!-- wp:group {\"align\":\"full\",\"className\":\"ls-band\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group alignfull ls-band\"><!-- wp:group {\"className\":\"ls-day\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group ls-day\"><!-- wp:group {\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group\"><!-- wp:paragraph {\"className\":\"ls-kicker\"} --><p class=\"ls-kicker\">A day at Little Sprouts</p><!-- /wp:paragraph --><!-- wp:heading --><h2 class=\"wp-block-heading\">Play, rest, eat, explore</h2><!-- /wp:heading --><!-- wp:paragraph --><p>Every day has a gentle rhythm, so children know what comes next and feel safe to try new things.</p><!-- /wp:paragraph --><!-- wp:buttons --><div class=\"wp-block-buttons\"><!-- wp:button --><div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"{{page:daily-schedule}}\">See the full schedule</a></div><!-- /wp:button --></div><!-- /wp:buttons --></div><!-- /wp:group --><!-- wp:group {\"className\":\"ls-panel\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group ls-panel\"><!-- wp:list {\"className\":\"ls-schedule\"} --><ul class=\"wp-block-list ls-schedule\"><!-- wp:list-item --><li><strong>7:30</strong> <span>Breakfast club and free play</span></li><!-- /wp:list-item --><!-- wp:list-item --><li><strong>9:00</strong> <span>Good morning circle</span></li><!-- /wp:list-item --><!-- wp:list-item --><li><strong>9:30</strong> <span>Outdoor play and garden club</span></li><!-- /wp:list-item --><!-- wp:list-item --><li><strong>11:30</strong> <span>Lunch together</span></li><!-- /wp:list-item --><!-- wp:list-item --><li><strong>12:30</strong> <span>Quiet time and naps</span></li><!-- /wp:list-item --><!-- wp:list-item --><li><strong>14:30</strong> <span>Art, music and stories</span></li><!-- /wp:list-item --><!-- wp:list-item --><li><strong>16:00</strong> <span>Snack and home time</span></li><!-- /wp:list-item --></ul><!-- /wp:list --></div><!-- /wp:group --></div><!-- /wp:group --></div><!-- /wp:group --><!-- wp:group {\"className\":\"ls-section\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group ls-section\"><!-- wp:group {\"className\":\"ls-section-head\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group ls-section-head\"><!-- wp:paragraph {\"className\":\"ls-kicker\"} --><p class=\"ls-kicker\">Parent news</p><!-- /wp:paragraph --><!-- wp:heading --><h2 class=\"wp-block-heading\">What's happening</h2><!-- /wp:heading --></div><!-- /wp:group --><!-- wp:latest-posts {\"postsToShow\":3,\"displayPostDate\":true,\"displayFeaturedImage\":true,\"featuredImageSizeSlug\":\"large\",\"displayPostContent\":true,\"excerptLength\":20,\"postLayout\":\"grid\",\"columns\":3} /--></div><!-- /wp:group --><!-- wp:group {\"className\":\"ls-section\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group ls-section\"><!-- wp:columns {\"className\":\"ls-quotes\"} --><div class=\"wp-block-columns ls-quotes\"><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:quote --><blockquote class=\"wp-block-quote\"><!-- wp:paragraph --><p>The staff know our son so well. He talks about his key person all weekend.</p><!-- /wp:paragraph --><cite>Parent of a Sapling</cite></blockquote><!-- /wp:quote --></div><!-- /wp:column --><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:quote --><blockquote class=\"wp-block-quote\"><!-- wp:paragraph --><p>Muddy, happy and full of stories every single day. We couldn't ask for more.</p><!-- /wp:paragraph --><cite>Parent of a Blossom</cite></blockquote><!-- /wp:quote --></div><!-- /wp:column --></div><!-- /wp:columns --></div><!-- /wp:group --><!-- wp:group {\"className\":\"ls-section ls-visit\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group ls-section ls-visit\"><!-- wp:heading --><h2 class=\"wp-block-heading\">Come and visit us</h2><!-- /wp:heading --><!-- wp:paragraph --><p>The best way to get to know us is to come and play. Book a visit and bring your little one.</p><!-- /wp:paragraph --><!-- wp:buttons --><div class=\"wp-block-buttons\"><!-- wp:button --><div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"{{page:enrol}}\">Book a visit</a></div><!-- /wp:button --><!-- wp:button {\"className\":\"is-style-outline\"} --><div class=\"wp-block-button is-style-outline\"><a class=\"wp-block-button__link wp-element-button\" href=\"{{page:enrol}}\">Call us</a></div><!-- /wp:button --></div><!-- /wp:buttons --></div><!-- /wp:group -->",
