{
  "slug": "roast-and-ritual",
  "name": "Roast & Ritual",
  "version": "1.1.0",
  "description": "A warm, characterful specialty coffee roaster for Pursae Commerce. A scrolling ticker, an espresso-dark header with a cup seal and a Cart pill, a full-bleed hero with a wavy edge, category tiles framed like coffee-bag labels, oat product cards with mono prices and a hard offset shadow on hover, stamp-style sale badges, tasting-note product pages and a counter-style checkout. Fraunces, Albert Sans and IBM Plex Mono, self-hosted. Ships a complete roastery demo: single origins with weight and grind options, brewing gear, a gift subscription and a gift box.",
  "author": "Pursae",
  "author_url": "https://github.com/boracomet/wordpress-go",
  "theme_url": "https://github.com/boracomet/wordpress-go/tree/main/web/theme-library/roast-and-ritual",
  "tags": ["E-Commerce", "Food & Drink", "Grid Layout", "Custom Colors", "Custom Logo", "Custom Menu", "Editor Style", "Featured Images", "Footer Widgets", "Wide Blocks"],
  "requires_core": "0.1.0",
  "screenshot": "assets/screenshot.png",
  "category": "shop",
  "style": "Warm coffee roaster, bag-label cards and stamps",
  "demo": "demo/demo.json",

  "widget_areas": [
    {"id": "footer-1", "name": "Footer", "description": "Widgets in the footer columns."},
    {"id": "shop-sidebar", "name": "Shop Sidebar", "description": "Filters beside the product catalog."}
  ],
  "menu_locations": [
    {"id": "primary", "name": "Primary Menu"},
    {"id": "footer", "name": "Footer Menu"}
  ],

  "styles": [
    {"handle": "roast-and-ritual-style", "src": "assets/style.css", "deps": ["wp-block-library"], "media": "all"}
  ],
  "scripts": [
    {"handle": "roast-and-ritual-navigation", "src": "assets/js/navigation.js", "deps": [], "in_footer": true}
  ],
  "editor_styles": ["assets/editor-style.css"],
  "preload_fonts": ["assets/fonts/albert-sans.woff2", "assets/fonts/fraunces.woff2"],

  "palette": [
    {"name": "Espresso", "slug": "espresso", "color": "#2b1d16"},
    {"name": "Crema", "slug": "crema", "color": "#c8a27a"},
    {"name": "Oat", "slug": "oat", "color": "#efe6da"},
    {"name": "Teal", "slug": "teal", "color": "#2f6f6a"},
    {"name": "Milk", "slug": "milk", "color": "#f8f3ec"}
  ],
  "supports": {
    "post-thumbnails": true,
    "custom-logo": {"width": 200, "height": 80, "flex-width": true, "flex-height": true, "header-text": ["site-title", "site-description"]},
    "title-tag": true,
    "html5": ["search-form", "comment-form", "comment-list", "gallery", "caption", "script", "style"],
    "responsive-embeds": true,
    "align-wide": true,
    "wp-block-styles": true,
    "woocommerce": true
  },

  "customizer": {
    "sections": [
      {
        "id": "roast_colors", "title": "Colours & Type", "priority": 40,
        "settings": [
          {"id": "accent", "label": "Accent colour", "description": "Buttons, the cart pill and links.", "type": "color", "default": "#2f6f6a", "transport": "postMessage", "css_var": "--rr-accent"},
          {"id": "crema", "label": "Crema colour", "description": "Stamps, tickers and highlights.", "type": "color", "default": "#c8a27a", "transport": "postMessage", "css_var": "--rr-crema"},
          {"id": "background", "label": "Background", "type": "color", "default": "#efe6da", "transport": "postMessage", "css_var": "--rr-bg"},
          {"id": "text_color", "label": "Text colour", "type": "color", "default": "#2b1d16", "transport": "postMessage", "css_var": "--rr-ink"},
          {"id": "font_pairing", "label": "Font pairing", "type": "select", "default": "fraunces", "transport": "postMessage", "body_class": "rr-fonts-{value}",
            "choices": [{"value": "fraunces", "label": "Fraunces & Albert Sans"}, {"value": "slab", "label": "Zilla Slab & Albert Sans"}, {"value": "sans", "label": "Albert Sans only"}]},
          {"id": "button_style", "label": "Buttons", "type": "select", "default": "rounded", "transport": "postMessage", "body_class": "rr-buttons-{value}",
            "choices": [{"value": "rounded", "label": "Rounded"}, {"value": "square", "label": "Square"}]}
        ]
      },
      {
        "id": "roast_store", "title": "Header & Store", "priority": 41,
        "settings": [
          {"id": "show_announcement", "label": "Show the ticker", "type": "checkbox", "default": true, "transport": "postMessage", "body_class": "rr-has-ticker"},
          {"id": "announcement", "label": "Ticker text", "type": "text", "default": "Roasted every Tuesday · Free shipping over $40 · Grind it your way", "transport": "refresh"},
          {"id": "header_style", "label": "Header colour", "type": "select", "default": "dark", "transport": "postMessage", "body_class": "rr-header-{value}",
            "choices": [{"value": "dark", "label": "Espresso"}, {"value": "light", "label": "Oat"}]},
          {"id": "card_shadow", "label": "Offset shadow on product cards", "type": "checkbox", "default": true, "transport": "postMessage", "body_class": "rr-stamp-shadow"},
          {"id": "catalog_columns", "label": "Products per row (large screens)", "type": "select", "default": "4", "transport": "postMessage", "body_class": "rr-cols-{value}",
            "choices": [{"value": "3", "label": "3"}, {"value": "4", "label": "4"}]},
          {"id": "footer_text", "label": "Footer text", "type": "text", "default": "", "transport": "refresh"}
        ]
      }
    ]
  }
}
