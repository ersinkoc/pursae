\":3} --><h3 class=\"wp-block-heading\">Ceremony</h3><!-- /wp:heading --><!-- wp:paragraph --><p>14:30, in the orchard</p><!-- /wp:paragraph --><!-- wp:paragraph --><p>The Orchard House, Willowmere</p><!-- /wp:paragraph --></div><!-- /wp:column --><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Reception</h3><!-- /wp:heading --><!-- wp:paragraph --><p>From 18:00 in the stone barn</p><!-- /wp:paragraph --><!-- wp:paragraph --><p>Dinner, cake and dancing</p><!-- /wp:paragraph --></div><!-- /wp:column --><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Stay</h3><!-- /wp:heading --><!-- wp:paragraph --><p>Rooms held at The Willow Inn</p><!-- /wp:paragraph --><!-- wp:paragraph --><p><a href=\"{{page:travel}}\">Travel &amp; stay guide</a></p><!-- /wp:paragraph --></div><!-- /wp:column --></div><!-- /wp:columns --></div><!-- /wp:group --><!-- wp:group {\"align\":\"full\",\"className\":\"ea-section ea-section--sage\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group alignfull ea-section ea-section--sage\"><!-- wp:paragraph {\"className\":\"ea-script ea-center\"} --><p class=\"ea-script ea-center\">Moments</p><!-- /wp:paragraph --><!-- wp:heading {\"textAlign\":\"center\"} --><h2 class=\"wp-block-heading has-text-align-center\">A few favourite pictures</h2><!-- /wp:heading --><!-- wp:gallery {\"columns\":3,\"linkTo\":\"none\",\"align\":\"wide\"} --><figure class=\"wp-block-gallery has-nested-images columns-3 is-cropped alignwide\"><!-- wp:image {\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} --><figure class=\"wp-block-image size-large\"><img src=\"{{media:lighthouse}}\" alt=\"The lighthouse at sunset\"/></figure><!-- /wp:image --><!-- wp:image {\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} --><figure class=\"wp-block-image size-large\"><img src=\"{{media:bouquet}}\" alt=\"A bouquet of blush roses\"/></figure><!-- /wp:image --><!-- wp:image {\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} --><figure class=\"wp-block-image size-large\"><img src=\"{{media:venue}}\" alt=\"The stone barn\"/></figure><!-- /wp:image --><!-- wp:image {\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} --><figure class=\"wp-block-image size-large\"><img src=\"{{media:rings}}\" alt=\"Two rings on a ribbon\"/></figure><!-- /wp:image --><!-- wp:image {\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} --><figure class=\"wp-block-image size-large\"><img src=\"{{media:table}}\" alt=\"A table set with candles\"/></figure><!-- /wp:image --><!-- wp:image {\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} --><figure class=\"wp-block-image size-large\"><img src=\"{{media:garden}}\" alt=\"A garden path\"/></figure><!-- /wp:image --></figure><!-- /wp:gallery --></div><!-- /wp:group --><!-- wp:group {\"align\":\"full\",\"className\":\"ea-section\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group alignfull ea-section\"><!-- wp:paragraph {\"className\":\"ea-script ea-center\"} --><p class=\"ea-script ea-center\">Kindly reply</p><!-- /wp:paragraph --><!-- wp:heading {\"textAlign\":\"center\"} --><h2 class=\"wp-block-heading has-text-align-center\">Will you join us?</h2><!-- /wp:heading --><!-- wp:paragraph {\"align\":\"center\"} --><p class=\"has-text-align-center\">Please let us know by 1 May 2027 whether you can come, and tell us about any dietary needs.</p><!-- /wp:paragraph --><!-- wp:buttons {\"layout\":{\"type\":\"flex\",\"justifyContent\":\"center\"}} --><div class=\"wp-block-buttons is-content-justification-center\"><!-- wp:button --><div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"{{page:rsvp}}\">RSVP</a></div><!-- /wp:button --></div><!-- /wp:buttons --></div><!-- /wp:group -->",
