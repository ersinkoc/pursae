  {
   "slug": "rsvp",
   "title": "RSVP",
   "content": "<!-- wp:paragraph {\"align\":\"center\"} --><p class=\"has-text-align-center\">We would be so happy to celebrate with you. Please reply by <strong>1 May 2027</strong>.</p><!-- /wp:paragraph --><!-- wp:list --><ul class=\"wp-block-list\"><!-- wp:list-item --><li>The names of everyone in your party</li><!-- /wp:list-item --><!-- wp:list-item --><li>Whether you can join us for the ceremony and the dinner</li><!-- /wp:list-item --><!-- wp:list-item --><li>Any allergies or dietary needs</li><!-- /wp:list-item --><!-- wp:list-item --><li>A song that will get you on the dance floor</li><!-- /wp:list-item --></ul><!-- /wp:list --><!-- wp:paragraph {\"align\":\"center\"} --><p class=\"has-text-align-center\">This is demo content: add your own RSVP form here (for example with a contact form block), or link to your RSVP service.</p><!-- /wp:paragraph --><!-- wp:buttons {\"layout\":{\"type\":\"flex\",\"justifyContent\":\"center\"}} --><div class=\"wp-block-buttons is-content-justification-center\"><!-- wp:button --><div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"mailto:hello@example.com\">Email us your reply</a></div><!-- /wp:button --></div><!-- /wp:buttons -->",
