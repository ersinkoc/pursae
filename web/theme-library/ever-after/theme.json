{
  "slug": "ever-after",
  "name": "Ever After",
  "version": "1.0.0",
  "description": "A romantic theme for weddings and celebrations: an arched hero photo with your names in script, the date and venue in small capitals, an RSVP button, floral dividers, a schedule timeline, a masonry gallery of stories and a blush footer that signs off with love. Cormorant Garamond with Great Vibes accents.",
  "author": "WordPress Go",
  "author_url": "https://github.com/boracomet/wordpress-go",
  "theme_url": "https://github.com/boracomet/wordpress-go/tree/main/web/theme-library/ever-after",
  "tags": [
    "Wedding",
    "Blog",
    "One Column",
    "Grid Layout",
    "Custom Colors",
    "Custom Logo",
    "Custom Menu",
    "Featured Images",
    "Threaded Comments",
    "Wide Blocks",
    "Editor Style"
  ],
  "requires_core": "0.1.0",
  "screenshot": "assets/screenshot.png",
  "category": "wedding",
  "style": "Romantic wedding site with serif and script type in blush and sage",
  "demo": "demo/demo.json",
  "widget_areas": [
    {
      "id": "sidebar-1",
      "name": "Sidebar",
      "description": "Beside journal posts when the sidebar is switched on."
    },
    {
      "id": "footer-1",
      "name": "Footer",
      "description": "Shown in the blush footer."
    }
  ],
  "menu_locations": [
    {
      "id": "primary",
      "name": "Primary Menu"
    },
    {
      "id": "footer",
      "name": "Footer Menu"
    }
  ],
  "styles": [
    {
      "handle": "ever-after-style",
      "src": "assets/style.css",
      "deps": [
        "wp-block-library"
      ],
      "media": "all"
    }
  ],
  "scripts": [
    {
      "handle": "ever-after-navigation",
      "src": "assets/js/navigation.js",
      "deps": [],
      "in_footer": true
    }
  ],
  "editor_styles": [
    "assets/editor-style.css"
  ],
  "preload_fonts": [
    "assets/fonts/cormorant.woff2",
    "assets/fonts/greatvibes.woff2"
  ],
  "palette": [
    {
      "name": "Rose",
      "slug": "rose",
      "color": "#9d5c63"
    },
    {
      "name": "Blush",
      "slug": "blush",
      "color": "#ecd2cd"
    },
    {
      "name": "Sage",
      "slug": "sage",
      "color": "#8a9a7b"
    },
    {
      "name": "Ivory",
      "slug": "ivory",
      "color": "#fbf7f2"
    },
    {
      "name": "Gold",
      "slug": "gold",
      "color": "#b8935a"
    },
    {
      "name": "Ink",
      "slug": "ink",
      "color": "#3b3433"
    }
  ],
  "supports": {
    "post-thumbnails": true,
    "custom-logo": {
      "width": 240,
      "height": 80,
      "flex-width": true,
      "flex-height": true,
      "header-text": [
        "site-title",
        "site-description"
      ]
    },
    "title-tag": true,
    "html5": [
      "search-form",
      "comment-form",
      "comment-list",
      "gallery",
      "caption",
      "script",
      "style"
    ],
    "responsive-embeds": true,
    "align-wide": true,
    "wp-block-styles": true
  },
  "customizer": {
    "sections": [
      {
        "id": "ea_colors",
        "title": "Ever After Colors",
        "priority": 30,
        "settings": [
          {
            "id": "rose",
            "label": "Rose (accent)",
            "description": "Links, buttons and script accents.",
            "type": "color",
            "default": "#9d5c63",
            "transport": "postMessage",
            "css_var": "--ea-rose"
          },
          {
            "id": "blush",
            "label": "Blush (sections and footer)",
            "type": "color",
            "default": "#ecd2cd",
            "transport": "postMessage",
            "css_var": "--ea-blush"
          },
          {
            "id": "sage",
            "label": "Sage (leaves and details)",
            "type": "color",
            "default": "#8a9a7b",
            "transport": "postMessage",
            "css_var": "--ea-sage"
          },
          {
            "id": "ivory",
            "label": "Page background",
            "type": "color",
            "default": "#fbf7f2",
            "transport": "postMessage",
            "css_var": "--ea-ivory"
          }
        ]
      },
      {
        "id": "ea_layout",
        "title": "Ever After Layout",
        "priority": 31,
        "settings": [
          {
            "id": "header_style",
            "label": "Header",
            "type": "select",
            "default": "centered",
            "transport": "postMessage",
            "body_class": "ea-header-{value}",
            "choices": [
              {
                "value": "centered",
                "label": "Centered names, menu below"
              },
              {
                "value": "minimal",
                "label": "Minimal bar"
              }
            ]
          },
          {
            "id": "post_layout",
            "label": "Journal layout",
            "type": "select",
            "default": "masonry",
            "transport": "postMessage",
            "body_class": "ea-layout-{value}",
            "choices": [
              {
                "value": "masonry",
                "label": "Masonry"
              },
              {
                "value": "grid",
                "label": "Even grid"
              },
              {
                "value": "list",
                "label": "Centered list"
              }
            ]
          },
          {
            "id": "sidebar",
            "label": "Sidebar",
            "type": "select",
            "default": "none",
            "transport": "postMessage",
            "body_class": "sidebar-{value}",
            "choices": [
              {
                "value": "none",
                "label": "No sidebar"
              },
              {
                "value": "right",
                "label": "Right"
              },
              {
                "value": "left",
                "label": "Left"
              }
            ]
          },
          {
            "id": "font_pairing",
            "label": "Typography",
            "type": "select",
            "default": "romantic",
            "transport": "postMessage",
            "body_class": "ea-fonts-{value}",
            "choices": [
              {
                "value": "romantic",
                "label": "Romantic (serif + script)"
              },
              {
                "value": "classic",
                "label": "Classic (serif italics, no script)"
              }
            ]
          },
          {
            "id": "ornaments",
            "label": "Floral dividers",
            "type": "checkbox",
            "default": true,
            "transport": "postMessage",
            "body_class": "ea-ornaments"
          },
          {
            "id": "sticky_header",
            "label": "Sticky header",
            "type": "checkbox",
            "default": false,
            "transport": "postMessage",
            "body_class": "sticky-header"
          },
          {
            "id": "show_thumbs",
            "label": "Show featured images",
            "type": "checkbox",
            "default": true,
            "transport": "postMessage",
            "body_class": "show-thumbs"
          },
          {
            "id": "show_author",
            "label": "Show the author",
            "type": "checkbox",
            "default": false,
            "transport": "postMessage",
            "body_class": "show-author"
          }
        ]
      },
      {
        "id": "ea_details",
        "title": "Wedding Details",
        "priority": 32,
        "description": "Printed in the hero, the header and the footer.",
        "settings": [
          {
            "id": "couple_names",
            "label": "Names",
            "type": "text",
            "default": "Clara & Theo"
          },
          {
            "id": "hero_kicker",
            "label": "Line above the names",
            "type": "text",
            "default": "Together with their families"
          },
          {
            "id": "wedding_date",
            "label": "Date",
            "type": "text",
            "default": "Saturday, 12 June 2027"
          },
          {
            "id": "venue",
            "label": "Venue",
            "type": "text",
            "default": "The Orchard House · Willowmere"
          },
          {
            "id": "rsvp_label",
            "label": "RSVP button label",
            "type": "text",
            "default": "RSVP"
          },
          {
            "id": "rsvp_link",
            "label": "RSVP button link",
            "type": "text",
            "default": "#rsvp"
          },
          {
            "id": "hero_image",
            "label": "Hero image",
            "description": "A portrait image works best inside the arch.",
            "type": "image"
          },
          {
            "id": "footer_text",
            "label": "Footer text",
            "type": "text",
            "default": ""
          }
        ]
      }
    ]
  }
}
