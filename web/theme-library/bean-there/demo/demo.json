 "pages": [
  {
   "slug": "home",
   "title": "Slow coffee for busy mornings",
   "front_page": true,
   "featured_media": "hero",
   "excerpt": "A neighbourhood café and micro-roastery. Small-batch beans, careful baristas and buns fresh from the oven, every day of the week.",
   "content": "<!-- wp:group {\"align\":\"full\",\"className\":\"band-crema\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group alignfull band-crema\"><!-- wp:paragraph {\"className\":\"eyebrow\",\"align\":\"center\"} --><p class=\"has-text-align-center eyebrow\">Why Bean There</p><!-- /wp:paragraph --><!-- wp:heading {\"textAlign\":\"center\"} --><h2 class=\"wp-block-heading has-text-align-center\">Coffee roasted behind the counter</h2><!-- /wp:heading --><!-- wp:columns {\"className\":\"feature-cards\"} --><div class=\"wp-block-columns feature-cards\"><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:group {\"className\":\"feature-card\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group feature-card\"><!-- wp:image {\"id\":{{media_id:beans}},\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} --><figure class=\"wp-block-image size-large\"><img src=\"{{media:beans}}\" alt=\"A heap of freshly roasted coffee beans\" class=\"wp-image-{{media_id:beans}}\"/></figure><!-- /wp:image --><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Roasted here</h3><!-- /wp:heading --><!-- wp:paragraph --><p>Small batches on our own roaster, never more than a week old on the shelf.</p><!-- /wp:paragraph --></div><!-- /wp:group --></div><!-- /wp:column --><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:group {\"className\":\"feature-card\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group feature-card\"><!-- wp:image {\"id\":{{media_id:latteart}},\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} --><figure class=\"wp-block-image size-large\"><img src=\"{{media:latteart}}\" alt=\"A latte with a heart in the foam\" class=\"wp-image-{{media_id:latteart}}\"/></figure><!-- /wp:image --><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Made with care</h3><!-- /wp:heading --><!-- wp:paragraph --><p>Baristas trained in-house, milk steamed for every single cup.</p><!-- /wp:paragraph --></div><!-- /wp:group --></div><!-- /wp:column --><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:group {\"className\":\"feature-card\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group feature-card\"><!-- wp:image {\"id\":{{media_id:pastries}},\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} --><figure class=\"wp-block-image size-large\"><img src=\"{{media:pastries}}\" alt=\"Croissants and buns on a counter\" class=\"wp-image-{{media_id:pastries}}\"/></figure><!-- /wp:image --><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Baked this morning</h3><!-- /wp:heading --><!-- wp:paragraph --><p>Buns and pastries from the bakery two doors down, delivered warm at seven.</p><!-- /wp:paragraph --></div><!-- /wp:group --></div><!-- /wp:column --></div><!-- /wp:columns --></div><!-- /wp:group -->\n\n<!-- wp:group {\"align\":\"wide\",\"className\":\"menu-board\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group alignwide menu-board\"><!-- wp:columns --><div class=\"wp-block-columns\"><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:paragraph {\"className\":\"eyebrow\"} --><p class=\"eyebrow\">On the board today</p><!-- /wp:paragraph --><!-- wp:heading --><h2 class=\"wp-block-heading\">Flat whites, filter and a cardamom bun</h2><!-- /wp:heading --><!-- wp:paragraph --><p>Our menu is short on purpose: a few drinks done properly, a weekly filter coffee and something sweet from the oven.</p><!-- /wp:paragraph --><!-- wp:buttons --><div class=\"wp-block-buttons\"><!-- wp:button --><div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"{{page:menu}}\">See the full menu</a></div><!-- /wp:button --></div><!-- /wp:buttons --></div><!-- /wp:column --><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:list {\"className\":\"menu-list\"} --><ul class=\"wp-block-list menu-list\"><!-- wp:list-item --><li><span>Flat white</span><span class=\"price\">3.40</span></li><!-- /wp:list-item --><!-- wp:list-item --><li><span>Pour-over of the week</span><span class=\"price\">4.20</span></li><!-- /wp:list-item --><!-- wp:list-item --><li><span>Iced mint mocha</span><span class=\"price\">4.40</span></li><!-- /wp:list-item --><!-- wp:list-item --><li><span>Cardamom bun</span><span class=\"price\">3.20</span></li><!-- /wp:list-item --></ul><!-- /wp:list --></div><!-- /wp:column --></div><!-- /wp:columns --></div><!-- /wp:group -->\n\n<!-- wp:group {\"align\":\"full\",\"className\":\"band-roast\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group alignfull band-roast\"><!-- wp:paragraph {\"className\":\"eyebrow\"} --><p class=\"eyebrow\">From the journal</p><!-- /wp:paragraph --><!-- wp:heading --><h2 class=\"wp-block-heading\">Brew better at home</h2><!-- /wp:heading --><!-- wp:latest-posts {\"postsToShow\":3,\"displayPostDate\":true,\"displayPostContent\":true,\"excerptLength\":18,\"postLayout\":\"grid\",\"columns\":3} /--><!-- wp:buttons --><div class=\"wp-block-buttons\"><!-- wp:button --><div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"{{category:brewing-guides}}\">All brewing guides</a></div><!-- /wp:button --></div><!-- /wp:buttons --></div><!-- /wp:group -->\n\n<!-- wp:group {\"align\":\"wide\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group alignwide\"><!-- wp:columns {\"className\":\"cta-row\"} --><div class=\"wp-block-columns cta-row\"><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:heading --><h2 class=\"wp-block-heading\">Two shops, one roaster</h2><!-- /wp:heading --><!-- wp:paragraph --><p>Find us on Market Street in the Old Town and by the river on Quay Lane. Same coffee, same smiles, different views.</p><!-- /wp:paragraph --></div><!-- /wp:column --><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:buttons --><div class=\"wp-block-buttons\"><!-- wp:button --><div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"{{page:locations}}\">Locations &amp; hours</a></div><!-- /wp:button --><!-- wp:button {\"className\":\"is-style-outline\"} --><div class=\"wp-block-button is-style-outline\"><a class=\"wp-block-button__link wp-element-button\" href=\"{{page:contact}}\">Say hello</a></div><!-- /wp:button --></div><!-- /wp:buttons --></div><!-- /wp:column --></div><!-- /wp:columns --></div><!-- /wp:group -->"
  },
