   "content": "<!-- wp:group {\"align\":\"wide\",\"className\":\"menu-board\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group alignwide menu-board\"><!-- wp:columns --><div class=\"wp-block-columns\"><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:heading --><h2 class=\"wp-block-heading\">Espresso bar</h2><!-- /wp:heading --><!-- wp:list {\"className\":\"menu-list\"} --><ul class=\"wp-block-list menu-list\"><!-- wp:list-item --><li><span>Espresso<em>Double shot, house blend</em></span><span class=\"price\">2.60</span></li><!-- /wp:list-item --><!-- wp:list-item --><li><span>Macchiato</span><span class=\"price\">2.90</span></li><!-- /wp:list-item --><!-- wp:list-item --><li><span>Flat white<em>Our most-ordered drink</em></span><span class=\"price\">3.40</span></li><!-- /wp:list-item --><!-- wp:list-item --><li><span>Cappuccino</span><span class=\"price\">3.50</span></li><!-- /wp:list-item --><!-- wp:list-item --><li><span>Latte<em>Oat, almond or whole milk</em></span><span class=\"price\">3.60</span></li><!-- /wp:list-item --><!-- wp:list-item --><li><span>Mocha<em>Dark chocolate</em></span><span class=\"price\">3.90</span></li><!-- /wp:list-item --></ul><!-- /wp:list --><!-- wp:heading --><h2 class=\"wp-block-heading\">Filter</h2><!-- /wp:heading --><!-- wp:list {\"className\":\"menu-list\"} --><ul class=\"wp-block-list menu-list\"><!-- wp:list-item --><li><span>Batch brew<em>Changes daily</em></span><span class=\"price\">2.80</span></li><!-- /wp:list-item --><!-- wp:list-item --><li><span>Pour-over<em>Ask about this week's origins</em></span><span class=\"price\">4.20</span></li><!-- /wp:list-item --><!-- wp:list-item --><li><span>Cold brew<em>Over ice</em></span><span class=\"price\">3.80</span></li><!-- /wp:list-item --></ul><!-- /wp:list --></div><!-- /wp:column --><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:heading --><h2 class=\"wp-block-heading\">Not coffee</h2><!-- /wp:heading --><!-- wp:list {\"className\":\"menu-list\"} --><ul class=\"wp-block-list menu-list\"><!-- wp:list-item --><li><span>Loose leaf tea<em>Six kinds</em></span><span class=\"price\">3.00</span></li><!-- /wp:list-item --><!-- wp:list-item --><li><span>Hot chocolate</span><span class=\"price\">3.40</span></li><!-- /wp:list-item --><!-- wp:list-item --><li><span>Iced mint mocha<em>Summer special</em></span><span class=\"price\">4.40</span></li><!-- /wp:list-item --><!-- wp:list-item --><li><span>Fresh lemonade</span><span class=\"price\">3.20</span></li><!-- /wp:list-item --></ul><!-- /wp:list --><!-- wp:heading --><h2 class=\"wp-block-heading\">From the oven</h2><!-- /wp:heading --><!-- wp:list {\"className\":\"menu-list\"} --><ul class=\"wp-block-list menu-list\"><!-- wp:list-item --><li><span>Butter croissant</span><span class=\"price\">2.80</span></li><!-- /wp:list-item --><!-- wp:list-item --><li><span>Cardamom bun<em>Baked every morning</em></span><span class=\"price\">3.20</span></li><!-- /wp:list-item --><!-- wp:list-item --><li><span>Banana bread<em>With salted butter</em></span><span class=\"price\">3.00</span></li><!-- /wp:list-item --><!-- wp:list-item --><li><span>Toasted sourdough<em>Jam or avocado</em></span><span class=\"price\">4.50</span></li><!-- /wp:list-item --></ul><!-- /wp:list --></div><!-- /wp:column --></div><!-- /wp:columns --><!-- wp:paragraph {\"className\":\"menu-note\"} --><p class=\"menu-note\">Oat milk at no extra cost &middot; Decaf available all day &middot; Ask us about allergens</p><!-- /wp:paragraph --></div><!-- /wp:group -->\n\n<!-- wp:heading --><h2 class=\"wp-block-heading\">Beans to take home</h2><!-- /wp:heading -->\n\n<!-- wp:paragraph --><p>Every coffee on the bar is also sold in 250 g bags, roasted on site. Ask us to grind it for your brewer.</p><!-- /wp:paragraph -->\n\n<!-- wp:table --><figure class=\"wp-block-table\"><table><thead><tr><th>Coffee</th><th>Notes</th><th>250 g</th></tr></thead><tbody><tr><td>House blend</td><td>Chocolate, hazelnut, caramel</td><td>9.50</td></tr><tr><td>Washed Ethiopian</td><td>Jasmine, peach, bergamot</td><td>13.00</td></tr><tr><td>Colombia decaf</td><td>Cocoa, red apple</td><td>10.50</td></tr></tbody></table></figure><!-- /wp:table -->",
   "excerpt": "Everything on the bar today. Prices include a smile."
  },
  {
   "slug": "locations",
   "title": "Locations & Hours",
   "content": "<!-- wp:paragraph --><p>Two shops, one roaster and the same friendly faces. Laptops welcome on weekdays; weekends are for conversation.</p><!-- /wp:paragraph -->\n\n<!-- wp:columns --><div class=\"wp-block-columns\"><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:group {\"className\":\"location-card\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group location-card\"><!-- wp:image {\"id\":{{media_id:storefront}},\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} --><figure class=\"wp-block-image size-large\"><img src=\"{{media:storefront}}\" alt=\"A small café storefront with a striped awning\" class=\"wp-image-{{media_id:storefront}}\"/></figure><!-- /wp:image --><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Market Street</h3><!-- /wp:heading --><!-- wp:paragraph --><p>14 Market Street, Old Town<br>Our original shop and roastery corner.</p><!-- /wp:paragraph --><!-- wp:table {\"className\":\"hours\"} --><figure class=\"wp-block-table hours\"><table><thead><tr><th>Day</th><th>Hours</th></tr></thead><tbody><tr><td>Mon&ndash;Fri</td><td>7:00&ndash;18:00</td></tr><tr><td>Saturday</td><td>8:00&ndash;18:00</td></tr><tr><td>Sunday</td><td>9:00&ndash;16:00</td></tr></tbody></table></figure><!-- /wp:table --></div><!-- /wp:group --></div><!-- /wp:column --><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:group {\"className\":\"location-card\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group location-card\"><!-- wp:image {\"id\":{{media_id:interior}},\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} --><figure class=\"wp-block-image size-large\"><img src=\"{{media:interior}}\" alt=\"A café counter with pendant lights\" class=\"wp-image-{{media_id:interior}}\"/></figure><!-- /wp:image --><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Riverside</h3><!-- /wp:heading --><!-- wp:paragraph --><p>3 Quay Lane, by the footbridge<br>Big windows, bigger tables.</p><!-- /wp:paragraph --><!-- wp:table {\"className\":\"hours\"} --><figure class=\"wp-block-table hours\"><table><thead><tr><th>Day</th><th>Hours</th></tr></thead><tbody><tr><td>Mon&ndash;Fri</td><td>7:30&ndash;17:00</td></tr><tr><td>Saturday</td><td>8:00&ndash;17:00</td></tr><tr><td>Sunday</td><td>Closed</td></tr></tbody></table></figure><!-- /wp:table --></div><!-- /wp:group --></div><!-- /wp:column --></div><!-- /wp:columns -->\n\n<!-- wp:heading --><h2 class=\"wp-block-heading\">Getting here</h2><!-- /wp:heading -->\n\n<!-- wp:list --><ul class=\"wp-block-list\"><!-- wp:list-item --><li>Bike racks outside both shops</li><!-- /wp:list-item --><!-- wp:list-item --><li>Five minutes from the central station on foot</li><!-- /wp:list-item --><!-- wp:list-item --><li>Step-free entrance and accessible toilet at Riverside</li><!-- /wp:list-item --></ul><!-- /wp:list -->"
  },
  {
   "slug": "about",
   "title": "About Us",
   "content": "<!-- wp:paragraph --><p>Bean There started as a coffee cart at the Saturday market. Six years, two shops and one roaster later, we still pull every shot by hand and still know most of our regulars by name.</p><!-- /wp:paragraph -->\n\n<!-- wp:media-text {\"mediaId\":{{media_id:interior}},\"mediaType\":\"image\"} --><div class=\"wp-block-media-text is-stacked-on-mobile\"><figure class=\"wp-block-media-text__media\"><img src=\"{{media:interior}}\" alt=\"A café counter with pendant lights\" class=\"wp-image-{{media_id:interior}} size-full\"/></figure><div class=\"wp-block-media-text__content\"><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">What we care about</h3><!-- /wp:heading --><!-- wp:list --><ul class=\"wp-block-list\"><!-- wp:list-item --><li>Coffees bought directly from farms we know</li><!-- /wp:list-item --><!-- wp:list-item --><li>Fair wages for our team, always</li><!-- /wp:list-item --><!-- wp:list-item --><li>Compostable cups and a discount for your own mug</li><!-- /wp:list-item --></ul><!-- /wp:list --></div></div><!-- /wp:media-text -->\n\n<!-- wp:heading --><h2 class=\"wp-block-heading\">The team</h2><!-- /wp:heading -->\n\n<!-- wp:paragraph --><p>We are a crew of nine baristas, one roaster and a part-time dog called Crema who supervises from the window seat.</p><!-- /wp:paragraph -->\n\n<!-- wp:quote --><blockquote class=\"wp-block-quote\"><!-- wp:paragraph --><p>Good coffee is a small, daily kindness.</p><!-- /wp:paragraph --><cite>Our founder</cite></blockquote><!-- /wp:quote -->"
  },
  {
   "slug": "contact",
   "title": "Contact",
   "parent": "about",
   "content": "<!-- wp:paragraph --><p>Questions about beans, wholesale or hosting an event in one of our shops? Drop us a line.</p><!-- /wp:paragraph -->\n\n<!-- wp:columns --><div class=\"wp-block-columns\"><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Email</h3><!-- /wp:heading --><!-- wp:paragraph --><p><a href=\"mailto:hello@example.com\">hello@example.com</a></p><!-- /wp:paragraph --></div><!-- /wp:column --><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Wholesale</h3><!-- /wp:heading --><!-- wp:paragraph --><p>We roast for a handful of local cafés and offices. Ask for our wholesale list.</p><!-- /wp:paragraph --></div><!-- /wp:column --></div><!-- /wp:columns -->"
  }
 ],
 "posts": [
  {
   "slug": "how-we-brew-a-pour-over",
   "title": "How We Brew a Pour-Over",
   "date": "2026-10-20T08:00:00",
   "sticky": true,
   "excerpt": "Our bar recipe for a clean, sweet cup from a cone dripper, scaled for your kitchen. Fifteen grams, four minutes, no fuss.",
   "categories": [
    "brewing-guides"
   ],
   "tags": [
    "pour-over",
    "filter",
    "at-home"
   ],
   "featured_media": "pourover",
   "content": "<!-- wp:paragraph --><p>Pour-over is how we taste every new coffee that arrives at the shop. It is slow enough to be calming and precise enough to show off what makes a coffee special.</p><!-- /wp:paragraph -->\n\n<!-- wp:paragraph --><p>You need a cone dripper, a paper filter, a kettle and ideally a scale. The scale matters more than a fancy kettle: weighing coffee and water is the fastest way to a consistent cup.</p><!-- /wp:paragraph -->\n\n<!-- wp:group {\"className\":\"brew-specs\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group brew-specs\"><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Our bar recipe</h3><!-- /wp:heading --><!-- wp:list {\"className\":\"recipe-facts\"} --><ul class=\"wp-block-list recipe-facts\"><!-- wp:list-item --><li><strong>Coffee</strong>15 g</li><!-- /wp:list-item --><!-- wp:list-item --><li><strong>Water</strong>250 g</li><!-- /wp:list-item --><!-- wp:list-item --><li><strong>Grind</strong>Medium-fine</li><!-- /wp:list-item --><!-- wp:list-item --><li><strong>Temp</strong>94&deg;C</li><!-- /wp:list-item --><!-- wp:list-item --><li><strong>Time</strong>3:30&ndash;4:00</li><!-- /wp:list-item --></ul><!-- /wp:list --><!-- wp:list {\"ordered\":true,\"className\":\"steps\"} --><ol class=\"wp-block-list steps\"><!-- wp:list-item --><li>Rinse the paper with hot water and discard it.</li><!-- /wp:list-item --><!-- wp:list-item --><li>Add coffee, level the bed and start a timer.</li><!-- /wp:list-item --><!-- wp:list-item --><li>Pour 40 g of water and let it bloom for 40 seconds.</li><!-- /wp:list-item --><!-- wp:list-item --><li>Pour in slow circles to 150 g by 1:15.</li><!-- /wp:list-item --><!-- wp:list-item --><li>Pour to 250 g by 2:00, then let it drain.</li><!-- /wp:list-item --><!-- wp:list-item --><li>Swirl gently and serve.</li><!-- /wp:list-item --></ol><!-- /wp:list --></div><!-- /wp:group -->\n\n<!-- wp:heading --><h2 class=\"wp-block-heading\">Adjusting the taste</h2><!-- /wp:heading -->\n\n<!-- wp:list --><ul class=\"wp-block-list\"><!-- wp:list-item --><li>Sour or thin? Grind finer.</li><!-- /wp:list-item --><!-- wp:list-item --><li>Bitter or dry? Grind coarser.</li><!-- /wp:list-item --><!-- wp:list-item --><li>Too strong? Add 20 g more water next time.</li><!-- /wp:list-item --></ul><!-- /wp:list -->\n\n<!-- wp:image {\"id\":{{media_id:pourover}},\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} --><figure class=\"wp-block-image size-large\"><img src=\"{{media:pourover}}\" alt=\"A cone dripper over a glass carafe\" class=\"wp-image-{{media_id:pourover}}\"/></figure><!-- /wp:image -->\n\n<!-- wp:quote --><blockquote class=\"wp-block-quote\"><!-- wp:paragraph --><p>Taste, change one thing, taste again. That is the whole secret.</p><!-- /wp:paragraph --><cite>Our head barista</cite></blockquote><!-- /wp:quote -->",
