   "slug": "release-calendar",
   "title": "Release Calendar",
   "content": "<!-- wp:heading --><h2 class=\"wp-block-heading\">November</h2><!-- /wp:heading --><!-- wp:table {\"className\":\"pa-release-table\"} --><figure class=\"wp-block-table pa-release-table\"><table><thead><tr><th>Date</th><th>Game</th><th>Genre</th><th>Platform</th></tr></thead><tbody><tr><td>NOV 04</td><td>Lantern Keep</td><td>Strategy</td><td>PC</td></tr><tr><td>NOV 12</td><td>Galley Below</td><td>Simulation</td><td>PC / Console</td></tr><tr><td>NOV 19</td><td>Beat Brawl</td><td>Fighting</td><td>Console</td></tr><tr><td>NOV 26</td><td>Moss &amp; Iron: Deeproot</td><td>Expansion</td><td>Console / Handheld</td></tr></tbody></table></figure><!-- /wp:table --><!-- wp:heading --><h2 class=\"wp-block-heading\">December</h2><!-- /wp:heading --><!-- wp:table {\"className\":\"pa-release-table\"} --><figure class=\"wp-block-table pa-release-table\"><table><thead><tr><th>Date</th><th>Game</th><th>Genre</th><th>Platform</th></tr></thead><tbody><tr><td>DEC 02</td><td>Paper Comet</td><td>Shooter</td><td>Handheld</td></tr><tr><td>DEC 10</td><td>Night Market Tycoon</td><td>Management</td><td>PC / Mobile</td></tr><tr><td>DEC 16</td><td>Tidal Circuit: Monsoon Cup</td><td>Racing DLC</td><td>Console / PC</td></tr></tbody></table></figure><!-- /wp:table --><!-- wp:paragraph --><p>Something missing? Studios can send dates through the contact page and we will add them after checking.</p><!-- /wp:paragraph -->",
