   "title": "Home",
   "content": "<!-- wp:group {\"className\":\"pa-section\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group pa-section\"><!-- wp:group {\"className\":\"pa-section-head\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group pa-section-head\"><!-- wp:heading --><h2 class=\"wp-block-heading\">Latest reviews</h2><!-- /wp:heading --><!-- wp:buttons --><div class=\"wp-block-buttons\"><!-- wp:button {\"className\":\"is-style-outline\"} --><div class=\"wp-block-button is-style-outline\"><a class=\"wp-block-button__link wp-element-button\" href=\"{{category:reviews}}\">All reviews</a></div><!-- /wp:button --></div><!-- /wp:buttons --></div><!-- /wp:group --><!-- wp:columns {\"className\":\"pa-reviews\"} --><div class=\"wp-block-columns pa-reviews\"><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:group {\"className\":\"pa-review\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group pa-review\"><!-- wp:image {\"id\":{{media_id:starfall-drift}},\"sizeSlug\":\"large\",\"linkDestination\":\"custom\"} --><figure class=\"wp-block-image size-large\"><a href=\"{{post:starfall-drift-review}}\"><img src=\"{{media:starfall-drift}}\" alt=\"Pixel-art spaceship flying over a purple planet ring\" class=\"wp-image-{{media_id:starfall-drift}}\"/></a></figure><!-- /wp:image --><!-- wp:paragraph {\"className\":\"pa-badge\"} --><p class=\"pa-badge\">9.1</p><!-- /wp:paragraph --><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\"><a href=\"{{post:starfall-drift-review}}\">Starfall Drift</a></h3><!-- /wp:heading --><!-- wp:paragraph --><p>A quiet space opera that earns every jump.</p><!-- /wp:paragraph --></div><!-- /wp:group --></div><!-- /wp:column --><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:group {\"className\":\"pa-review\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group pa-review\"><!-- wp:image {\"id\":{{media_id:moss-and-iron}},\"sizeSlug\":\"large\",\"linkDestination\":\"custom\"} --><figure class=\"wp-block-image size-large\"><a href=\"{{post:moss-and-iron-review}}\"><img src=\"{{media:moss-and-iron}}\" alt=\"Pixel-art forest ruins with a lone knight under green moss\" class=\"wp-image-{{media_id:moss-and-iron}}\"/></a></figure><!-- /wp:image --><!-- wp:paragraph {\"className\":\"pa-badge\"} --><p class=\"pa-badge\">8.7</p><!-- /wp:paragraph --><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\"><a href=\"{{post:moss-and-iron-review}}\">Moss &amp; Iron</a></h3><!-- /wp:heading --><!-- wp:paragraph --><p>A soulful knight in a forest that remembers.</p><!-- /wp:paragraph --></div><!-- /wp:group --></div><!-- /wp:column --><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:group {\"className\":\"pa-review\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group pa-review\"><!-- wp:image {\"id\":{{media_id:tidal-circuit}},\"sizeSlug\":\"large\",\"linkDestination\":\"custom\"} --><figure class=\"wp-block-image size-large\"><a href=\"{{post:tidal-circuit-review}}\"><img src=\"{{media:tidal-circuit}}\" alt=\"Neon racing track twisting over a dark ocean in pixel art\" class=\"wp-image-{{media_id:tidal-circuit}}\"/></a></figure><!-- /wp:image --><!-- wp:paragraph {\"className\":\"pa-badge\"} --><p class=\"pa-badge\">8.2</p><!-- /wp:paragraph --><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\"><a href=\"{{post:tidal-circuit-review}}\">Tidal Circuit</a></h3><!-- /wp:heading --><!-- wp:paragraph --><p>Arcade racing at the speed of the tide.</p><!-- /wp:paragraph --></div><!-- /wp:group --></div><!-- /wp:column --></div><!-- /wp:columns --></div><!-- /wp:group --><!-- wp:group {\"className\":\"pa-section\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group pa-section\"><!-- wp:group {\"className\":\"pa-section-head\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group pa-section-head\"><!-- wp:heading --><h2 class=\"wp-block-heading\">Upcoming releases</h2><!-- /wp:heading --><!-- wp:buttons --><div class=\"wp-block-buttons\"><!-- wp:button {\"className\":\"is-style-outline\"} --><div class=\"wp-block-button is-style-outline\"><a class=\"wp-block-button__link wp-element-button\" href=\"{{page:release-calendar}}\">Full calendar</a></div><!-- /wp:button --></div><!-- /wp:buttons --></div><!-- /wp:group --><!-- wp:table {\"className\":\"pa-release-table\"} --><figure class=\"wp-block-table pa-release-table\"><table><thead><tr><th>Date</th><th>Game</th><th>Platform</th></tr></thead><tbody><tr><td>NOV 04</td><td>Lantern Keep</td><td>PC</td></tr><tr><td>NOV 12</td><td>Galley Below</td><td>PC / Console</td></tr><tr><td>NOV 19</td><td>Beat Brawl</td><td>Console</td></tr><tr><td>DEC 02</td><td>Paper Comet</td><td>Handheld</td></tr><tr><td>DEC 10</td><td>Night Market Tycoon</td><td>PC / Mobile</td></tr></tbody></table></figure><!-- /wp:table --></div><!-- /wp:group --><!-- wp:group {\"className\":\"pa-section\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group pa-section\"><!-- wp:group {\"className\":\"pa-section-head\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group pa-section-head\"><!-- wp:heading --><h2 class=\"wp-block-heading\">News &amp; guides</h2><!-- /wp:heading --><!-- wp:buttons --><div class=\"wp-block-buttons\"><!-- wp:button {\"className\":\"is-style-outline\"} --><div class=\"wp-block-button is-style-outline\"><a class=\"wp-block-button__link wp-element-button\" href=\"{{page:news}}\">Everything</a></div><!-- /wp:button --></div><!-- /wp:buttons --></div><!-- /wp:group --><!-- wp:latest-posts {\"postsToShow\":6,\"displayPostDate\":true,\"displayFeaturedImage\":true,\"featuredImageSizeSlug\":\"large\",\"postLayout\":\"grid\",\"columns\":3} /--></div><!-- /wp:group --><!-- wp:group {\"className\":\"pa-section pa-platforms\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group pa-section pa-platforms\"><!-- wp:heading --><h2 class=\"wp-block-heading\">Pick your platform</h2><!-- /wp:heading --><!-- wp:buttons --><div class=\"wp-block-buttons\"><!-- wp:button --><div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"{{tag:pc}}\">PC</a></div><!-- /wp:button --><!-- wp:button --><div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"{{tag:console}}\">Console</a></div><!-- /wp:button --><!-- wp:button --><div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"{{tag:handheld}}\">Handheld</a></div><!-- /wp:button --><!-- wp:button --><div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"{{tag:vr}}\">VR</a></div><!-- /wp:button --><!-- wp:button --><div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"{{tag:retro}}\">Retro</a></div><!-- /wp:button --><!-- wp:button --><div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"{{tag:indie}}\">Indie</a></div><!-- /wp:button --></div><!-- /wp:buttons --></div><!-- /wp:group --><!-- wp:group {\"className\":\"pa-section pa-insert-coin\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group pa-section pa-insert-coin\"><!-- wp:paragraph {\"className\":\"pa-kicker\"} --><p class=\"pa-kicker\">Insert coin</p><!-- /wp:paragraph --><!-- wp:heading --><h2 class=\"wp-block-heading\">Get the Friday save file</h2><!-- /wp:heading --><!-- wp:paragraph --><p>One email a week: the best reviews, the biggest news and one hidden gem you have never heard of.</p><!-- /wp:paragraph --><!-- wp:buttons --><div class=\"wp-block-buttons\"><!-- wp:button --><div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"{{page:contact}}\">Join the party</a></div><!-- /wp:button --></div><!-- /wp:buttons --></div><!-- /wp:group -->",
