{
  "slug": "velvet-runway",
  "name": "Velvet Runway",
  "version": "1.0.0",
  "description": "An elegant fashion and lifestyle magazine. A centred serif masthead, a cover story with an editorial mosaic below it, articles with standfirsts, drop caps and pull quotes, and a muted luxury palette with an optional evening (dark) edition. Bodoni Moda and Karla, self-hosted.",
  "author": "Pursae",
  "author_url": "https://github.com/pursae",
  "theme_url": "https://github.com/pursae/pursae-dev/tree/main/web/theme-library/velvet-runway",
  "tags": ["Fashion", "Magazine", "Blog", "Grid Layout", "Custom Colors", "Custom Logo", "Custom Menu", "Editor Style", "Featured Images", "Footer Widgets", "Threaded Comments", "Wide Blocks"],
  "requires_core": "0.1.0",
  "screenshot": "assets/screenshot.png",
  "category": "fashion",
  "style": "Editorial serif magazine, muted luxury",
  "demo": "demo/demo.json",

  "widget_areas": [
    {"id": "footer-1", "name": "Footer", "description": "Widgets under the footer masthead."}
  ],
  "menu_locations": [
    {"id": "primary", "name": "Sections Menu"},
    {"id": "footer", "name": "Footer Menu"}
  ],

  "styles": [
    {"handle": "velvet-runway-style", "src": "assets/style.css", "deps": ["wp-block-library"], "media": "all"}
  ],
  "scripts": [
    {"handle": "velvet-runway-navigation", "src": "assets/js/navigation.js", "deps": [], "in_footer": true}
  ],
  "editor_styles": ["assets/editor-style.css"],
  "preload_fonts": ["assets/fonts/bodoni-moda.woff2"],

  "palette": [
    {"name": "Oxblood", "slug": "oxblood", "color": "#6b1f2e"},
    {"name": "Espresso", "slug": "espresso", "color": "#1f1a17"},
    {"name": "Taupe", "slug": "taupe", "color": "#9a8a7c"},
    {"name": "Blush", "slug": "blush", "color": "#ead6cf"},
    {"name": "Ivory", "slug": "ivory", "color": "#f6f1ea"}
  ],
  "supports": {
    "post-thumbnails": true,
    "custom-logo": {"width": 360, "height": 90, "flex-width": true, "flex-height": true, "header-text": ["site-title", "site-description"]},
    "title-tag": true,
    "html5": ["search-form", "comment-form", "comment-list", "gallery", "caption", "script", "style"],
    "responsive-embeds": true,
    "align-wide": true,
    "wp-block-styles": true
  },

  "customizer": {
    "sections": [
      {
        "id": "velvet_colors", "title": "Colours & Type", "priority": 40,
        "settings": [
          {"id": "accent", "label": "Accent colour", "description": "Kickers, links and rules.", "type": "color", "default": "#6b1f2e", "transport": "postMessage", "css_var": "--vr-accent"},
          {"id": "background", "label": "Paper colour", "type": "color", "default": "#f6f1ea", "transport": "postMessage", "css_var": "--vr-bg"},
          {"id": "text_color", "label": "Ink colour", "type": "color", "default": "#1f1a17", "transport": "postMessage", "css_var": "--vr-ink"},
          {"id": "evening_edition", "label": "Evening edition (dark mode)", "description": "Switches the magazine to a dark palette.", "type": "checkbox", "default": false, "transport": "postMessage", "body_class": "vr-dark"},
          {"id": "font_pairing", "label": "Font pairing", "type": "select", "default": "bodoni-karla", "transport": "postMessage", "body_class": "vr-fonts-{value}",
            "choices": [{"value": "bodoni-karla", "label": "Bodoni Moda & Karla"}, {"value": "fraunces-karla", "label": "Fraunces & Karla"}, {"value": "classic", "label": "System serif"}]}
        ]
      },
      {
        "id": "velvet_layout", "title": "Masthead & Layout", "priority": 41,
        "settings": [
          {"id": "masthead", "label": "Masthead", "type": "select", "default": "grand", "transport": "postMessage", "body_class": "vr-masthead-{value}",
            "choices": [{"value": "grand", "label": "Grand, centred"}, {"value": "compact", "label": "Compact, centred"}, {"value": "left", "label": "Left aligned"}]},
          {"id": "home_layout", "label": "Front page layout", "type": "select", "default": "editorial", "transport": "postMessage", "body_class": "vr-home-{value}",
            "choices": [{"value": "editorial", "label": "Cover story and mosaic"}, {"value": "grid", "label": "Even grid"}, {"value": "list", "label": "Long list"}]},
          {"id": "drop_cap", "label": "Drop cap on articles", "type": "checkbox", "default": true, "transport": "postMessage", "body_class": "vr-dropcap"},
          {"id": "show_author", "label": "Show bylines", "type": "checkbox", "default": true, "transport": "postMessage", "body_class": "vr-show-author"},
          {"id": "issue_label", "label": "Issue line", "description": "The small line above the masthead, for example the season.", "type": "text", "default": "Autumn / Winter Edition", "transport": "refresh"},
          {"id": "footer_text", "label": "Footer text", "type": "text", "default": "", "transport": "refresh"}
        ]
      }
    ]
  }
}
