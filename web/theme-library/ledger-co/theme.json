{
  "slug": "ledger-co",
  "name": "Ledger & Co.",
  "version": "1.0.0",
  "description": "A trustworthy corporate theme for consultancies, advisory firms and professional services: a navy and slate palette with a brass accent, a split hero, service cards, a figures band, client wordmarks and an Insights blog with grid or list layouts.",
  "author": "Pursae",
  "author_url": "https://github.com/pursae",
  "theme_url": "https://github.com/pursae/pursae-dev/tree/main/web/theme-library/ledger-co",
  "tags": ["Business", "Corporate", "Consulting", "Two Columns", "Right Sidebar", "Left Sidebar", "Grid Layout", "Custom Colors", "Custom Logo", "Custom Menu", "Editor Style", "Featured Images", "Footer Widgets", "Sticky Header", "Threaded Comments", "Wide Blocks"],
  "requires_core": "0.1.0",
  "screenshot": "assets/screenshot.png",
  "category": "business",
  "style": "Corporate navy and slate, serif headings, brass accent",
  "demo": "demo/demo.json",

  "widget_areas": [
    {"id": "sidebar-1", "name": "Sidebar", "description": "Beside posts and archives (Customize › Blog & Footer sets the side)."},
    {"id": "footer-1", "name": "Footer", "description": "Columns in the navy footer, next to the site description."}
  ],
  "menu_locations": [
    {"id": "primary", "name": "Primary Menu"},
    {"id": "footer", "name": "Footer Menu"}
  ],

  "styles": [
    {"handle": "ledger-co-style", "src": "assets/style.css", "deps": ["wp-block-library"], "media": "all"}
  ],
  "scripts": [
    {"handle": "ledger-co-navigation", "src": "assets/js/navigation.js", "deps": [], "in_footer": true}
  ],
  "editor_styles": ["assets/editor-style.css"],
  "preload_fonts": ["assets/fonts/ibm-plex-sans-var.woff2", "assets/fonts/source-serif-4-600.woff2"],

  "palette": [
    {"name": "Navy", "slug": "navy", "color": "#13294b"},
    {"name": "Deep navy", "slug": "deep-navy", "color": "#0b1a33"},
    {"name": "Slate", "slug": "slate", "color": "#475569"},
    {"name": "Brass", "slug": "brass", "color": "#b08d57"},
    {"name": "Mist", "slug": "mist", "color": "#f3f5f8"},
    {"name": "White", "slug": "white", "color": "#ffffff"}
  ],
  "supports": {
    "post-thumbnails": true,
    "custom-logo": {"width": 220, "height": 60, "flex-width": true, "flex-height": true, "header-text": ["site-title", "site-description"]},
    "title-tag": true,
    "html5": ["search-form", "comment-form", "comment-list", "gallery", "caption", "script", "style"],
    "responsive-embeds": true,
    "align-wide": true,
    "wp-block-styles": true
  },

  "customizer": {
    "sections": [
      {
        "id": "ledger_brand", "title": "Brand & Colors", "description": "The corporate palette and typefaces.", "priority": 40,
        "settings": [
          {"id": "primary_color", "label": "Primary (navy)", "description": "Header, footer, figures band and headings.", "type": "color", "default": "#13294b", "transport": "postMessage", "css_var": "--lc-primary"},
          {"id": "accent_color", "label": "Accent (brass)", "description": "Rules, kickers, buttons and highlights.", "type": "color", "default": "#b08d57", "transport": "postMessage", "css_var": "--lc-accent"},
          {"id": "tint_color", "label": "Section tint", "description": "Background of alternating sections and cards.", "type": "color", "default": "#f3f5f8", "transport": "postMessage", "css_var": "--lc-tint"},
          {"id": "font_pairing", "label": "Typefaces", "type": "select", "default": "serif", "transport": "postMessage", "body_class": "lc-font-{value}",
            "choices": [{"value": "serif", "label": "Source Serif headings, IBM Plex Sans text"}, {"value": "sans", "label": "IBM Plex Sans throughout"}, {"value": "system", "label": "System fonts"}]}
        ]
      },
      {
        "id": "ledger_header", "title": "Header", "priority": 41,
        "settings": [
          {"id": "header_style", "label": "Header style", "type": "select", "default": "light", "transport": "postMessage", "body_class": "lc-header-{value}",
            "choices": [{"value": "light", "label": "White bar"}, {"value": "navy", "label": "Navy bar"}, {"value": "centered", "label": "Centered logo, menu below"}]},
          {"id": "sticky_header", "label": "Keep the header visible while scrolling", "type": "checkbox", "default": true, "transport": "postMessage", "body_class": "lc-sticky"},
          {"id": "show_topbar", "label": "Show the contact strip above the header", "type": "checkbox", "default": true, "transport": "refresh"},
          {"id": "topbar_text", "label": "Contact strip text", "type": "text", "default": "Mon–Fri 8:00–18:00 · +1 (555) 014-2200 · hello@ledger.example", "transport": "refresh"},
          {"id": "cta_label", "label": "Header button label", "description": "Leave empty to hide the button.", "type": "text", "default": "Book a consultation", "transport": "refresh"},
          {"id": "cta_url", "label": "Header button link", "type": "text", "default": "/contact/", "transport": "refresh"}
        ]
      },
      {
        "id": "ledger_hero", "title": "Front Page Hero", "description": "The split hero on a static front page. Without an image the page's featured image is used.", "priority": 42,
        "settings": [
          {"id": "hero_image", "label": "Hero image", "type": "image"},
          {"id": "hero_kicker", "label": "Small line above the heading", "type": "text", "default": "Advisory · Finance · Operations", "transport": "refresh"},
          {"id": "hero_heading", "label": "Heading", "description": "Empty uses the page title.", "type": "text", "default": "", "transport": "refresh"},
          {"id": "hero_text", "label": "Text", "type": "textarea", "default": "", "transport": "refresh"},
          {"id": "hero_button_label", "label": "Button label", "type": "text", "default": "Our services", "transport": "refresh"},
          {"id": "hero_button_url", "label": "Button link", "type": "text", "default": "#services", "transport": "refresh"}
        ]
      },
      {
        "id": "ledger_blog", "title": "Blog & Footer", "priority": 43,
        "settings": [
          {"id": "blog_layout", "label": "Post list layout", "type": "select", "default": "grid", "transport": "postMessage", "body_class": "lc-blog-{value}",
            "choices": [{"value": "grid", "label": "Cards in a grid"}, {"value": "list", "label": "List with thumbnails"}]},
          {"id": "sidebar_position", "label": "Sidebar", "type": "select", "default": "right", "transport": "postMessage", "body_class": "lc-sidebar-{value}",
            "choices": [{"value": "right", "label": "Right"}, {"value": "left", "label": "Left"}, {"value": "none", "label": "No sidebar"}]},
          {"id": "show_featured", "label": "Show featured images", "type": "checkbox", "default": true, "transport": "postMessage", "body_class": "lc-thumbs"},
          {"id": "show_author", "label": "Show the author on posts", "type": "checkbox", "default": true, "transport": "postMessage", "body_class": "lc-show-author"},
          {"id": "footer_text", "label": "Footer text", "description": "Replaces the copyright line.", "type": "text", "default": "", "transport": "refresh"}
        ]
      }
    ]
  }
}
