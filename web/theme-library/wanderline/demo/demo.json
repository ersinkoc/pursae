   "content": "<!-- wp:group {\"align\":\"full\",\"className\":\"wl-section\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group alignfull wl-section\"><!-- wp:paragraph {\"className\":\"wl-eyebrow\"} --><p class=\"wl-eyebrow\">Where to next?</p><!-- /wp:paragraph --><!-- wp:heading --><h2 class=\"wp-block-heading\">Pick a direction</h2><!-- /wp:heading --><!-- wp:paragraph --><p>Every story on Wanderline is filed by the kind of place it happened in. Choose a landscape and start reading.</p><!-- /wp:paragraph --><!-- wp:columns {\"align\":\"wide\",\"className\":\"wl-tiles\"} --><div class=\"wp-block-columns alignwide wl-tiles\"><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:cover {\"url\":\"{{media:mountains}}\",\"dimRatio\":50,\"minHeight\":340,\"minHeightUnit\":\"px\",\"align\":\"none\"} --><div class=\"wp-block-cover alignnone\" style=\"min-height:340px\"><span aria-hidden=\"true\" class=\"wp-block-cover__background has-background-dim-50 has-background-dim\"></span><img class=\"wp-block-cover__image-background\" alt=\"\" src=\"{{media:mountains}}\" data-object-fit=\"cover\"/><div class=\"wp-block-cover__inner-container\"><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\"><a href=\"{{category:mountains}}\">Mountains</a></h3><!-- /wp:heading --><!-- wp:paragraph --><p>12 trails</p><!-- /wp:paragraph --></div></div><!-- /wp:cover --></div><!-- /wp:column --><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:cover {\"url\":\"{{media:coast}}\",\"dimRatio\":50,\"minHeight\":340,\"minHeightUnit\":\"px\",\"align\":\"none\"} --><div class=\"wp-block-cover alignnone\" style=\"min-height:340px\"><span aria-hidden=\"true\" class=\"wp-block-cover__background has-background-dim-50 has-background-dim\"></span><img class=\"wp-block-cover__image-background\" alt=\"\" src=\"{{media:coast}}\" data-object-fit=\"cover\"/><div class=\"wp-block-cover__inner-container\"><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\"><a href=\"{{category:coastlines}}\">Coastlines</a></h3><!-- /wp:heading --><!-- wp:paragraph --><p>9 stories</p><!-- /wp:paragraph --></div></div><!-- /wp:cover --></div><!-- /wp:column --><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:cover {\"url\":\"{{media:city}}\",\"dimRatio\":50,\"minHeight\":340,\"minHeightUnit\":\"px\",\"align\":\"none\"} --><div class=\"wp-block-cover alignnone\" style=\"min-height:340px\"><span aria-hidden=\"true\" class=\"wp-block-cover__background has-background-dim-50 has-background-dim\"></span><img class=\"wp-block-cover__image-background\" alt=\"\" src=\"{{media:city}}\" data-object-fit=\"cover\"/><div class=\"wp-block-cover__inner-container\"><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\"><a href=\"{{category:city-breaks}}\">City Breaks</a></h3><!-- /wp:heading --><!-- wp:paragraph --><p>14 weekends</p><!-- /wp:paragraph --></div></div><!-- /wp:cover --></div><!-- /wp:column --></div><!-- /wp:columns --><!-- wp:columns {\"align\":\"wide\",\"className\":\"wl-tiles\"} --><div class=\"wp-block-columns alignwide wl-tiles\"><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:cover {\"url\":\"{{media:dunes}}\",\"dimRatio\":50,\"minHeight\":340,\"minHeightUnit\":\"px\",\"align\":\"none\"} --><div class=\"wp-block-cover alignnone\" style=\"min-height:340px\"><span aria-hidden=\"true\" class=\"wp-block-cover__background has-background-dim-50 has-background-dim\"></span><img class=\"wp-block-cover__image-background\" alt=\"\" src=\"{{media:dunes}}\" data-object-fit=\"cover\"/><div class=\"wp-block-cover__inner-container\"><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\"><a href=\"{{category:deserts}}\">Deserts</a></h3><!-- /wp:heading --><!-- wp:paragraph --><p>5 nights out</p><!-- /wp:paragraph --></div></div><!-- /wp:cover --></div><!-- /wp:column --><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:cover {\"url\":\"{{media:lakes}}\",\"dimRatio\":50,\"minHeight\":340,\"minHeightUnit\":\"px\",\"align\":\"none\"} --><div class=\"wp-block-cover alignnone\" style=\"min-height:340px\"><span aria-hidden=\"true\" class=\"wp-block-cover__background has-background-dim-50 has-background-dim\"></span><img class=\"wp-block-cover__image-background\" alt=\"\" src=\"{{media:lakes}}\" data-object-fit=\"cover\"/><div class=\"wp-block-cover__inner-container\"><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\"><a href=\"{{category:forests-lakes}}\">Forests &amp; Lakes</a></h3><!-- /wp:heading --><!-- wp:paragraph --><p>7 loops</p><!-- /wp:paragraph --></div></div><!-- /wp:cover --></div><!-- /wp:column --><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:cover {\"url\":\"{{media:pack}}\",\"dimRatio\":50,\"minHeight\":340,\"minHeightUnit\":\"px\",\"align\":\"none\"} --><div class=\"wp-block-cover alignnone\" style=\"min-height:340px\"><span aria-hidden=\"true\" class=\"wp-block-cover__background has-background-dim-50 has-background-dim\"></span><img class=\"wp-block-cover__image-background\" alt=\"\" src=\"{{media:pack}}\" data-object-fit=\"cover\"/><div class=\"wp-block-cover__inner-container\"><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\"><a href=\"{{category:field-notes}}\">Field Notes</a></h3><!-- /wp:heading --><!-- wp:paragraph --><p>Gear and how-to</p><!-- /wp:paragraph --></div></div><!-- /wp:cover --></div><!-- /wp:column --></div><!-- /wp:columns --></div><!-- /wp:group --><!-- wp:group {\"align\":\"full\",\"className\":\"wl-section wl-section--sand\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group alignfull wl-section wl-section--sand\"><!-- wp:paragraph {\"className\":\"wl-eyebrow\"} --><p class=\"wl-eyebrow\">Fresh from the road</p><!-- /wp:paragraph --><!-- wp:heading --><h2 class=\"wp-block-heading\">Latest stories</h2><!-- /wp:heading --><!-- wp:latest-posts {\"postsToShow\":3,\"displayPostContent\":true,\"excerptLength\":20,\"displayPostDate\":true,\"postLayout\":\"grid\",\"columns\":3} /--><!-- wp:buttons --><div class=\"wp-block-buttons\"><!-- wp:button --><div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"{{page:journal}}\">Read the journal</a></div><!-- /wp:button --></div><!-- /wp:buttons --></div><!-- /wp:group --><!-- wp:group {\"align\":\"full\",\"className\":\"wl-section wl-section--dusk\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group alignfull wl-section wl-section--dusk\"><!-- wp:columns {\"align\":\"wide\",\"className\":\"wl-stats\"} --><div class=\"wp-block-columns alignwide wl-stats\"><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:paragraph {\"className\":\"wl-stat\"} --><p class=\"wl-stat\">34</p><!-- /wp:paragraph --><!-- wp:paragraph --><p>countries, slowly</p><!-- /wp:paragraph --></div><!-- /wp:column --><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:paragraph {\"className\":\"wl-stat\"} --><p class=\"wl-stat\">2,140</p><!-- /wp:paragraph --><!-- wp:paragraph --><p>kilometres on foot</p><!-- /wp:paragraph --></div><!-- /wp:column --><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:paragraph {\"className\":\"wl-stat\"} --><p class=\"wl-stat\">61</p><!-- /wp:paragraph --><!-- wp:paragraph --><p>night trains</p><!-- /wp:paragraph --></div><!-- /wp:column --><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:paragraph {\"className\":\"wl-stat\"} --><p class=\"wl-stat\">1</p><!-- /wp:paragraph --><!-- wp:paragraph --><p>small backpack</p><!-- /wp:paragraph --></div><!-- /wp:column --></div><!-- /wp:columns --></div><!-- /wp:group --><!-- wp:group {\"align\":\"full\",\"className\":\"wl-section\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group alignfull wl-section\"><!-- wp:media-text {\"mediaType\":\"image\",\"className\":\"alignwide\"} --><div class=\"wp-block-media-text is-stacked-on-mobile alignwide\"><figure class=\"wp-block-media-text__media\"><img src=\"{{media:road}}\" alt=\"An empty road winding toward distant mountains\" class=\"size-full\"/></figure><div class=\"wp-block-media-text__content\"><!-- wp:paragraph {\"className\":\"wl-eyebrow\"} --><p class=\"wl-eyebrow\">Hello from the passenger seat</p><!-- /wp:paragraph --><!-- wp:heading --><h2 class=\"wp-block-heading\">Two backpacks, no fixed address</h2><!-- /wp:heading --><!-- wp:paragraph --><p>We are a pair of slow travellers writing about long walks, night trains and the small places most itineraries skip. No sponsored posts, no top-ten lists, just the road as we found it.</p><!-- /wp:paragraph --><!-- wp:buttons --><div class=\"wp-block-buttons\"><!-- wp:button {\"className\":\"is-style-outline\"} --><div class=\"wp-block-button is-style-outline\"><a class=\"wp-block-button__link wp-element-button\" href=\"{{page:about}}\">Our story</a></div><!-- /wp:button --></div><!-- /wp:buttons --></div></div><!-- /wp:media-text --></div><!-- /wp:group -->",
   "template": "",
