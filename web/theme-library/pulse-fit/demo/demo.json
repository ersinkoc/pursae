  {
   "slug": "schedule",
   "title": "Class schedule",
   "content": "<!-- wp:paragraph {\"className\":\"lead\"} --><p class=\"lead\">Classes run all year except public holidays. Book in the app up to seven days ahead; cancel up to two hours before so someone else can take your spot.</p><!-- /wp:paragraph -->\n\n<!-- wp:table {\"className\":\"schedule alignwide\"} --><figure class=\"wp-block-table schedule alignwide\"><table><thead><tr><th>Time</th><th>Mon</th><th>Tue</th><th>Wed</th><th>Thu</th><th>Fri</th><th>Sat / Sun</th></tr></thead><tbody><tr><td>06:00</td><td><strong>Strength</strong>Coach Mira</td><td><strong>HIIT</strong>Coach Dev<span class=\"intensity\">High</span></td><td><strong>Strength</strong>Coach Mira</td><td><strong>HIIT</strong>Coach Dev<span class=\"intensity\">High</span></td><td><strong>Strength</strong>Coach Mira</td><td><strong>Track</strong>Open session</td></tr><tr><td>07:15</td><td><strong>Spin 45</strong>Coach Rae</td><td><strong>Mobility</strong>Coach Jun<span class=\"intensity intensity--low\">Low</span></td><td><strong>Spin 45</strong>Coach Rae</td><td><strong>Boxing</strong>Coach Tomi</td><td><strong>Spin 45</strong>Coach Rae</td><td><strong>Mobility</strong>Coach Jun<span class=\"intensity intensity--low\">Low</span></td></tr><tr><td>12:30</td><td><strong>Express HIIT</strong>30 min</td><td><strong>Kettlebells</strong>Coach Dev</td><td><strong>Express HIIT</strong>30 min</td><td><strong>Kettlebells</strong>Coach Dev</td><td><strong>Express HIIT</strong>30 min</td><td>—</td></tr><tr><td>18:00</td><td><strong>Boxing</strong>Coach Tomi<span class=\"intensity\">High</span></td><td><strong>Strength</strong>Coach Mira</td><td><strong>Boxing</strong>Coach Tomi<span class=\"intensity\">High</span></td><td><strong>Spin 45</strong>Coach Rae</td><td><strong>Team WOD</strong>All coaches</td><td>—</td></tr><tr><td>19:30</td><td><strong>Mobility</strong>Coach Jun<span class=\"intensity intensity--low\">Low</span></td><td><strong>Spin 45</strong>Coach Rae</td><td><strong>Strength</strong>Coach Mira</td><td><strong>Mobility</strong>Coach Jun<span class=\"intensity intensity--low\">Low</span></td><td>—</td><td>—</td></tr></tbody></table></figure><!-- /wp:table -->\n\n<!-- wp:columns {\"align\":\"wide\"} --><div class=\"wp-block-columns alignwide\"><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">High intensity</h3><!-- /wp:heading --><!-- wp:paragraph --><p>Marked <span class=\"intensity\">High</span>: fast, sweaty and scalable. Tell your coach if it is your first time.</p><!-- /wp:paragraph --></div><!-- /wp:column --><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Low intensity</h3><!-- /wp:heading --><!-- wp:paragraph --><p>Marked <span class=\"intensity intensity--low\">Low</span>: mobility and recovery. Perfect on rest days.</p><!-- /wp:paragraph --></div><!-- /wp:column --><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Open gym</h3><!-- /wp:heading --><!-- wp:paragraph --><p>The gym floor is open from 5am to 11pm whenever there is no class in the main room.</p><!-- /wp:paragraph --></div><!-- /wp:column --></div><!-- /wp:columns -->"
  },
  {
   "slug": "trainers",
   "title": "Trainers",
   "content": "<!-- wp:paragraph {\"className\":\"lead\"} --><p class=\"lead\">Every coach at Pulse Fit holds a recognised qualification, first-aid certificate and, most importantly, a genuine love of helping people move better.</p><!-- /wp:paragraph -->\n\n<!-- wp:columns {\"align\":\"wide\"} --><div class=\"wp-block-columns alignwide\"><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:group {\"className\":\"trainer\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group trainer\"><!-- wp:image {\"sizeSlug\":\"large\"} --><figure class=\"wp-block-image size-large\"><img src=\"{{media:plates}}\" alt=\"Weight plates\"/></figure><!-- /wp:image --><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Mira</h3><!-- /wp:heading --><!-- wp:paragraph {\"className\":\"role\"} --><p class=\"role\">Strength coach</p><!-- /wp:paragraph --><!-- wp:paragraph --><p>Former competitive lifter who now teaches beginners to love the barbell.</p><!-- /wp:paragraph --></div><!-- /wp:group --></div><!-- /wp:column --></div><!-- /wp:column --><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:group {\"className\":\"trainer\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group trainer\"><!-- wp:image {\"sizeSlug\":\"large\"} --><figure class=\"wp-block-image size-large\"><img src=\"{{media:stopwatch}}\" alt=\"A stopwatch\"/></figure><!-- /wp:image --><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Dev</h3><!-- /wp:heading --><!-- wp:paragraph {\"className\":\"role\"} --><p class=\"role\">HIIT &amp; kettlebells</p><!-- /wp:paragraph --><!-- wp:paragraph --><p>Builds sessions that are hard, fun and over before you know it.</p><!-- /wp:paragraph --></div><!-- /wp:group --></div><!-- /wp:column --></div><!-- /wp:column --><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:group {\"className\":\"trainer\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group trainer\"><!-- wp:image {\"sizeSlug\":\"large\"} --><figure class=\"wp-block-image size-large\"><img src=\"{{media:spin}}\" alt=\"Spin bikes\"/></figure><!-- /wp:image --><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Rae</h3><!-- /wp:heading --><!-- wp:paragraph {\"className\":\"role\"} --><p class=\"role\">Spin lead</p><!-- /wp:paragraph --><!-- wp:paragraph --><p>Plays the best playlists in the building. Rides every class with you.</p><!-- /wp:paragraph --></div><!-- /wp:group --></div><!-- /wp:column --></div><!-- /wp:column --><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:group {\"className\":\"trainer\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group trainer\"><!-- wp:image {\"sizeSlug\":\"large\"} --><figure class=\"wp-block-image size-large\"><img src=\"{{media:yoga}}\" alt=\"A yoga mat\"/></figure><!-- /wp:image --><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Jun</h3><!-- /wp:heading --><!-- wp:paragraph {\"className\":\"role\"} --><p class=\"role\">Mobility &amp; recovery</p><!-- /wp:paragraph --><!-- wp:paragraph --><p>Helps stiff hips and busy minds slow down for an hour.</p><!-- /wp:paragraph --></div><!-- /wp:group --></div><!-- /wp:column --></div><!-- /wp:column --></div><!-- /wp:columns -->\n\n<!-- wp:pullquote --><figure class=\"wp-block-pullquote\"><blockquote><p>We coach people, not workouts.</p><cite>The Pulse Fit team</cite></blockquote></figure><!-- /wp:pullquote -->",
   "parent": "schedule"
  },
  {
   "slug": "membership",
   "title": "Membership",
   "content": "<!-- wp:paragraph {\"className\":\"lead\"} --><p class=\"lead\">No joining fee, no long contracts. Every plan can be paused for up to two months a year.</p><!-- /wp:paragraph -->\n\n<!-- wp:columns {\"align\":\"wide\"} --><div class=\"wp-block-columns alignwide\"><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:group {\"className\":\"plan\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group plan\"><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Flex</h3><!-- /wp:heading --><!-- wp:paragraph {\"className\":\"price\"} --><p class=\"price\">$59<small> / month</small></p><!-- /wp:paragraph --><!-- wp:list --><ul class=\"wp-block-list\"><!-- wp:list-item --><li>8 classes a month</li><!-- /wp:list-item --><!-- wp:list-item --><li>Open gym off-peak</li><!-- /wp:list-item --><!-- wp:list-item --><li>App booking</li><!-- /wp:list-item --></ul><!-- /wp:list --></div><!-- /wp:group --></div><!-- /wp:column --></div><!-- /wp:column --><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:group {\"className\":\"plan is-featured\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group plan is-featured\"><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Unlimited</h3><!-- /wp:heading --><!-- wp:paragraph {\"className\":\"price\"} --><p class=\"price\">$89<small> / month</small></p><!-- /wp:paragraph --><!-- wp:list --><ul class=\"wp-block-list\"><!-- wp:list-item --><li>Unlimited classes</li><!-- /wp:list-item --><!-- wp:list-item --><li>Open gym 5am–11pm</li><!-- /wp:list-item --><!-- wp:list-item --><li>Monthly coach check-in</li><!-- /wp:list-item --><!-- wp:list-item --><li>Bring a friend on Fridays</li><!-- /wp:list-item --></ul><!-- /wp:list --></div><!-- /wp:group --></div><!-- /wp:column --></div><!-- /wp:column --><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:group {\"className\":\"plan\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group plan\"><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Coached</h3><!-- /wp:heading --><!-- wp:paragraph {\"className\":\"price\"} --><p class=\"price\">$149<small> / month</small></p><!-- /wp:paragraph --><!-- wp:list --><ul class=\"wp-block-list\"><!-- wp:list-item --><li>Everything in Unlimited</li><!-- /wp:list-item --><!-- wp:list-item --><li>Two personal sessions</li><!-- /wp:list-item --><!-- wp:list-item --><li>Written programme</li><!-- /wp:list-item --></ul><!-- /wp:list --></div><!-- /wp:group --></div><!-- /wp:column --></div><!-- /wp:column --></div><!-- /wp:columns -->\n\n<!-- wp:heading --><h2 class=\"wp-block-heading\">Questions</h2><!-- /wp:heading -->\n\n<!-- wp:list --><ul class=\"wp-block-list\"><!-- wp:list-item --><li><strong>Can I try before I join?</strong> Yes: your first week is free.</li><!-- /wp:list-item --><!-- wp:list-item --><li><strong>Is there a student rate?</strong> Twenty percent off any plan with a valid card.</li><!-- /wp:list-item --><!-- wp:list-item --><li><strong>How do I cancel?</strong> One month's notice from the app or at the desk.</li><!-- /wp:list-item --></ul><!-- /wp:list -->\n\n<!-- wp:buttons --><div class=\"wp-block-buttons\"><!-- wp:button --><div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"{{page:contact}}\">Start your free week</a></div><!-- /wp:button --></div><!-- /wp:buttons -->"
