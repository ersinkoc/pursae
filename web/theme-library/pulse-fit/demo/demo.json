 "posts": [
  {
   "slug": "twenty-minute-kettlebell-burner",
   "title": "The 20-minute kettlebell burner",
   "date": "2026-10-21T06:00:00",
   "categories": [
    "workouts"
   ],
   "tags": [
    "kettlebell",
    "hiit"
   ],
   "featured_media": "kettlebells",
   "sticky": true,
   "excerpt": "One bell, five moves, four rounds. A full-body session you can do in the studio or the living room.",
   "content": "<!-- wp:paragraph --><p>No time? No problem. This circuit hits legs, back, core and lungs in twenty minutes with a single kettlebell. Pick a weight you can swing for fifteen clean reps.</p><!-- /wp:paragraph -->\n\n<!-- wp:columns {\"className\":\"stat-row\"} --><div class=\"wp-block-columns stat-row\"><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:paragraph {\"className\":\"big\"} --><p class=\"big\">20 min</p><!-- /wp:paragraph --><!-- wp:paragraph --><p>Time</p><!-- /wp:paragraph --></div><!-- /wp:column --><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:paragraph {\"className\":\"big\"} --><p class=\"big\">4</p><!-- /wp:paragraph --><!-- wp:paragraph --><p>Rounds</p><!-- /wp:paragraph --></div><!-- /wp:column --><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:paragraph {\"className\":\"big\"} --><p class=\"big\">All</p><!-- /wp:paragraph --><!-- wp:paragraph --><p>Level</p><!-- /wp:paragraph --></div><!-- /wp:column --></div><!-- /wp:columns -->\n\n<!-- wp:heading --><h2 class=\"wp-block-heading\">The circuit</h2><!-- /wp:heading -->\n\n<!-- wp:list {\"ordered\":true,\"className\":\"workout\"} --><ol class=\"wp-block-list workout\"><!-- wp:list-item --><li><strong>Swings × 15</strong> Hinge, snap the hips, let the bell float.</li><!-- /wp:list-item --><!-- wp:list-item --><li><strong>Goblet squats × 10</strong> Elbows inside the knees, chest proud.</li><!-- /wp:list-item --><!-- wp:list-item --><li><strong>Single-arm rows × 8 each</strong> Pull to the hip, not the shoulder.</li><!-- /wp:list-item --><!-- wp:list-item --><li><strong>Push-ups × 10</strong> Knees down is fine; quality first.</li><!-- /wp:list-item --><!-- wp:list-item --><li><strong>Farmer carry × 40 m</strong> Switch hands halfway. Walk tall.</li><!-- /wp:list-item --></ol><!-- /wp:list -->\n\n<!-- wp:paragraph --><p>Rest 60 seconds between rounds. Write down your weight and time so you can beat it next week.</p><!-- /wp:paragraph -->\n\n<!-- wp:pullquote --><figure class=\"wp-block-pullquote\"><blockquote><p>Fast is fine. Accurate is final.</p><cite>Coach's rule</cite></blockquote></figure><!-- /wp:pullquote -->\n\n<!-- wp:image {\"sizeSlug\":\"large\"} --><figure class=\"wp-block-image size-large\"><img src=\"{{media:stopwatch}}\" alt=\"A stopwatch with a lime rim\"/><figcaption class=\"wp-element-caption\">Use a timer: twenty minutes, every minute counted.</figcaption></figure><!-- /wp:image -->",
   "comments": [
