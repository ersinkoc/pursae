   "slug": "home",
   "title": "Stronger every week",
   "content": "<!-- wp:group {\"align\":\"full\",\"className\":\"section-programs\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group alignfull section-programs\"><!-- wp:paragraph {\"className\":\"kicker\"} --><p class=\"kicker\">Programs</p><!-- /wp:paragraph --><!-- wp:heading {\"className\":\"section-title\"} --><h2 class=\"wp-block-heading section-title\">Train <span class=\"outline-text\">your</span> way</h2><!-- /wp:heading --><!-- wp:columns {\"align\":\"wide\"} --><div class=\"wp-block-columns alignwide\"><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:group {\"className\":\"program\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group program\"><!-- wp:paragraph {\"className\":\"num\"} --><p class=\"num\">01</p><!-- /wp:paragraph --><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Strength</h3><!-- /wp:heading --><!-- wp:paragraph --><p>Barbells, kettlebells and coaching on every rep. Get strong, safely.</p><!-- /wp:paragraph --></div><!-- /wp:group --></div><!-- /wp:column --></div><!-- /wp:column --><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:group {\"className\":\"program\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group program\"><!-- wp:paragraph {\"className\":\"num\"} --><p class=\"num\">02</p><!-- /wp:paragraph --><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">HIIT</h3><!-- /wp:heading --><!-- wp:paragraph --><p>Short, sharp intervals that leave you buzzing, in thirty or forty-five minutes.</p><!-- /wp:paragraph --></div><!-- /wp:group --></div><!-- /wp:column --></div><!-- /wp:column --><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:group {\"className\":\"program\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group program\"><!-- wp:paragraph {\"className\":\"num\"} --><p class=\"num\">03</p><!-- /wp:paragraph --><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Spin</h3><!-- /wp:heading --><!-- wp:paragraph --><p>Lights down, music up. Rhythm rides and climbs for every fitness level.</p><!-- /wp:paragraph --></div><!-- /wp:group --></div><!-- /wp:column --></div><!-- /wp:column --><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:group {\"className\":\"program\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group program\"><!-- wp:paragraph {\"className\":\"num\"} --><p class=\"num\">04</p><!-- /wp:paragraph --><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Mobility</h3><!-- /wp:heading --><!-- wp:paragraph --><p>Stretch, breathe and move better. The class your other classes need.</p><!-- /wp:paragraph --></div><!-- /wp:group --></div><!-- /wp:column --></div><!-- /wp:column --></div><!-- /wp:columns --></div><!-- /wp:group -->\n\n<!-- wp:group {\"align\":\"full\",\"className\":\"section-trial\",\"backgroundColor\":\"lime\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group alignfull section-trial has-lime-background-color has-background\"><!-- wp:columns {\"align\":\"wide\"} --><div class=\"wp-block-columns alignwide\"><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:paragraph {\"className\":\"kicker\"} --><p class=\"kicker\">Free trial</p><!-- /wp:paragraph --><!-- wp:heading {\"className\":\"section-title\"} --><h2 class=\"wp-block-heading section-title\">Your first week is <span class=\"outline-text\">on us</span></h2><!-- /wp:heading --><!-- wp:paragraph --><p>Seven days of unlimited classes, a welcome session with a coach and no contract. Bring a friend and you both get a second week free.</p><!-- /wp:paragraph --><!-- wp:buttons --><div class=\"wp-block-buttons\"><!-- wp:button --><div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"{{page:membership}}\">Claim your free week</a></div><!-- /wp:button --></div><!-- /wp:buttons --></div><!-- /wp:column --><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:image {\"sizeSlug\":\"large\"} --><figure class=\"wp-block-image size-large\"><img src=\"{{media:trainers}}\" alt=\"Three coaches standing together\"/></figure><!-- /wp:image --></div><!-- /wp:column --></div><!-- /wp:columns --></div><!-- /wp:group -->\n\n<!-- wp:group {\"align\":\"full\",\"className\":\"section-schedule\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group alignfull section-schedule\"><!-- wp:paragraph {\"className\":\"kicker\"} --><p class=\"kicker\">Timetable</p><!-- /wp:paragraph --><!-- wp:heading {\"className\":\"section-title\"} --><h2 class=\"wp-block-heading section-title\">This week at the studio</h2><!-- /wp:heading --><!-- wp:table {\"className\":\"schedule alignwide\"} --><figure class=\"wp-block-table schedule alignwide\"><table><thead><tr><th>Time</th><th>Mon</th><th>Tue</th><th>Wed</th><th>Thu</th><th>Fri</th><th>Sat / Sun</th></tr></thead><tbody><tr><td>06:00</td><td><strong>Strength</strong>Coach Mira</td><td><strong>HIIT</strong>Coach Dev<span class=\"intensity\">High</span></td><td><strong>Strength</strong>Coach Mira</td><td><strong>HIIT</strong>Coach Dev<span class=\"intensity\">High</span></td><td><strong>Strength</strong>Coach Mira</td><td><strong>Track</strong>Open session</td></tr><tr><td>07:15</td><td><strong>Spin 45</strong>Coach Rae</td><td><strong>Mobility</strong>Coach Jun<span class=\"intensity intensity--low\">Low</span></td><td><strong>Spin 45</strong>Coach Rae</td><td><strong>Boxing</strong>Coach Tomi</td><td><strong>Spin 45</strong>Coach Rae</td><td><strong>Mobility</strong>Coach Jun<span class=\"intensity intensity--low\">Low</span></td></tr><tr><td>12:30</td><td><strong>Express HIIT</strong>30 min</td><td><strong>Kettlebells</strong>Coach Dev</td><td><strong>Express HIIT</strong>30 min</td><td><strong>Kettlebells</strong>Coach Dev</td><td><strong>Express HIIT</strong>30 min</td><td>—</td></tr></tbody></table></figure><!-- /wp:table --><!-- wp:buttons --><div class=\"wp-block-buttons\"><!-- wp:button {\"className\":\"is-style-outline\"} --><div class=\"wp-block-button is-style-outline\"><a class=\"wp-block-button__link wp-element-button\" href=\"{{page:schedule}}\">Full schedule</a></div><!-- /wp:button --></div><!-- /wp:buttons --></div><!-- /wp:group -->\n\n<!-- wp:group {\"align\":\"full\",\"className\":\"section-plans\",\"backgroundColor\":\"graphite\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group alignfull section-plans has-graphite-background-color has-background\"><!-- wp:paragraph {\"className\":\"kicker\"} --><p class=\"kicker\">Membership</p><!-- /wp:paragraph --><!-- wp:heading {\"className\":\"section-title\"} --><h2 class=\"wp-block-heading section-title\">Pick a plan, start today</h2><!-- /wp:heading --><!-- wp:columns {\"align\":\"wide\"} --><div class=\"wp-block-columns alignwide\"><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:group {\"className\":\"plan\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group plan\"><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Flex</h3><!-- /wp:heading --><!-- wp:paragraph {\"className\":\"price\"} --><p class=\"price\">$59<small> / month</small></p><!-- /wp:paragraph --><!-- wp:list --><ul class=\"wp-block-list\"><!-- wp:list-item --><li>8 classes a month</li><!-- /wp:list-item --><!-- wp:list-item --><li>Open gym off-peak</li><!-- /wp:list-item --><!-- wp:list-item --><li>App booking</li><!-- /wp:list-item --></ul><!-- /wp:list --><!-- wp:buttons --><div class=\"wp-block-buttons\"><!-- wp:button {\"className\":\"is-style-outline\"} --><div class=\"wp-block-button is-style-outline\"><a class=\"wp-block-button__link wp-element-button\" href=\"{{page:membership}}\">Choose Flex</a></div><!-- /wp:button --></div><!-- /wp:buttons --></div><!-- /wp:group --></div><!-- /wp:column --></div><!-- /wp:column --><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:group {\"className\":\"plan is-featured\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group plan is-featured\"><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Unlimited</h3><!-- /wp:heading --><!-- wp:paragraph {\"className\":\"price\"} --><p class=\"price\">$89<small> / month</small></p><!-- /wp:paragraph --><!-- wp:list --><ul class=\"wp-block-list\"><!-- wp:list-item --><li>Unlimited classes</li><!-- /wp:list-item --><!-- wp:list-item --><li>Open gym 5am–11pm</li><!-- /wp:list-item --><!-- wp:list-item --><li>Monthly coach check-in</li><!-- /wp:list-item --><!-- wp:list-item --><li>Bring a friend on Fridays</li><!-- /wp:list-item --></ul><!-- /wp:list --><!-- wp:buttons --><div class=\"wp-block-buttons\"><!-- wp:button --><div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"{{page:membership}}\">Choose Unlimited</a></div><!-- /wp:button --></div><!-- /wp:buttons --></div><!-- /wp:group --></div><!-- /wp:column --></div><!-- /wp:column --><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:group {\"className\":\"plan\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group plan\"><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Coached</h3><!-- /wp:heading --><!-- wp:paragraph {\"className\":\"price\"} --><p class=\"price\">$149<small> / month</small></p><!-- /wp:paragraph --><!-- wp:list --><ul class=\"wp-block-list\"><!-- wp:list-item --><li>Everything in Unlimited</li><!-- /wp:list-item --><!-- wp:list-item --><li>Two personal sessions</li><!-- /wp:list-item --><!-- wp:list-item --><li>Written programme</li><!-- /wp:list-item --></ul><!-- /wp:list --><!-- wp:buttons --><div class=\"wp-block-buttons\"><!-- wp:button {\"className\":\"is-style-outline\"} --><div class=\"wp-block-button is-style-outline\"><a class=\"wp-block-button__link wp-element-button\" href=\"{{page:membership}}\">Choose Coached</a></div><!-- /wp:button --></div><!-- /wp:buttons --></div><!-- /wp:group --></div><!-- /wp:column --></div><!-- /wp:column --></div><!-- /wp:columns --></div><!-- /wp:group -->\n\n<!-- wp:group {\"align\":\"full\",\"className\":\"section-journal\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group alignfull section-journal\"><!-- wp:paragraph {\"className\":\"kicker\"} --><p class=\"kicker\">Journal</p><!-- /wp:paragraph --><!-- wp:heading {\"className\":\"section-title\"} --><h2 class=\"wp-block-heading section-title\">Workouts &amp; advice</h2><!-- /wp:heading --><!-- wp:latest-posts {\"postsToShow\":3,\"displayPostContent\":true,\"excerptLength\":18,\"displayPostDate\":true,\"postLayout\":\"grid\",\"columns\":3,\"align\":\"wide\"} /--></div><!-- /wp:group -->",
