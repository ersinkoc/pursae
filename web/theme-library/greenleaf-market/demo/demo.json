   "slug": "home",
   "title": "Fresh from fields you can cycle to",
   "content": "<!-- wp:group {\"align\":\"wide\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group alignwide\"><!-- wp:columns {\"align\":\"wide\"} --><div class=\"wp-block-columns alignwide\"><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:group {\"className\":\"feature-card\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group feature-card\"><!-- wp:paragraph {\"className\":\"icon\"} --><p class=\"icon\">✿</p><!-- /wp:paragraph --><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Grown within 30 miles</h3><!-- /wp:heading --><!-- wp:paragraph --><p>Nine farms, a dairy, a bakery and a beekeeper. We know them all by name.</p><!-- /wp:paragraph --></div><!-- /wp:group --></div><!-- /wp:column --><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:group {\"className\":\"feature-card\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group feature-card\"><!-- wp:paragraph {\"className\":\"icon\"} --><p class=\"icon\">♻</p><!-- /wp:paragraph --><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Plastic-free shelves</h3><!-- /wp:heading --><!-- wp:paragraph --><p>Bring your own jars for oils, grains, soap and coffee.</p><!-- /wp:paragraph --></div><!-- /wp:group --></div><!-- /wp:column --><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:group {\"className\":\"feature-card\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group feature-card\"><!-- wp:paragraph {\"className\":\"icon\"} --><p class=\"icon\">✦</p><!-- /wp:paragraph --><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Fair to growers</h3><!-- /wp:heading --><!-- wp:paragraph --><p>Farmers set their own prices and are paid within a week.</p><!-- /wp:paragraph --></div><!-- /wp:group --></div><!-- /wp:column --></div><!-- /wp:columns --></div><!-- /wp:group -->\n\n<!-- wp:group {\"align\":\"full\",\"className\":\"section-band\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group alignfull section-band\"><!-- wp:columns {\"align\":\"wide\"} --><div class=\"wp-block-columns alignwide\"><!-- wp:column {\"width\":\"58%\"} --><div class=\"wp-block-column\" style=\"flex-basis:58%\"><!-- wp:group {\"className\":\"chalkboard\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group chalkboard\"><!-- wp:paragraph {\"className\":\"eyebrow\"} --><p class=\"eyebrow\">This week's box</p><!-- /wp:paragraph --><!-- wp:heading --><h2 class=\"wp-block-heading\">Week 44 · Small box</h2><!-- /wp:heading --><!-- wp:list {\"className\":\"price-list\"} --><ul class=\"wp-block-list price-list\"><!-- wp:list-item --><li><strong>Vine tomatoes</strong> <span class=\"price\">500 g</span> <span class=\"desc\">Hal's polytunnel, the last of the season</span></li><!-- /wp:list-item --><!-- wp:list-item --><li><strong>Rainbow carrots</strong> <span class=\"price\">1 kg</span> <span class=\"desc\">Muddy on purpose; they keep longer</span></li><!-- /wp:list-item --><!-- wp:list-item --><li><strong>Cavolo nero</strong> <span class=\"price\">1 bunch</span> <span class=\"desc\">Strip the leaves, keep the stems for soup</span></li><!-- /wp:list-item --><!-- wp:list-item --><li><strong>Cox apples</strong> <span class=\"price\">6</span> <span class=\"desc\">From the orchard at Millbrook End</span></li><!-- /wp:list-item --><!-- wp:list-item --><li><strong>Victoria plums</strong> <span class=\"price\">500 g</span> <span class=\"desc\">Ripe now: eat within three days</span></li><!-- /wp:list-item --><!-- wp:list-item --><li><strong>Red onions</strong> <span class=\"price\">4</span> <span class=\"desc\">Dry-stored, lasts for weeks</span></li><!-- /wp:list-item --></ul><!-- /wp:list --><!-- wp:buttons --><div class=\"wp-block-buttons\"><!-- wp:button --><div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"{{page:weekly-box}}\">Order by Wednesday noon</a></div><!-- /wp:button --></div><!-- /wp:buttons --></div><!-- /wp:group --></div><!-- /wp:column --><!-- wp:column {\"width\":\"42%\"} --><div class=\"wp-block-column\" style=\"flex-basis:42%\"><!-- wp:paragraph {\"className\":\"eyebrow\"} --><p class=\"eyebrow\">How the box works</p><!-- /wp:paragraph --><!-- wp:heading {\"className\":\"section-title\"} --><h2 class=\"wp-block-heading section-title\">Pick a size, we fill it with whatever is best</h2><!-- /wp:heading --><!-- wp:list --><ul class=\"wp-block-list\"><!-- wp:list-item --><li>Small box $24 · for one or two</li><!-- /wp:list-item --><!-- wp:list-item --><li>Family box $38 · for three to five</li><!-- /wp:list-item --><!-- wp:list-item --><li>Fruit only $18 · for snacking households</li><!-- /wp:list-item --></ul><!-- /wp:list --><!-- wp:paragraph --><p>Collect on Friday from the shop or get free delivery within five miles. Skip or pause any week.</p><!-- /wp:paragraph --></div><!-- /wp:column --></div><!-- /wp:columns --></div><!-- /wp:group -->\n\n<!-- wp:group {\"align\":\"wide\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group alignwide\"><!-- wp:paragraph {\"align\":\"center\",\"className\":\"eyebrow\"} --><p class=\"has-text-align-center eyebrow\">On the shelves</p><!-- /wp:paragraph --><!-- wp:heading {\"textAlign\":\"center\",\"className\":\"section-title\"} --><h2 class=\"wp-block-heading has-text-align-center section-title\">Fresh this week</h2><!-- /wp:heading --><!-- wp:columns {\"align\":\"wide\"} --><div class=\"wp-block-columns alignwide\"><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:group {\"className\":\"price-tag\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group price-tag\"><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Sourdough</h3><!-- /wp:heading --><!-- wp:paragraph --><p>Ilse's long-ferment loaf</p><!-- /wp:paragraph --><!-- wp:paragraph {\"className\":\"price-from\"} --><p class=\"price-from\">$6.50</p><!-- /wp:paragraph --></div><!-- /wp:group --></div><!-- /wp:column --><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:group {\"className\":\"price-tag\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group price-tag\"><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Free-range eggs</h3><!-- /wp:heading --><!-- wp:paragraph --><p>Half dozen, mixed sizes</p><!-- /wp:paragraph --><!-- wp:paragraph {\"className\":\"price-from\"} --><p class=\"price-from\">$4.20</p><!-- /wp:paragraph --></div><!-- /wp:group --></div><!-- /wp:column --><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:group {\"className\":\"price-tag\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group price-tag\"><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Raw honey</h3><!-- /wp:heading --><!-- wp:paragraph --><p>Wildflower, 340 g jar</p><!-- /wp:paragraph --><!-- wp:paragraph {\"className\":\"price-from\"} --><p class=\"price-from\">$9.00</p><!-- /wp:paragraph --></div><!-- /wp:group --></div><!-- /wp:column --><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:group {\"className\":\"price-tag\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group price-tag\"><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Oat milk</h3><!-- /wp:heading --><!-- wp:paragraph --><p>Refill, per litre</p><!-- /wp:paragraph --><!-- wp:paragraph {\"className\":\"price-from\"} --><p class=\"price-from\">$2.80</p><!-- /wp:paragraph --></div><!-- /wp:group --></div><!-- /wp:column --></div><!-- /wp:columns --></div><!-- /wp:group -->\n\n<!-- wp:group {\"align\":\"full\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group alignfull\"><!-- wp:paragraph {\"align\":\"center\",\"className\":\"eyebrow\"} --><p class=\"has-text-align-center eyebrow\">Meet the growers</p><!-- /wp:paragraph --><!-- wp:heading {\"textAlign\":\"center\",\"className\":\"section-title\"} --><h2 class=\"wp-block-heading has-text-align-center section-title\">The people behind the produce</h2><!-- /wp:heading --><!-- wp:columns {\"align\":\"wide\"} --><div class=\"wp-block-columns alignwide\"><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:group {\"className\":\"team-card\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group team-card\"><!-- wp:image {\"id\":{{media_id:grower-hal}},\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} --><figure class=\"wp-block-image size-large\"><img src=\"{{media:grower-hal}}\" alt=\"Portrait illustration of Hal\" class=\"wp-image-{{media_id:grower-hal}}\"/></figure><!-- /wp:image --><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Hal</h3><!-- /wp:heading --><!-- wp:paragraph {\"className\":\"role\"} --><p class=\"role\">Tomatoes &amp; salad</p><!-- /wp:paragraph --><!-- wp:paragraph --><p>Three polytunnels and a field of squash on the river meadow.</p><!-- /wp:paragraph --></div><!-- /wp:group --></div><!-- /wp:column --><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:group {\"className\":\"team-card\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group team-card\"><!-- wp:image {\"id\":{{media_id:grower-noor}},\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} --><figure class=\"wp-block-image size-large\"><img src=\"{{media:grower-noor}}\" alt=\"Portrait illustration of Noor\" class=\"wp-image-{{media_id:grower-noor}}\"/></figure><!-- /wp:image --><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Noor</h3><!-- /wp:heading --><!-- wp:paragraph {\"className\":\"role\"} --><p class=\"role\">Orchard fruit</p><!-- /wp:paragraph --><!-- wp:paragraph --><p>Forty-two apple varieties, some older than the village church.</p><!-- /wp:paragraph --></div><!-- /wp:group --></div><!-- /wp:column --><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:group {\"className\":\"team-card\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group team-card\"><!-- wp:image {\"id\":{{media_id:baker-ilse}},\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} --><figure class=\"wp-block-image size-large\"><img src=\"{{media:baker-ilse}}\" alt=\"Portrait illustration of Ilse\" class=\"wp-image-{{media_id:baker-ilse}}\"/></figure><!-- /wp:image --><!-- wp:heading {\"level\":3} --><h3 class=\"wp-block-heading\">Ilse</h3><!-- /wp:heading --><!-- wp:paragraph {\"className\":\"role\"} --><p class=\"role\">Sourdough &amp; buns</p><!-- /wp:paragraph --><!-- wp:paragraph --><p>Bakes through the night so our shelves are full by eight.</p><!-- /wp:paragraph --></div><!-- /wp:group --></div><!-- /wp:column --></div><!-- /wp:columns --><!-- wp:buttons {\"layout\":{\"type\":\"flex\",\"justifyContent\":\"center\"}} --><div class=\"wp-block-buttons is-content-justification-center is-layout-flex\"><!-- wp:button --><div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"{{page:producers}}\">All our producers</a></div><!-- /wp:button --></div><!-- /wp:buttons --></div><!-- /wp:group -->\n\n<!-- wp:group {\"align\":\"full\",\"className\":\"section-band\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group alignfull section-band\"><!-- wp:paragraph {\"align\":\"center\",\"className\":\"eyebrow\"} --><p class=\"has-text-align-center eyebrow\">Recipes &amp; news</p><!-- /wp:paragraph --><!-- wp:heading {\"textAlign\":\"center\",\"className\":\"section-title\"} --><h2 class=\"wp-block-heading has-text-align-center section-title\">From the market table</h2><!-- /wp:heading --><!-- wp:latest-posts {\"postsToShow\":3,\"displayPostDate\":true,\"postLayout\":\"grid\",\"columns\":3,\"align\":\"wide\",\"displayPostContent\":true,\"excerptLength\":18,\"displayFeaturedImage\":true,\"featuredImageSizeSlug\":\"medium_large\"} /--></div><!-- /wp:group -->",
