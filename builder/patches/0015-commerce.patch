diff --git a/src/builder/dynamic/shop-inspector.tsx b/src/builder/dynamic/shop-inspector.tsx
new file mode 100644
index 0000000..8e0cb2e
--- /dev/null
+++ b/src/builder/dynamic/shop-inspector.tsx
@@ -0,0 +1,232 @@
+import { useEffect, useState, type ReactNode } from 'react'
+import { useB } from '../store'
+import type { DynSettings, Item, Section } from '../types'
+import { Toggle, cn } from '../ui'
+import { Ctl, Panel, Select, Slider, inputCls } from '../StudioPanel'
+import { t } from '../i18n'
+import { useDynamic } from './ctx'
+import { DYN_DEFS, isDynWidget } from './model'
+
+/* Inspector of the Pursae Commerce widgets and the language switcher (contract §11.12). */
+
+const TAGS = ['h1', 'h2', 'h3', 'h4', 'h5', 'h6', 'p', 'div', 'span'] as const
+const IDS_RE = /^[1-9][0-9]{0,18}(,[1-9][0-9]{0,18}){0,23}$/
+
+function Hint({ children }: { children: ReactNode }) {
+  return <p className="text-[11px] leading-relaxed text-ink-500">{children}</p>
+}
+
+/** A comma-separated id list, written when the field loses focus (at most 24 ids). */
+function IdList({ value, onChange, placeholder }: { value: string; onChange: (v: string) => void; placeholder?: string }) {
+  const [draft, setDraft] = useState(value)
+  useEffect(() => setDraft(value), [value])
+  const commit = () => {
+    const v = draft.split(/[^0-9]+/).filter((x) => /^[1-9][0-9]{0,18}$/.test(x)).slice(0, 24).join(',')
+    setDraft(v)
+    if (v !== value) onChange(v)
+  }
+  return (
+    <input
+      value={draft}
+      maxLength={480}
+      placeholder={placeholder}
+      onChange={(e) => setDraft(e.target.value)}
+      onBlur={commit}
+      onKeyDown={(e) => e.key === 'Enter' && commit()}
+      className={cn(inputCls, 'w-[150px]')}
+    />
+  )
+}
+
+const PRODUCT_WIDGETS = new Set(['shop-add-to-cart', 'product-title', 'product-images', 'product-price', 'product-add-to-cart', 'product-rating', 'product-stock', 'product-meta', 'product-short-desc', 'product-content', 'product-tabs', 'product-related', 'product-upsells', 'product-sale-badge'])
+
+/** Settings of a cell holding a shop, product or language-switcher widget. */
+export function ShopCellPanel({ s, item }: { s: Section; item: Item }) {
+  const b = useB()
+  const ctx = useDynamic()
+  if (!isDynWidget(item.title)) return null
+  const w = item.title
+  const d: DynSettings = { ...DYN_DEFS[w].defaults, ...item.dyn }
+  const set = (patch: Partial<DynSettings>, key?: string) => b.dispatch({ type: 'dyn', id: s.id, itemId: item.id, patch, key })
+  const shop = ctx.shop ?? null
+  const cats = shop?.categories ?? []
+  const ids = (csv: string | undefined) => (csv && IDS_RE.test(csv) ? csv.split(',') : [])
+  return (
+    <Panel title={DYN_DEFS[w].label}>
+      {w === 'language-switcher' && (
+        <>
+          <Ctl label={t('Dropdown')}>
+            <Toggle on={!!d.dropdown} onChange={(v) => set({ dropdown: v })} />
+          </Ctl>
+          <Ctl label={t('Show flags')}>
+            <Toggle on={!!d.flags} onChange={(v) => set({ flags: v })} />
+          </Ctl>
+          <Ctl label={t('Show names')}>
+            <Toggle on={d.names !== false} onChange={(v) => set({ names: v })} />
+          </Ctl>
+          <Ctl label={t('Hide the current language')}>
+            <Toggle on={!!d.hideCurrent} onChange={(v) => set({ hideCurrent: v })} />
+          </Ctl>
+          <Hint>{t('Links to this page in each language of Pursae Multi Language.')}</Hint>
+        </>
+      )}
+      {w === 'shop-products' && (
+        <>
+          <Ctl label={t('Source')}>
+            <Select
+              value={d.source ?? 'recent'}
+              onChange={(v) => set({ source: v })}
+              options={[
+                { value: 'recent', label: t('Latest products') },
+                { value: 'featured', label: t('Featured products') },
+                { value: 'sale', label: t('On sale') },
+                { value: 'best-selling', label: t('Best selling') },
+                { value: 'top-rated', label: t('Top rated') },
+                { value: 'ids', label: t('Chosen products') },
+              ]}
+            />
+          </Ctl>
+          {d.source === 'ids' && (
+            <Ctl label={t('Product IDs')}>
+              <IdList value={d.ids ?? ''} placeholder="12,34" onChange={(v) => set({ ids: v || undefined })} />
+            </Ctl>
+          )}
+          <Ctl label={t('Columns')}>
+            <Slider value={d.columns ?? 4} min={1} max={6} unit="" onChange={(v) => set({ columns: v }, 'cols')} />
+          </Ctl>
+          <Ctl label={t('Products')}>
+            <Slider value={d.limit ?? 8} min={1} max={24} unit="" onChange={(v) => set({ limit: v }, 'limit')} />
+          </Ctl>
+          {d.source !== 'best-selling' && d.source !== 'top-rated' && (
+            <>
+              <Ctl label={t('Order by')}>
+                <Select
+                  value={d.orderBy ?? 'date'}
+                  onChange={(v) => set({ orderBy: v })}
+                  options={[
+                    { value: 'date', label: t('Date') },
+                    { value: 'title', label: t('Title') },
+                    { value: 'price', label: t('Price') },
+                    { value: 'popularity', label: t('Popularity') },
+                    { value: 'rating', label: t('Rating') },
+                    { value: 'menu_order', label: t('Menu order') },
+                    { value: 'rand', label: t('Random') },
+                  ]}
+                />
+              </Ctl>
+              <Ctl label={t('Order')}>
+                <Select
+                  value={d.order ?? 'desc'}
+                  onChange={(v) => set({ order: v })}
+                  options={[
+                    { value: 'desc', label: t('Descending') },
+                    { value: 'asc', label: t('Ascending') },
+                  ]}
+                />
+              </Ctl>
+            </>
+          )}
+          <Ctl label={t('Paginate')}>
+            <Toggle on={!!d.paginate} onChange={(v) => set({ paginate: v })} />
+          </Ctl>
+        </>
+      )}
+      {w === 'shop-categories' && (
+        <>
+          <Ctl label={t('Columns')}>
+            <Slider value={d.columns ?? 4} min={1} max={6} unit="" onChange={(v) => set({ columns: v }, 'cols')} />
+          </Ctl>
+          <Ctl label={t('Show')}>
+            <Select
+              value={d.parent ?? ''}
+              onChange={(v) => set({ parent: v })}
+              options={[{ value: '', label: t('All categories') }, { value: '0', label: t('Top level only') }, ...cats.map((c) => ({ value: String(c.id), label: t('Children of {name}', { name: c.name }) }))]}
+            />
+          </Ctl>
+          <Ctl label={t('Hide empty categories')}>
+            <Toggle on={d.hideEmpty !== false} onChange={(v) => set({ hideEmpty: v })} />
+          </Ctl>
+        </>
+      )}
+      {(w === 'shop-products' || w === 'shop-categories') && cats.length > 0 && (
+        <Ctl label={w === 'shop-products' ? t('Only from these categories') : t('Only these categories')} stack>
+          <div className="grid max-h-[180px] grid-cols-2 gap-1.5 overflow-y-auto">
+            {cats.map((c) => {
+              const cur = ids(d.cats)
+              const on = cur.includes(String(c.id))
+              return (
+                <label key={c.id} className="flex items-center gap-2 text-[12px] text-ink-200">
+                  <input
+                    type="checkbox"
+                    checked={on}
+                    onChange={() => set({ cats: (on ? cur.filter((x) => x !== String(c.id)) : [...cur, String(c.id)].slice(0, 20)).join(',') })}
+                    className="accent-[var(--color-accent)]"
+                  />
+                  <span className="truncate">{c.name}</span>
+                </label>
+              )
+            })}
+          </div>
+        </Ctl>
+      )}
+      {w === 'shop-products' && (
+        <Ctl label={t('Tag IDs')}>
+          <IdList value={d.tags ?? ''} onChange={(v) => set({ tags: v || undefined })} />
+        </Ctl>
+      )}
+      {PRODUCT_WIDGETS.has(w) && (
+        <>
+          <Ctl label={t('Product')}>
+            <Select
+              value={d.product ?? 0}
+              onChange={(v) => set({ product: Number(v) || undefined })}
+              options={[{ value: 0, label: t('Current product') }, ...(shop?.products ?? []).map((p) => ({ value: p.id, label: p.title }))]}
+            />
+          </Ctl>
+          <Ctl label={t('Product ID')}>
+            <input value={d.product ? String(d.product) : ''} maxLength={19} placeholder={t('Current')} onChange={(e) => set({ product: Number(e.target.value.replace(/\D+/g, '')) || undefined }, 'pid')} className={cn(inputCls, 'w-[110px]')} />
+          </Ctl>
+          <Hint>{t('Current product: the product being viewed (Single Product templates). Pick a product to show it anywhere.')}</Hint>
+        </>
+      )}
+      {w === 'shop-add-to-cart' && (
+        <Ctl label={t('Show the price')}>
+          <Toggle on={!!d.showPrice} onChange={(v) => set({ showPrice: v })} />
+        </Ctl>
+      )}
+      {(w === 'product-title' || w === 'shop-archive-title') && (
+        <Ctl label={t('HTML tag')}>
+          <Select value={d.tag ?? 'h1'} w={90} onChange={(v) => set({ tag: v })} options={TAGS.map((v) => ({ value: v, label: v.toUpperCase() }))} />
+        </Ctl>
+      )}
+      {w === 'product-title' && (
+        <Ctl label={t('Link to the product')}>
+          <Toggle on={!!d.link} onChange={(v) => set({ link: v })} />
+        </Ctl>
+      )}
+      {w === 'product-images' && (
+        <Ctl label={t('Gallery')}>
+          <Toggle on={d.gallery !== false} onChange={(v) => set({ gallery: v })} />
+        </Ctl>
+      )}
+      {w === 'shop-cart' && (
+        <>
+          <Ctl label={t('Show the subtotal')}>
+            <Toggle on={!!d.showTotal} onChange={(v) => set({ showTotal: v })} />
+          </Ctl>
+          <Ctl label={t('Mini cart on click')}>
+            <Toggle on={d.dropdown !== false} onChange={(v) => set({ dropdown: v })} />
+          </Ctl>
+          <Hint>{t('The count stays right on cached pages: the store updates it in the browser.')}</Hint>
+        </>
+      )}
+      {w === 'shop-cart-page' && <Hint>{t('Shows the cart on the Cart page only. Design the Cart page around it.')}</Hint>}
+      {w === 'shop-checkout-page' && <Hint>{t('Shows the checkout form on the Checkout page only. Design the Checkout page around it.')}</Hint>}
+      {w === 'shop-notices' && <Hint>{t('Shows the store messages, such as "added to your cart".')}</Hint>}
+      {(w === 'shop-archive-products' || w === 'shop-archive-title' || w === 'shop-archive-desc' || w === 'shop-breadcrumb') && (
+        <Hint>{t('Shows the shop or product category being viewed (Product Archive templates).')}</Hint>
+      )}
+      {!shop && w !== 'language-switcher' && <Hint>{t('Turn on Pursae Commerce to use the shop widgets.')}</Hint>}
+    </Panel>
+  )
+}
