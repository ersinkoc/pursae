+  }
+  if (source === 'top-rated') list.sort((a, b) => b.rating - a.rating)
+  const cats = ids(d.cats)
+  if (cats.length) list = list.filter((p) => p.categories.some((c) => cats.includes(c)))
+  if (source !== 'ids' && source !== 'top-rated') {
+    if (d.orderBy === 'title') list.sort((a, b) => a.title.localeCompare(b.title))
+    if (d.order === 'asc' && (d.orderBy ?? 'date') === 'date') list.reverse()
+    if (d.order === 'desc' && d.orderBy === 'title') list.reverse()
+  }
+  return list.slice(0, clamp(d.limit, 1, 24, 8))
+}
+
+const Price = ({ html, className }: { html: string; className?: string }) => {
