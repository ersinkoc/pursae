+}
+
+function CartIcon({ m, d, shop, ph }: { m: DynMode; d: DynSettings; shop: DynShop | null; ph: (slot: string, extra?: P) => P }) {
+  const count = (
+    <span className="wb-cart-count inline-grid min-w-5 place-items-center rounded-full px-1.5 text-[11.5px] font-bold leading-5" style={{ background: 'var(--btn-bg)', color: 'var(--btn-fg)' }} {...(m.ph ? ph('shop.cart-count') : { children: shop?.cart.count ?? 0 })} />
+  )
+  const total = d.showTotal ? <span className="text-[14px] font-semibold" {...(m.ph ? ph('shop.cart-subtotal') : { dangerouslySetInnerHTML: { __html: cleanHtml(shop?.cart.subtotalHtml ?? '') } })} /> : null
+  const icon = (
+    <>
+      <ShoppingCart size={22} aria-hidden />
+      {count}
+      {total}
+    </>
+  )
+  if (d.dropdown !== false && m.live)
+    return (
+      <LiveMenu
+        label={t('Cart')}
+        className="wb-cart-menu relative inline-block"
+        summaryClass="inline-flex items-center gap-2"
+        panelClass="absolute right-0 top-full z-50 mt-2 w-[320px] max-w-[90vw] p-5 shadow-[0_30px_40px_-30px_rgba(0,0,0,.35)]"
+        panelStyle={{ background: 'var(--bg)', color: 'var(--fg)', borderRadius: 'min(var(--r-card), 14px)' }}
+        icon={icon}
+      >
+        {m.ph ? <div className="wb-shop widget_shopping_cart wb-mini-cart" {...ph('shop.mini-cart')} /> : <p className="text-[14px]" style={MUTED}>{t('No products in the cart.')}</p>}
+      </LiveMenu>
+    )
+  return (
+    <a className="wb-cart inline-flex items-center gap-2" aria-label={t('Cart')} {...(m.ph ? ph('shop.cart-url') : { href: liveHref(shop?.cartUrl) })}>
+      {icon}
+    </a>
+  )
+}
+
+/** The Pursae Multi Language switcher: the languages as links (or a select), filled by the server. */
+export function LanguageSwitcher({ d, m, editing, itemId }: { d: DynSettings; m: DynMode; editing: boolean; itemId: string }) {
+  if (m.ph) return <div className={cn('wb-langs', LANGS)} data-wb-slot="site.languages" data-wb-item={itemId} />
+  const langs: DynLanguage[] = (m.ctx.languages ?? []).filter((l) => !(d.hideCurrent && l.current))
+  if (!langs.length)
+    return editing ? (
+      <p className="px-3 py-2 text-[13px]" style={{ ...MUTED, ...DASHED }}>
+        {t('Turn on Pursae Multi Language and add languages to show the switcher.')}
+      </p>
+    ) : null
+  const label = (l: DynLanguage) => [d.flags && l.flag ? l.flag : '', d.names !== false || !d.flags || !l.flag ? l.name : ''].filter(Boolean).join(' ')
+  if (d.dropdown)
+    return (
+      <div className={cn('wb-langs', LANGS)}>
+        <select value={langs.find((l) => l.current)?.slug} disabled={editing} onChange={() => {}} aria-label={t('Language')}>
+          {langs.map((l) => (
+            <option key={l.slug} value={l.slug}>
+              {label(l)}
+            </option>
+          ))}
+        </select>
+      </div>
+    )
+  return (
+    <div className={cn('wb-langs', LANGS)}>
+      <ul>
+        {langs.map((l) => (
+          <li key={l.slug} className={l.current ? 'current-lang' : undefined}>
+            <a href={liveHref(l.url)} aria-current={l.current ? 'true' : undefined}>
+              {label(l)}
+            </a>
+          </li>
+        ))}
+      </ul>
+    </div>
+  )
+}
