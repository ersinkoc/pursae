+/** Store markup inside a widget (the server fills it with Commerce's own classes). */
+const SHOP = 'wb-shop'
+/** The language switcher's list or select (pll_the_languages markup). */
+const LANGS =
+  '[&_ul]:m-0 [&_ul]:flex [&_ul]:list-none [&_ul]:flex-wrap [&_ul]:items-center [&_ul]:gap-x-4 [&_ul]:gap-y-1 [&_ul]:p-0 [&_li]:list-none [&_a]:inline-flex [&_a]:items-center [&_a]:gap-1.5 [&_a]:transition-opacity [&_a:hover]:opacity-70 [&_.current-lang_a]:font-semibold [&_select]:h-10 [&_select]:rounded-[min(var(--r-btn),10px)] [&_select]:border [&_select]:border-(--line) [&_select]:bg-transparent [&_select]:px-3'
+
+const tagOf = (d: DynSettings, fallback: string) => (d.tag && /^(h[1-6]|p|div|span)$/.test(d.tag) ? d.tag : fallback)
