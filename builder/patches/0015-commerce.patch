+const ids = (csv: string | undefined) => (csv && /^[1-9][0-9]{0,18}(,[1-9][0-9]{0,18}){0,23}$/.test(csv) ? csv.split(',').map(Number) : [])
+
+/** The product a product widget shows in the editor: the cell's own product, else the preview product. */
+function productOf(shop: DynShop | null | undefined, d: DynSettings): DynProduct | null {
+  if (!shop) return null
+  if (d.product && d.product > 0) return shop.products.find((p) => p.id === d.product) ?? (shop.product?.id === d.product ? shop.product : null)
+  return shop.product ?? shop.products[0] ?? null
+}
+
+/** Products a shop-products cell shows in the editor (the server runs the real query). */
+function productsOf(shop: DynShop | null | undefined, d: DynSettings): DynProduct[] {
+  if (!shop) return []
+  let list = [...shop.products]
