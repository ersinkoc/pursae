diff --git a/src/builder/codeFrameDoc.ts b/src/builder/codeFrameDoc.ts
new file mode 100644
index 0000000..956de0f
--- /dev/null
+++ b/src/builder/codeFrameDoc.ts
@@ -0,0 +1,84 @@
+import type { FrameGuard } from './elementsSeam'
+import type { Section } from './types'
+
+/*
+ * The document of a code frame (CodeSection.tsx): a run of consecutive code sections drawn as one
+ * page, with the head markup they need and the wrappers they share (like the server publishes
+ * them). With the host's guard (elementsSeam) the frame is static: the head and the body are the
+ * guard's neutralised copy (nothing in it runs or loads a document, embeds are placeholders) and
+ * the frame is sandboxed without allow-scripts; without it (the design's scripts run: Preview
+ * after the author's confirmation, or the standalone builder) the markup as stored.
+ */
+
+export const EDIT_CSS =
+  '[data-wbc]{cursor:default}[data-wbc]:hover{outline:1px dashed rgba(34,113,177,.75);outline-offset:2px}' +
+  '[data-wbc-sel]{outline:2px solid #2271b1!important;outline-offset:2px}' +
+  '[data-wbc][contenteditable]{outline:2px solid #2271b1!important;outline-offset:2px;cursor:text}img[data-wbc]{cursor:pointer}'
+
+const esc = (v: string) => v.replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;')
+
+const TAG_RE = /^<[a-zA-Z][a-zA-Z0-9-]{0,30}(?:\s[^<>]*)?>$/
+
+/** A section's wrapper chain (content.wrap). */
+export function wrapChain(wrap: string | undefined): string[] {
+  return (wrap ?? '')
+    .split('\n')
+    .map((l) => l.trim())
+    .filter((l) => TAG_RE.test(l))
+}
+
+const closeOf = (open: string) => `</${/^<([a-zA-Z][a-zA-Z0-9-]*)/.exec(open)![1]}>`
+
+/** The head markup of a run: each distinct top-level tag once, in order (parsed inert: DOMParser). */
+export function mergeHeads(heads: string[]): string {
+  const seen = new Set<string>()
+  const out: string[] = []
+  for (const h of heads) {
+    if (!h.trim()) continue
+    const doc = new DOMParser().parseFromString(`<!doctype html><html><head>${h}</head><body></body></html>`, 'text/html')
+    for (const el of Array.from(doc.head.children)) {
+      const tag = el.outerHTML
+      if (!seen.has(tag)) {
+        seen.add(tag)
+        out.push(tag)
+      }
+    }
+  }
+  return out.join('\n')
+}
+
+/** The run's body: sections in order, consecutive ones sharing their wrappers (like the server). */
+export function runBody(run: Section[]): string {
+  const stack: string[] = []
+  let out = ''
+  for (const s of run) {
+    const chain = wrapChain(s.content.wrap)
+    let k = 0
+    while (k < stack.length && k < chain.length && stack[k] === chain[k]) k++
+    while (stack.length > k) out += closeOf(stack.pop()!)
+    for (const w of chain.slice(k)) {
+      out += w
+      stack.push(w)
+    }
+    out += s.content.html ?? ''
+  }
+  while (stack.length) out += closeOf(stack.pop()!)
+  return out
+}
+
+/**
+ * The frame document of a run. edit: the editor's outlines; guard: a static frame (the guard's
+ * neutralised copy and its stylesheet), null: the markup as stored (its scripts run).
+ */
+export function codeFrameDoc(run: Section[], edit: boolean, guard: Pick<FrameGuard, 'copy' | 'css'> | null, base = typeof location !== 'undefined' ? location.origin + '/' : '/'): string {
+  const first = run[0]
+  const body = first.content.body ? ` class="${esc(first.content.body)}"` : ''
+  const head = mergeHeads(run.map((s) => s.content.head ?? ''))
+  const css = (edit ? EDIT_CSS : '') + (guard ? guard.css() : '')
+  return (
+    `<!doctype html><html lang="${esc(first.content.lang || 'en')}"><head><meta charset="utf-8">` +
+    // data-wb-editor: the editor's own <base> (the guard's sweep keeps it).
+    `<meta name="viewport" content="width=device-width,initial-scale=1"><base href="${esc(base)}" data-wb-editor="">` +
+    `${guard ? guard.copy(head) : head}${css ? `<style data-wb-edit>${css}</style>` : ''}</head><body${body}>${guard ? guard.copy(runBody(run)) : runBody(run)}</body></html>`
+  )
+}
