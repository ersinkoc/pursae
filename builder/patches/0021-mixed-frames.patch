+}
+
+/**
+ * Static, script-free drawing of a design in a code frame (the host's element editor rules: a
+ * neutralised copy in a frame sandboxed without allow-scripts, embeds as placeholders, scripts run
+ * only after the author's confirmation for the editor session).
+ */
+export interface FrameGuard {
+  /** The frame's copy of design markup (body or head): nothing in it can run or load a document. */
+  copy(markup: string): string
+  /** Makes the loaded static frame's document inert once more (whatever a second parse made). */
+  sweep(doc: Document): void
+  /** Makes one element of the static frame (and what is inside it) inert after an attribute change. */
+  neutralEl(el: Element): void
+  /** Stylesheet of a static frame (embedded content drawn as placeholders). */
+  css(): string
+  /** The element a pointer event at (x, y) on `el` is about (an embed placeholder under the pointer). */
+  target(doc: Document, el: Element, x: number, y: number): Element
+  /**
+   * Starts an in-place text edit of el, whose stored markup is srcOuter: returns what gives el's new
+   * inner markup, written from the source (null: it cannot be written back).
+   */
+  beginText(srcOuter: string, el: HTMLElement): () => string | null
+  /** Whether the author let the design's scripts run in this editor session (a React hook). */
+  useScripts(): boolean
+  /** The preview notice when the scripts are not running, with the button that asks. */
+  Banner: ComponentType
 }
 
 let seam: ElementsSeam | null = null
