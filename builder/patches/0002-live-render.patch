+/*
+ * Published-page runtime (IIFE, no dependencies, ≤ 8 KB gzip). Loaded with `defer` only on pages whose snapshot
+ * lists features. Everything is opt-in by data-wb-* attributes (contract §5); the page works without it.
+ */
+import { EASING_CSS, FRAMES, MOTION_DEFAULTS, hasEntrance, hasScrollFx, playOnView, reducedMotion, scrollFx, sectionTargets, type Motion, type Track } from '../motion-core'
+import type { EasingId, EntranceId } from '../types'
+
+const $$ = <T extends Element = HTMLElement>(sel: string, root: ParentNode = document) => Array.from(root.querySelectorAll<T>(sel))
+const IN = 'wb-in'
+
+/* ---------- menu: <details data-wb-menu> ---------- */
+function menus() {
+  const all = $$<HTMLDetailsElement>('details[data-wb-menu]')
+  if (!all.length) return
+  const sync = (d: HTMLDetailsElement) => d.querySelector(':scope > summary')?.setAttribute('aria-expanded', String(d.open))
+  for (const d of all) {
+    sync(d)
+    d.addEventListener('toggle', () => sync(d))
+    d.addEventListener('click', (e) => {
+      if ((e.target as Element).closest('a') && d.open) d.open = false
+    })
+  }
+  document.addEventListener('keydown', (e) => {
+    if (e.key !== 'Escape') return
+    for (const d of all)
+      if (d.open) {
+        d.open = false
+        d.querySelector<HTMLElement>(':scope > summary')?.focus()
+      }
+  })
+  document.addEventListener('click', (e) => {
+    for (const d of all) if (d.open && !d.contains(e.target as Node)) d.open = false
+  })
+}
+
+/* ---------- acc: <details data-wb-acc>, one open per [data-wb-acc-single] group ---------- */
+function accordions() {
+  for (const d of $$<HTMLDetailsElement>('details[data-wb-acc]'))
+    d.addEventListener('toggle', () => {
+      const g = d.open && d.closest('[data-wb-acc-single]')
+      if (g) for (const o of $$<HTMLDetailsElement>('details[data-wb-acc]', g)) if (o !== d) o.open = false
+    })
+}
+
+/* ---------- tabs ---------- */
+function tabs() {
+  for (const box of $$('[data-wb-tabs]')) {
+    const list = $$('[data-wb-tab]', box)
+    if (!list.length) continue
+    const panels = $$('[data-wb-panel]', box)
+    const pick = (t: HTMLElement, focus?: boolean) => {
+      for (const o of list) {
+        const on = o === t
+        o.setAttribute('aria-selected', String(on))
+        o.tabIndex = on ? 0 : -1
+      }
+      for (const p of panels) p.toggleAttribute('data-wb-inactive', p.dataset.wbPanel !== t.dataset.wbTab)
+      if (focus) t.focus()
+    }
+    const step = (d: number) => {
+      const i = list.findIndex((o) => o.getAttribute('aria-selected') === 'true')
+      return list[(i + d + list.length) % list.length]
+    }
+    list.forEach((t, i) => {
+      t.addEventListener('click', () => pick(t))
+      t.addEventListener('keydown', (e) => {
+        const k = e.key
+        const n = k === 'ArrowRight' || k === 'ArrowDown' ? step(1) : k === 'ArrowLeft' || k === 'ArrowUp' ? step(-1) : k === 'Home' ? list[0] : k === 'End' ? list[list.length - 1] : null
+        if (!n) return
+        e.preventDefault()
+        pick(n, true)
+      })
+      if (i === 0 && !list.some((o) => o.getAttribute('aria-selected') === 'true')) pick(t)
+    })
+    const ms = Number(box.dataset.wbAutoplay)
+    if (ms >= 1000 && !reducedMotion()) {
+      let paused = false
+      for (const [ev, v] of [['mouseenter', true], ['mouseleave', false], ['focusin', true], ['focusout', false]] as const) box.addEventListener(ev, () => (paused = v))
+      setInterval(() => !paused && !document.hidden && pick(step(1)), ms)
+    }
+  }
+}
+
+/* ---------- dismiss ---------- */
+function dismiss() {
+  const post = document.querySelector<HTMLElement>('[data-wb-root]')?.dataset.wbPost ?? ''
+  for (const el of $$('[data-wb-dismiss]')) {
+    const key = `wb-dismiss:${post}:${el.dataset.wbDismiss}`
+    const host = el.closest<HTMLElement>('section') ?? el
+    try {
+      if (sessionStorage.getItem(key)) host.hidden = true
+    } catch {
+      /* storage blocked */
+    }
+    el.querySelector('[data-wb-dismiss-btn]')?.addEventListener('click', () => {
+      host.hidden = true
+      try {
+        sessionStorage.setItem(key, '1')
+      } catch {
+        /* storage blocked */
+      }
+    })
+  }
+}
+
+/* ---------- form ---------- */
+function forms() {
+  const t0 = Date.now()
+  for (const f of $$<HTMLFormElement>('form[data-wb-form]')) {
+    if (!f.getAttribute('action')) continue
+    const status = f.querySelector<HTMLElement>('[data-wb-form-status]')
+    const say = (state: string, msg: string) => {
+      f.dataset.wbState = state
+      if (status) status.textContent = msg
+    }
+    f.addEventListener('submit', async (e) => {
+      e.preventDefault()
+      if (f.dataset.wbState === 'sending') return
+      const t = f.querySelector<HTMLInputElement>('input[name=wb_t]')
+      if (t) t.value = String(Date.now() - t0)
+      say('sending', '')
+      try {
+        const r = await fetch(f.action, { method: 'POST', body: new URLSearchParams(new FormData(f) as unknown as Record<string, string>), headers: { Accept: 'application/json' }, credentials: 'same-origin' })
+        const j = (await r.json().catch(() => ({}))) as { ok?: boolean; message?: string }
+        const ok = r.ok && j.ok !== false
+        say(ok ? 'sent' : 'error', j.message || (ok ? 'Thank you, your message was sent.' : 'Sorry, the message could not be sent.'))
+        if (ok) f.reset()
+      } catch {
+        say('error', 'Sorry, the message could not be sent.')
+      }
+    })
+  }
+}
+
+/* ---------- embed: html sections report their height ---------- */
+function embeds() {
+  const frames = $$<HTMLIFrameElement>('iframe[data-wb-embed]')
+  if (!frames.length) return
+  addEventListener('message', (e) => {
+    const d = e.data as { __wb?: unknown; h?: unknown }
+    if (!d || typeof d.__wb !== 'string' || typeof d.h !== 'number' || !isFinite(d.h)) return
+    const f = frames.find((x) => x.contentWindow === e.source && x.dataset.wbEmbed === d.__wb)
+    if (f) f.style.height = `${Math.min(Math.max(Math.ceil(d.h), 40), 20000)}px`
+  })
+}
+
+/* ---------- motion ---------- */
+const num = (v: string | undefined, def: number, lo: number, hi: number) => {
+  const n = Number(v)
+  return v === undefined || v === '' || !isFinite(n) ? def : Math.min(hi, Math.max(lo, n))
+}
+
+/** Motion settings from data-wb-* attributes (validated: unknown values fall back to the defaults). */
+function readMotion(el: HTMLElement): Motion {
+  const d = el.dataset
+  const entrance = (d.wbMotion ?? '') in FRAMES ? (d.wbMotion as EntranceId) : 'none'
+  return {
+    ...MOTION_DEFAULTS,
+    entrance,
+    duration: num(d.wbDur, MOTION_DEFAULTS.duration, 0, 10000),
+    delay: num(d.wbDelay, 0, 0, 10000),
+    easing: (d.wbEase ?? '') in EASING_CSS ? (d.wbEase as EasingId) : MOTION_DEFAULTS.easing,
+    repeat: d.wbRepeat !== undefined,
+    stagger: d.wbStagger !== undefined,
+    staggerDelay: num(d.wbStagger, MOTION_DEFAULTS.staggerDelay, 0, 2000),
+    parallax: num(d.wbParallax, 0, -100, 100),
+    parallaxTarget: d.wbParallaxOn === 'content' ? 'content' : 'bg',
+    scrollFade: d.wbScrollFade !== undefined,
+    scrollScale: d.wbScrollScale !== undefined,
+  }
+}
+
+function motion() {
+  const reduced = reducedMotion()
+  const targets = $$('[data-wb-motion]')
+  const reveal = (el: Element) => el.classList.add(IN)
+  // Element-level effects (an element with its own entrance), played on their own.
+  const own = targets.filter((el) => !('wbScope' in el.dataset))
+  const mine = new Set<Element>(own)
+  if (reduced) {
+    // No animation: everything shows at once.
+    targets.forEach(reveal)
+    return
+  }
+  for (const el of own) {
+    const m = readMotion(el)
+    const t: Track = { el, m, offset: 0 }
+    playOnView(el, [t], m.repeat, false)
+    reveal(el)
+  }
+  for (const root of $$('[data-wb-scope],[data-wb-parallax],[data-wb-scroll-fade],[data-wb-scroll-scale]')) {
+    const m = readMotion(root)
+    if (hasEntrance(m) && 'wbScope' in root.dataset) {
+      const items = sectionTargets(root, m, '[data-wb-grid]', mine)
+      if (items.length) playOnView(root, items, m.repeat, false)
+      reveal(root)
+    }
+    const section = root.parentElement
+    if (section && hasScrollFx(m)) scrollFx(section, root, m, '[data-wb-bg]')
+  }
+  // Anything left (e.g. an entrance on an element the design no longer has) is shown.
+  targets.forEach(reveal)
+}
+
+function init() {
+  for (const f of [menus, accordions, tabs, dismiss, forms, embeds, motion])
+    try {
+      f()
+    } catch (e) {
+      console.error('[web-builder]', e)
+    }
+}
+
+if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init)
+else init()
