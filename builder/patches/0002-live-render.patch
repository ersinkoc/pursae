+++ b/src/builder/motion-core.ts
@@ -0,0 +1,225 @@
+import type { EasingId, EntranceId, MotionSettings } from './types'
+
+/*
+ * DOM-only motion engine (WAAPI + scroll), shared by the editor (motion.ts) and the published page's
+ * runtime (live/runtime.ts). No React, no labels: everything here ships to visitors.
+ */
+
+export type Motion = Required<MotionSettings>
+
+export const MOTION_DEFAULTS: Motion = {
+  entrance: 'none',
+  duration: 700,
+  delay: 0,
+  easing: 'smooth',
+  repeat: false,
+  stagger: false,
+  staggerDelay: 90,
+  parallax: 0,
+  parallaxTarget: 'bg',
+  scrollFade: false,
+  scrollScale: false,
+  sticky: false,
+  hover: 'none',
+  hoverTarget: 'self',
+}
+
+export const EASING_CSS: Record<EasingId, string> = {
+  smooth: 'cubic-bezier(.22,1,.36,1)',
+  'ease-out': 'cubic-bezier(0,0,.2,1)',
+  'ease-in-out': 'cubic-bezier(.65,0,.35,1)',
+  ease: 'ease',
+  spring: 'cubic-bezier(.34,1.56,.64,1)',
+  linear: 'linear',
+}
+
+export const hasEntrance = (m: MotionSettings) => !!m.entrance && m.entrance !== 'none'
+export const hasScrollFx = (m: MotionSettings) => !!m.parallax || !!m.scrollFade || !!m.scrollScale
+
+/* ---------- Keyframes ---------- */
+const T0 = 'translate3d(0,0,0)'
+const move = (x: number, y: number): Keyframe[] => [
+  { opacity: 0, transform: `translate3d(${x}px,${y}px,0)` },
+  { opacity: 1, transform: T0 },
+]
+const slide = (x: number, y: number): Keyframe[] => [{ opacity: 0, transform: `translate3d(${x}px,${y}px,0)` }, { opacity: 1, offset: 0.35 }, { opacity: 1, transform: T0 }]
+
+export const FRAMES: Record<Exclude<EntranceId, 'none'>, Keyframe[]> = {
+  fade: [{ opacity: 0 }, { opacity: 1 }],
+  'fade-up': move(0, 40),
+  'fade-down': move(0, -40),
+  'fade-left': move(-48, 0),
+  'fade-right': move(48, 0),
+  'zoom-in': [
+    { opacity: 0, transform: 'scale(.86)' },
+    { opacity: 1, transform: 'scale(1)' },
+  ],
+  'zoom-out': [
+    { opacity: 0, transform: 'scale(1.14)' },
+    { opacity: 1, transform: 'scale(1)' },
+  ],
+  'slide-up': slide(0, 120),
+  'slide-left': slide(-140, 0),
+  'slide-right': slide(140, 0),
+  blur: [
+    { opacity: 0, filter: 'blur(14px)', transform: 'scale(1.03)' },
+    { opacity: 1, filter: 'blur(0px)', transform: 'scale(1)' },
+  ],
+  flip: [
+    { opacity: 0, transformOrigin: '50% 0%', transform: 'perspective(1200px) rotateX(-38deg) translate3d(0,24px,0)' },
+    { opacity: 1, transformOrigin: '50% 0%', transform: `perspective(1200px) rotateX(0deg) ${T0}` },
+  ],
+  bounce: [
+    { opacity: 0, transform: 'translate3d(0,64px,0)' },
+    { opacity: 1, transform: 'translate3d(0,-10px,0)', offset: 0.55 },
+    { transform: 'translate3d(0,4px,0)', offset: 0.78 },
+    { opacity: 1, transform: T0 },
+  ],
+}
+
+export const reducedMotion = () => typeof window !== 'undefined' && !!window.matchMedia?.('(prefers-reduced-motion: reduce)').matches
+
+export interface Track {
+  el: HTMLElement
+  m: Motion
+  /** Extra delay (stagger), ms. */
+  offset: number
+}
+
+/** Paused at its first frame (hidden) until played; leaves no styles behind when finished or cancelled. */
+export function arm(t: Track, reduced: boolean): Animation | null {
+  if (!hasEntrance(t.m) || typeof t.el.animate !== 'function') return null
+  const frames = reduced ? FRAMES.fade : FRAMES[t.m.entrance as Exclude<EntranceId, 'none'>]
+  if (!frames) return null
+  const a = t.el.animate(frames, {
+    duration: reduced ? Math.min(t.m.duration, 300) : t.m.duration,
+    delay: reduced ? Math.min(t.offset, 120) : t.m.delay + t.offset,
+    easing: EASING_CSS[t.m.easing] ?? 'ease',
+    fill: 'backwards',
+  })
+  a.pause()
+  return a
+}
+
+/* ---------- Targets ---------- */
+export const shown = (el: Element): el is HTMLElement => el instanceof HTMLElement && !(el instanceof HTMLStyleElement) && el.getClientRects().length > 0
+
+/** Content blocks for staggering: unwraps single-child wrappers and expands card grids (`grid` selector) into their cards. */
+export function blocks(root: Element, grid: string, depth = 0): HTMLElement[] {
+  let el = root
+  while (el.children.length === 1) el = el.children[0]
+  return Array.from(el.children)
+    .filter(shown)
+    .flatMap((c) => {
+      if (c.matches(grid)) return Array.from(c.children).filter(shown)
+      if (depth < 3 && c.querySelector(grid)) return blocks(c, grid, depth + 1)
+      return [c]
+    })
+}
+
+/** Section-level entrance targets: the content's blocks (stagger) or direct children, minus elements with their own motion. */
+export function sectionTargets(root: HTMLElement, m: Motion, grid: string, mine: Set<Element>): Track[] {
+  if (!hasEntrance(m)) return []
+  const list = (m.stagger ? blocks(root, grid) : Array.from(root.children).filter(shown)).filter((el) => !mine.has(el)).slice(0, 48)
+  return list.map((el, i) => ({ el, m, offset: m.stagger ? Math.min(i * m.staggerDelay, 1500) : 0 }))
+}
+
+/**
+ * Plays armed tracks when `trigger` scrolls into view; with `repeat`, re-arms them when it leaves.
+ * Returns a cleanup.
+ */
+export function playOnView(trigger: Element, items: Track[], repeat: boolean, reduced: boolean, onPlay?: () => void): () => void {
+  let anims = items.map((t) => arm(t, reduced))
+  let played = false
+  const io = new IntersectionObserver(
+    (es) => {
+      if (!played && es.some((e) => e.isIntersecting)) {
+        played = true
+        onPlay?.()
+        anims.forEach((a) => a?.play())
+      }
+    },
+    { rootMargin: '0px 0px -12% 0px' },
+  )
+  io.observe(trigger)
+  const exit = repeat
+    ? new IntersectionObserver((es) => {
+        if (played && es.every((e) => !e.isIntersecting)) {
+          played = false
+          anims.forEach((a) => a?.cancel())
+          anims = items.map((t) => arm(t, reduced))
+        }
+      })
+    : null
+  exit?.observe(trigger)
+  return () => {
+    io.disconnect()
+    exit?.disconnect()
+    anims.forEach((a) => a?.cancel())
+  }
+}
+
+/* ---------- Scroll effects ---------- */
+function scrollParent(el: HTMLElement): HTMLElement | null {
+  for (let p = el.parentElement; p; p = p.parentElement) {
+    const o = getComputedStyle(p).overflowY
+    if (o === 'auto' || o === 'scroll') return p
+  }
+  return null
+}
+
+const clamp = (v: number, a: number, b: number) => Math.min(b, Math.max(a, v))
+const smooth = (a: number, b: number, v: number) => {
+  const t = clamp((v - a) / (b - a), 0, 1)
+  return t * t * (3 - 2 * t)
+}
+
+/** Parallax / scroll fade / scroll scale of one section; `bg` selects the section's background layer box. */
+export function scrollFx(section: HTMLElement, content: HTMLElement, m: Motion, bg: string) {
+  const scroller = scrollParent(section)
+  const layers = m.parallax && m.parallaxTarget === 'bg' ? Array.from(section.querySelector(`:scope > ${bg}`)?.children ?? []).filter((c): c is HTMLElement => c instanceof HTMLElement) : []
+  const moveContent = !!m.parallax && m.parallaxTarget === 'content'
+  const prevTransition = content.style.transitionProperty
+  if (m.scrollFade) content.style.transitionProperty = 'none'
+  let frame = 0
+  const update = () => {
+    frame = 0
+    const vp = scroller ? scroller.getBoundingClientRect() : { top: 0, height: window.innerHeight }
+    const r = section.getBoundingClientRect()
+    // -1: leaving at the top, 0: centered, 1: entering at the bottom.
+    const p = clamp((r.top + r.height / 2 - (vp.top + vp.height / 2)) / (vp.height / 2 + r.height / 2), -1, 1)
+    if (layers.length) {
+      const amp = Math.abs(m.parallax) * 1.2
+      const y = -p * amp * Math.sign(m.parallax)
+      const sc = 1 + (2 * amp) / Math.max(r.height, 1) + 0.01
+      for (const l of layers) {
+        l.style.translate = `0 ${y.toFixed(1)}px`
+        l.style.scale = sc.toFixed(4)
+      }
+    }
+    const ty = moveContent ? p * m.parallax * 0.8 : 0
+    content.style.translate = ty ? `0 ${ty.toFixed(1)}px` : ''
+    content.style.scale = m.scrollScale ? (1 - smooth(0.3, 1, Math.abs(p)) * 0.12).toFixed(4) : ''
+    content.style.opacity = m.scrollFade ? (1 - smooth(0.35, 0.95, Math.abs(p)) * 0.9).toFixed(3) : ''
+  }
+  const onScroll = () => {
+    if (!frame) frame = requestAnimationFrame(update)
+  }
+  update()
+  const target: HTMLElement | Window = scroller ?? window
+  target.addEventListener('scroll', onScroll, { passive: true })
+  window.addEventListener('resize', onScroll)
+  return () => {
+    cancelAnimationFrame(frame)
+    target.removeEventListener('scroll', onScroll)
+    window.removeEventListener('resize', onScroll)
+    for (const l of layers) {
+      l.style.translate = ''
+      l.style.scale = ''
+    }
+    content.style.translate = ''
+    content.style.scale = ''
+    content.style.opacity = ''
+    content.style.transitionProperty = prevTransition
+  }
+}
