+// Deterministic ids for the fixture export (uid() uses Math.random): imported before any builder module.
+let x = 0x2f6b9e1d
+Math.random = () => {
+  x ^= x << 13
+  x ^= x >>> 17
+  x ^= x << 5
+  return (x >>> 0) / 0x100000000
+}
+export {}
