@@ -0,0 +1,189 @@
+/*
+ * Styles shared by the editor canvas and the published page (theme tokens, rich text, badges), plus the
+ * published page's own rules (.wb-page root, data-wb-* behaviours, CSS stand-ins for editor animations).
+ * Imported by src/index.css (editor) and by live/site.css (the page stylesheet built per release).
+ * Content stays readable without JavaScript: every rule that hides content is scoped to .wb-js.
+ */
+@theme {
+  --font-sans: 'Inter', ui-sans-serif, system-ui, sans-serif;
+  --font-mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, monospace;
+  --font-serif: 'Instrument Serif', Georgia, serif;
+  --color-ink-950: #0c0d0f;
+  --color-ink-900: #131417;
+  --color-ink-850: #17181c;
+  --color-ink-800: #1c1d22;
+  --color-ink-750: #22242a;
+  --color-ink-700: #2a2c33;
+  --color-ink-600: #393c45;
+  --color-ink-500: #5b5f6a;
+  --color-ink-400: #8a8f9a;
+  --color-ink-300: #b1b5be;
+  --color-ink-200: #d7d9de;
+  --color-ink-100: #eef0f3;
+  --color-accent: #5b7cfa;
+  --color-accent-soft: #93abff;
+  --ease-soft: cubic-bezier(0.22, 1, 0.36, 1);
+}
+
+/* Rich text (b, i, u, s, code, a, ul/ol) in canvas elements and inspector fields */
+.rt a {
+  color: inherit;
+  text-decoration: underline;
+  text-decoration-thickness: from-font;
+  text-underline-offset: 0.18em;
+}
+.rt code {
+  padding: 0.08em 0.32em;
+  border-radius: 4px;
+  background: color-mix(in srgb, currentColor 11%, transparent);
+  font-family: ui-monospace, 'SF Mono', Menlo, monospace;
+  font-size: 0.88em;
+}
+.rt ul,
+.rt ol {
+  margin: 0.35em 0;
+  padding-left: 1.35em;
+}
+.rt ul {
+  list-style: disc;
+}
+.rt ol {
+  list-style: decimal;
+}
+.dot-badge::before {
+  content: '';
+  width: 7px;
+  height: 7px;
+  border-radius: 99px;
+  background: #4ade80;
+  box-shadow: 0 0 0 3px rgb(74 222 128 / 0.25);
+}
+
+/* ---------- Published page ---------- */
+.wb-page {
+  container-type: inline-size;
+  container-name: canvas;
+}
+.wb-page button {
+  cursor: pointer;
+}
+/* Same look as the editor's preview (basic mode): editable elements are plain boxes. */
+.wb-page .sf,
+.wb-page .ed {
+  position: relative;
+}
+.wb-page .ed {
+  border-radius: 6px;
+  box-shadow: none !important;
+}
+/* An open menu panel overlays the sections below: lift its section (sections stack by order and z-index). */
+.wb-page .sf:has(details[data-wb-menu][open]) {
+  z-index: 60 !important;
+}
+.wb-page summary {
+  list-style: none;
+}
+.wb-page summary::-webkit-details-marker {
+  display: none;
+}
+/* Tabs: without JavaScript every panel shows, stacked. */
+.wb-js .wb-page [data-wb-inactive] {
+  display: none;
+}
+
+/* Motion (data-wb-*): sticky and hover are CSS only; entrances need the runtime. */
+.wb-page [data-wb-sticky] {
+  position: sticky;
+  top: 0;
+  z-index: 6;
+}
+@media (prefers-reduced-motion: no-preference) {
+  /* Entrance targets wait hidden for the runtime; a failsafe shows them if it never runs. */
+  .wb-js [data-wb-motion]:not(.wb-in) {
+    opacity: 0;
+    animation: wb-reveal 0s 3s forwards;
+  }
+  .wb-page [data-wb-hover-on='self'],
+  .wb-page [data-wb-hover-on='items'] :is([data-wb-grid] > *, .cell) {
+    transition:
+      translate 0.4s cubic-bezier(0.22, 1, 0.36, 1),
+      scale 0.4s cubic-bezier(0.22, 1, 0.36, 1),
+      box-shadow 0.4s cubic-bezier(0.22, 1, 0.36, 1);
+  }
+  .wb-page [data-wb-hover-on='self']:hover {
+    z-index: 3;
+  }
+  .wb-page [data-wb-hover='lift'][data-wb-hover-on='self']:hover,
+  .wb-page [data-wb-hover='lift'][data-wb-hover-on='items'] :is([data-wb-grid] > *, .cell):hover {
+    translate: 0 -6px;
+    box-shadow: 0 24px 48px -24px rgb(0 0 0 / 0.35) !important;
+  }
+  .wb-page [data-wb-hover='scale'][data-wb-hover-on='self']:hover {
+    scale: 1.015;
+  }
+  .wb-page [data-wb-hover='scale'][data-wb-hover-on='items'] :is([data-wb-grid] > *, .cell):hover {
+    scale: 1.04;
+  }
+  .wb-page [data-wb-hover='glow'][data-wb-hover-on='self']:hover {
+    box-shadow:
+      inset 0 0 0 1px color-mix(in srgb, var(--brand) 40%, transparent),
+      inset 0 0 140px -40px color-mix(in srgb, var(--brand) 55%, transparent);
+  }
+  .wb-page [data-wb-hover='glow'][data-wb-hover-on='items'] :is([data-wb-grid] > *, .cell):hover {
+    box-shadow:
+      0 0 0 1px color-mix(in srgb, var(--brand) 45%, transparent),
+      0 18px 50px -18px color-mix(in srgb, var(--brand) 65%, transparent) !important;
+  }
+
+  /* Endless decorative loops (the editor runs them with motion/react). */
+  .wb-spin {
+    animation: wb-spin 90s linear infinite;
+  }
+  .wb-float {
+    animation: wb-float 7s ease-in-out infinite;
+  }
+  .wb-pulse {
+    animation: wb-pulse 6s ease-in-out infinite;
+  }
+  .wb-bob {
+    animation: wb-bob 5s ease-in-out infinite;
+  }
+  .wb-ping {
+    animation: wb-ping 2.4s ease-out infinite;
+  }
+}
+@keyframes wb-reveal {
+  to {
+    opacity: 1;
+  }
+}
+@keyframes wb-spin {
+  to {
+    rotate: 360deg;
+  }
+}
+@keyframes wb-float {
+  50% {
+    translate: 0 -18px;
+  }
+}
+@keyframes wb-pulse {
+  50% {
+    scale: 1.06;
+  }
+}
+@keyframes wb-bob {
+  50% {
+    translate: 0 -6px;
+  }
+}
+@keyframes wb-ping {
+  from {
+    scale: 1;
+    opacity: 0.6;
+  }
+  to {
+    scale: 1.45;
+    opacity: 0;
+  }
+}
