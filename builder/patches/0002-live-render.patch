+import type { CSSProperties, ReactNode } from 'react'
+import { Menu, X } from 'lucide-react'
+import { cn } from '../ui'
+import { useLive } from './ctx'
+
+/**
+ * Disclosure menu of the published page: a native <details data-wb-menu> (works without JavaScript; the
+ * runtime adds Escape / outside-click / link-click closing). The panel is absolutely positioned against the
+ * nearest positioned ancestor (the header), so it overlays the content below instead of pushing it down.
+ */
+export function LiveMenu({ label = 'Menu', className, summaryClass, panelClass, panelStyle, icon, children }: { label?: string; className?: string; summaryClass?: string; panelClass?: string; panelStyle?: CSSProperties; icon?: ReactNode; children: ReactNode }) {
+  return (
+    <details data-wb-menu="" className={cn('group/m', className)}>
+      <summary aria-label={label} className={cn('cursor-pointer list-none [&::-webkit-details-marker]:hidden', summaryClass)}>
+        {icon ?? (
+          <>
+            <Menu size={21} aria-hidden className="group-open/m:hidden" />
+            <X size={21} aria-hidden className="hidden group-open/m:block" />
+          </>
+        )}
+      </summary>
+      <div className={panelClass} style={panelStyle}>
+        {children}
+      </div>
+    </details>
+  )
+}
+
+/** Inline CSS animation classes standing in for the editor's infinite motion loops (page.css). */
+export const LIVE_ANIM = { spin: 'wb-spin', float: 'wb-float', pulse: 'wb-pulse', bob: 'wb-bob', ping: 'wb-ping' } as const
+
+/**
+ * A real form on the published page: posts to this section's form endpoint (plain POST without JavaScript,
+ * fetch with the runtime), with the honeypot and timing fields and a live status line.
+ */
+export function LiveForm({ label, className, style, children }: { label?: string; className?: string; style?: CSSProperties; children: ReactNode }) {
+  const live = useLive()!
+  return (
+    <form data-wb-form="" method="post" action={live.formAction(live.sectionId)} aria-label={label} className={className} style={style}>
+      {children}
+      <div aria-hidden="true" className="sr-only">
+        <input type="text" name="wb_hp" tabIndex={-1} autoComplete="off" />
+      </div>
+      <input type="hidden" name="wb_t" defaultValue="" />
+      <p data-wb-form-status="" aria-live="polite" className="text-[14px] empty:hidden" />
+    </form>
+  )
+}
+
+/** Form control name on the published page (contract §3.5); unknown fields get none and are not sent. */
+export function fieldName(o: { type?: string; auto?: string; rows?: number }): string | undefined {
+  if (o.rows) return 'message'
+  if (o.auto === 'name') return 'name'
+  if (o.type === 'email' || o.auto === 'email') return 'email'
+  if (o.type === 'tel' || o.auto === 'tel') return 'phone'
+  return undefined
+}
