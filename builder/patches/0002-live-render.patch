+/*
+ * Stylesheet of published pages (one per builder release, served as a hashed immutable file).
+ * Utilities come from a scan of the files that draw sections only (no editor chrome); classes the
+ * renderer builds at run time are listed with @source inline. The build appends the width-range classes
+ * of the designs that switch on a JS width check (useNarrow breakpoints, see renderStatic).
+ */
+@import './page.css';
+@import 'tailwindcss' source(none);
+
+@source '../sections.tsx';
+@source '../Decor.tsx';
+@source '../CustomSection.tsx';
+@source '../EIcon.tsx';
+@source '../RichText.tsx';
+@source '../variants/*.tsx';
+@source './ui.tsx';
+@source './renderStatic.tsx';
+
+/* Per-device hiding (hideOnClass in sections.tsx). */
+@source inline('@max-[640px]:hidden! @min-[640px]:@max-[1024px]:hidden! @min-[1024px]:hidden!');
