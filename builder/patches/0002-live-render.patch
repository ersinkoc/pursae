+++ b/src/builder/live/renderStatic.tsx
@@ -0,0 +1,362 @@
+import { renderToStaticMarkup } from 'react-dom/server'
+import { paletteVars } from '../data'
+import { SectionBackground } from '../Decor'
+import { docFontNeeds, getFont } from '../fonts'
+import { getElMotion, getMotion, hasEntrance, hasScrollFx, MOTION_DEFAULTS, type Motion } from '../motion'
+import { RENDERERS, containerFrameStyle, framePad, hideOnClass } from '../sections'
+import { BuilderCtx, initHistory, type BuilderApi } from '../store'
+import { hasTint, isSvgSrc, preloadSvgs } from '../svgTint'
+import type { DocState, PageSettings, Section } from '../types'
+import { cn } from '../ui'
+import { pageVars } from '../variants/Preview'
+import { LiveCtx, type LiveState } from './ctx'
+
+/*
+ * Static snapshot of a page for publishing (no editor, no React on the visitor's side). The server stores the
+ * HTML after sanitizing it; behaviour comes from the data-wb-* runtime (live/runtime.ts), styles from the
+ * per-release site stylesheet (live/site.css) plus the page's `css`. Contract: docs/developer/web-builder-contract.md §4–§5.
+ */
+
+/** Static markup + data-wb-* runtime version (contract RENDERER_VERSION). */
+export const RENDERER_VERSION = 1
+
+export type Feature = 'menu' | 'acc' | 'tabs' | 'dismiss' | 'form' | 'motion' | 'embed'
+
+export interface FontNeed {
+  family: string
+  weights: number[]
+  italic: boolean
+}
+
+export interface RenderOptions {
+  postId: number
+  /** Absolute action URL of a form section. */
+  formAction: (sectionId: string) => string
+  /** Home URL, no trailing slash. Relative links in the doc stay relative. */
+  siteUrl: string
+}
+
+export interface RenderResult {
+  /** One root <div class="wb-page …" data-wb-root>…</div>. */
+  html: string
+  /** Section custom CSS (style.css, `selector` → the section's id) and generated small-screen rules. */
+  css: string
+  /** Tailwind candidate classes used by html. */
+  classes: string[]
+  fonts: FontNeed[]
+  /** Sorted, unique; empty = the page needs no runtime. */
+  features: Feature[]
+  renderer: number
+}
+
+/** Container widths at or above this are treated as "never" (designs that are always in their narrow form). */
+const NEVER = 4000
+/** Width the widest copy of a section is drawn at. */
+const DESKTOP = 1280
+
+const noop = () => {}
+
+/** Read-only builder context: preview mode, nothing selectable, every action a no-op. */
+function stubApi(doc: DocState): BuilderApi {
+  return {
+    doc,
+    history: initHistory(doc),
+    dispatch: noop,
+    canUndo: false,
+    canRedo: false,
+    mode: 'basic',
+    setMode: noop,
+    device: 'desktop',
+    setDevice: noop,
+    preview: true,
+    setPreview: noop,
+    selection: null,
+    select: noop,
+    hoverSection: null,
+    setHoverSection: noop,
+    activeField: null,
+    setActiveField: noop,
+    focusReq: null,
+    scrollReq: null,
+    basicView: 'list',
+    setBasicView: noop,
+    studioTab: 'widgets',
+    setStudioTab: noop,
+    picker: null,
+    boxHint: null,
+    setBoxHint: noop,
+    setPicker: noop,
+    insertAt: null,
+    setInsertAt: noop,
+    dragging: null,
+    setDragging: noop,
+    drop: null,
+    setDrop: noop,
+    add: noop,
+    remove: noop,
+    notify: noop,
+    structureOpen: false,
+    setStructureOpen: noop,
+    publishState: 'idle',
+    dirty: false,
+    publish: noop,
+    clipboard: null,
+    copySection: noop,
+    pasteSection: noop,
+    styleClipboard: null,
+    copyStyle: noop,
+    pasteStyle: noop,
+    saved: [],
+    saveComponent: noop,
+    removeSaved: noop,
+    menu: null,
+    setMenu: noop,
+    paletteOpen: false,
+    setPaletteOpen: noop,
+    dialog: null,
+    setDialog: noop,
+    page: {} as PageSettings,
+    setPage: noop,
+    saveState: 'saved',
+    scrollTo: noop,
+    milestones: { title: true, color: true, section: true, publish: true, dismissed: true },
+    setMilestone: noop,
+    resetPage: noop,
+  }
+}
+
+/* ---------- Motion attributes (contract §5 "motion") ---------- */
+type Attrs = Record<string, string>
+
+/** data-wb-* attributes of an entrance / scroll effect; `scope` marks a section's content (animates its children). */
+export function motionData(m: Motion, scope: boolean): Attrs {
+  const a: Attrs = {}
+  if (hasEntrance(m)) {
+    a['data-wb-motion'] = m.entrance
+    if (scope) a['data-wb-scope'] = ''
+    if (m.duration !== MOTION_DEFAULTS.duration) a['data-wb-dur'] = String(Math.round(m.duration))
+    if (m.delay !== MOTION_DEFAULTS.delay) a['data-wb-delay'] = String(Math.round(m.delay))
+    if (m.easing !== MOTION_DEFAULTS.easing) a['data-wb-ease'] = m.easing
+    if (m.repeat) a['data-wb-repeat'] = ''
+    if (scope && m.stagger) a['data-wb-stagger'] = String(Math.round(m.staggerDelay))
+  }
+  if (scope && hasScrollFx(m)) {
+    if (m.parallax) {
+      a['data-wb-parallax'] = String(Math.round(m.parallax))
+      a['data-wb-parallax-on'] = m.parallaxTarget
+    }
+    if (m.scrollFade) a['data-wb-scroll-fade'] = ''
+    if (m.scrollScale) a['data-wb-scroll-scale'] = ''
+  }
+  return a
+}
+
+/** One top-level section like the editor's preview frame, with the published page's attributes. */
+function LiveSection({ s, brand, id, className }: { s: Section; brand: string; id: string; className?: string }) {
+  const R = RENDERERS[s.kind]
+  const m = getMotion(s)
+  const fx: Attrs = {
+    ...(m.sticky ? { 'data-wb-sticky': '' } : {}),
+    ...(m.hover !== 'none' ? { 'data-wb-hover': m.hover, 'data-wb-hover-on': m.hoverTarget } : {}),
+  }
+  return (
+    <section className={cn('sf', hideOnClass(s.style.hideOn), className)} id={id} {...fx} style={{ ...paletteVars(s.style.palette, brand, s.style.bg), background: 'var(--bg)', color: 'var(--fg)', ...containerFrameStyle(s) }}>
+      <SectionBackground s={s} />
+      <div className="relative z-[1]" style={framePad(s)} {...motionData(m, true)}>
+        <R s={s} />
+      </div>
+    </section>
+  )
+}
+
+/* ---------- Helpers ---------- */
+/** CSS identifier escape (CSS.escape is not available outside the browser). */
+export function cssIdent(v: string): string {
+  return v
+    .replace(/[^A-Za-z0-9_-]/g, (c) => `\\${c.codePointAt(0)!.toString(16)} `)
+    .replace(/^(-?)([0-9])/, (_m, d: string, n: string) => `${d}\\3${n} `)
+}
+
+const htmlAttr = (v: string) => v.replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;')
+const unescapeAttr = (v: string) => v.replace(/&quot;/g, '"').replace(/&#x27;/g, "'").replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&amp;/g, '&')
+const attrString = (a: Attrs) =>
+  Object.entries(a)
+    .map(([k, v]) => ` ${k}="${htmlAttr(v)}"`)
+    .join('')
+
+/** Every section, nested containers included. */
+function walk(list: Section[], f: (s: Section, nested: boolean) => void, nested = false) {
+  for (const s of list) {
+    f(s, nested)
+    for (const it of s.items) if (it.sub) walk([it.sub], f, true)
+  }
+}
+
+interface Acc {
+  css: string[]
+  keepEl: Set<string>
+}
+
+/**
+ * Draws one top-level section. Designs that switch layout on a JS width check (useNarrow) report their
+ * breakpoints; such a section is drawn once per width range and each copy is shown by container query.
+ */
+function renderSection(s: Section, index: number, doc: DocState, opts: RenderOptions, api: BuilderApi, acc: Acc): { html: string; ids: string[] } {
+  const baseId = s.style.cssId || s.id
+  const run = (width: number, copy: string, id: string, className?: string) => {
+    const live: LiveState = { postId: opts.postId, sectionId: s.id, formAction: opts.formAction, width, bps: new Set(), css: acc.css, keepEl: acc.keepEl }
+    const html = renderToStaticMarkup(
+      <BuilderCtx.Provider value={api}>
+        <LiveCtx.Provider value={live}>
+          <LiveSection s={s} brand={doc.site.brand} id={id} className={className} />
+        </LiveCtx.Provider>
+      </BuilderCtx.Provider>,
+      { identifierPrefix: `wb${index}${copy}-` },
+    )
+    return { html, bps: live.bps }
+  }
+  const finite = (set: Set<number>) => [...set].filter((b) => b > 0 && b < NEVER)
+  const first = run(DESKTOP, '', baseId)
+  let bps = new Set(finite(first.bps))
+  if (!bps.size) return { html: first.html, ids: [baseId] }
+  for (let round = 0; round < 3; round++) {
+    const cuts = [...bps].sort((a, b) => a - b)
+    const ranges = [0, ...cuts].map((lo, i) => ({ lo, hi: cuts[i] ?? Infinity }))
+    const copies = ranges.map((r, i) => {
+      const top = r.hi === Infinity
+      const id = top ? baseId : `${baseId}-w${r.lo}`
+      const cls = cn(r.lo > 0 && `@max-[${r.lo}px]:hidden!`, !top && `@min-[${r.hi}px]:hidden!`)
+      return { id, ...run(top ? Math.max(r.lo, DESKTOP) : r.lo, `w${i}`, id, cls) }
+    })
+    const more = new Set(bps)
+    for (const c of copies) for (const b of finite(c.bps)) more.add(b)
+    if (more.size === bps.size || round === 2) return { html: copies.map((c) => c.html).join(''), ids: copies.map((c) => c.id) }
+    bps = more
+  }
+  return { html: first.html, ids: [baseId] }
+}
+
+/**
+ * Turns editor markup into published markup: hidden / deleted elements get `hidden`, elements with their
+ * own motion get data-wb-* motion attributes, generated-CSS targets keep data-wb-el, editor-only data-*
+ * and editing attributes go.
+ */
+function finalize(html: string, doc: DocState, keepEl: Set<string>): string {
+  const hidden = new Set<string>()
+  const motion = new Map<string, Attrs>()
+  walk(doc.sections, (s) => {
+    for (const [el, es] of Object.entries(s.els ?? {})) {
+      const key = `${s.id}:${el}`
+      if (es.removed || es.hide) hidden.add(key)
+      if (es.motion && hasEntrance(es.motion)) motion.set(key, motionData(getElMotion(es), false))
+    }
+  })
+  return html
+    .replace(/ data-el="([^"]*)"/g, (_m, raw: string) => {
+      const key = unescapeAttr(raw)
+      let out = ''
+      if (hidden.has(key)) out += ' hidden=""'
+      const m = motion.get(key)
+      if (m) out += attrString(m)
+      if (keepEl.has(key)) out += ` data-wb-el="${raw}"`
+      return out
+    })
+    .replace(/ data-mbg="[^"]*"/g, ' data-wb-bg=""')
+    .replace(/ data-grid="[^"]*"/g, ' data-wb-grid=""')
+    .replace(/ data-(?!wb-)[A-Za-z0-9_.:-]+="[^"]*"/g, '')
+    .replace(/ (?:spellcheck|draggable|contenteditable)="[^"]*"/gi, '')
+    // React's resource hints for images (the page head is the server's business).
+    .replace(/<link rel="preload"[^>]*>/g, '')
+}
+
+/* ---------- Fonts ---------- */
+/** Families the designs name directly (wordmarks, logo marks, mono / serif utilities). */
+const FIXED_FONTS: { family: string; test: RegExp; weights: number[]; italic: boolean }[] = [
+  { family: 'Space Grotesk', test: /Space[_ ]Grotesk/, weights: [500, 600, 700], italic: false },
+  { family: 'Instrument Serif', test: /Instrument[_ ]Serif|\bfont-serif\b/, weights: [400], italic: true },
+  { family: 'JetBrains Mono', test: /JetBrains[_ ]Mono|\bfont-mono\b/, weights: [400, 500], italic: false },
+]
+
+function fontNeeds(doc: DocState, html: string): FontNeed[] {
+  const need = new Map<string, { w: Set<number>; italic: boolean }>()
+  const add = (family: string, weights: number[], italic: boolean) => {
+    const e = need.get(family) ?? { w: new Set<number>(), italic: false }
+    for (const w of weights) e.w.add(w)
+    e.italic ||= italic
+    need.set(family, e)
+  }
+  for (const [family, n] of docFontNeeds(doc)) add(family, [...n.w], n.i.size > 0)
+  for (const f of FIXED_FONTS) if (f.test.test(html)) add(f.family, f.weights, f.italic)
+  walk(doc.sections, (s) => {
+    const f = s.kind === 'custom' ? getFont(s.content.font) : undefined
+    if (f && !f.stack) add(f.family, [400, 600, 700], false)
+  })
+  return [...need]
+    .map(([family, e]) => ({ family, weights: [...e.w].sort((a, b) => a - b), italic: e.italic }))
+    .sort((a, b) => a.family.localeCompare(b.family))
+}
+
+/* ---------- Public API ---------- */
+const FEATURES: [Feature, RegExp][] = [
+  ['acc', / data-wb-acc=/],
+  ['dismiss', / data-wb-dismiss=/],
+  ['embed', / data-wb-embed=/],
+  ['form', / data-wb-form=/],
+  ['menu', / data-wb-menu=/],
+  ['motion', / data-wb-(?:motion|parallax|scroll-fade|scroll-scale)=/],
+  ['tabs', / data-wb-tabs=/],
+]
+
+/**
+ * Remote SVG sources that are recolored (icon colors) must be loaded before the synchronous render;
+ * call this first (renderStaticAsync does).
+ */
+export function prepareStatic(doc: DocState): Promise<void> {
+  const srcs: string[] = []
+  walk(doc.sections, (s) => {
+    if (!Object.values(s.els ?? {}).some(hasTint)) return
+    // Any SVG source of a section with a recolored element (content fields, item fields, icons).
+    for (const v of [...Object.values(s.content), ...s.items.flatMap((i) => [i.title, i.text, i.icon])]) if (v && isSvgSrc(v)) srcs.push(v)
+  })
+  return srcs.length ? preloadSvgs(srcs) : Promise.resolve()
+}
+
+/** Static snapshot of `doc` (contract RenderResult). Synchronous; see prepareStatic for recolored remote SVGs. */
+export function renderStatic(doc: DocState, opts: RenderOptions): RenderResult {
+  const api = stubApi(doc)
+  const acc: Acc = { css: [], keepEl: new Set() }
+  const parts: string[] = []
+  const css: string[] = []
+  doc.sections.forEach((s, i) => {
+    if (s.hidden || (['mobile', 'tablet', 'desktop'] as const).every((d) => s.style.hideOn.includes(d))) return
+    const { html, ids } = renderSection(s, i, doc, opts, api, acc)
+    parts.push(html)
+    if (s.style.css) {
+      const sel = ids.length === 1 ? `#${cssIdent(ids[0])}` : `:is(${ids.map((x) => `#${cssIdent(x)}`).join(',')})`
+      css.push(s.style.css.replace(/\bselector\b/g, sel))
+    }
+    for (const it of s.items)
+      if (it.sub)
+        walk([it.sub], (sub) => {
+          if (sub.style.css && !sub.hidden) css.push(sub.style.css.replace(/\bselector\b/g, `#${cssIdent(sub.style.cssId || sub.id)}`))
+        })
+  })
+  const inner = finalize(parts.join(''), doc, acc.keepEl)
+  const root = renderToStaticMarkup(<div className="wb-page cv @container relative bg-white text-left" data-wb-root="" data-wb-post={String(opts.postId)} style={pageVars(doc.site)} dangerouslySetInnerHTML={{ __html: inner }} />)
+  const classes = new Set<string>()
+  for (const m of root.matchAll(/ class="([^"]*)"/g)) for (const c of unescapeAttr(m[1]).split(/\s+/)) if (c) classes.add(c)
+  return {
+    html: root,
+    css: [...css, ...new Set(acc.css)].join('\n'),
+    classes: [...classes].sort(),
+    fonts: fontNeeds(doc, root),
+    features: FEATURES.filter(([, re]) => re.test(root)).map(([f]) => f),
+    renderer: RENDERER_VERSION,
+  }
+}
+
+/** prepareStatic + renderStatic. */
+export async function renderStaticAsync(doc: DocState, opts: RenderOptions): Promise<RenderResult> {
+  await prepareStatic(doc)
+  return renderStatic(doc, opts)
+}
