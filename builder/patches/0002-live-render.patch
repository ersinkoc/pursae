diff --git a/src/builder/live/ctx.ts b/src/builder/live/ctx.ts
new file mode 100644
index 0000000..832dbf8
--- /dev/null
+++ b/src/builder/live/ctx.ts
@@ -0,0 +1,37 @@
+import { createContext, useContext } from 'react'
+
+/**
+ * Live (static snapshot) rendering state. Present only while renderStatic() draws a page for publishing;
+ * the editor, previews and thumbnails never provide it, so every live branch is opt-in.
+ */
+export interface LiveState {
+  postId: number
+  /** Top-level section being drawn (form actions, dismiss keys). */
+  sectionId: string
+  /** Absolute action URL of a form section. */
+  formAction: (sectionId: string) => string
+  /** Container width this pass is drawn for (designs that switch on a JS width check read it). */
+  width: number
+  /** Breakpoints (px) the section asked about through useNarrow during this pass. */
+  bps: Set<number>
+  /** Generated CSS (free-form sections' small-screen rules); keyed selectors use data-wb-el. */
+  css: string[]
+  /** data-el keys to keep in the output as data-wb-el (targets of generated CSS). */
+  keepEl: Set<string>
+}
+
+export const LiveCtx = createContext<LiveState | null>(null)
+
+/** The live rendering state, or null in the editor. */
+export const useLive = () => useContext(LiveCtx)
+
+/** href values a published page may carry (mirrors the server's SafeHref: http(s), mailto, tel, #…, relative). */
+export function liveHref(raw?: string): string | undefined {
+  const v = (raw ?? '').trim()
+  if (!v) return undefined
+  const probe = v.replace(/[\u0000- \u007f-\u009f]/g, '')
+  if (/^(https?:|mailto:|tel:)/i.test(probe)) return v
+  if (/^[a-z][a-z0-9+.-]*:/i.test(probe)) return undefined
+  if (probe.startsWith('//') || probe.includes('\\')) return undefined
+  return v
+}
diff --git a/src/builder/live/fixtures.tsx b/src/builder/live/fixtures.tsx
new file mode 100644
index 0000000..bc41729
--- /dev/null
+++ b/src/builder/live/fixtures.tsx
@@ -0,0 +1,123 @@
+/*
+ * Node-only fixture export and checks for the static renderer (not part of any bundle).
+ *   node fixtures.mjs <out-dir> <site.css>
+ * Writes <name>.doc.json (the DocState) and <name>.render.json (its RenderResult) for every case, and fails
+ * on any exception or contract violation: editor attributes, inline opacity:0, <style>/<script> in the
+ * markup, width-range classes missing from the site stylesheet.
+ */
+import './seed'
+import fs from 'node:fs'
+import path from 'node:path'
+import { KINDS, createLayout, createSection, initialDoc } from '../data'
+import { historyReducer, initHistory } from '../store'
+import type { DocAction } from '../store'
+import type { DocState, Section, SectionKind } from '../types'
+import { LIBRARY, createVariantSection } from '../variants'
+import { renderStatic, type RenderResult } from './renderStatic'
+
+const POST = 42
+const SITE = 'https://example.com'
+const opts = { postId: POST, siteUrl: SITE, formAction: (id: string) => `${SITE}/wp-json/web-builder/v2/forms/${POST}/${encodeURIComponent(id)}` }
+
+const site = initialDoc.site
+const cases: [string, DocState][] = []
+
+cases.push(['initial', initialDoc])
+cases.push(['kinds', { site, sections: (Object.keys(KINDS) as SectionKind[]).map((k) => createSection(k)) }])
+for (const kv of LIBRARY) {
+  const sections = kv.variants.filter((v) => v.C).map((v) => createVariantSection(kv.kind, v.id))
+  if (sections.length) cases.push([`variants-${kv.kind}`, { site, sections }])
+}
+
+/** Flexbox + grid layouts with every cell type, a nested container (hidden on mobile, own CSS). */
+function layoutDoc(): DocState {
+  let h = initHistory({ site, sections: [createLayout('flex', '33-33-33'), createLayout('grid', 'g-2x2')] })
+  const act = (a: unknown) => (h = historyReducer(h, a as DocAction))
+  const [a, g] = h.entries[0].doc.sections
+  const types = ['heading', 'text', 'button', 'image'] as const
+  a.items.forEach((it, i) => act({ type: 'cell', id: a.id, itemId: it.id, cell: i === 2 ? 'layout' : types[i] }))
+  g.items.forEach((it, i) => act({ type: 'cell', id: g.id, itemId: it.id, cell: types[i % 4] }))
+  const doc = h.entries[h.cursor].doc
+  const nested = doc.sections[0].items.find((i) => i.sub)?.sub
+  if (nested) nested.style = { ...nested.style, hideOn: ['mobile'], css: 'selector { outline: 1px solid var(--line); }' }
+  return doc
+}
+cases.push(['layout', layoutDoc()])
+
+/** Every runtime behaviour, per-device and per-element visibility, motion, links and custom CSS. */
+function behavioursDoc(): DocState {
+  const variant = (kind: SectionKind, id: string) => createVariantSection(kind, id)
+  const nav = createSection('nav')
+  const hero = createSection('hero')
+  const features = createSection('features')
+  const faq = createSection('faq')
+  const steps = createSection('steps')
+  const html = createSection('html')
+  const form = createSection('form')
+  const cta = createSection('cta')
+  nav.items = nav.items.map((it, i) => ({ ...it, href: ['#' + features.id, 'https://example.org/docs', 'mailto:hello@example.com', '/pricing'][i % 4] }))
+  nav.style = { ...nav.style, motion: { sticky: true } }
+  hero.content = { ...hero.content, primaryHref: '#' + form.id, secondaryHref: 'https://example.org/' }
+  hero.style = { ...hero.style, motion: { entrance: 'fade-up', stagger: true, staggerDelay: 120, parallax: 30, parallaxTarget: 'bg' } }
+  hero.bg = { ...hero.bg, decor: 'rings', decorAnim: 'spin' }
+  const [f0, f1] = features.items
+  features.style = { ...features.style, motion: { entrance: 'zoom-in', duration: 900, easing: 'spring', repeat: true, hover: 'lift', hoverTarget: 'items' } }
+  features.els = {
+    [`items.${f0.id}.title`]: { motion: { entrance: 'blur', delay: 200 } },
+    [`items.${f1.id}.text`]: { hide: true },
+    body: { removed: true },
+  }
+  steps.style = { ...steps.style, hideOn: ['mobile', 'tablet'], cssId: 'how-it-works', css: 'selector h3 { letter-spacing: -0.01em; }', motion: { scrollFade: true, scrollScale: true } }
+  cta.style = { ...cta.style, hideOn: ['desktop'], palette: 'dark' }
+  return {
+    site,
+    sections: [variant('banner', 'dismiss'), nav, hero, features, steps, faq, variant('nav', 'mega'), html, form, variant('form', 'booking'), variant('form', 'newsletter'), cta],
+  }
+}
+cases.push(['behaviours', behavioursDoc()])
+
+/* ---------- Checks ---------- */
+const cssEscape = (v: string) =>
+  v.replace(/[^A-Za-z0-9_-]/g, (c) => `\\${c}`).replace(/^([0-9])/, (d) => `\\3${d} `)
+
+function check(name: string, r: RenderResult, siteCss: string): string[] {
+  const bad: string[] = []
+  // The html section's sandboxed srcdoc is the author's own (escaped) document; check the page markup only.
+  const h = r.html.replace(/ srcdoc="[^"]*"/gi, ' srcdoc=""')
+  if (!/^<div class="wb-page[ "]/.test(h) || !h.includes(' data-wb-root=""')) bad.push('root element')
+  const editorAttr = h.match(/ data-(?!wb-)[A-Za-z0-9_.:-]+=/g)
+  if (editorAttr) bad.push(`editor attributes: ${[...new Set(editorAttr)].join(' ')}`)
+  if (/opacity:0(?![.\d])/.test(h)) bad.push('inline opacity:0')
+  if (/<(style|script|link|meta)[\s>]/i.test(h)) bad.push('style/script/link/meta element')
+  if (/ (?:on[a-z]+|contenteditable|spellcheck|draggable)=/i.test(h)) bad.push('event handler or editing attribute')
+  for (const c of r.classes) if (/^@(?:min|max)-\[/.test(c) && !siteCss.includes(`.${cssEscape(c)}`)) bad.push(`class ${c} missing from site.css`)
+  return bad.map((b) => `${name}: ${b}`)
+}
+
+const out = process.argv[2]
+const siteCss = process.argv[3] ? fs.readFileSync(process.argv[3], 'utf8') : ''
+if (!out) throw new Error('usage: fixtures <out-dir> [site.css]')
+fs.rmSync(out, { recursive: true, force: true })
+fs.mkdirSync(out, { recursive: true })
+const problems: string[] = []
+let bytes = 0
+for (const [name, doc] of cases) {
+  let r: RenderResult
+  try {
+    r = renderStatic(doc, opts)
+  } catch (e) {
+    problems.push(`${name}: ${(e as Error).stack ?? e}`)
+    continue
+  }
+  if (siteCss) problems.push(...check(name, r, siteCss))
+  const json = JSON.stringify(r) + '\n'
+  bytes += json.length
+  fs.writeFileSync(path.join(out, `${name}.doc.json`), JSON.stringify(doc) + '\n')
+  fs.writeFileSync(path.join(out, `${name}.render.json`), json)
+}
+const count = (sections: Section[]) => sections.length
+console.log(`[web-builder] fixtures: ${cases.length} docs, ${cases.reduce((n, [, d]) => n + count(d.sections), 0)} sections, ${(bytes / 1024).toFixed(0)} KB of render JSON → ${out}`)
+if (problems.length) {
+  console.error(problems.join('\n'))
+  process.exit(1)
+}
