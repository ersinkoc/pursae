+++ b/src/builder/i18n.ts
@@ -0,0 +1,103 @@
+/**
+ * Tiny i18n for the builder UI.
+ *
+ * Source strings are English: wrap every UI string in t('English text'). A catalog per language
+ * (./i18n/<lang>.ts) maps the English source to the translation; a missing entry falls back to the
+ * English text. Placeholders are written as {name} and filled from the second argument:
+ *
+ *   t('{count} items selected', { count: 3 })
+ *
+ * The language comes from setLocale() (an embedding host calls it before the builder modules load),
+ * else from the installed host's locale (window.__WEB_BUILDER_HOST__), else from the standalone
+ * host; outside a browser (Node: fixtures, tests) it is English. Locales are matched by their
+ * language part: "tr", "tr_TR" and "tr-TR" all pick Turkish; anything without a catalog is English.
+ *
+ * Some strings are translated once, at module load (constant tables such as section kinds), so the
+ * language should be set before the builder modules are imported.
+ *
+ * Published output never depends on the editor's language: renderStatic runs inside
+ * withSourceLocale(), where t() returns the English source. Document content (default texts,
+ * demo page) is plain English and is not translated at all.
+ *
+ * Keep this file free of React and runtime imports other than the catalogs.
+ */
+import { standaloneHost } from './host'
+import tr from './i18n/tr'
+
+export type Catalog = Readonly<Record<string, string>>
+export type Vars = Readonly<Record<string, string | number | null | undefined>>
+
+const CATALOGS: Readonly<Record<string, Catalog>> = { tr }
+
+/** Language code of a locale ("tr_TR" → "tr"), or "en" when there is no catalog for it. */
+export function langOf(locale: string | undefined | null): string {
+  const lang = String(locale ?? '').trim().toLowerCase().split(/[_-]/)[0]
+  return lang && CATALOGS[lang] ? lang : 'en'
+}
+
+let fixed: string | null = null
+let sourceDepth = 0
+
+/** Sets the UI language for the rest of the session ("tr_TR", "en_US", …). */
+export function setLocale(locale: string | undefined | null) {
+  fixed = langOf(locale)
+}
+
+/** The current UI language ("en" or a catalog language). */
+export function lang(): string {
+  if (sourceDepth > 0) return 'en'
+  if (fixed) return fixed
+  if (typeof window === 'undefined') return 'en'
+  return langOf(window.__WEB_BUILDER_HOST__?.locale ?? standaloneHost.locale)
+}
+
+/** BCP 47 tag of the current UI language, for Intl and toLocale*() calls. */
+export const intlLocale = () => (lang() === 'tr' ? 'tr-TR' : 'en-US')
+
+const fill = (msg: string, vars?: Vars) => (vars ? msg.replace(/\{(\w+)\}/g, (m, k: string) => (k in vars ? String(vars[k] ?? '') : m)) : msg)
+
+/** The UI string `source` (English) in the current language, with {placeholders} filled. */
+export function t(source: string, vars?: Vars): string {
+  const l = lang()
+  const msg = l === 'en' ? source : CATALOGS[l]?.[source] || source
+  return fill(msg, vars)
+}
+
+/** Runs fn with t() returning the English source strings (published output, fixtures). */
+export function withSourceLocale<T>(fn: () => T): T {
+  sourceDepth++
+  try {
+    return fn()
+  } finally {
+    sourceDepth--
+  }
+}
+
+const escapeRe = (s: string) => s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')
+
+/**
+ * Reads the placeholders back out of a string made with t(pattern, vars): tMatch('Hero edited',
+ * '{name} edited') → { name: 'Hero' }; null when the string does not have that shape. Used where
+ * the builder inspects labels it produced earlier (history entries).
+ */
+export function tMatch(text: string, pattern: string): Record<string, string> | null {
+  const msg = t(pattern)
+  const names: string[] = []
+  const re = new RegExp(
+    '^' +
+      msg
+        .split(/(\{\w+\})/)
+        .map((part) => {
+          const m = /^\{(\w+)\}$/.exec(part)
+          if (!m) return escapeRe(part)
+          names.push(m[1])
+          return '(.+?)'
+        })
+        .join('') +
+      '$',
+    's',
+  )
+  const m = re.exec(text)
+  if (!m) return null
+  return Object.fromEntries(names.map((n, i) => [n, m[i + 1]]))
+}
