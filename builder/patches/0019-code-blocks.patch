+          className="pointer-events-auto sticky top-2 mt-2 mr-2 ml-auto flex w-72 flex-col overflow-hidden rounded-xl border border-black/10 bg-white text-[12px] text-[#1d2327] shadow-2xl"
+          style={{ maxHeight: Math.min(Math.max(240, h - 16), typeof window !== 'undefined' ? window.innerHeight - 96 : 800) }}
+          onClick={(e) => e.stopPropagation()}
+        >
+          <div className="flex items-center gap-1 border-b border-black/10 p-1.5">
+            {(['style', 'layers'] as const).map((k) => (
+              <button key={k} type="button" className={`rounded-md px-2.5 py-1 font-medium ${panel === k ? 'bg-[#2271b1] text-white' : 'hover:bg-black/5'}`} onClick={() => setPanel(k)}>
+                {k === 'style' ? t('Style') : t('Layers')}
+              </button>
+            ))}
+            <button type="button" aria-label={t('Close')} className="ml-auto rounded-md p-1 hover:bg-black/5" onClick={() => setPanel(null)}>
+              <X size={14} />
+            </button>
+          </div>
+          <div className="min-h-0 flex-1 overflow-auto p-2.5">
+            {panel === 'style' && (pick && src ? <StylePanel key={pick.id} el={src} live={liveEl(pick.id)} onStyle={(p, v) => setStyle(pick.id, p, v)} onAttr={(n, v, l) => setAttr(pick.id, n, v, l)} /> : <p className="text-black/60">{t('Select an element on the page.')}</p>)}
+            {panel === 'layers' && <LayerTree run={cur.current.run} selected={pick?.id ?? null} onPick={(id) => choose(id, true)} />}
+          </div>
+        </div>
+        </div>
+      )}
     </div>
   )
 }
+
+function StylePanel({ el, live, onStyle, onAttr }: { el: HTMLElement; live: HTMLElement | null; onStyle: (prop: string, value: string) => void; onAttr: (name: string, value: string, label: string) => void }) {
+  const computed = live ? live.ownerDocument.defaultView?.getComputedStyle(live) : null
+  const field = 'w-full rounded-md border border-black/15 px-2 py-1 text-[12px] focus:border-[#2271b1] focus:outline-none'
+  return (
+    <div className="flex flex-col gap-2">
+      <p className="text-[11px] text-black/55">{t('Values set here override the design’s own style for this element.')}</p>
+      {styleFields().map((f) => {
+        const own = el.style.getPropertyValue(f.prop)
+        const now = computed?.getPropertyValue(f.prop) ?? ''
+        const commit = (v: string) => {
+          const next = f.kind === 'len' ? withUnits(v.trim()) : v.trim()
+          if (next !== own) onStyle(f.prop, next)
+        }
+        return (
+          <label key={f.prop} className="grid grid-cols-[96px_1fr] items-center gap-2">
+            <span className="text-black/70">{f.label}</span>
+            {f.kind === 'select' ? (
+              <select className={field} defaultValue={own} onChange={(e) => commit(e.target.value)}>
+                {f.options!.map((o) => (
+                  <option key={o} value={o}>
+                    {o || `${t('Design')} (${now})`}
+                  </option>
+                ))}
+              </select>
+            ) : (
+              <span className="flex items-center gap-1">
+                {f.kind === 'color' && <input type="color" className="h-7 w-8 shrink-0 cursor-pointer rounded border border-black/15 p-0" defaultValue={toHex(own || now) || '#ffffff'} onChange={(e) => commit(e.target.value)} />}
+                <input className={field} defaultValue={own} placeholder={now} onKeyDown={(e) => e.key === 'Enter' && (e.target as HTMLInputElement).blur()} onBlur={(e) => commit(e.target.value)} />
+              </span>
+            )}
+          </label>
+        )
+      })}
+      <label className="mt-1 flex flex-col gap-1">
+        <span className="text-black/70">{t('Classes')}</span>
+        <input className={field} defaultValue={el.getAttribute('class') ?? ''} onKeyDown={(e) => e.key === 'Enter' && (e.target as HTMLInputElement).blur()} onBlur={(e) => e.target.value.trim() !== (el.getAttribute('class') ?? '') && onAttr('class', e.target.value.trim(), t('Classes changed'))} />
+      </label>
+      <label className="flex flex-col gap-1">
+        <span className="text-black/70">{t('Inline CSS')}</span>
+        <textarea className={`${field} font-mono`} rows={3} defaultValue={el.getAttribute('style') ?? ''} onBlur={(e) => e.target.value.trim() !== (el.getAttribute('style') ?? '') && onAttr('style', e.target.value.trim(), t('Style changed'))} />
+      </label>
+    </div>
+  )
+}
+
+/** The run's elements as a tree; the path to the selection is open. */
+function LayerTree({ run, selected, onPick }: { run: Section[]; selected: string | null; onPick: (id: string) => void }) {
+  const roots = useMemo(() => run.map((s) => ({ s, body: parse(s.content.html ?? '').body })), [run])
+  const path = useMemo(() => {
+    const open = new Set<string>()
+    if (!selected) return open
+    for (const r of roots) {
+      let el: Element | null = byId(r.body, selected)
+      if (!el) continue
+      open.add(r.s.id)
+      while ((el = el.parentElement)) if (el.getAttribute('data-wbc')) open.add(el.getAttribute('data-wbc')!)
+    }
+    return open
+  }, [roots, selected])
+  const [opened, setOpened] = useState<Set<string>>(new Set())
+  const isOpen = (k: string) => opened.has(k) !== path.has(k)
+  const toggle = (k: string) => setOpened((o) => {
+    const n = new Set(o)
+    if (n.has(k)) n.delete(k)
+    else n.add(k)
+    return n
+  })
+  const kids = (el: Element) => Array.from(el.children).filter((k) => k.hasAttribute('data-wbc'))
+  const row = (el: Element, depth: number): ReactNode => {
+    const id = el.getAttribute('data-wbc')!
+    const list = el.tagName.toLowerCase() === 'svg' ? [] : kids(el)
+    const open = list.length > 0 && isOpen(id)
+    return (
+      <li key={id}>
+        <div className={`flex items-center rounded ${selected === id ? 'bg-[#2271b1] text-white' : 'hover:bg-black/5'}`} style={{ paddingLeft: depth * 12 }}>
+          <button type="button" className="w-4 shrink-0" aria-label={open ? t('Collapse') : t('Expand')} onClick={() => list.length && toggle(id)}>
+            {list.length > 0 && (open ? <ChevronDown size={12} /> : <ChevronRight size={12} />)}
+          </button>
+          <button type="button" className="min-w-0 flex-1 truncate py-0.5 text-left" onClick={() => onPick(id)}>
+            {elName(el)}
+          </button>
+        </div>
+        {open && <ul>{list.map((k) => row(k, depth + 1))}</ul>}
+      </li>
+    )
+  }
+  return (
+    <ul className="flex flex-col">
+      {roots.map(({ s, body }) => {
+        const open = isOpen(s.id)
+        return (
+          <li key={s.id}>
+            <button type="button" className="flex w-full items-center gap-1 rounded py-0.5 text-left font-semibold hover:bg-black/5" onClick={() => toggle(s.id)}>
+              {open ? <ChevronDown size={12} /> : <ChevronRight size={12} />}
+              <span className="truncate">{s.name || t('Code section')}</span>
+            </button>
+            {open && <ul>{kids(body).map((k) => row(k, 1))}</ul>}
+          </li>
+        )
+      })}
+    </ul>
+  )
+}
