diff --git a/src/builder/host.ts b/src/builder/host.ts
new file mode 100644
index 0000000..6274fe0
--- /dev/null
+++ b/src/builder/host.ts
@@ -0,0 +1,188 @@
+/**
+ * Host seam: everything the builder needs from the page that embeds it.
+ *
+ * The builder never talks to storage, a server, a media library or a font CDN directly; it asks
+ * the current host. `standaloneHost` keeps the original behaviour (localStorage, blob: uploads,
+ * Google Fonts, a simulated publish), so the app still runs on its own. An embedding CMS sets its
+ * own host before the first render, either with setHost() or by assigning
+ * `window.__WEB_BUILDER_HOST__`.
+ *
+ * Keep this file free of React and of runtime imports: hosts import it on its own.
+ */
+import type { DocState, PageSettings } from './types'
+
+/* ---------- Local persistence (used by the standalone host) ---------- */
+export const STORE_KEY = 'pursae-builder:v2'
+
+export function loadJSON<T>(key: string, fallback: T): T {
+  try {
+    const raw = localStorage.getItem(key)
+    return raw ? (JSON.parse(raw) as T) : fallback
+  } catch {
+    return fallback
+  }
+}
+
+export function saveJSON(key: string, value: unknown) {
+  try {
+    localStorage.setItem(key, JSON.stringify(value))
+  } catch {
+    /* storage full or unavailable: keep working in memory */
+  }
+}
+
+/* ---------- Media ---------- */
+
+export type MediaKind = 'image'
+
+/** A stored media file. `url` is what goes into the document. */
+export interface MediaAsset {
+  url: string
+  id?: number
+  alt?: string
+  width?: number
+  height?: number
+}
+
+export interface BuilderHostMedia {
+  /** Stores a file the user chose from their computer and returns where it now lives. */
+  upload(file: File, kind: MediaKind): Promise<MediaAsset>
+  /** Optional media library dialog; null when the user cancels. Absent = no library button. */
+  pick?(kind: MediaKind): Promise<MediaAsset | null>
+  /**
+   * Reads an .svg file the user chose; the markup is inlined into the document, so a host can
+   * enforce its own size or content rules here (reject by throwing an Error with a message).
+   */
+  readSvg(file: File): Promise<string>
+}
+
+/* ---------- Storage (per-user editor preferences) ---------- */
+
+/**
+ * Small per-user preferences (saved components, onboarding flags, recent fonts, …). Keys are short
+ * names like "flags"; the host namespaces them. Synchronous on purpose: they seed initial state.
+ */
+export interface BuilderHostStorage {
+  get<T>(key: string, fallback: T): T
+  set(key: string, value: unknown): void
+}
+
+/* ---------- Publish / forms / AI ---------- */
+
+export interface PublishInput {
+  doc: DocState
+  page: PageSettings
+}
+
+export interface PublishResult {
+  /** Toast text instead of the default "published" message (e.g. "Submitted for review"). */
+  message?: string
+}
+
+export interface FormResult {
+  ok: boolean
+  message: string
+}
+
+export interface BuilderHostAi {
+  /** false: no AI mode, no AI chip, no AI settings, no AI requests. */
+  enabled: boolean
+  /** Base URL the LLM client calls instead of the provider APIs; undefined = call providers directly. */
+  llmBase?: string
+  /** The host holds the provider keys: the browser never asks for or sends one. */
+  serverKeys: boolean
+  /** AI tools may write html sections and custom CSS. */
+  allowCode: boolean
+  /** Image search endpoint; undefined = the built-in dev endpoint. */
+  imagesEndpoint?: string
+  /** Clone-site endpoint; undefined = the built-in dev endpoint, null = clone is unavailable. */
+  cloneEndpoint?: string | null
+}
+
+/* ---------- The host ---------- */
+
+export interface BuilderHost {
+  /** The stored document, unvalidated (the builder runs it through normalizeDoc); null = start fresh. */
+  loadDoc(): unknown
+  /** Stored page settings, or null for the defaults. */
+  loadPage(): Partial<PageSettings> | null
+  /** Autosave of the working copy. A rejected promise is shown to the user and retried on the next change. */
+  saveDraft(doc: DocState, page: PageSettings): void | Promise<void>
+  /** Debounce of saveDraft in milliseconds (default 500). */
+  autosaveDelay?: number
+  /** Makes the current document live. Reject with an Error whose message the user should see. */
+  publish(input: PublishInput): Promise<PublishResult | void>
+  storage: BuilderHostStorage
+  media: BuilderHostMedia
+  /** Google Fonts CSS2-compatible endpoint (…/css2) used to load fonts in the editor. */
+  fontsCss: string
+  /** Absolute site home URL, no trailing slash. */
+  siteUrl: string
+  /** Where the logo in the top bar leads (back to the CMS); undefined = the logo is not a link. */
+  exitUrl?: string
+  /** Sends a form section's fields; used by live pages and previews. */
+  submitForm(sectionId: string, fields: Record<string, string>): Promise<FormResult>
+  /** AI integration; absent = AI disabled. */
+  ai?: BuilderHostAi
+  /** BCP 47 or WordPress-style locale of the editor UI (e.g. "tr", "en_US"). */
+  locale: string
+}
+
+export const AI_DISABLED: BuilderHostAi = Object.freeze({ enabled: false, serverKeys: false, allowCode: false, cloneEndpoint: null })
+
+/* ---------- Standalone host (original behaviour) ---------- */
+
+const NS = 'pursae-builder:'
+const PAGE_KEY = 'page'
+
+export const standaloneHost: BuilderHost = {
+  loadDoc: () => loadJSON<unknown>(STORE_KEY, null),
+  loadPage: () => loadJSON<Partial<PageSettings> | null>(NS + PAGE_KEY, null),
+  saveDraft(doc, page) {
+    saveJSON(STORE_KEY, doc)
+    saveJSON(NS + PAGE_KEY, page)
+  },
+  autosaveDelay: 500,
+  publish: () => new Promise<void>((resolve) => window.setTimeout(resolve, 1300)),
+  storage: {
+    get: (key, fallback) => loadJSON(NS + key, fallback),
+    set: (key, value) => saveJSON(NS + key, value),
+  },
+  media: {
+    upload: async (file) => ({ url: URL.createObjectURL(file) }),
+    readSvg: (file) => file.text(),
+  },
+  fontsCss: 'https://fonts.googleapis.com/css2',
+  siteUrl: 'https://pursae.dev',
+  submitForm: async () => ({ ok: true, message: '' }),
+  ai: { enabled: true, serverKeys: false, allowCode: true },
+  locale: 'tr',
+}
+
+/* ---------- Current host ---------- */
+
+declare global {
+  interface Window {
+    /** A host installed by the embedding page before the builder loads. */
+    __WEB_BUILDER_HOST__?: BuilderHost
+  }
+}
+
+let current: BuilderHost | null = null
+
+/** Installs the host. Call before the builder first renders; later calls do not re-run loaders. */
+export function setHost(host: BuilderHost) {
+  current = host
+}
+
+/** The current host: setHost(), else window.__WEB_BUILDER_HOST__, else the standalone host. */
+export function getHost(): BuilderHost {
+  if (!current) current = (typeof window !== 'undefined' && window.__WEB_BUILDER_HOST__) || standaloneHost
+  return current
+}
+
+/** The host's AI settings, AI_DISABLED when it has none. */
+export const hostAi = (h: BuilderHost = getHost()): BuilderHostAi => h.ai ?? AI_DISABLED
+
+/** Site URL without the scheme, for display ("example.com/path"). */
+export const siteLabel = (h: BuilderHost = getHost()) => h.siteUrl.replace(/^[a-z][a-z0-9+.-]*:\/\//i, '').replace(/\/+$/, '')
