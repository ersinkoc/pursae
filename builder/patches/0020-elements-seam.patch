diff --git a/src/builder/elementsSeam.ts b/src/builder/elementsSeam.ts
new file mode 100644
index 0000000..35998c2
--- /dev/null
+++ b/src/builder/elementsSeam.ts
@@ -0,0 +1,30 @@
+import type { ComponentType, ReactNode } from 'react'
+import type { DocState, Section } from './types'
+
+/**
+ * Host seam of the element editor (Pursae Web Builder, builder/host/elements): a page made of code
+ * sections is drawn and edited by the host's canvas (one frame with the whole page) and its
+ * sections get the host's branch in the navigator. Absent in the standalone builder; then code
+ * sections keep CodeSection.tsx.
+ */
+export interface ElementsSeam {
+  /** The host draws this doc's canvas. */
+  handles(doc: DocState): boolean
+  Canvas: ComponentType
+  /** Navigator rows of one code section (the section row included). */
+  Nav: ComponentType<{ s: Section }>
+  /** The inspector's Style and Advanced tabs for a code section of a page the host draws. */
+  Tab?: ComponentType<{ s: Section; tab: 'style' | 'advanced' }>
+  /** The inspector's Content tab for that section; fallback is the builder's own (the section's code). */
+  Content?: ComponentType<{ s: Section; fallback: ReactNode }>
+  /** The inspector's title for that section ("Edit Heading"); null keeps the builder's. */
+  title?: (s: Section) => string | null
+}
+
+let seam: ElementsSeam | null = null
+
+export function setElementsSeam(next: ElementsSeam | null) {
+  seam = next
+}
+
+export const elementsSeam = () => seam
