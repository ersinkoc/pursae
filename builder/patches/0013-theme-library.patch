+import { useSyncExternalStore } from 'react'
+
+/**
+ * Host seam of the theme library (Pursae Web Builder): a card in the Items panel that opens the
+ * host's gallery of ready-made themes. Absent in the standalone builder, so no card is drawn.
+ */
+export interface ThemeLibrarySeam {
+  title: string
+  blurb: string
+  open(): void
+}
+
+let seam: ThemeLibrarySeam | null = null
+const subs = new Set<() => void>()
+
+export function setThemeLibrarySeam(next: ThemeLibrarySeam | null) {
+  seam = next
+  subs.forEach((f) => f())
+}
+
+const subscribe = (f: () => void) => {
+  subs.add(f)
+  return () => subs.delete(f)
+}
+export const useThemeLibrarySeam = () => useSyncExternalStore(subscribe, () => seam)
