+  post(102, 'Moving forty sites in an afternoon', 'moving-forty-sites', 'A step-by-step account of a real migration, with the numbers before and after.', 21, 1, 'Guides', 2),
+  post(103, 'Designing a header that works on every screen', 'designing-a-header', 'Logo, menu and search: small decisions that make a site easy to find your way around.', 14, 2, 'Design', 0),
+  post(104, 'Why plugins run in a sandbox', 'why-plugins-run-in-a-sandbox', 'WebAssembly lets plugins do their job without reaching into the rest of the site.', 7, 4, 'Engineering', 7),
+  post(105, 'Caching without the plugin hunt', 'caching-without-plugins', 'The built-in cache knows which pages a change touches, so purges stay small.', 3, 5, 'Engineering', 1),
+  post(106, 'A theme in three files', 'a-theme-in-three-files', 'Header, content and footer: the smallest theme that still looks finished.', 1, 6, 'Design', 3),
+]
+
+const menu = (labels: [string, string][]): DynMenuItem[] => labels.map(([label, path], i) => ({ id: 900 + i, label, url: `${HOME}${path}`, current: i === 0, children: [] }))
+
+/** The standalone default: a blog with a few posts, two menus and no custom logo. */
+export const SAMPLE_DYNAMIC: DynContext = {
+  object: 'front',
+  site: { title: 'Pursae', tagline: 'WordPress, at the speed of Go', home: HOME, logo: null, year: '2026' },
+  locations: [
+    { slug: 'primary', name: 'Primary Menu' },
+    { slug: 'footer', name: 'Footer Menu' },
