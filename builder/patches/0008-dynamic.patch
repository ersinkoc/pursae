+  '<blockquote><p>We moved forty sites in an afternoon and our hosting bill halved.</p></blockquote>',
+  '<p>Read the migration guide to move an existing site, or start fresh with the built-in theme.</p>',
+].join('\n')
+
+const author = { name: 'Ada Lovelace', url: `${HOME}/author/ada/`, avatar: IMAGES[3].url, bio: 'Writes about fast websites, plain HTML and the people who build them.' }
+
+function post(id: number, title: string, slug: string, excerpt: string, day: number, img: number, cat: string, comments: number): DynPost {
