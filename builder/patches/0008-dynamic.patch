+/**
+ * Starter designs of Theme Builder templates (contract §11.2): the editor loads one when a
+ * template's doc is empty (patch 0009); the fixtures render them too. Document content, so plain
+ * English and not translated.
+ */
+import { createLayout, createSection, defaultBox, uid } from '../data'
+import type { DynSettings, DynWidget, Section } from '../types'
+import { dynDefaults } from './model'
+
+export const STARTER_IDS = ['blank', 'header', 'footer', 'single', 'archive', 'search'] as const
+export type StarterId = (typeof STARTER_IDS)[number]
+
+/** A boxed one-column grid of dynamic widgets, top to bottom. */
+function stack(cells: [DynWidget, DynSettings?][], o: { width?: number; padT?: number; padB?: number; gap?: number } = {}): Section {
+  const s = createLayout('grid', 'g3r')
+  s.name = 'Content'
+  s.items = cells.map(([w, dyn]) => ({ id: uid('c'), title: w, text: '', dyn: { ...dynDefaults(w), ...dyn } }))
+  // Side padding of a ready-made section's content (W: 40px on wide screens), so stacks line up with loops.
+  const pad = { t: o.padT ?? 64, r: 40, b: o.padB ?? 64, l: 40 }
+  s.box = { ...defaultBox(s), gridCols: 1, gridRows: s.items.length, width: o.width ?? 760, gapX: 16, gapY: o.gap ?? 20, padding: pad }
+  return s
+}
+
+function header(): Section[] {
+  const nav = createSection('nav', { menu: 'primary', logoSource: 'site', primary: 'Contact' })
+  nav.name = 'Header'
+  return [nav]
+}
+
+function footer(): Section[] {
+  const f = createSection('footer', { menu: 'footer', logoSource: 'site', note: '' })
+  f.name = 'Footer'
+  const legal = stack([['copyright']], { width: 1160, padT: 0, padB: 32 })
+  legal.name = 'Copyright'
+  legal.style = { ...legal.style, palette: f.style.palette }
+  return [f, legal]
+}
+
+/**
+ * An article header: the title and what sits right under it, close together, above the body.
+ * The body stack starts with no top padding so the header's bottom padding is the only gap.
+ */
+function postHeader(cells: [DynWidget, DynSettings?][]): Section {
+  const s = stack(cells, { padB: 32, gap: 12 })
+  s.name = 'Post header'
+  return s
+}
+
+function postBody(cells: [DynWidget, DynSettings?][]): Section {
+  return stack(cells, { padT: 0, gap: 32 })
+}
+
+function single(): Section[] {
+  return [
+    postHeader([
+      ['post-title', { tag: 'h1' }],
+      ['post-meta', { fields: ['date', 'author', 'comments'] }],
+    ]),
+    postBody([
+      ['post-image', { size: 'large', ratio: 1.78 }],
+      ['post-content'],
+      ['post-terms', { prefix: 'Filed under' }],
+      ['author-box'],
+      ['post-nav'],
+      ['post-comments'],
+    ]),
+  ]
+}
+
+function loop(empty: string): Section {
+  const l = createSection('loop', { source: 'main', pagination: 'numbers', empty })
+  l.box = { ...defaultBox(l), padding: { t: 16, r: 0, b: 96, l: 0 } }
+  return l
+}
+
+function archive(): Section[] {
+  return [stack([['archive-title', { tag: 'h1' }], ['archive-desc']], { width: 1160, padB: 24, gap: 12 }), loop('No posts yet.')]
+}
+
+function search(): Section[] {
+  return [
+    stack([['search-query', { tag: 'h1', prefix: 'Search results for:' }], ['search-form']], { width: 1160, padB: 24, gap: 16 }),
+    loop('Nothing matched your search. Try different words.'),
+  ]
+}
+
+/** The sections of a starter (fresh ids on every call). */
+export function starterSections(id: StarterId): Section[] {
+  switch (id) {
+    case 'header':
+      return header()
+    case 'footer':
+      return footer()
+    case 'single':
+      return single()
+    case 'archive':
+      return archive()
+    case 'search':
+      return search()
+    default:
+      return []
+  }
+}
