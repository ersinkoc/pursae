+import type { ReactNode } from 'react'
+import { useB } from '../store'
+import type { DynSettings, DynWidget, Item, Section } from '../types'
+import { Toggle, cn } from '../ui'
+import { Ctl, Panel, Select, Slider, inputCls } from '../StudioPanel'
+import { t } from '../i18n'
+import { useDynamic } from './ctx'
+import { CONTENT_LOGO_SOURCE, CONTENT_MENU } from './menu'
+import { BURGER_WIDTHS, DYN_DEFS, burgerWidth, isDynWidget, loopQuery } from './model'
+import { DATE_FORMAT_RE } from './format'
+
+/* Studio inspector panels of the Theme Builder: dynamic widget settings, the loop query and the nav / footer binding. */
+
+const TAGS = ['h1', 'h2', 'h3', 'h4', 'h5', 'h6', 'p', 'div', 'span'] as const
+const has = (w: DynWidget, list: DynWidget[]) => list.includes(w)
+
+function Text({ value, onChange, max, placeholder, rows }: { value: string; onChange: (v: string) => void; max: number; placeholder?: string; rows?: number }) {
+  const cls = 'w-full rounded-[5px] border border-white/[0.08] bg-ink-850 px-2 py-1.5 text-[12px] text-ink-100 outline-none focus:border-accent/70'
+  return rows ? (
+    <textarea rows={rows} value={value} maxLength={max} placeholder={placeholder} onChange={(e) => onChange(e.target.value)} className={cn(cls, 'resize-y leading-snug')} />
+  ) : (
+    <input value={value} maxLength={max} placeholder={placeholder} onChange={(e) => onChange(e.target.value)} className={cn(inputCls, 'w-[150px]')} />
+  )
+}
+
+function Hint({ children }: { children: ReactNode }) {
+  return <p className="text-[11px] leading-relaxed text-ink-500">{children}</p>
+}
+
+/** Settings of a layout cell holding a dynamic widget (Content tab of the cell). */
+export function DynCellPanel({ s, item }: { s: Section; item: Item }) {
+  const b = useB()
+  const ctx = useDynamic()
+  if (!isDynWidget(item.title)) return null
+  const w = item.title
+  const d: DynSettings = { ...DYN_DEFS[w].defaults, ...item.dyn }
+  const set = (patch: Partial<DynSettings>, key?: string) => b.dispatch({ type: 'dyn', id: s.id, itemId: item.id, patch, key })
+  const locations = ctx.locations.length ? ctx.locations : [{ slug: 'primary', name: t('Primary menu') }]
+  const taxes = [...new Set(['category', 'post_tag', d.tax ?? 'category'])]
+  const taxLabel = (x: string) => (x === 'category' ? t('Categories') : x === 'post_tag' ? t('Tags') : x)
+  return (
+    <Panel title={DYN_DEFS[w].label}>
+      {has(w, ['site-title', 'site-tagline', 'post-title', 'archive-title', 'search-query']) && (
+        <Ctl label={t('HTML tag')}>
+          <Select value={d.tag ?? 'p'} w={90} onChange={(v) => set({ tag: v })} options={TAGS.map((v) => ({ value: v, label: v.toUpperCase() }))} />
+        </Ctl>
+      )}
+      {has(w, ['site-logo', 'site-title', 'post-title', 'post-image', 'post-author']) && (
+        <Ctl label={w.startsWith('site') ? t('Link to the home page') : w === 'post-author' ? t('Link to the author') : t('Link to the post')}>
+          <Toggle on={!!d.link} onChange={(v) => set({ link: v })} />
+        </Ctl>
+      )}
+      {w === 'nav-menu' && (
+        <>
+          <Ctl label={t('Menu location')}>
+            <Select value={d.location ?? 'primary'} onChange={(v) => set({ location: v })} options={locations.map((l) => ({ value: l.slug, label: l.name }))} />
+          </Ctl>
+          <Ctl label={t('Layout')}>
+            <Select
+              value={d.menuLayout ?? 'row'}
+              onChange={(v) => set({ menuLayout: v })}
+              options={[
+                { value: 'row', label: t('Row') },
+                { value: 'column', label: t('Column') },
+                { value: 'burger', label: t('Menu button') },
+              ]}
+            />
+          </Ctl>
+          {(d.menuLayout ?? 'row') === 'row' && (
+            <Ctl label={t('Menu button below')}>
+              <Select value={burgerWidth(d.burgerAt)} w={110} onChange={(v) => set({ burgerAt: v })} options={[{ value: 0, label: t('Never') }, ...BURGER_WIDTHS.map((px) => ({ value: px, label: `${px}px` }))]} />
+            </Ctl>
+          )}
+        </>
+      )}
+      {w === 'search-form' && (
+        <>
+          <Ctl label={t('Placeholder')}>
+            <Text value={d.placeholder ?? ''} max={80} onChange={(v) => set({ placeholder: v }, 'ph')} />
+          </Ctl>
+          <Ctl label={t('Button text')}>
+            <Text value={d.button ?? ''} max={40} placeholder={t('Icon only')} onChange={(v) => set({ button: v }, 'btn')} />
+          </Ctl>
+        </>
+      )}
+      {has(w, ['copyright', 'post-terms', 'post-date', 'post-author', 'search-query']) && (
+        <Ctl label={t('Text before')}>
+          <Text value={d.prefix ?? ''} max={60} onChange={(v) => set({ prefix: v }, 'prefix')} />
+        </Ctl>
+      )}
+      {w === 'post-image' && (
+        <>
+          <Ctl label={t('Image size')}>
+            <Select
+              value={d.size ?? 'large'}
+              onChange={(v) => set({ size: v })}
+              options={[
+                { value: 'thumbnail', label: t('Thumbnail') },
+                { value: 'medium', label: t('Medium') },
+                { value: 'large', label: t('Large') },
+                { value: 'full', label: t('Full size') },
+              ]}
+            />
+          </Ctl>
+          <Ctl label={t('Aspect ratio')}>
+            <Select
+              value={d.ratio ?? 0}
+              w={110}
+              onChange={(v) => set({ ratio: v || undefined })}
+              options={[
+                { value: 0, label: t('Original') },
+                { value: 1.78, label: '16:9' },
+                { value: 1.6, label: '16:10' },
+                { value: 1.5, label: '3:2' },
+                { value: 1.33, label: '4:3' },
+                { value: 1, label: '1:1' },
+                { value: 0.75, label: '3:4' },
+              ]}
+            />
+          </Ctl>
+        </>
+      )}
+      {w === 'post-meta' && (
+        <Ctl label={t('Show')} stack>
+          <div className="grid grid-cols-2 gap-1.5">
+            {(
+              [
+                ['date', t('Date')],
+                ['modified', t('Last updated')],
+                ['author', t('Author')],
+                ['comments', t('Comments')],
+                ['terms', t('Terms')],
+              ] as const
+            ).map(([f, label]) => {
+              const on = (d.fields ?? []).includes(f)
+              return (
+                <label key={f} className="flex items-center gap-2 text-[12px] text-ink-200">
+                  <input type="checkbox" checked={on} onChange={() => set({ fields: on ? (d.fields ?? []).filter((x) => x !== f) : [...(d.fields ?? []), f] })} className="accent-[var(--color-accent)]" />
+                  {label}
+                </label>
+              )
+            })}
+          </div>
+        </Ctl>
+      )}
+      {(w === 'post-terms' || (w === 'post-meta' && d.fields?.includes('terms'))) && (
+        <Ctl label={t('Taxonomy')}>
+          <Select value={d.tax ?? 'category'} onChange={(v) => set({ tax: v })} options={taxes.map((x) => ({ value: x, label: taxLabel(x) }))} />
+        </Ctl>
+      )}
+      {(w === 'post-meta' || w === 'post-terms') && (
+        <Ctl label={t('Separator')}>
+          <Text value={d.sep ?? ''} max={8} onChange={(v) => set({ sep: v }, 'sep')} />
+        </Ctl>
+      )}
+      {(w === 'post-date' || (w === 'post-meta' && (d.fields?.includes('date') || d.fields?.includes('modified')))) && (
+        <>
+          <Ctl label={t('Date format')}>
+            <Text value={d.format ?? ''} max={32} placeholder="F j, Y" onChange={(v) => set({ format: v }, 'format')} />
+          </Ctl>
+          {d.format && !DATE_FORMAT_RE.test(d.format) ? <Hint>{t('Use letters, spaces and , . : / - only.')}</Hint> : <Hint>{t("Empty = the site's date format.")}</Hint>}
+        </>
+      )}
+      {w === 'post-excerpt' && (
+        <Ctl label={t('Words')}>
+          <Slider value={d.words ?? 30} min={5} max={100} unit="" onChange={(v) => set({ words: v }, 'words')} />
