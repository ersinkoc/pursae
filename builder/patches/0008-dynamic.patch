+import { IMAGES } from '../data'
+import type { DynContext, DynImage, DynMenuItem, DynPost } from './types'
+
+const HOME = 'https://pursae.dev'
+
+const image = (n: number): DynImage => ({ url: IMAGES[n].url, width: 1400, height: 933, alt: IMAGES[n].alt })
+
+const BODY = [
+  '<p>Pursae keeps the parts of WordPress people rely on and rewrites the rest in Go: one binary, one PostgreSQL database and plugins that run in a WebAssembly sandbox.</p>',
+  '<h2>Why a rewrite?</h2>',
