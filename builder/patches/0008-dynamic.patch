+import { createElement, useMemo, type CSSProperties, type MouseEvent, type ReactNode } from 'react'
+import { Image as ImageIcon, Lock, Menu, MessageCircle, Search } from 'lucide-react'
+import { elCss } from '../data'
+import { useB } from '../store'
+import type { DynSettings, DynWidget, ElKind, Item, Section } from '../types'
+import { cn } from '../ui'
+import { liveHref } from '../live/ctx'
+import { LiveMenu } from '../live/ui'
+import { t } from '../i18n'
+import { DYN_DEFS, burgerWidth } from './model'
+import { When, attr, html, txt, useDyn, type DynMode } from './ctx'
+import { DATE_FORMAT_RE, cleanHtml, formatDate, paginationHtml, postNavHtml, termsHtml, trimWords } from './format'
+import type { DynMenuItem } from './types'
+
+/*
+ * Dynamic widgets: layout cells that show site or post data (contract §11.4). One element tree per
+ * widget; the editor fills it with the sample data, the published snapshot carries the placeholder
+ * attributes of §11.5 instead (dynamic/ctx.tsx). Everything a widget draws sits inside one root
+ * <div class="ed"> that takes the cell element's style (els['items.<id>.text']).
+ */
+
+type P = Record<string, unknown>
+
+const MUTED: CSSProperties = { color: 'var(--muted)' }
+const PRIMARY: CSSProperties = { background: 'var(--btn-bg)', color: 'var(--btn-fg)', borderRadius: 'var(--r-btn)' }
+
+/** Class lists the published stylesheet must contain (scanned from this file by live/site.css). */
+const HIDE_BELOW: Record<number, string> = { 480: '@max-[480px]:hidden!', 640: '@max-[640px]:hidden!', 768: '@max-[768px]:hidden!', 896: '@max-[896px]:hidden!', 1024: '@max-[1024px]:hidden!' }
+const HIDE_FROM: Record<number, string> = { 480: '@min-[480px]:hidden!', 640: '@min-[640px]:hidden!', 768: '@min-[768px]:hidden!', 896: '@min-[896px]:hidden!', 1024: '@min-[1024px]:hidden!' }
+
+/** WordPress post content (core blocks, classic HTML). */
+export const PROSE =
+  'text-[17px] leading-[1.75] [&>*:first-child]:mt-0 [&>*:last-child]:mb-0 [&_p]:my-5 [&_h2]:mb-3 [&_h2]:mt-10 [&_h2]:text-[1.6em] [&_h2]:font-semibold [&_h2]:leading-tight [&_h3]:mb-2 [&_h3]:mt-8 [&_h3]:text-[1.3em] [&_h3]:font-semibold [&_h4]:mt-6 [&_h4]:font-semibold [&_ul]:my-5 [&_ul]:list-disc [&_ul]:pl-6 [&_ol]:my-5 [&_ol]:list-decimal [&_ol]:pl-6 [&_li]:my-1 [&_blockquote]:my-7 [&_blockquote]:border-l-4 [&_blockquote]:border-(--line) [&_blockquote]:pl-5 [&_blockquote]:italic [&_img]:h-auto [&_img]:max-w-full [&_figure]:my-7 [&_figcaption]:mt-2 [&_figcaption]:text-[14px] [&_figcaption]:text-(--muted) [&_a]:underline [&_a]:underline-offset-2 [&_pre]:my-6 [&_pre]:overflow-x-auto [&_code]:font-mono [&_code]:text-[0.9em] [&_hr]:my-10 [&_hr]:border-(--line) [&_table]:my-6 [&_table]:w-full [&_td]:border [&_td]:border-(--line) [&_td]:p-2 [&_th]:border [&_th]:border-(--line) [&_th]:p-2'
+
+/** WordPress paginate_links() markup. */
+export const PAGINATION =
+  'flex flex-wrap items-center gap-2 text-[14.5px] [&_.page-numbers]:inline-grid [&_.page-numbers]:h-10 [&_.page-numbers]:min-w-10 [&_.page-numbers]:place-items-center [&_.page-numbers]:px-3 [&_.page-numbers]:rounded-[min(var(--r-btn),10px)] [&_a.page-numbers]:shadow-[inset_0_0_0_1px_var(--line)] [&_a.page-numbers]:transition-colors [&_a.page-numbers:hover]:bg-[color-mix(in_srgb,var(--fg)_6%,transparent)] [&_.current]:bg-(--btn-bg) [&_.current]:text-(--btn-fg) [&_.dots]:min-w-0 [&_.dots]:px-1'
+
+/** WordPress the_post_navigation() markup. */
+const POST_NAV = '[&_.nav-links]:flex [&_.nav-links]:flex-wrap [&_.nav-links]:justify-between [&_.nav-links]:gap-4 [&_.nav-next]:ml-auto [&_.nav-next]:text-right [&_a]:font-medium [&_a]:transition-opacity [&_a:hover]:opacity-70'
+
+/** Typography a widget starts from before the element style. */
+function baseStyle(w: DynWidget, title: CSSProperties, body: CSSProperties): { style: CSSProperties; kind: ElKind } {
+  switch (w) {
+    case 'post-title':
+    case 'archive-title':
+    case 'search-query':
+      return { style: title, kind: 'heading' }
+    case 'site-title':
+      return { style: { fontFamily: 'var(--f-head)', fontWeight: 600, fontSize: 22, lineHeight: 1.2, letterSpacing: '-0.01em' }, kind: 'heading' }
+    case 'site-tagline':
+    case 'post-excerpt':
+    case 'archive-desc':
+      return { style: { ...body, fontSize: body.fontSize ?? 16, lineHeight: 1.65 }, kind: 'text' }
+    case 'post-meta':
+    case 'post-terms':
+    case 'post-date':
+    case 'post-author':
+    case 'copyright':
+      return { style: { ...MUTED, fontSize: 14 }, kind: 'text' }
+    case 'nav-menu':
+      return { style: { fontSize: 15, fontWeight: 500 }, kind: 'text' }
+    default:
+      return { style: { fontSize: 16 }, kind: 'text' }
+  }
+}
+
+/** Editor: links inside a widget never navigate away from the canvas. */
+const stopLinks = (e: MouseEvent) => {
+  if ((e.target as HTMLElement).closest('a')) e.preventDefault()
+}
+
+/** A layout cell holding a dynamic widget. `title` / `body`: the section's heading and body styles. */
+export function DynWidgetView({ s, item, title, body }: { s: Section; item: Item; title: CSSProperties; body: CSSProperties }) {
+  const b = useB()
+  const m = useDyn()
+  const w = item.title as DynWidget
+  const def = DYN_DEFS[w]
+  const d: DynSettings = { ...def.defaults, ...item.dyn }
+  const el = `items.${item.id}.text`
+  const es = s.els?.[el]
+  if (m.live && es?.removed) return null
+  const base = baseStyle(w, title, body)
+  const selected = b.selection?.sectionId === s.id && b.selection.el === el
+  return (
+    <div
+      className={cn('ed', m.ph && 'wb-dyn')}
+      data-el={`${s.id}:${el}`}
+      data-label={def.label}
+      data-selected={selected || undefined}
+      style={{ ...base.style, ...elCss(es, base.kind) }}
+      onClickCapture={m.live ? undefined : stopLinks}
+    >
+      <Widget w={w} d={d} m={m} editing={!m.live && !b.preview} />
+    </div>
+  )
+}
+
+const tagOf = (d: DynSettings, fallback: string) => (d.tag && /^(h[1-6]|p|div|span)$/.test(d.tag) ? d.tag : fallback)
+
+/** <Tag> with the given props: the root's typography comes from the widget root. */
+const mk = (tag: string, props: P, ...children: ReactNode[]) => createElement(tag, props, ...children)
+
+function Widget({ w, d, m, editing }: { w: DynWidget; d: DynSettings; m: DynMode; editing: boolean }) {
+  const site = m.ctx.site
+  const post = m.post
+  switch (w) {
+    case 'site-logo':
+      return <SiteLogo m={m} link={d.link !== false} />
+    case 'site-title': {
+      const tag = tagOf(d, 'p')
+      if (d.link === false) return mk(tag, txt(m, 'site.title', site.title))
+      return mk(tag, {}, <a {...attr(m, 'site.url', { href: liveHref(m.home + '/') })} key="a"><span {...txt(m, 'site.title', site.title)} /></a>)
+    }
+    case 'site-tagline':
+      return mk(tagOf(d, 'p'), txt(m, 'site.tagline', site.tagline))
+    case 'nav-menu':
+      return <NavMenu m={m} d={d} />
+    case 'search-form':
+      return <SearchForm m={m} d={d} editing={editing} />
+    case 'copyright':
+      return (
+        <p>
+          {d.prefix ? `${d.prefix} ` : ''}
+          <span {...txt(m, 'site.year', site.year)} /> <span {...txt(m, 'site.title', site.title)} />
+        </p>
+      )
+    case 'post-title': {
+      const tag = tagOf(d, 'h1')
+      if (!d.link) return mk(tag, txt(m, 'post.title', post?.title))
+      return mk(tag, {}, <a {...attr(m, 'post.url', { href: liveHref(post?.url) })} key="a"><span {...txt(m, 'post.title', post?.title)} /></a>)
+    }
+    case 'post-content':
+      return <PostContent m={m} editing={editing} />
+    case 'post-excerpt': {
+      const words = clampWords(d.words)
+      return (
+        <Empty m={m} slot="post.excerpt" has={!!post?.excerpt} empty={d.empty}>
+          {(p) => <p {...p} {...(m.ph ? { 'data-wb-words': String(words) } : {})} {...txt(m, 'post.excerpt', trimWords(post?.excerpt ?? '', words))} />}
+        </Empty>
+      )
+    }
+    case 'post-image':
+      return <PostImage m={m} d={d} editing={editing} />
+    case 'post-meta':
+      return <PostMeta m={m} d={d} />
+    case 'post-terms': {
+      const tax = taxOf(d)
+      const sep = sepOf(d, ', ')
+      return (
+        <Empty m={m} slot="post.terms" has={!!post?.terms[tax]?.length} empty={d.empty}>
+          {(p) => (
+            <p {...p}>
+              {d.prefix ? `${d.prefix} ` : ''}
+              <span {...(m.ph ? { 'data-wb-tax': tax, 'data-wb-sep': sep } : {})} {...html(m, 'post.terms', termsHtml(post, tax, sep))} />
+            </p>
+          )}
+        </Empty>
+      )
+    }
+    case 'post-date':
+      return (
+        <p>
+          {d.prefix ? `${d.prefix} ` : ''}
+          <DateEl m={m} which="date" format={d.format} />
+        </p>
+      )
+    case 'post-author':
+      return (
+        <p>
+          {d.prefix ? `${d.prefix} ` : ''}
+          {d.link === false ? <span {...txt(m, 'post.author', post?.author.name)} /> : <AuthorLink m={m} />}
+        </p>
+      )
+    case 'author-box':
+      return (
+        <div className="flex items-start gap-4 p-5" style={{ background: 'color-mix(in srgb, var(--fg) 4%, transparent)', borderRadius: 'var(--r-card)' }}>
+          <When m={m} slot="post.avatar" has={!!post?.author.avatar}>
+            {(p) => <img {...p} alt="" {...attr(m, 'post.avatar', { src: post?.author.avatar })} width={64} height={64} loading="lazy" className="size-16 shrink-0 rounded-full object-cover" />}
+          </When>
+          <div className="min-w-0">
+            <p className="text-[17px] font-semibold">
+              <AuthorLink m={m} />
+            </p>
+            <p className="mt-1 text-[15px] leading-[1.6]" style={MUTED} {...txt(m, 'post.author-bio', post?.author.bio)} />
+          </div>
+        </div>
+      )
+    case 'post-nav':
+      return <div className={POST_NAV} {...html(m, 'post.nav', postNavHtml(post, m.ctx.posts))} />
+    case 'post-comments':
+      if (m.ph) return <div className="wb-comments" data-wb-slot="post.comments" />
+      // Language-neutral stand-in: the published page shows the theme's comments template.
+      return (
+        <div className="p-6" style={{ border: '1.5px dashed var(--line)', borderRadius: 'var(--r-card)' }}>
+          <p className="flex items-center gap-2 text-[18px] font-semibold">
+            <MessageCircle size={18} aria-hidden />
+            {post?.commentsCount ?? 0}
+          </p>
+          {[78, 62, 70].map((w, i) => (
+            <div key={i} aria-hidden className="mt-3 h-2.5 rounded-full" style={{ width: `${w}%`, background: 'color-mix(in srgb, var(--fg) 8%, transparent)' }} />
+          ))}
+        </div>
+      )
+    case 'archive-title':
+      return mk(tagOf(d, 'h1'), txt(m, 'archive.title', m.ctx.view.archiveTitle))
+    case 'archive-desc':
+      return (
+        <Empty m={m} slot="archive.description" has={!!m.ctx.view.archiveDesc} empty={d.empty}>
+          {(p) => <div {...p} {...txt(m, 'archive.description', m.ctx.view.archiveDesc)} />}
+        </Empty>
+      )
+    case 'search-query':
+      return mk(tagOf(d, 'h1'), {}, d.prefix ? `${d.prefix} ` : '', <span key="q" {...txt(m, 'search.query', m.ctx.view.search)} />)
+    case 'pagination':
+      return <nav aria-label="Pagination" className={PAGINATION} {...html(m, 'loop.pagination', paginationHtml(m.ctx.pagination))} />
+  }
+}
+
+const clampWords = (v: number | undefined) => Math.min(100, Math.max(5, Math.round(v ?? 30)))
+const taxOf = (d: DynSettings) => (d.tax && /^[a-z0-9_-]{1,32}$/.test(d.tax) ? d.tax : 'category')
+const sepOf = (d: DynSettings, fallback: string) => [...(d.sep ?? fallback)].slice(0, 8).join('')
+
+/** The value element when the slot has a value, else the `empty` text (only when one is set). */
+function Empty({ m, slot, has, empty, children }: { m: DynMode; slot: string; has: boolean; empty?: string; children: (p: P) => ReactNode }) {
+  const text = (empty ?? '').slice(0, 200)
+  if (!text) return <>{children({})}</>
+  return (
+    <>
+      <When m={m} slot={slot} has={has}>
+        {children}
+      </When>
+      <When m={m} slot={slot} has={has} not>
+        {(p) => <p {...p}>{text}</p>}
+      </When>
+    </>
+  )
+}
+
+function SiteLogo({ m, link }: { m: DynMode; link: boolean }) {
+  const logo = m.ctx.site.logo
+  const inner = (
+    <>
+      <When m={m} slot="site.logo" has={!!logo}>
+        {(p) => <img {...p} alt="" {...attr(m, 'site.logo', logo ? { src: logo.url, width: logo.width, height: logo.height, alt: logo.alt } : {})} className="block h-10 w-auto max-w-full" />}
+      </When>
+      <When m={m} slot="site.logo" has={!!logo} not>
+        {(p) => <span {...p} className="text-[22px] font-semibold tracking-[-0.01em]" style={{ fontFamily: 'var(--f-head)' }} {...txt(m, 'site.title', m.ctx.site.title)} />}
+      </When>
+    </>
+  )
+  return link ? (
+    <a className="inline-flex items-center" {...attr(m, 'site.url', { href: liveHref(m.home + '/') })}>
+      {inner}
+    </a>
+  ) : (
+    <span className="inline-flex items-center">{inner}</span>
+  )
+}
+
+/** Menu links of a location: one placeholder template, or the sample items. */
+function MenuList({ m, loc, className, linkClass }: { m: DynMode; loc: string; className: string; linkClass: string }) {
+  if (m.ph)
+    return (
+      <div className={className} data-wb-menu-loc={loc}>
+        <a data-wb-loop-item="" data-wb-slot="menu.url" className={linkClass}>
+          <span data-wb-slot="menu.label" />
+        </a>
+      </div>
+    )
+  const items: DynMenuItem[] = m.ctx.menus[loc] ?? []
+  return (
+    <div className={className}>
+      {items.map((i) => (
+        <a key={i.id} href={liveHref(i.url)} aria-current={i.current ? 'page' : undefined} className={cn(linkClass, i.current && 'is-current')}>
+          {i.label}
+        </a>
+      ))}
+    </div>
+  )
+}
+
+const MENU_LINK = 'transition-opacity hover:opacity-70 [&.is-current]:text-(--accent)'
+
+function NavMenu({ m, d }: { m: DynMode; d: DynSettings }) {
+  const loc = d.location && /^[a-z0-9_-]{1,40}$/.test(d.location) ? d.location : 'primary'
+  const layout = d.menuLayout === 'column' || d.menuLayout === 'burger' ? d.menuLayout : 'row'
+  const at = layout === 'row' ? burgerWidth(d.burgerAt) : 0
+  if (!m.ph && !(m.ctx.menus[loc] ?? []).length && !m.live)
+    return <p className="text-[13px]" style={MUTED}>{t('No menu is assigned to this location yet.')}</p>
+  const burger = (className?: string) =>
+    m.live ? (
+      <LiveMenu className={className} summaryClass="grid size-10 place-items-center" panelClass="absolute right-0 top-full z-50 min-w-[240px] p-5 shadow-[0_30px_40px_-30px_rgba(0,0,0,.35)]" panelStyle={{ background: 'var(--bg)', color: 'var(--fg)', borderRadius: 'min(var(--r-card), 14px)' }}>
+        <MenuList m={m} loc={loc} className="flex flex-col" linkClass={cn(MENU_LINK, 'block border-b py-2.5')} />
+      </LiveMenu>
+    ) : (
+      <span className={cn('grid size-10 place-items-center', className)}>
+        <Menu size={21} aria-hidden />
+      </span>
+    )
+  return (
+    <nav aria-label="Menu" className="relative">
+      {layout !== 'burger' && <MenuList m={m} loc={loc} className={cn(layout === 'column' ? 'flex flex-col gap-2' : 'flex flex-wrap items-center gap-x-6 gap-y-2', at > 0 && HIDE_BELOW[at])} linkClass={MENU_LINK} />}
+      {(layout === 'burger' || at > 0) && burger(at > 0 ? HIDE_FROM[at] : undefined)}
+    </nav>
+  )
+}
+
+function SearchForm({ m, d, editing }: { m: DynMode; d: DynSettings; editing: boolean }) {
+  const label = (d.button ?? '').slice(0, 40)
+  return (
+    <form data-wb-search="" method="get" action={m.home + '/'} className="flex items-stretch gap-2" onSubmit={(e) => e.preventDefault()}>
+      <input
+        type="search"
+        name="s"
+        placeholder={d.placeholder ?? ''}
+        aria-label={t('Search')}
+        readOnly={editing || undefined}
+        tabIndex={editing ? -1 : undefined}
+        className="h-11 min-w-0 flex-1 bg-transparent px-3.5 text-[15px] outline-none"
+        style={{ border: '1px solid var(--line)', borderRadius: 'min(var(--r-btn), 12px)', color: 'var(--fg)' }}
+      />
+      <button type="submit" aria-label={label ? undefined : t('Search')} className="inline-flex h-11 shrink-0 items-center justify-center gap-2 px-4 text-[14.5px] font-semibold" style={PRIMARY}>
+        {label || <Search size={18} aria-hidden />}
+      </button>
+    </form>
+  )
+}
+
+function PostContent({ m, editing }: { m: DynMode; editing: boolean }) {
+  const raw = m.ph ? '' : m.post?.contentHtml ?? ''
+  const safe = useMemo(() => cleanHtml(raw), [raw])
+  if (m.ph) return <div className={PROSE} data-wb-slot="post.content" />
+  return (
+    <div className="relative">
+      <div className={cn(PROSE, editing && 'pointer-events-none select-none')} dangerouslySetInnerHTML={{ __html: safe }} />
+      {editing && (
+        <span className="absolute -top-3 right-0 z-10 inline-flex items-center gap-1 rounded-full px-2 py-[3px] text-[10.5px] font-semibold" style={{ background: 'var(--ov)', color: 'var(--ov-ink)' }}>
+          <Lock size={10} aria-hidden />
+          {t('Post content · edited in the post editor')}
+        </span>
+      )}
+    </div>
+  )
+}
+
+function PostImage({ m, d, editing }: { m: DynMode; d: DynSettings; editing: boolean }) {
+  const img = m.post?.image ?? null
+  const size = d.size && ['thumbnail', 'medium', 'large', 'full'].includes(d.size) ? d.size : 'large'
+  const ratio = d.ratio && d.ratio >= 0.2 && d.ratio <= 5 ? d.ratio : undefined
+  const frame: CSSProperties = { aspectRatio: ratio ? String(ratio) : undefined, borderRadius: 'var(--r-card)' }
+  const pic = (p: P) => <img {...p} alt="" {...attr(m, 'post.image', img ? { src: img.url, width: img.width, height: img.height, alt: img.alt } : {})} {...(m.ph ? { 'data-wb-size': size } : {})} loading="lazy" className="block size-full object-cover" style={frame} />
+  return (
+    <>
+      <When m={m} slot="post.image" has={!!img}>
+        {(p) => (d.link ? <a {...p} className="block" {...attr(m, 'post.url', { href: liveHref(m.post?.url) })}>{pic({})}</a> : pic(p))}
+      </When>
+      {!img && editing && !m.ph && (
+        <div className="grid place-items-center" style={{ ...frame, aspectRatio: String(ratio ?? 1.6), background: 'color-mix(in srgb, var(--fg) 6%, transparent)', color: 'var(--muted)' }}>
+          <ImageIcon size={28} strokeWidth={1.4} aria-label={t('No featured image')} />
+        </div>
+      )}
+    </>
+  )
+}
+
+function AuthorLink({ m }: { m: DynMode }) {
+  return (
+    <a {...attr(m, 'post.author-url', { href: liveHref(m.post?.author.url) })}>
+      <span {...txt(m, 'post.author', m.post?.author.name)} />
+    </a>
+  )
+}
+
+function DateEl({ m, which, format }: { m: DynMode; which: 'date' | 'modified'; format?: string }) {
+  const post = m.post
+  const fmt = format && DATE_FORMAT_RE.test(format) ? format : undefined
+  const iso = which === 'date' ? post?.date ?? '' : post?.modified ?? ''
+  const text = formatDate(iso, fmt, which === 'date' ? post?.dateText ?? '' : post?.modifiedText ?? '')
+  return <time {...(m.ph ? { 'data-wb-slot': `post.${which}`, ...(fmt ? { 'data-wb-format': fmt } : {}) } : { dateTime: iso || undefined, children: text })} />
+}
+
+const META_FIELDS = ['date', 'modified', 'author', 'comments', 'terms'] as const
+
+function PostMeta({ m, d }: { m: DynMode; d: DynSettings }) {
+  const fields = (d.fields ?? []).filter((f, i, a) => META_FIELDS.includes(f) && a.indexOf(f) === i)
+  const sep = sepOf(d, '·')
+  const post = m.post
+  const parts = fields.map((f) => {
+    switch (f) {
+      case 'date':
+      case 'modified':
+        return <DateEl key={f} m={m} which={f} format={d.format} />
+      case 'author':
+        return <AuthorLink key={f} m={m} />
+      case 'comments':
+        return (
+          <a key={f} className="inline-flex items-center gap-1" {...attr(m, 'post.comments-url', { href: liveHref(post?.commentsUrl) })}>
+            <MessageCircle size={14} aria-hidden />
+            <span {...txt(m, 'post.comments-count', post?.commentsCount ?? 0)} />
+          </a>
+        )
+      case 'terms': {
+        const tax = taxOf(d)
+        return <span key={f} {...(m.ph ? { 'data-wb-tax': tax, 'data-wb-sep': ', ' } : {})} {...html(m, 'post.terms', termsHtml(post, tax, ', '))} />
+      }
+    }
+  })
+  return (
+    <p className="flex flex-wrap items-center gap-x-2 gap-y-1">
+      {parts.map((part, i) => (
+        <span key={i} className="contents">
+          {i > 0 && sep && <span aria-hidden="true">{sep}</span>}
+          {part}
+        </span>
+      ))}
+    </p>
+  )
+}
