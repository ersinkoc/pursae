+        </Ctl>
+      )}
+      {w === 'post-content' && <Hint>{t('The post content is edited in the post editor; here it is shown read-only.')}</Hint>}
+      {w === 'post-comments' && <Hint>{t('The comments and the reply form show here on the site.')}</Hint>}
+      <Hint>{t('Shows the data of the post or page being viewed.')}</Hint>
+    </Panel>
+  )
+}
+
+/** Content tab panels of a loop section and of a nav / footer section (menu and logo binding). */
+export function DynSectionPanel({ s }: { s: Section }) {
+  const b = useB()
+  const ctx = useDynamic()
+  const set = (key: string, value: string, label: string) => b.dispatch({ type: 'content', id: s.id, key, value, label: t('{label} changed', { label }) })
+  if (s.kind === 'nav' || s.kind === 'footer') {
+    const locs = ctx.locations
+    return (
+      <Panel title={t('Site data')}>
+        <Ctl label={t('Links')}>
+          <Select value={s.content[CONTENT_MENU] ?? ''} onChange={(v) => set(CONTENT_MENU, v, t('Links'))} options={[{ value: '', label: t('This section') }, ...locs.map((l) => ({ value: l.slug, label: l.name }))]} />
+        </Ctl>
+        <Ctl label={t('Logo')}>
+          <Select
+            value={s.content[CONTENT_LOGO_SOURCE] === 'site' ? 'site' : ''}
+            onChange={(v) => set(CONTENT_LOGO_SOURCE, v, t('Logo'))}
+            options={[
+              { value: '', label: t('This section') },
+              { value: 'site', label: t('Site logo') },
+            ]}
+          />
+        </Ctl>
+        <Hint>{t('Links from a menu location follow the menu: edit them under Appearance › Menus.')}</Hint>
+      </Panel>
+    )
+  }
+  if (s.kind !== 'loop') return null
+  const q = loopQuery(s.content)
+  const types = [...new Set(['post', 'page', q.postType])]
+  return (
+    <Panel title={t('Query')}>
+      <Ctl label={t('Source')}>
+        <Select
+          value={q.source}
+          onChange={(v) => set('source', v, t('Source'))}
+          options={[
+            { value: 'main', label: t('Posts of the page') },
+            { value: 'query', label: t('Custom query') },
+            { value: 'related', label: t('Related posts') },
+          ]}
+        />
+      </Ctl>
+      {q.source === 'main' ? (
+        <>
+          <Ctl label={t('Pagination')}>
+            <Select
+              value={q.pagination}
+              onChange={(v) => set('pagination', v, t('Pagination'))}
+              options={[
+                { value: 'numbers', label: t('Numbers') },
+                { value: 'prev-next', label: t('Previous / next') },
+                { value: 'none', label: t('None') },
+              ]}
+            />
+          </Ctl>
+          <Hint>{t('Shows the posts of the archive, search or blog page being viewed.')}</Hint>
+        </>
+      ) : (
+        <>
+          <Ctl label={t('Post type')}>
+            <Select value={q.postType} onChange={(v) => set('postType', v, t('Post type'))} options={types.map((x) => ({ value: x, label: x === 'post' ? t('Posts') : x === 'page' ? t('Pages') : x }))} />
+          </Ctl>
+          <Ctl label={t('Posts')}>
+            <Slider value={Number(q.perPage)} min={1} max={24} unit="" onChange={(v) => set('perPage', String(v), t('Posts'))} />
+          </Ctl>
+          <Ctl label={t('Order by')}>
+            <Select
+              value={q.orderBy}
+              onChange={(v) => set('orderBy', v, t('Order by'))}
+              options={[
+                { value: 'date', label: t('Date') },
+                { value: 'modified', label: t('Last updated') },
+                { value: 'title', label: t('Title') },
+                { value: 'menu_order', label: t('Menu order') },
+                { value: 'comment_count', label: t('Comments') },
+                { value: 'rand', label: t('Random') },
+              ]}
+            />
+          </Ctl>
+          <Ctl label={t('Order')}>
+            <Select
+              value={q.order}
+              onChange={(v) => set('order', v, t('Order'))}
+              options={[
+                { value: 'desc', label: t('Newest first') },
+                { value: 'asc', label: t('Oldest first') },
+              ]}
+            />
+          </Ctl>
+          {q.source === 'query' && (
+            <>
+              <Ctl label={t('Terms')}>
+                <Text value={s.content.terms ?? ''} max={400} placeholder="category:12" onChange={(v) => set('terms', v.replace(/\s+/g, ''), t('Terms'))} />
+              </Ctl>
+              <Ctl label={t('Author ID')}>
+                <Text value={s.content.author ?? ''} max={19} onChange={(v) => set('author', v.replace(/\D+/g, ''), t('Author ID'))} />
+              </Ctl>
+            </>
+          )}
+          <Ctl label={t('Skip')}>
+            <Slider value={Number(q.offset)} min={0} max={50} unit="" onChange={(v) => set('offset', String(v), t('Skip'))} />
+          </Ctl>
+          <Ctl label={t('Leave out the current post')}>
+            <Toggle on={q.exclude === 'current'} onChange={(v) => set('exclude', v ? 'current' : '', t('Leave out the current post'))} />
+          </Ctl>
+        </>
+      )}
+      <Ctl label={t('Text when empty')} stack>
+        <Text value={s.content.empty ?? ''} max={200} rows={2} onChange={(v) => set('empty', v, t('Text when empty'))} />
+      </Ctl>
+      <Hint>{t('Design the card once: select it on the canvas to change its widgets and style.')}</Hint>
+    </Panel>
+  )
+}
diff --git a/src/builder/dynamic/loop.tsx b/src/builder/dynamic/loop.tsx
new file mode 100644
index 0000000..dfd866b
--- /dev/null
+++ b/src/builder/dynamic/loop.tsx
@@ -0,0 +1,97 @@
+import type { ReactNode } from 'react'
+import { Repeat } from 'lucide-react'
+import { getGrid } from '../data'
+import { NestedLayout, secPad } from '../sections'
+import { useB } from '../store'
+import type { Section } from '../types'
+import { cn } from '../ui'
+import { GRID_CLS, W, gridStyle } from '../variants/kit'
+import { t } from '../i18n'
+import { LoopPostCtx, useDyn, type DynMode } from './ctx'
+import { paginationHtml } from './format'
+import { loopQuery } from './model'
+import type { DynPost } from './types'
+import { PAGINATION } from './widgets'
+
+/*
+ * The 'loop' section (contract §11.4): a grid of post cards. The card design is items[0].sub (a
+ * layout container whose cells hold post widgets), the query is `content`, the grid `section.grid`.
+ * The snapshot holds one card template in a data-wb-loop list (the server repeats it per post and
+ * reads the query from the stored doc, never from the markup); the editor draws the sample posts.
+ */
+
+const MUTED = { color: 'var(--muted)' }
+
+/** Sample posts of a loop: the view's posts, a custom query shaped like the real one. */
+function samplePosts(m: DynMode, s: Section): DynPost[] {
+  const q = loopQuery(s.content)
+  if (q.source === 'main') return m.ctx.posts
+  let list = m.ctx.posts.filter((p) => q.postType === p.type)
+  if (q.exclude === 'current' || q.source === 'related') list = list.filter((p) => p.id !== m.ctx.post?.id)
+  return list.slice(Number(q.offset), Number(q.offset) + Number(q.perPage))
+}
+
+export function LoopSection({ s }: { s: Section }) {
+  const b = useB()
+  const m = useDyn()
+  const q = loopQuery(s.content)
+  const g = getGrid(s)
+  const card = s.items[0]?.sub
+  const pages = q.source === 'main' && q.pagination !== 'none'
+  const drawCard = (key: string | number, inert?: boolean): ReactNode =>
+    card ? (
+      <div key={key} className={cn('flex min-w-0 flex-col', inert && 'pointer-events-none')} aria-hidden={inert || undefined}>
+        <NestedLayout parent={s} sub={card} fill={false} />
+      </div>
+    ) : null
+
+  if (m.ph)
+    return (
+      <div style={secPad(s)}>
+        <W>
+          <div data-wb-loop={s.id} className={GRID_CLS} style={gridStyle(g)}>
+            <div data-wb-loop-item="" className="flex min-w-0 flex-col">
+              {card && <NestedLayout parent={s} sub={card} fill={false} />}
+            </div>
+            {q.empty && (
+              <p data-wb-loop-empty="" className="col-span-full text-[16px]" style={MUTED}>
+                {q.empty}
+              </p>
+            )}
+          </div>
+          {pages && <nav aria-label="Pagination" data-wb-slot="loop.pagination" className={cn(PAGINATION, 'mt-12 justify-center')} />}
+        </W>
+      </div>
+    )
+
+  const posts = samplePosts(m, s)
+  const pag = pages ? paginationHtml(m.ctx.pagination, q.pagination === 'prev-next' ? 'prev-next' : 'numbers') : ''
+  return (
+    <div style={secPad(s)}>
+      <W>
+        {posts.length > 0 ? (
+          <div className={GRID_CLS} style={gridStyle(g)}>
+            {posts.map((p, i) => (
+              <LoopPostCtx.Provider key={p.id} value={p}>
+                {drawCard(p.id, !m.live && i > 0)}
+              </LoopPostCtx.Provider>
+            ))}
+          </div>
+        ) : q.empty ? (
+          <p className="text-[16px]" style={MUTED}>
+            {q.empty}
+          </p>
+        ) : (
+          !m.live &&
+          !b.preview && (
+            <div className="flex items-center gap-2 p-6 text-[14px]" style={{ ...MUTED, border: '1.5px dashed var(--line)', borderRadius: 'var(--r-card)' }}>
+              <Repeat size={16} aria-hidden />
+              {t('No posts match this loop in the preview.')}
+            </div>
+          )
+        )}
+        {pag && <nav aria-label="Pagination" className={cn(PAGINATION, 'mt-12 justify-center')} dangerouslySetInnerHTML={{ __html: pag }} />}
+      </W>
+    </div>
+  )
+}
diff --git a/src/builder/dynamic/menu.tsx b/src/builder/dynamic/menu.tsx
new file mode 100644
index 0000000..2af8708
--- /dev/null
+++ b/src/builder/dynamic/menu.tsx
@@ -0,0 +1,126 @@
+import { createContext, createElement, useContext, useMemo, type CSSProperties, type ReactNode } from 'react'
+import type { Item, Section } from '../types'
+import { cn } from '../ui'
+import { liveHref } from '../live/ctx'
+import { When, attr, txt, useDyn, type DynMode } from './ctx'
+
+/*
+ * nav / footer binding (contract §11.4): `content.menu = '<location>'` takes the links from that
+ * menu location, `content.logoSource = 'site'` shows the custom logo or the site title.
+ *
+ * The designs stay untouched: the section they draw is derived. Bound links become items with
+ * `wbm-` ids (the menu's items in the editor, read-only; two placeholder templates in the
+ * snapshot, one per half, so split-logo designs keep their halves and every other design draws
+ * both halves one after the other). E() asks boundEl() how to draw those items and the brand.
+ */
+
+export const CONTENT_MENU = 'menu'
+export const CONTENT_LOGO_SOURCE = 'logoSource'
+
+/** Placeholder link templates of a bound menu: first and second half of the items. */
+const TEMPLATES: Item[] = [
+  { id: 'wbm-1', title: 'Menu', text: '' },
+  { id: 'wbm-2', title: 'Menu', text: '' },
+]
+const PART: Record<string, string> = { 'wbm-1': '1/2', 'wbm-2': '2/2' }
+
+/** Link items drawn from a menu location (editor or placeholder); never in the stored doc. */
+export const isBoundItem = (i: Pick<Item, 'id'>) => i.id.startsWith('wbm-')
+/** A placeholder link template (snapshot only). */
+export const isMenuTemplate = (i: Pick<Item, 'id'>) => i.id in PART
+
+const menuLoc = (s: Section) => {
+  const v = s.content[CONTENT_MENU] ?? ''
+  return /^[a-z0-9_-]{1,40}$/.test(v) ? v : ''
+}
+const siteLogo = (s: Section) => s.content[CONTENT_LOGO_SOURCE] === 'site'
+
+/** True when the section takes links or its logo from the site. */
+export const isBound = (s: Section) => (s.kind === 'nav' || s.kind === 'footer') && (!!menuLoc(s) || siteLogo(s))
+
+/** The section a nav / footer design draws: links from the menu, no logo letter with the site logo. */
+export function boundSection(s: Section, m: DynMode): Section {
+  if (!isBound(s)) return s
+  const loc = menuLoc(s)
+  let items = s.items
+  if (loc) items = m.ph ? TEMPLATES : (m.ctx.menus[loc] ?? []).map((i) => ({ id: `wbm-${i.id}`, title: i.label, text: '', href: i.url }))
+  let content = s.content
+  if (siteLogo(s)) {
+    content = { ...s.content }
+    delete content.logo
+  }
+  return { ...s, items, content }
+}
+
+interface Bound {
+  m: DynMode
+  /** The stored section (selection, editing). */
+  s: Section
+}
+
+const BoundCtx = createContext<Bound | null>(null)
+
+/** E() reads this: set while a bound nav / footer section is drawn. */
+export const useBound = () => useContext(BoundCtx)
+
+/** Wraps a nav / footer renderer: draws the derived section when the stored one is bound. */
+export function withBinding(R: (p: { s: Section }) => ReactNode) {
+  function Bound({ s }: { s: Section }) {
+    const m = useDyn()
+    const sb = useMemo(() => boundSection(s, m), [s, m])
+    const value = useMemo(() => ({ m, s }), [m, s])
+    if (sb === s) return <R s={s} />
+    return (
+      <BoundCtx.Provider value={value}>
+        <R s={sb} />
+      </BoundCtx.Provider>
+    )
+  }
+  return Bound
+}
+
+/**
+ * How E() draws an element of a bound section: undefined = as usual. `select` selects the
+ * section (bound elements are not edited on the canvas).
+ */
+export function boundEl(o: { bound: Bound; s: Section; el: string; as: string; className?: string; style: CSSProperties; value: string; preview: boolean; select: () => void }): ReactNode | undefined {
+  const { bound, s, el, as, className, style, value } = o
+  const { m } = bound
+  const editorProps = {
+    'data-el': `${s.id}:${el}`,
+    onClick: (e: React.MouseEvent) => {
+      e.preventDefault()
+      if (o.preview) return
+      e.stopPropagation()
+      o.select()
+    },
+  }
+  if (siteLogo(s) && el === 'logo') return null
+  if (siteLogo(s) && el === 'brand') {
+    const logo = m.ctx.site.logo
+    return (
+      <a className={cn('ed inline-flex items-center', className)} style={style} {...editorProps} {...attr(m, 'site.url', { href: liveHref(m.home + '/') })}>
+        <When m={m} slot="site.logo" has={!!logo}>
+          {(p) => <img {...p} alt="" {...attr(m, 'site.logo', logo ? { src: logo.url, width: logo.width, height: logo.height, alt: logo.alt } : {})} className="block h-[1.6em] w-auto max-w-full" />}
+        </When>
+        <When m={m} slot="site.logo" has={!!logo} not>
+          {(p) => <span {...p} {...txt(m, 'site.title', m.ctx.site.title)} />}
+        </When>
+      </a>
+    )
+  }
+  if (!el.startsWith('items.wbm-')) return undefined
+  const id = el.split('.')[1]
+  // Only the label is drawn: menu items have no description or icon.
+  if (!el.endsWith('.title')) return null
+  if (m.ph) {
+    const loc = menuLoc(s)
+    return (
+      <span className="contents" data-wb-menu-loc={loc} data-wb-loop-part={PART[id]}>
+        {createElement(as, { className: cn('ed', className), style, 'data-el': `${s.id}:${el}`, 'data-wb-loop-item': '', 'data-wb-slot': 'menu.url' }, <span data-wb-slot="menu.label" />)}
+      </span>
+    )
+  }
+  const item = s.items.find((i) => i.id === id)
+  return createElement(as, { className: cn('ed', className), style, ...editorProps, href: as === 'a' ? liveHref(item?.href) : undefined }, value)
+}
