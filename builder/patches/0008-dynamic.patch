+/**
+ * Theme Builder data model: dynamic widgets (layout cell types that show site or post data), their
+ * default settings and widget panel groups, and the post loop section (contract §11.4).
+ * No React here: data.ts and store.ts import it.
+ */
+import {
+  AlignLeft,
+  ArrowLeftRight,
+  CalendarDays,
+  Copyright,
+  FileText,
+  Heading1,
+  Image as ImageIcon,
+  Info,
+  LetterText,
+  ListOrdered,
+  Menu,
+  MessagesSquare,
+  Repeat,
+  Search,
+  SearchCheck,
+  Tags,
+  TextQuote,
+  Type,
+  User,
+  UserSquare,
+  Hexagon,
+  type LucideIcon,
+} from 'lucide-react'
+import type { CellType, DynSettings, DynWidget, LoopContent, Payload } from '../types'
+import { t } from '../i18n'
+
+/** Every dynamic widget, in panel order. */
+export const DYN_WIDGETS: readonly DynWidget[] = [
+  'site-logo', 'site-title', 'site-tagline', 'nav-menu', 'search-form', 'copyright',
+  'post-title', 'post-content', 'post-excerpt', 'post-image', 'post-meta', 'post-terms', 'post-date', 'post-author', 'author-box', 'post-nav', 'post-comments',
+  'archive-title', 'archive-desc', 'search-query', 'pagination',
+]
+
+const DYN_SET = new Set<string>(DYN_WIDGETS)
+/** Dynamic cells have no text (CELL_DEFAULTS entries). */
+export const DYN_CELL_TEXT = Object.fromEntries(DYN_WIDGETS.map((w) => [w, ''])) as Record<DynWidget, ''>
+export const isDynWidget = (v: string | undefined | null): v is DynWidget => !!v && DYN_SET.has(v)
+
+/** Widget panel group of a dynamic widget (template mode decides which groups show, patch 0009). */
+export type DynGroup = 'site' | 'post' | 'archive' | 'search'
+
+export interface DynWidgetDef {
+  label: string
+  icon: LucideIcon
+  group: DynGroup
+  /** Settings a new cell of this type starts with. */
+  defaults: DynSettings
+}
+
+export const DYN_DEFS: Record<DynWidget, DynWidgetDef> = {
+  'site-logo': { label: t('Site logo'), icon: Hexagon, group: 'site', defaults: { link: true } },
+  'site-title': { label: t('Site title'), icon: Type, group: 'site', defaults: { tag: 'p', link: true } },
+  'site-tagline': { label: t('Tagline'), icon: TextQuote, group: 'site', defaults: { tag: 'p' } },
+  'nav-menu': { label: t('Menu'), icon: Menu, group: 'site', defaults: { location: 'primary', menuLayout: 'row', burgerAt: 768 } },
+  'search-form': { label: t('Search form'), icon: Search, group: 'site', defaults: { placeholder: 'Search…', button: 'Search' } },
+  copyright: { label: t('Copyright'), icon: Copyright, group: 'site', defaults: { prefix: '©' } },
+  'post-title': { label: t('Post title'), icon: Heading1, group: 'post', defaults: { tag: 'h1', link: false } },
+  'post-content': { label: t('Post content'), icon: FileText, group: 'post', defaults: {} },
+  'post-excerpt': { label: t('Post excerpt'), icon: LetterText, group: 'post', defaults: { words: 30 } },
+  'post-image': { label: t('Featured image'), icon: ImageIcon, group: 'post', defaults: { size: 'large', ratio: 1.6, link: false } },
+  'post-meta': { label: t('Post info'), icon: Info, group: 'post', defaults: { fields: ['date', 'author', 'comments'], sep: '·' } },
+  'post-terms': { label: t('Post terms'), icon: Tags, group: 'post', defaults: { tax: 'category', sep: ', ' } },
+  'post-date': { label: t('Post date'), icon: CalendarDays, group: 'post', defaults: {} },
+  'post-author': { label: t('Post author'), icon: User, group: 'post', defaults: { link: true } },
+  'author-box': { label: t('Author box'), icon: UserSquare, group: 'post', defaults: {} },
+  'post-nav': { label: t('Post navigation'), icon: ArrowLeftRight, group: 'post', defaults: {} },
+  'post-comments': { label: t('Comments'), icon: MessagesSquare, group: 'post', defaults: {} },
+  'archive-title': { label: t('Archive title'), icon: Heading1, group: 'archive', defaults: { tag: 'h1' } },
+  'archive-desc': { label: t('Archive description'), icon: AlignLeft, group: 'archive', defaults: {} },
+  'search-query': { label: t('Search query'), icon: SearchCheck, group: 'search', defaults: { tag: 'h1', prefix: 'Search results for:' } },
+  pagination: { label: t('Pagination'), icon: ListOrdered, group: 'archive', defaults: {} },
+}
+
+export const dynLabel = (w: DynWidget) => DYN_DEFS[w].label
+
+/** Widgets that fill their grid cell like an empty or container cell (blocks, not text runs). */
+const BLOCK_WIDGETS = new Set<string>(['post-content', 'post-image', 'author-box', 'post-nav', 'post-comments', 'search-form', 'pagination'])
+export const isBlockWidget = (v: string) => BLOCK_WIDGETS.has(v)
+
+/** Settings of a new dynamic cell (a fresh copy). */
+export const dynDefaults = (w: DynWidget): DynSettings => {
+  const d = DYN_DEFS[w].defaults
+  return { ...d, ...(d.fields ? { fields: [...d.fields] } : {}) }
+}
+
+
+/* ---------- Widget panel ---------- */
+
+export interface DynWidgetEntry {
+  id: string
+  label: string
+  icon: LucideIcon
+  payload: Payload
+}
+
+/** A dynamic widget dropped into a cell becomes that cell type; dropped on the page, a one-cell container holding it. */
+const entry = (w: DynWidget): DynWidgetEntry => ({
+  id: w,
+  label: DYN_DEFS[w].label,
+  icon: DYN_DEFS[w].icon,
+  payload: { kind: 'layout', label: DYN_DEFS[w].label, content: { type: 'flex', structure: 'col' }, cell: w },
+})
+
+const LOOP_ENTRY: DynWidgetEntry = { id: 'loop', label: t('Posts'), icon: Repeat, payload: { kind: 'loop', label: t('Posts') } }
+
+export const DYN_GROUP_LABELS: Record<DynGroup, string> = { site: t('Site'), post: t('Post'), archive: t('Archive'), search: t('Search') }
+
+/** Widget panel groups of the Theme Builder, in order; `dynamic` names the group (data.ts WIDGET_GROUPS). */
+export const DYN_WIDGET_GROUPS: { title: string; dynamic: DynGroup; items: DynWidgetEntry[] }[] = (['site', 'post', 'archive', 'search'] as DynGroup[]).map((g) => ({
+  title: DYN_GROUP_LABELS[g],
+  dynamic: g,
+  items: [
+    ...DYN_WIDGETS.filter((w) => DYN_DEFS[w].group === g).map(entry),
+    ...(g === 'archive' || g === 'search' ? [LOOP_ENTRY] : []),
+    ...(g === 'search' ? [entry('search-form'), entry('pagination')] : []),
+  ],
+}))
+
+/* ---------- Menus ---------- */
+
+/** Container widths (px) a row menu can switch to a burger at; the published stylesheet has classes for exactly these. */
+export const BURGER_WIDTHS = [480, 640, 768, 896, 1024] as const
+/** The supported width closest to `px`; 0 = never. */
+export function burgerWidth(px: number | undefined): number {
+  if (!px || px <= 0) return 0
+  return BURGER_WIDTHS.reduce((a, b) => (Math.abs(b - px) < Math.abs(a - px) ? b : a), BURGER_WIDTHS[0])
+}
+
+/* ---------- Loop ---------- */
+
+export const LOOP_DEFAULTS: Required<LoopContent> = {
+  source: 'main',
+  postType: 'post',
+  perPage: '6',
+  orderBy: 'date',
+  order: 'desc',
+  terms: '',
+  author: '',
+  exclude: '',
+  offset: '0',
+  pagination: 'numbers',
+  empty: '',
+}
+
+/** A loop section's query with defaults filled in and values clamped to the contract ranges. */
+export function loopQuery(content: Record<string, string>): Required<LoopContent> {
+  const c = { ...LOOP_DEFAULTS, ...content } as Record<string, string>
+  const int = (v: string, lo: number, hi: number, d: number) => {
+    const n = Number.parseInt(v, 10)
+    return String(Number.isFinite(n) ? Math.min(hi, Math.max(lo, n)) : d)
+  }
+  const pick = <T extends string>(v: string, allowed: readonly T[], d: T): T => ((allowed as readonly string[]).includes(v) ? (v as T) : d)
+  return {
+    source: pick(c.source, ['main', 'query', 'related'], 'main'),
+    postType: /^[a-z0-9_-]{1,32}$/.test(c.postType) ? c.postType : 'post',
+    perPage: int(c.perPage, 1, 24, 6),
+    orderBy: pick(c.orderBy, ['date', 'modified', 'title', 'menu_order', 'comment_count', 'rand'], 'date'),
+    order: pick(c.order, ['desc', 'asc'], 'desc'),
+    terms: c.terms,
+    author: /^[1-9][0-9]{0,18}$/.test(c.author) ? c.author : '',
+    exclude: c.exclude === 'current' ? 'current' : '',
+    offset: int(c.offset, 0, 50, 0),
+    pagination: pick(c.pagination, ['numbers', 'prev-next', 'none'], 'numbers'),
+    empty: c.empty.slice(0, 200),
+  }
+}
+
+/** Cells of a new post card, top to bottom. */
+export const CARD_CELLS: [DynWidget, DynSettings][] = [
+  ['post-image', { size: 'medium', ratio: 1.5, link: true }],
+  ['post-meta', { fields: ['date'], sep: '·' }],
+  ['post-title', { tag: 'h3', link: true }],
+  ['post-excerpt', { words: 20 }],
+]
+
+/** Cell type choices of the inspector: a dynamic cell keeps its own type in the list. */
+export function cellTypeOptions(current: CellType, options: { value: CellType; label: string }[]): { value: CellType; label: string }[] {
+  return isDynWidget(current) && !options.some((o) => o.value === current) ? [...options, { value: current, label: DYN_DEFS[current].label }] : options
+}
