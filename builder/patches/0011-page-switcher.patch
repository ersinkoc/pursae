+/* ---------- Page switcher ---------- */
+
+/** One thing the editor can switch to (the page switcher in the top bar). */
+export interface NavItem {
+  id: number
+  title: string
+  /** Group heading ("Templates", "Pages", …). */
+  group: string
+  kind: 'template' | 'post'
+  /** Template type label ("Header", …) or post status; shown next to the title. */
+  detail?: string
+  /** WordPress status: publish, draft, pending, private, future. */
+  status: string
+  /** Where the item opens in the builder. */
+  editUrl: string
+  disabled?: boolean
+}
+
 /* ---------- The host ---------- */
 
 export interface BuilderHost {
@@ -158,6 +176,12 @@ export interface BuilderHost {
    * host first opens its display conditions dialog). A rejection is shown like a publish error.
    */
   beforePublish?(input: PublishInput): boolean | Promise<boolean>
+  /** Id of the document being edited; marks it in the page switcher. */
+  currentId?: number
+  /** The page switcher's list (templates, pages, posts); absent = the top bar title opens page settings. */
+  navigator?(): Promise<NavItem[]>
+  /** Runs before the editor navigates to another item: send pending changes (autosave flush). */
+  beforeLeave?(): Promise<void>
 }
 
 export const AI_DISABLED: BuilderHostAi = Object.freeze({ enabled: false, serverKeys: false, allowCode: false, cloneEndpoint: null })
