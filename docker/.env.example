# Production settings for `make prod-up` (docker/compose.yaml + docker/compose.prod.yaml).
# Copy to docker/.env (ignored by git) and fill in:
#
#   cp docker/.env.example docker/.env
#   make prod-up
#
# The site is published on 127.0.0.1:8088; put your TLS proxy (Caddy, nginx) in front of it.

# Database password, set once: it is applied when the database volume is created. Letters and digits
# keep the URL simple. Generate one with: openssl rand -hex 24
WPGO_DB_PASSWORD=

# The public https:// address of the site, as your proxy serves it, e.g. https://example.com.
WPGO_SITE_URL=

# Outgoing mail (password resets, new-user and comment notifications). Without a host messages are
# only written as .eml files inside the container.
WPGO_SMTP_HOST=
WPGO_SMTP_PORT=587
WPGO_SMTP_USER=
WPGO_SMTP_PASS=
# Sender, e.g. "My Site <hello@example.com>"; default: <Site Title> <wordpress@your-host>.
WPGO_MAIL_FROM=

# Optional
# WPGO_PORT=8088                 # host port
# WPGO_BIND=127.0.0.1            # host address the port is published on
# WPGO_PLUGIN_KEYS=              # extra trusted plugin signing keys (base64, comma separated)
# WPGO_TRUSTED_PROXIES=          # proxies whose X-Forwarded-For is believed (default: loopback + private)
# WPGO_HUB=off                   # never contact hub.pursae.com: no updates, marketplace or licenses (not recommended)
