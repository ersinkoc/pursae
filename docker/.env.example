# Production settings for `make prod-up` (docker/compose.yaml + docker/compose.prod.yaml).
# Copy to docker/.env (ignored by git) and fill in:
#
#   cp docker/.env.example docker/.env
#   make prod-up
#
# The site is published on 127.0.0.1:8088; put your TLS proxy (Caddy, nginx) in front of it.
# Before Pursae 0.5.0 these settings were named WPGO_* (WPGO_SITE_URL …). An existing .env with the
# old names keeps working until 1.0; rename them (docs/developer/getting-started/upgrading.md).

# Database password, set once: it is applied when the database volume is created. Letters and digits
# keep the URL simple. Generate one with: openssl rand -hex 24
PURSAE_DB_PASSWORD=

# The public https:// address of the site, as your proxy serves it, e.g. https://example.com.
PURSAE_SITE_URL=

# Outgoing mail (password resets, new-user and comment notifications). Without a host messages are
# only written as .eml files inside the container.
PURSAE_SMTP_HOST=
PURSAE_SMTP_PORT=587
PURSAE_SMTP_USER=
PURSAE_SMTP_PASS=
# Sender, e.g. "My Site <hello@example.com>"; default: <Site Title> <wordpress@your-host>.
PURSAE_MAIL_FROM=

# Setup token for the installer (/wp-admin/install). Leave it empty and the server generates one and
# prints the install link in its log (make prod-logs); or set your own long random value
# (openssl rand -hex 24) and enter it on the install screen. It stops working once the site is installed.
PURSAE_SETUP_TOKEN=

# Optional
# PURSAE_PORT=8088                 # host port
# PURSAE_BIND=127.0.0.1            # host address the port is published on
# PURSAE_PLUGIN_KEYS=              # extra trusted plugin signing keys (base64, comma separated)
# PURSAE_TRUSTED_PROXIES=          # proxies whose X-Forwarded-For is believed (default: loopback + private)
# PURSAE_GEOIP_UPDATE=off          # stop the monthly DB-IP country database download (default: on)
# PURSAE_HUB=off                   # never contact hub.pursae.com: no updates, marketplace or licenses (not recommended)
