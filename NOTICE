* web/gowebeditor/pro/js/packages/{core-adapter-utils,editor-canvas-extended,
  editor-templates-extended,editor-controls-extended,editor-editing-panel-extended,
  editor-components-extended}/ and web/gowebeditor/pro/js/atomic-form-editor.min.js — Elementor
