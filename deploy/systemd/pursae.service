# Pursae as a systemd service (docs/developer/getting-started/install-binary.md).
#
# Layout:
#   /opt/pursae/bin/pursae    the binary, in a directory owned by the pursae user: Dashboard › Updates
#                             replaces it in place (keeping the previous one as pursae.prev) and
#                             re-executes it, so a core update needs no root and survives restarts
#   /var/lib/pursae/          uploads/, plugins/, themes/, languages/, backups/, … (owned by pursae)
#   /etc/pursae/pursae.env    DATABASE_URL, WPGO_SITE_URL, WPGO_UPLOADS_DIR, WPGO_SECRET, mail
#                             settings (root:pursae, mode 0640)
#
# Install: cp pursae.service /etc/systemd/system/ && systemctl daemon-reload && systemctl enable --now pursae
# Local changes: systemctl edit pursae (a drop-in), so this file can be replaced on upgrade.

[Unit]
Description=Pursae
Documentation=https://github.com/pursae/pursae/blob/main/docs/developer/getting-started/install-binary.md
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=pursae
Group=pursae
EnvironmentFile=/etc/pursae/pursae.env
WorkingDirectory=/var/lib/pursae
ExecStart=/opt/pursae/bin/pursae serve
# A failed update rolls back to pursae.prev on the next start; a crash restarts the service.
Restart=always
RestartSec=2
# The server finishes requests in flight on SIGTERM.
KillSignal=SIGTERM
TimeoutStopSec=30
# Migrations of a new version run before the server listens.
TimeoutStartSec=300
LimitNOFILE=65536
UMask=0027

# Hardening. The service writes only to its binary directory (self-update) and its data directory.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/opt/pursae/bin /var/lib/pursae
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# Not set: MemoryDenyWriteExecute=yes would stop the WebAssembly compiler that runs plugins.
# To listen on port 80 or 443 directly instead of behind a reverse proxy (systemctl edit pursae):
#   AmbientCapabilities=CAP_NET_BIND_SERVICE
#   CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
